#: sites/all/modules/custom/rovas_stripe_express_checkout/js/express_checkout.js
msgid "Enter a valid amount (up to two decimal places)."
msgstr ""

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:1567
msgid "I understand that this payment is not a subscription for premium features."
msgstr "Rozumím, že tato platba není předplatné prémiových funkcí."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:686
msgid "Premium access is not activated when you start payment from this project page in Rovas. Start your order from the project's own application."
msgstr "Prémiový přístup se neaktivuje, pokud platbu zahájíte z této stránky projektu v Rováši. Objednávku musíte zahájit v aplikaci projektu."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:708
msgid "Premium access is granted only when you start your order on !site and pay at least !thresholds. Starting payment from this project page in Rovas does not activate premium."
msgstr "Prémiový přístup získáte pouze pokud objednávku zahájíte na !site a zaplatíte alespoň !thresholds. Platba zahájená z této stránky projektu v Rováši premium neaktivuje."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:714
msgid "Premium access is granted only when you start your order from the project's own application and pay at least !thresholds. Starting payment from this project page in Rovas does not activate premium."
msgstr "Prémiový přístup získáte pouze pokud objednávku zahájíte v aplikaci projektu a zaplatíte alespoň !thresholds. Platba zahájená z této stránky projektu v Rováši premium neaktivuje."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:2145
msgid "Please confirm that you understand this payment is not a subscription for premium features."
msgstr "Potvrďte, že rozumíte, že tato platba není předplatné prémiových funkcí."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:62
msgid "Disable Stripe card, Express Checkout and bank transfer"
msgstr "Vypnout platbu kartou (Stripe), Express Checkout a bankovní převod"

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:64
msgid ""
"When checked, the /rewpro form hides \"Pay by card\", \"Pay with bank "
"transfer\" and the Express Checkout (Apple/Google Pay, Link, etc.) section. "
"Only Chron payments are accepted, both for direct project-page rewards and "
"for 3rd-party app orders that land on /rewpro. Anonymous visitors are asked "
"to log in. Existing orders already in checkout are not affected; only new "
"payments are blocked."
msgstr ""
"Po zaškrtnutí formulář /rewpro skryje tlačítka „Zaplatit kartou“ a „Zaplatit "
"bankovním převodem“ a sekci Express Checkout (Apple/Google Pay, Link atd.). "
"Přijímány jsou pouze platby chrony, a to jak z přímého odměňování projektu, "
"tak z objednávek třetích stran na /rewpro. Nepřihlášení návštěvníci jsou "
"vyzváni k přihlášení. Existující objednávky v procesu platby nejsou "
"ovlivněny; blokovány jsou pouze nové platby."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:1253
msgctxt "reward project"
msgid ""
"Please <a href=\"@login\">log in</a> or <a href=\"@register\">register</a> to "
"pay with Chrons."
msgstr ""
"Pro platbu chrony se musíte <a href=\"@login\">přihlásit</a> nebo <a "
"href=\"@register\">zaregistrovat</a>."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:2247
msgctxt "reward project"
msgid "Only Chron payments are accepted right now."
msgstr "Momentálně jsou přijímány pouze platby chrony."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:2251
msgctxt "reward project"
msgid "Please log in to pay with Chrons."
msgstr "Pro platbu chrony se musíte přihlásit."

#: sites/all/modules/custom/rovas_stripe_express_checkout/includes/init.inc:49
msgctxt "reward project"
msgid "Card payments are disabled."
msgstr "Platby kartou jsou vypnuté."

#: sites/all/modules/custom/rovas_forex/rovas_forex.module:502;1080
msgid "Chrons to Euros exchanges are temporarily suspended"
msgstr "Směny chronů za eura jsou dočasně pozastaveny."

#: sites/all/modules/contrib/oauth2_server/oauth2_server.pages.inc:94
msgid "Authorize @client to use your account?"
msgstr "Autorizovat @client k používání vašeho účtu?"

#: sites/all/modules/contrib/oauth2_server/oauth2_server.pages.inc:97
msgid "This application will be able to:"
msgstr "Tato aplikace bude moci:"

#: sites/all/modules/contrib/oauth2_server/oauth2_server.pages.inc:110
msgid "Yes, I authorize this request."
msgstr "Ano, autorizuji tento požadavek."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Your Civic account"
msgstr "Váš Civic účet"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Create account"
msgstr "Vytvořit účet"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Reset password"
msgstr "Resetovat heslo"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Enter your username."
msgstr "Zadejte své uživatelské jméno."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "The selected country is invalid."
msgstr "Vybraná země je neplatná."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "You can sign in via a service represented by an icon, or create an account with a password by filling in the form under the icons."
msgstr "Přihlásit se můžete přes službu reprezentovanou ikonou, nebo si můžete vytvořit účet s heslem vyplněním formuláře pod ikonami."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Sign in via a service represented by an icon, or enter your username and password in the form under the icons. Your Civic login credentials are the same as your Rovas login credentials."
msgstr "Přihlaste se přes službu reprezentovanou ikonou, nebo zadejte uživatelské jméno a vaše heslo ve formuláři pod ikonami. Vaše Civic přihlašovací údaje jsou stejné jako přihlašovací údaje do Rováše."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Request a link to reset a lost or forgotten password. The link will be sent to the e-mail address you provide below. If you do not receive it within 10 minutes, please check your spam folder."
msgstr "Požádejte o odkaz na obnovení ztraceného nebo zapomenutého hesla. Odkaz vám pošleme na e-mailovou adresu, kterou zadáte níže. Pokud ho nedostanete do 10 minut, zkontrolujte také složku se spamem."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Continue to Civic"
msgstr "Pokračovat do Civic"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Continue"
msgstr "Pokračovat"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Your Civic account on Rovas"
msgstr "Váš Civic účet v Rováši"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Privacy"
msgstr "Soukromí"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module:159
msgid "Read your Rovas username and grant Merits on your behalf."
msgstr "Číst vaše uživatelské jméno v Rováši a přidělovat Merity vaším jménem."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Public-benefit / nonprofit project"
msgstr "Veřejně prospěšný / neziskový projekt"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "This is a project of a registered public-benefit organization (nonprofit)"
msgstr "Toto je projekt registrované veřejně prospěšné (neziskové) organizace"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "When checked, link a public-benefit / nonprofit organization. NeoFund must approve the organization before the project appears in Civic and before EUR donations or share purchases are allowed."
msgstr "Po zaškrtnutí propojte veřejně prospěšnou / neziskovou organizaci. NeoFund musí organizaci schválit, než se projekt zobrazí v Civic a než budou povoleny dary v eurech nebo nákup podílů."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Public-benefit / nonprofit organization"
msgstr "Veřejně prospěšná / nezisková organizace"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Select an organization you manage, or !create first."
msgstr "Vyberte organizaci, kterou spravujete, nebo nejprve !create."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "create a public-benefit / nonprofit organization"
msgstr "vytvořte veřejně prospěšnou / neziskovou organizaci"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Donate instructions (project override)"
msgstr "Pokyny k darování (přepsání pro projekt)"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Optional. Overrides the organization's default donate instructions for this project."
msgstr "Volitelné. Přepíše výchozí pokyny k darování organizace pro tento projekt."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Donate URL (project override)"
msgstr "URL pro darování (přepsání pro projekt)"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Optional absolute URL. Overrides the organization's default donate URL."
msgstr "Volitelná absolutní URL. Přepíše výchozí URL pro darování organizace."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Select or create a public-benefit / nonprofit organization for this project."
msgstr "Vyberte nebo vytvořte veřejně prospěšnou / neziskovou organizaci pro tento projekt."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Invalid public-benefit / nonprofit organization."
msgstr "Neplatná veřejně prospěšná / nezisková organizace."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "You may only link public-benefit / nonprofit organizations you own."
msgstr "Můžete propojit jen veřejně prospěšné / neziskové organizace, které vlastníte."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Register a public-benefit / nonprofit organization"
msgstr "Registrovat veřejně prospěšnou / neziskovou organizaci"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Legal name"
msgstr "Právní název"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Official registered name of the public-benefit / nonprofit organization."
msgstr "Oficiální registrovaný název veřejně prospěšné / neziskové organizace."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "EUR donations and EUR share purchases are unavailable until NeoFund approves this project’s public-benefit / nonprofit organization. You can still pay with Chrons."
msgstr "Dary v eurech a nákup podílů za eura nejsou dostupné, dokud NeoFund neschválí veřejně prospěšnou / neziskovou organizaci tohoto projektu. Stále můžete platit chrony."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "EUR payments are blocked until NeoFund approves this public-benefit / nonprofit organization."
msgstr "Platby v eurech jsou zablokované, dokud NeoFund neschválí tuto veřejně prospěšnou / neziskovou organizaci."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Nonprofit or charity project of organization @org, added by a donor/sponsor of this organization. If you represent this organization, send a message to !mail and we will change the owner to you."
msgstr "Neziskový nebo charitativní projekt organizace @org, přidaný dárcem/sponzorem této organizace. Pokud tuto organizaci zastupujete, pošlete zprávu na !mail a my po ověření změníme vlastníka na vás."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Hello,"
msgstr "Dobrý den,"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "a Civic user"
msgstr "Civic"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "At the request of user @username of our Rovas app, we today added your organization @org to the application and also created a project for it. These two steps are necessary so that our users can send you money and at the same time be rewarded by us for it."
msgstr "Na žádost uživatele „@username“ naší aplikace Rováš jsme dnes do aplikace přidali vaši organizaci @org a vytvořili pro ni také projekt. Tyto dva kroky jsou nutné, aby vám naši uživatelé mohli posílat peníze a zároveň za to být námi odměněni."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Your organization page: @url"
msgstr "Stránka vaší organizace: @url"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "The project we created for you: @url"
msgstr "Projekt, který jsme pro vás vytvořili: @url"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "You can claim this project on Rovas (log in or register) to take ownership and add or correct information such as donation instructions. Please reply to this email if you wish to do so."
msgstr "Tento projekt můžete v Rováši převzít (přihlaste se nebo se zaregistrujte), abyste v něm mohli doplnit nebo opravit údaje, například pokyny k darování. Pokud o to máte zájem, vytvořte si v Rováši účet a poté odpovězte na tento e-mail."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Learn more about <a href=\"!url\">how this works</a>."
msgstr "Více o tom, <a href=\"!url\">jak to funguje</a>."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "We are NeoFund, a Slovak nonprofit. We develop solutions that aim to increase contributions to the volunteer, nonprofit, and charitable sector."
msgstr "Jsme slovenská nezisková organizace, jejímž cílem je zvýšit příspěvky do dobrovolnického, neziskového a charitativního sektoru."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Rovas: Your organization was added — @title"
msgstr "Rovas: Vaše organizace byla přidána — @title"

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "Trusted user — settings"
msgstr "Důvěryhodný uživatel — nastavení"

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "A user can become trusted if their <a href=\"@glossary\">compliance score</a> is at least @score, or if they own a project and have earned more than @merits Merits from rewards to that project (owning shares alone is not enough)."
msgstr "Důvěryhodným uživatelem se může stát ten, kdo má <a href=\"@glossary\">skóre souladu</a> alespoň @score, nebo pokud vlastní projekt a z odměn tohoto projektu získal více než @merits Meritů (samotné vlastnictví podílů nestačí)."

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "Even when your reports are immediately approved, other users can still challenge them by filing a dispute. Losing a dispute can revoke Trusted user status."
msgstr "I když jsou vaše zprávy okamžitě schváleny, jiní uživatelé je mohou stále napadnout podáním sporu. Prohra ve sporu může status důvěryhodného uživatele odejmout."

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "I want my reports immediately approved"
msgstr "Chci, aby byly mé zprávy okamžitě schváleny"

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "Verification requests"
msgstr "Žádosti o ověření"

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "I am willing to keep verifying any work reports as needed"
msgstr "Jsem ochoten nadále ověřovat pracovní zprávy podle potřeby"

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "I do not want to receive the mandatory verification requests"
msgstr "Nechci dostávat povinné žádosti o ověření"

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "I do not want to receive any verification requests"
msgstr "Nechci dostávat žádné žádosti o ověření"

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "You will be receiving verification requests from your domain of expertise, and occasionally also requests for reports out of your domain of expertise."
msgstr "Budete dostávat žádosti o ověření z vaší oblasti odbornosti a příležitostně také žádosti o zprávy mimo vaši oblast."

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "You might occasionally receive requests for reports out of your domain of expertise that you can refuse to verify without penalties."
msgstr "Příležitostně můžete dostat žádosti o zprávy mimo vaši oblast odbornosti, které můžete odmítnout ověřit bez sankcí."

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "You will not receive any verification requests."
msgstr "Nebudete dostávat žádné žádosti o ověření."

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "You will stop receiving verification requests only after you have verified your existing verification requests."
msgstr "Výzvy k ověření přestanete dostávat až poté, co ověříte své existující žádosti o ověření."

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "Congratulations, you are now a <strong>Trusted user</strong>!"
msgstr "Blahopřejeme, stali jste se <strong>důvěryhodným uživatelem</strong>!"

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "You can have your work reports immediately approved and can also stop verifying other users' reports. You can set these benefits in your <a href=\"@profile\">account settings</a>."
msgstr "Vaše pracovní výkazy můžete mít okamžitě schválené a můžete také přestat ověřovat zprávy jiných uživatelů. Tyto výhody si můžete nastavit v <a href=\"@profile\">nastavení účtu</a>."

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "Verify one more work report to become a <strong>Trusted user</strong>."
msgstr "Ověřte ještě jeden pracovní výkaz a stanete se <strong>důvěryhodným uživatelem</strong>."

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "Verify @count more work reports to become a <strong>Trusted user</strong>."
msgstr "Ověřte ještě @count pracovních výkazů a stanete se <strong>důvěryhodným uživatelem</strong>."

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "Trusted users can have their work reports approved immediately and do not even have to verify reports."
msgstr "Důvěryhodní uživatelé mohou mít své výkazy okamžitě schválené a nemusí ani ověřovat výkazy."

#: sites/all/modules/custom/rovas_user/rovas_user.module
#: sites/all/modules/custom/rovas_comment_watch/rovas_comment_watch.module
msgid "Do not show this message again"
msgstr "Tuto zprávu již nezobrazovat"

#: sites/all/modules/custom/rovas_user/rovas_user.module
msgid "Dismiss trusted notification"
msgstr "Zavřít upozornění o důvěryhodném stavu"

#: sites/all/modules/custom/rovas_report_form/rovas_report_form.module
msgid "Work can only be reported if it started within the last 30 days."
msgstr "Práci lze nahlásit pouze tehdy, pokud začala v posledních 30 dnech."

#: sites/all/modules/custom/rovas_chron/rovas_chron.module
msgid "Merit receipt offset"
msgstr "Vyrovnání Merit potvrzenky"

#: sites/all/modules/custom/rovas_chron/rovas_chron.module
msgid "Work report grant"
msgstr "Grant z pracovního výkazu"

#: sites/all/modules/custom/rovas_chron/rovas_chron.module
msgid "Work report clawback"
msgstr "Storno z pracovního výkazu"

#: sites/all/modules/custom/rovas_chron/rovas_chron.module
msgid "Opening balance"
msgstr "Počáteční zůstatek"

#: sites/all/modules/custom/rovas_chron/rovas_chron.ledger.inc
msgid "Opening balance at Chron ledger cutover (no wallet change; closes Chron-tab drift)."
msgstr "Počáteční zůstatek při přechodu na Chron ledger (bez změny peněženky; uzavře odchylku Chron karty)."

#: sites/all/modules/custom/rovas_comment_watch/rovas_comment_watch.module
msgid "Dismiss comment watch notice"
msgstr "Zavřít upozornění na komentář"

#: sites/all/modules/custom/rovas_comment_watch/rovas_comment_watch.module
msgid "Pending watched-comment notices"
msgstr "Čekající upozornění na sledované komentáře"

#: sites/all/modules/custom/rovas_comment_watch/rovas_comment_watch.module
msgid "New comments you are watching"
msgstr "Nové komentáře, které sledujete"

#: sites/all/modules/custom/rovas_comment_watch/rovas_comment_watch.module
msgid "There is a new comment on !title you are watching."
msgstr "Na !title, který sledujete, je nový komentář."

#: sites/all/modules/custom/rovas_comment_watch/rovas_comment_watch.module
msgid "There are new comments on !title you are watching."
msgstr "Na !title, který sledujete, jsou nové komentáře."

#: sites/all/modules/custom/rovas_report_form/rovas_report_form.module
msgid "Public proof photos"
msgstr "Veřejné důkazové fotografie"

#: sites/all/modules/custom/rovas_report_form/rovas_report_form.module
msgid "Proofs of work are visible to the public, so we encourage you to review and redact sensitive information from the images using the paint tools provided here."
msgstr "Důkazy práce jsou veřejně viditelné, proto vás žádáme, abyste zkontrolovali obrázky a zakryli citlivé údaje pomocí nástrojů na malování dostupných zde."

#: sites/all/modules/custom/rovas_report_form/rovas_report_form.module
msgid "Use \"Black out areas\" under each photo (or click the thumbnail) to rotate the image or cover names, emails, or phones with a black marker."
msgstr "Pod každou fotografií použijte „Zakrýt oblasti“ (nebo klikněte na náhled) k otočení obrázku nebo k zakrytí jmen, e-mailů či telefonů černým popisovačem."

#: sites/all/modules/custom/rovas_report_form/rovas_report_form.module
msgid "Got it"
msgstr "Rozumím"

#: sites/all/modules/custom/rovas_report_form/rovas_report_form.module
msgid "Black out areas"
msgstr "Zakrýt oblasti"

#: sites/all/modules/custom/rovas_report_form/rovas_report_form.module
msgid "Opens a tool to rotate the photo or black out sensitive parts. You can also click the thumbnail."
msgstr "Otevře nástroj k otočení fotografie nebo zakrytí citlivých částí. Můžete také kliknout na náhled."

#: sites/all/modules/custom/rovas_report_form/rovas_report_form.module
