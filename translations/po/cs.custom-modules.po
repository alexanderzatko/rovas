#: sites/all/modules/custom/rovas_stripe_express_checkout/js/express_checkout.js
msgid "Enter a valid amount (up to two decimal places)."
msgstr ""

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:1567
msgid "I understand that this payment is not a subscription for premium features."
msgstr "Rozumím, že tato platba není předplatné prémiových funkcí."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:686
msgid "Premium access is not activated when you start payment from this project page in Rovas. Start your order from the project's own application."
msgstr "Prémiový přístup se neaktivuje, pokud platbu zahájíte z této stránky projektu v Rováši. Objednávku musíte zahájit v aplikaci projektu."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:708
msgid "Premium access is granted only when you start your order on !site and pay at least !thresholds. Starting payment from this project page in Rovas does not activate premium."
msgstr "Prémiový přístup získáte pouze pokud objednávku zahájíte na !site a zaplatíte alespoň !thresholds. Platba zahájená z této stránky projektu v Rováši premium neaktivuje."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:714
msgid "Premium access is granted only when you start your order from the project's own application and pay at least !thresholds. Starting payment from this project page in Rovas does not activate premium."
msgstr "Prémiový přístup získáte pouze pokud objednávku zahájíte v aplikaci projektu a zaplatíte alespoň !thresholds. Platba zahájená z této stránky projektu v Rováši premium neaktivuje."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:2145
msgid "Please confirm that you understand this payment is not a subscription for premium features."
msgstr "Potvrďte, že rozumíte, že tato platba není předplatné prémiových funkcí."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:62
msgid "Disable Stripe card, Express Checkout and bank transfer"
msgstr "Vypnout platbu kartou (Stripe), Express Checkout a bankovní převod"

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:64
msgid ""
"When checked, the /rewpro form hides \"Pay by card\", \"Pay with bank "
"transfer\" and the Express Checkout (Apple/Google Pay, Link, etc.) section. "
"Only Chron payments are accepted, both for direct project-page rewards and "
"for 3rd-party app orders that land on /rewpro. Anonymous visitors are asked "
"to log in. Existing orders already in checkout are not affected; only new "
"payments are blocked."
msgstr ""
"Po zaškrtnutí formulář /rewpro skryje tlačítka „Zaplatit kartou“ a „Zaplatit "
"bankovním převodem“ a sekci Express Checkout (Apple/Google Pay, Link atd.). "
"Přijímány jsou pouze platby chrony, a to jak z přímého odměňování projektu, "
"tak z objednávek třetích stran na /rewpro. Nepřihlášení návštěvníci jsou "
"vyzváni k přihlášení. Existující objednávky v procesu platby nejsou "
"ovlivněny; blokovány jsou pouze nové platby."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:1253
msgctxt "reward project"
msgid ""
"Please <a href=\"@login\">log in</a> or <a href=\"@register\">register</a> to "
"pay with Chrons."
msgstr ""
"Pro platbu chrony se musíte <a href=\"@login\">přihlásit</a> nebo <a "
"href=\"@register\">zaregistrovat</a>."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:2247
msgctxt "reward project"
msgid "Only Chron payments are accepted right now."
msgstr "Momentálně jsou přijímány pouze platby chrony."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:2251
msgctxt "reward project"
msgid "Please log in to pay with Chrons."
msgstr "Pro platbu chrony se musíte přihlásit."

#: sites/all/modules/custom/rovas_stripe_express_checkout/includes/init.inc:49
msgctxt "reward project"
msgid "Card payments are disabled."
msgstr "Platby kartou jsou vypnuté."

#: sites/all/modules/custom/rovas_forex/rovas_forex.module:502;1080
msgid "Chrons to Euros exchanges are temporarily suspended"
msgstr "Směny chronů za eura jsou dočasně pozastaveny."

#: sites/all/modules/contrib/oauth2_server/oauth2_server.pages.inc:94
