#: sites/all/modules/custom/rovas_stripe_express_checkout/js/express_checkout.js
msgid "Enter a valid amount (up to two decimal places)."
msgstr ""

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:1567
msgid "I understand that this payment is not a subscription for premium features."
msgstr "Rozumiem, že táto platba nie je predplatné prémiových funkcií."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:686
msgid "Premium access is not activated when you start payment from this project page in Rovas. Start your order from the project's own application."
msgstr "Prémiový prístup sa neaktivuje, ak platbu začnete z tejto stránky projektu v Rováši. Objednávku musíte začať v aplikácii projektu."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:708
msgid "Premium access is granted only when you start your order on !site and pay at least !thresholds. Starting payment from this project page in Rovas does not activate premium."
msgstr "Prémiový prístup získate len ak objednávku začnete na !site a zaplatíte aspoň !thresholds. Platba začatá z tejto stránky projektu v Rováši prémiu neaktivuje."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:714
msgid "Premium access is granted only when you start your order from the project's own application and pay at least !thresholds. Starting payment from this project page in Rovas does not activate premium."
msgstr "Prémiový prístup získate len ak objednávku začnete v aplikácii projektu a zaplatíte aspoň !thresholds. Platba začatá z tejto stránky projektu v Rováši prémiu neaktivuje."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:2145
msgid "Please confirm that you understand this payment is not a subscription for premium features."
msgstr "Potvrďte, že rozumiete, že táto platba nie je predplatné prémiových funkcií."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:62
msgid "Disable Stripe card, Express Checkout and bank transfer"
msgstr "Vypnúť platbu kartou (Stripe), Express Checkout a bankovný prevod"

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:64
msgid ""
"When checked, the /rewpro form hides \"Pay by card\", \"Pay with bank "
"transfer\" and the Express Checkout (Apple/Google Pay, Link, etc.) section. "
"Only Chron payments are accepted, both for direct project-page rewards and "
"for 3rd-party app orders that land on /rewpro. Anonymous visitors are asked "
"to log in. Existing orders already in checkout are not affected; only new "
"payments are blocked."
msgstr ""
"Po zaškrtnutí formulár /rewpro skryje tlačidlá „Zaplatiť kartou“ a „Zaplatiť "
"bankovým prevodom“ a sekciu Express Checkout (Apple/Google Pay, Link atď.). "
"Prijímané sú len platby chronmi, a to pri priamom odmeňovaní projektu aj pri "
"objednávkach tretích strán na /rewpro. Neprihlásení návštevníci sú vyzvaní na "
"prihlásenie. Existujúce objednávky v procese platby nie sú ovplyvnené; "
"blokované sú len nové platby."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:1253
msgctxt "reward project"
msgid ""
"Please <a href=\"@login\">log in</a> or <a href=\"@register\">register</a> to "
"pay with Chrons."
msgstr ""
"Na zaplatenie chronmi sa musíte <a href=\"@login\">prihlásiť</a> alebo <a "
"href=\"@register\">zaregistrovať</a>."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:2247
msgctxt "reward project"
msgid "Only Chron payments are accepted right now."
msgstr "Momentálne sú prijímané len platby chronmi."

#: sites/all/modules/custom/rovas_project_reward/rovas_project_reward.module:2251
msgctxt "reward project"
msgid "Please log in to pay with Chrons."
msgstr "Na zaplatenie chronmi sa musíte prihlásiť."

#: sites/all/modules/custom/rovas_stripe_express_checkout/includes/init.inc:49
msgctxt "reward project"
msgid "Card payments are disabled."
msgstr "Platby kartou sú vypnuté."

#: sites/all/modules/custom/rovas_forex/rovas_forex.module:502;1080
msgid "Chrons to Euros exchanges are temporarily suspended"
msgstr "Výmeny chronov za eurá sú dočasne pozastavené."

#: sites/all/modules/contrib/oauth2_server/oauth2_server.pages.inc:94
msgid "Authorize @client to use your account?"
msgstr "Autorizovať @client na používanie vášho účtu?"

#: sites/all/modules/contrib/oauth2_server/oauth2_server.pages.inc:97
msgid "This application will be able to:"
msgstr "Táto aplikácia bude môcť:"

#: sites/all/modules/contrib/oauth2_server/oauth2_server.pages.inc:110
msgid "Yes, I authorize this request."
msgstr "Áno, autorizujem túto požiadavku."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Your Civic account"
msgstr "Váš Civic účet"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Create account"
msgstr "Vytvoriť účet"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Reset password"
msgstr "Resetovať heslo"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Enter your username."
msgstr "Zadajte svoje používateľské meno."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "The selected country is invalid."
msgstr "Vybraná krajina je neplatná."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "You can sign in via a service represented by an icon, or create an account with a password by filling in the form under the icons."
msgstr "Prihlásiť sa môžete cez službu reprezentovanú ikonou, alebo si môžete vytvoriť účet s heslom vyplnením formulára pod ikonami."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Sign in via a service represented by an icon, or enter your username and password in the form under the icons. Your Civic login credentials are the same as your Rovas login credentials."
msgstr "Prihláste sa cez službu reprezentovanú ikonou, alebo zadajte používateľské meno a vaše heslo vo formulári pod ikonami. Vaše Civic prihlasovacie údaje sú rovnaké ako prihlasovacie údaje do Rováša."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Request a link to reset a lost or forgotten password. The link will be sent to the e-mail address you provide below. If you do not receive it within 10 minutes, please check your spam folder."
msgstr "Požiadajte o odkaz na obnovenie strateného alebo zabudnutého hesla. Odkaz vám pošleme na e-mailovú adresu, ktorú zadáte nižšie. Ak ho nedostanete do 10 minút, skontrolujte aj priečinok so spamom."

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Continue to Civic"
msgstr "Pokračovať do Civic"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Continue"
msgstr "Pokračovať"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Your Civic account on Rovas"
msgstr "Váš Civic účet v Rováši"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module
msgid "Privacy"
msgstr "Súkromie"

#: sites/all/modules/custom/rovas_oauth/rovas_oauth.module:159
msgid "Read your Rovas username and grant Merits on your behalf."
msgstr "Čítať vaše používateľské meno v Rováši a prideľovať Merity vo vašom mene."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Public-benefit / nonprofit project"
msgstr "Verejnoprospešný / neziskový projekt"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "This is a project of a registered public-benefit organization (nonprofit)"
msgstr "Toto je projekt registrovanej verejnoprospešnej (neziskovej) organizácie"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "When checked, link a public-benefit / nonprofit organization. NeoFund must approve the organization before the project appears in Civic and before EUR donations or share purchases are allowed."
msgstr "Po zaškrtnutí prepojte verejnoprospešnú / neziskovú organizáciu. NeoFund musí organizáciu schváliť, skôr než sa projekt zobrazí v Civic a skôr než budú povolené dary v eurách alebo nákup podielov."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Public-benefit / nonprofit organization"
msgstr "Verejnoprospešná / nezisková organizácia"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Select an organization you manage, or !create first."
msgstr "Vyberte organizáciu, ktorú spravujete, alebo najprv !create."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "create a public-benefit / nonprofit organization"
msgstr "vytvorte verejnoprospešnú / neziskovú organizáciu"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Donate instructions (project override)"
msgstr "Pokyny na darovanie (prepísanie pre projekt)"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Optional. Overrides the organization's default donate instructions for this project."
msgstr "Voliteľné. Prepíše predvolené pokyny na darovanie organizácie pre tento projekt."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Donate URL (project override)"
msgstr "URL na darovanie (prepísanie pre projekt)"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Optional absolute URL. Overrides the organization's default donate URL."
msgstr "Voliteľná absolútna URL. Prepíše predvolenú URL na darovanie organizácie."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Select or create a public-benefit / nonprofit organization for this project."
msgstr "Vyberte alebo vytvorte verejnoprospešnú / neziskovú organizáciu pre tento projekt."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Invalid public-benefit / nonprofit organization."
msgstr "Neplatná verejnoprospešná / nezisková organizácia."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "You may only link public-benefit / nonprofit organizations you own."
msgstr "Môžete prepojiť len verejnoprospešné / neziskové organizácie, ktoré vlastníte."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Register a public-benefit / nonprofit organization"
msgstr "Registrovať verejnoprospešnú / neziskovú organizáciu"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Legal name"
msgstr "Právny názov"

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Official registered name of the public-benefit / nonprofit organization."
msgstr "Oficiálny registrovaný názov verejnoprospešnej / neziskovej organizácie."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Only NeoFund staff should set Approved. Review for public-benefit / nonprofit eligibility (not charity-only). Owners leave this as Pending."
msgstr "Schválené majú nastaviť len pracovníci NeoFundu. Skontrolujte spôsobilosť verejnoprospešnej / neziskovej organizácie (nie len charity). Vlastníci nechajú stav Čakajúce."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "EUR donations and EUR share purchases are unavailable until NeoFund approves this project’s public-benefit / nonprofit organization. You can still pay with Chrons."
msgstr "Dary v eurách a nákup podielov za eurá nie sú dostupné, kým NeoFund neschváli verejnoprospešnú / neziskovú organizáciu tohto projektu. Stále môžete platiť chronmi."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "EUR payments are blocked until NeoFund approves this public-benefit / nonprofit organization."
msgstr "Platby v eurách sú zablokované, kým NeoFund neschváli túto verejnoprospešnú / neziskovú organizáciu."

#: sites/all/modules/custom/rovas_civic/rovas_civic.module
msgid "Nonprofit projects"
msgstr "Neziskové projekty"

#: sites/all/modules/custom/rovas_civic/rovas_civic.module
msgid "Public-benefit / nonprofit organizations"
msgstr "Verejnoprospešné / neziskové organizácie"

#: sites/all/modules/custom/rovas_civic/rovas_civic.admin.inc
msgid "Review public-benefit / nonprofit organizations"
msgstr "Skontrolovať verejnoprospešné / neziskové organizácie"

#: sites/all/modules/custom/rovas_civic/rovas_civic.admin.inc
msgid "NeoFund review queue for organizations linked from public-benefit / nonprofit projects."
msgstr "Fronta NeoFundu na kontrolu organizácií prepojených z verejnoprospešných / neziskových projektov."

#: sites/all/modules/custom/rovas_civic/rovas_civic.admin.inc
msgid "Approved public-benefit / nonprofit organization @title."
msgstr "Schválená verejnoprospešná / nezisková organizácia @title."

#: sites/all/modules/custom/rovas_civic/rovas_civic.admin.inc
msgid "No public-benefit / nonprofit organizations match this filter."
msgstr "Tomuto filtru nezodpovedajú žiadne verejnoprospešné / neziskové organizácie."

#: sites/all/modules/custom/rovas_civic/rovas_civic.charity.inc
msgid "Nonprofit or charity project of organization @org, added by a donor/sponsor of this organization. If you represent this organization, send a message to !mail and we will change the owner to you."
msgstr "Neziskový alebo charitatívny projekt organizácie @org, pridaný darcom/sponzorom tejto organizácie. Ak reprezentujete túto organizáciu, pošlite správu na !mail a my po overení zmeníme vlastníka na vás."
