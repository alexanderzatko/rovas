"\t$ch_basket = $forex_baskets_temp['ch_basket'];\r\n"
"\t$eur_basket = $forex_baskets_temp['eur_basket'];\r\n"
"}\r\n"
"$input = abs($euros);\r\n"
"$buy_ch_fee = variable_get('buy_ch_fee');\r\n"
"$buy_ch_fixed_fee = variable_get('buy_ch_fixed_fee');\r\n"
"$eur_result_ary = forex($input,$eur_basket,$ch_basket,$buy_ch_fee,$buy_ch_fixed_fee);\r\n"
"echo $eur_result_ary['output'];\r\n"
"\r\n"
"?>"
