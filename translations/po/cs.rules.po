msgctxt "rules_config:rules_proxy_check_or_add_project_shareholder:19:value"
msgid ""
"<?php\r\n"
"$res = db_query(\"SELECT ma.field_merit_allocation_value AS shares, sn.nid as shpr\r\n"
"FROM {node} node\r\n"
"LEFT JOIN {field_data_field_project} fpr ON node.nid = fpr.entity_id AND (fpr.entity_type = 'node' AND fpr.deleted = '0')\r\n"
"LEFT JOIN {node} n ON fpr.field_project_target_id = n.nid\r\n"
"LEFT JOIN {field_data_field_merit_allocation} ma ON node.nid = ma.entity_id AND (ma.entity_type = 'node' AND ma.deleted = '0')\r\n"
"LEFT JOIN {field_data_field_shareholder_project} shpr ON node.nid = shpr.entity_id AND (shpr.entity_type = 'node' AND shpr.deleted = '0')\r\n"
"LEFT JOIN {node} sn ON shpr.field_shareholder_project_target_id = sn.nid\r\n"
"WHERE n.nid = :prid\r\n"
"AND node.status = '1'\r\n"
"AND node.type IN ('project_merit_allocation', 'co_worker_merit_allocation')\r\n"
"\", array(':prid' => $project->nid));\r\n"
"\r\n"
"$sumarray = $res->fetchAll();\r\n"
"\r\n"
"$total_shares = 0;\r\n"
"$dupe = 0;\r\n"
"\r\n"
"foreach ($sumarray AS $share) {\r\n"
"\t$total_shares += $share->shares;\r\n"
"\tif ($share->shpr == $shareholder_project->nid) {\r\n"
"\t\t$dupe = 1;\r\n"
"\t\tbreak;\r\n"
"\t}\r\n"
"}\r\n"
"\r\n"
"/*\r\n"
"* make sure that:\r\n"
"- the project being added isn't already a shareholder\r\n"
"- for share-based projects, the total shares does not exceed 100% after the new share is added\r\n"
"*/\r\n"
"\r\n"
"$result = !$time_based ? ($merit_share + $total_shares) <= 100 : 1;\r\n"
"\r\n"
"echo !$dupe && $result;\r\n"
"\r\n"
"?>"
msgstr ""

