#: rules:rules_config:rules_update_user_expertise:8:value
msgctxt "rules_config:rules_update_user_expertise:8:value"
msgid ""
"<?php\r\n"
"\r\n"
"\t//load the expert table node corresponding to the current category in order to find its existing Merit value\r\n"
"\t$result = db_query(\"SELECT node.nid AS nid, m.field_merits_value AS merits\r\n"
"\tFROM {node} node\r\n"
"\tLEFT JOIN {field_data_field_expert} x ON node.nid = x.entity_id AND (x.entity_type = 'node' AND x.deleted = '0')\r\n"
"\tLEFT JOIN {field_data_field_category} c ON node.nid = c.entity_id AND (c.entity_type = 'node' AND c.deleted = '0')\r\n"
"\tLEFT JOIN {field_data_field_merits} m ON node.nid = m.entity_id AND (m.entity_type = 'node' AND m.deleted = '0')\r\n"
"\tWHERE node.type = 'user_expertise'\r\n"
"\tAND field_expert_target_id = :uid\r\n"
"\tAND c.field_category_tid = :cat\r\n"
"\t\", array(':uid' => $rewardee_uid, ':cat' => $classification));\r\n"
"\r\n"
"\t$record = $result->fetchAssoc();\r\n"
"\t//for some users and category IDs we will have to create a new user_expertise node\t\t\t\r\n"
"\tif (empty($record)) {\r\n"
"\t\t$node = new stdClass();\r\n"
"\t\t$node->type = 'user_expertise';\r\n"
"\t\t$node->title = 'UX-' . $rewardee_uid . '-' . $classification;\r\n"
"\t\t$node->language = LANGUAGE_NONE;\r\n"
"\t\tnode_object_prepare($node);\r\n"
"\t\t$node->uid = $rewardee_uid;\r\n"
"\r\n"
"\t\t$node->field_expert[LANGUAGE_NONE][0]['target_id'] = $rewardee_uid;\r\n"
"\t\t$node->field_category[LANGUAGE_NONE][0]['tid'] = $classification;\r\n"
"\r\n"
"\t\t$old_merits = 0;\r\n"
"\t\t$node->field_merits[LANGUAGE_NONE][0]['value'] = $old_merits;\r\n"
"\r\n"
"\t\t$node = node_submit($node);\r\n"
"\t\tnode_save($node);\r\n"
"\t\t$nid = $node->nid;\r\n"
"\r\n"
"\t}\r\n"
"\telse {\r\n"
"\t\t$old_merits = $record['merits'];\r\n"
"\t\t$nid = $record['nid'];\r\n"
"\t}\r\n"
"\t// @time_share is the ratio of the time reported in the work report being processed divided by the project total_time\r\n"
"\tif ($time_share == 1) {\r\n"
"\t\t$cur_merits = $old_merits + $merit_reward;\r\n"
"\t}\r\n"
"\telse {\r\n"
"\t\t$merits2add = $time_share * $merit_reward;\r\n"
"\t\t$cur_merits = $old_merits + $merits2add;\r\n"
"\t}\r\n"
"\r\n"
"\t//updating the node with new merit value\r\n"
"\t$xobject = entity_metadata_wrapper('node', $nid);\r\n"
"\t$xobject->field_merits = $cur_merits;\r\n"
"\t$xobject->save();\r\n"
"?>"
msgstr ""

