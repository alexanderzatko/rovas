"\r\n"
"$i='';\r\n"
"foreach ($result as $row) {\r\n"
"\tif ($i != '')\r\n"
"\t\t$i = $i . ',' . $row->nid;\r\n"
"\telse\r\n"
"\t\t$i = $row->nid;\r\n"
"}\r\n"
"//watchdog('rules','[' . $i . ']');\r\n"
"echo $i;\r\n"
