msgctxt "rules_config:rules_google_translate_text:2:value"
msgid ""
"<?php\r\n"
"\r\n"
"if (empty($from_code) || $from_code == 'xx') {\r\n"
"   $from_code = '';\r\n"
"}\r\n"
"else {\r\n"
"   $from_code = $from_code;\r\n"
"}\r\n"
"$encoded = drupal_encode_path($input);\r\n"
"$contype = 'text/plain';\r\n"
"$google_service = 'https://translation.googleapis.com/language/translate/v2';\r\n"
"$api_key = trim(variable_get('rovas_google_translate_api_key', ''));\r\n"
"if ($api_key === '') {\r\n"
"\techo 'error';\r\n"
"\twatchdog('rule', 'rules_google_translate_text missing Google Translate API key.');\r\n"
"\treturn;\r\n"
"}\r\n"
"\r\n"
"$url = $google_service . '?key=' . $api_key . '&q=' . $encoded . '&target=' . $to_code . (empty($from_code) ? '' : '&source=' . $from_code);\r\n"
"\r\n"
"global $base_url;\r\n"
"\r\n"
"$rest_call = drupal_http_request($url, array(\r\n"
"    'headers' => array(\r\n"
"        'Content-Type' => $contype,\r\n"
"        'Referer' => $base_url . '/',\r\n"
"    ),\r\n"
"    'method' => 'POST',\r\n"
"    'timeout' => 5,\r\n"
"));\r\n"
"\r\n"
"if (isset($rest_call->code) && $rest_call->code == 200) {\r\n"
"\t$kuk = json_decode($rest_call->data);\r\n"
"\techo $kuk->data->translations[0]->translatedText;\r\n"
"}\r\n"
"else {\r\n"
"\techo 'error';\r\n"
"watchdog('rule','rules_google_translate_text 1' . print_r($rest_call,1));\r\n"
"}\r\n"
"\r\n"
"?>"
msgstr ""

