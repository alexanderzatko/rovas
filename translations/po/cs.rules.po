#: rules:rules_config:rules_find_verifier_test:27:value
msgctxt "rules_config:rules_find_verifier_test:27:value"
msgid ""
"<?php\r\n"
"\r\n"
"$report = entity_metadata_wrapper('node', $wr_object);\r\n"
"$ex_node = $report->field_web_address->value();\r\n"
"$ex_token = $report->field_content_access_token->value();\r\n"
"\r\n"
"if (count($ex_node) == 1) {\r\n"
"\t$web = $ex_node[0];\r\n"
"\t$septyp = strpos($web, '?');\r\n"
"\t$doubles = strpos($web, '\"');\r\n"
"\r\n"
"\tif ($septyp) {\r\n"
"\t\t$separator = '&';\r\n"
"\t}\r\n"
"\telse {\r\n"
"\t\t$separator = '?';\r\n"
"\t}\r\n"
"\r\n"
"$quotsrc = array('[',\"]\",'{',\"}\",'\"',\"'\");\r\n"
"$quotrepl = array('%5B','%5D','%7B','%7D','%22','%27');\r\n"
"\t\r\n"
"\tif ($doubles) {\r\n"
"\t\r\n"
"\t\t$url = $web . $separator . \"cbt=\" . $ex_token . \"&vrfier=\" . $verifier_uid_int;\r\n"
"\t\t$ary = explode('?',$url);\r\n"
"\t\t$encoded = str_replace($quotsrc,$quotrepl,$ary[1]);\r\n"
"\t\t$url = $ary[0] . '?' . $encoded;\r\n"
"\r\n"
"\t\t$link = $url;\r\n"
"\t}\r\n"
"\telse {\r\n"
"\t\t$url = $web . $separator . 'cbt=' . $ex_token . '&vrfier=' . $verifier_uid_int;\r\n"
"\t\t$ary = explode('?',$url);\r\n"
"\t\t$encoded = str_replace($quotsrc,$quotrepl,$ary[1]);\r\n"
"\t\t$url = $ary[0] . '?' . $encoded;\r\n"
"\r\n"
"\t\t$link = $url;\r\n"
"\t}\r\n"
"}\r\n"
"else {\r\n"
"\t$link = '';\r\n"
"}\r\n"
"echo $link;\r\n"
"?>"
msgstr ""

