"?>"
msgstr ""

#: /admin/structure/views/view/project_coworkers/edit
msgid ""
"<?php\n"
"$result = db_query(\"SELECT SUM(field_merit_allocation_value) AS allocval \n"
"FROM {field_data_field_merit_allocation}\n"
"WHERE bundle = 'co_worker_merit_allocation'\n"
"AND entity_id in (\n"
"SELECT entity_id AS mallocid \n"
"FROM {field_data_field_project}\n"
"WHERE bundle = 'co_worker_merit_allocation'\n"
"AND field_project_target_id = :projecid\n"
")\", array(':projecid' => 14));\n"
"\n"
"    foreach ($result as $row) {\n"
"if($row->allocval > 100)\n"
"      print '<span style=\"color: red;\"> '. t('Warning: The sum of Merit shares is more than 100%!') . '</span>';\n"
"else if ($row->allocval == \"\")\n"
"      print t('Any Merit reward will be distributed among workers in proportion to the number of hours they worked');\n"
"else if ($row->allocval == 100)\n"
"      print t('Any Merit reward will be distributed among workers according to negotiated shares.');\n"
"else\n"
"      print t('Any Merit reward will be distributed among workers according to negotiated shares and the number of hours they worked.');\n"
"    }\n"
"\n"
"print '<a class=\"btn btn-default btn-xs\" style=\"color: white; background-color: green;\" role=\"button\" href=\"/node/add/co-worker-merit-allocation/' . arg(1) . '\">' . t('Add Worker') . '</a></br>';\n"
"?>"
msgstr ""

