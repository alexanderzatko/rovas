msgstr ""
"Impossibile caricare il file perché la destinazione %destinazione non è "
"valida."

msgid ""
"The file %source could not be uploaded because a file by that name already "
"exists in the destination %directory."
msgstr ""
"Impossibile caricare il file %source perché esiste già un file con quel nome"
" nella directory %d."

msgid ""
"The file's name exceeds the 240 characters limit. Please rename the file and"
" try again."
msgstr ""
"Il nome del file supera il limite di 240 caratteri. Rinominare il file e "
"riprovare."

msgid ""
"%path is a directory and cannot be removed using file_unmanaged_delete()."
msgstr ""
"%path è una directory e non può essere eliminata con "
"file_unactivate_delete()."

msgid "The file %path is not of a recognized type so it was not deleted."
msgstr "Il file %path è di tipo sconosciuto, quindi non è stato rimosso."

msgid "The file permissions could not be set on %uri."
msgstr "Impossibile impostare le autorizzazioni del file su %uri."

msgid "Completed @current of @total."
msgstr "Completato @current da @total."

msgid ""
"Failed to run all tasks against the database server. The task %task wasn't "
"found."
msgstr ""
"Tutte le attività sul server del database non sono riuscite. Attività %task "
"non trovata."

msgid "Failed to modify %settings. Verify the file permissions."
msgstr "Impossibile modificare %simpostazioni. Verifica i permessi dei file."

msgid "Failed to open %settings. Verify the file permissions."
msgstr ""
"Impossibile aprire %simpostazioni. Verificare i diritti di accesso ai file."

