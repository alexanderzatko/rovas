"Name of the request/session parameter used to determine the desired "
"language."
msgstr ""
"Il nome del parametro di richiesta/sessione utilizzato per determinare la "
"lingua richiesta."

msgid "Filter translatable strings"
msgstr "Filtra le stringhe di traduzione"

msgid "Date type"
msgstr "Tipo di data"

