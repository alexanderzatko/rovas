msgid ""
"The specified file %file could not be copied, because the destination "
"directory is not properly configured. This may be caused by a problem with "
"file or directory permissions. More information is available in the system "
"log."
msgstr ""
"Uvedený soubor %file nemůže být zkopírován, protože cílový adresář není "
"správně nastaven. To může být problémem s přístupovými právy souboru nebo "
"adresáře. Více informací je dostupných v systémovém logu."

msgid ""
"The file %file could not be copied because a file by that name already "
"exists in the destination directory."
msgstr ""
"Soubor %file nemůže být překopírován, protože soubor se stejným názvem již v"
" cílovém adresáři existuje."

msgid ""
"The specified file %file could not be moved, because the destination is "
"invalid. More information is available in the system log."
msgstr ""
"Uvedený soubor %file nemohl být přesunut, protože cíl je neplatný. Více "
"informací je k dispozici v systémovém logu."

msgid ""
"The specified file %file could not be deleted, because it is not a valid "
"URI. More information is available in the system log."
msgstr ""
"Uvedený soubor %file nemohl být odstraněn, protože není platným URI. Více "
"informací je k dispozici v systémovém logu."

msgid ""
"The data could not be saved, because the destination is invalid. More "
"information is available in the system log."
msgstr ""
"Údaje nemohly být uloženy, protože cíl je neplatný. Více informací je k "
"dispozici v systémovém logu."

msgid ""
"File %file (%realpath) could not be copied, because the destination "
"%destination is invalid. This is often caused by improper use of file_copy()"
" or a missing stream wrapper."
msgstr ""
"Soubor %file (%realpath) nemohl být zkopírován, protože cílový adresář "
"%destination není platný. To je často způsobeno nesprávným použitím "
"file_copy() nebo chybějícím proudovým zařízením."

msgid "File %file (%realpath) could not be copied because it does not exist."
msgstr "Soubor %file (%realpath) nelze zkopírovat, protože neexistuje."

msgid ""
"File %file could not be copied because a file by that name already exists in"
" the destination directory (%directory)"
msgstr ""
"Soubor %file nelze zkopírovat, protože soubor s tímto jménem již existuje v "
"cílovém adresáři (%directory)"

msgid "File %file could not be copied because it would overwrite itself."
msgstr "Soubor %file nelze zkopírovat, protože by přepsal sám sebe."

msgid "The specified file %file could not be copied to %destination."
msgstr "Zadaný soubor %file nelze zkopírovat do %destination."

msgid ""
"File %file (%realpath) could not be moved, because the destination "
"%destination is invalid. This may be caused by improper use of file_move() "
"or a missing stream wrapper."
msgstr ""
"Soubor %file (%realpath) nemohl být přesunut, protože cílový adresář "
"%destination je neplatný. To může být způsobeno nesprávným použitím "
"file_move() nebo chybějícím proudovým zařízením."

msgid ""
"File %file (%realpath) could not be deleted because it is not a valid URI. "
"This may be caused by improper use of file_delete() or a missing stream "
"wrapper."
msgstr ""
"Soubor %file (%realpath) nemohl být odstraněn, protože to není správné URI. "
"To může být způsobeno nesprávným použitím file_delete() nebo chybějícím "
"proudovým zařízením."

msgid ""
"The data could not be saved because the destination %destination is invalid."
" This may be caused by improper use of file_save_data() or a missing stream "
"wrapper."
msgstr ""
"Data nemohou být uložena nebo cílový adresář %destination je neplatný. Toto "
"může být způsobeno nesprávným použitím file_save_data() nebo chybějícím "
"proudovým zařízením."

msgid ""
"Your PHP configuration only supports a single database type, so it has been "
"automatically selected."
msgstr ""
"Vaše konfigurace PHP podporuje pouze jeden typ databáze, proto byl "
"automaticky zvolen."

