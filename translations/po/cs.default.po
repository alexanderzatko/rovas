msgstr ""
"Automatická aktualizace jádra Drupalu není podporována. Více informací o "
"manuální aktualizaci jádra Drupalu naleznete v <a href=\"@upgrade-"
"guide\">průvodci aktualizací</a>."

msgid ""
"%archive_file contains a version of %names that is not compatible with "
"Drupal !version."
msgid_plural ""
"%archive_file contains versions of modules or themes that are not compatible"
" with Drupal !version: %names"
