"The %label action has been appended, which is required to save the property "
"change."
msgstr ""
"Akce %label byla přidána, což bylo potřebné pro uložení změny vlastnosti."

msgid "The %label action was moved to save the property change."
msgstr ""
"Akce %label byla přesunuta, což bylo potřebné pro uložení změny vlastnosti."

msgid "Configuring triggers and actions"
msgstr "Konfigurace spouštěčů a akcí"

msgid "When either saving new content or updating existing content"
msgstr "Když se ukládá nový nebo aktualizuje již existující obsah"

msgid "After saving updated content"
msgstr "Po uložení aktualizovaného obsahu"

msgid "When either saving a new comment or updating an existing comment"
msgstr "Když se ukládá nový nebo aktualizuje již existující komentář"

msgid "After creating a new user account"
msgstr "Po vytvoření nového uživatelského účtu"

msgid "After updating a user account"
msgstr "Po aktualizaci uživatelského účtu"

msgid "Configure when to execute actions."
msgstr "Nastavit kdy se mají provést akce."

msgid "Installing updates"
msgstr "Instalují se aktualizace"

msgid "Preparing to update your site"
msgstr "Připravuje se aktualizace vaší stránky"

msgid "Installing %project"
msgstr "Instaluje se %project"

msgid "Preparing to install"
msgstr "Připravuje se instalace"

msgid "Error installing / updating"
msgstr "Chybí při instalaci / aktualizaci"

msgid "Installed %project_name successfully"
msgstr "%project_name byl úspěšně nainstalován"

msgid ""
"Update was completed successfully. Your site has been taken out of "
"maintenance mode."
msgstr ""
"Aktualizace byla úspěšně ukončena. Režim údržby na vašem webu byl vypnut."

msgid "Update was completed successfully."
msgstr "Aktualizace byla úspěšně dokončena."

msgid "Update failed! See the log below for more information."
msgstr "Aktualizace selhala! Více informací naleznete ve zprávě níže."

msgid ""
"Update failed! See the log below for more information. Your site is still in"
" maintenance mode."
msgstr ""
"Aktualizace selhala! Více informací naleznete ve zprávě níže. Váš web "
"zůstává v režimu údržby."

msgid ""
"Installation was completed successfully. Your site has been taken out of "
"maintenance mode."
msgstr "Instalace proběhla úspěšně. Režim údržby byl vypnut."

msgid "Installation was completed successfully."
msgstr "Instalace proběhla úspěšně."

msgid "Installation failed! See the log below for more information."
msgstr "Instalace selhala! Více informací naleznete ve zprávě níže."

msgid ""
"Installation failed! See the log below for more information. Your site is "
"still in maintenance mode."
msgstr ""
"Instalace selhala! Více informací naleznete ve zprávě níže. Vaše stránka je "
"stále v režimu údržby."

msgid "Failed to get available update data."
msgstr "Převzetí dostupných aktualizačních údajů se nezdařilo."

msgid "No available update data"
msgstr "Žádné dostupné údaje aktualizace"

msgid "Checking available update data"
msgstr "Kontrolují se dostupné údaje aktualizace"

