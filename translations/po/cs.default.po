msgstr "Pokus o kontrolu dostupných údajů aktualizace ..."

msgid "Error checking available update data."
msgstr "Chyba při kontrole dostupných dat aktualizace."

msgid "Checking available update data ..."
msgstr "Kontrolují se dostupné údaje aktualizace ..."

msgid "Checked available update data for %title."
msgstr "Vyhledávání dostupných aktualizačních údajů pro %title skončilo."

msgid "Failed to check available update data for %title."
msgstr "Zjišťování dostupných aktualizačních údajů pro %title selhalo."

msgid "An error occurred trying to get available update data."
msgstr "Při pokusu o stažení dostupných aktualizačních údajů došlo k chybě."

msgid "Checked available update data for one project."
msgid_plural "Checked available update data for @count projects."
msgstr[0] ""
"Zjišťování dostupných aktualizačních údajů pro jeden projekt skončilo."
msgstr[1] ""
"Zjišťování dostupných aktualizačních údajů pro @count projekty skončilo."
msgstr[2] ""
"Zjišťování dostupných aktualizačních údajů pro @count projektů skončilo."

msgid "Failed to get available update data for one project."
msgid_plural "Failed to get available update data for @count projects."
msgstr[0] ""
"Zjišťování dostupných aktualizačních údajů pro jeden projekt selhalo."
msgstr[1] ""
"Zjišťování dostupných aktualizačních údajů pro @count projekty selhalo."
msgstr[2] ""
"Zjišťování dostupných aktualizačních údajů pro @count projektů selhalo."

msgid "There was a problem getting update information. Try again later."
msgstr ""
"Při stahování aktualizačních informací nastal problém. Zkuste znovu později."

msgid "(Theme)"
msgstr "(Téma vzhledu)"

msgid "(Release notes)"
msgstr "(Poznámky k verzi)"

msgid ""
"This update is a major version update which means that it may not be "
"backwards compatible with your currently running version.  It is recommended"
" that you read the release notes and proceed at your own risk."
msgstr ""
"Toto je aktualizace na nové hlavní číslo verze. To znamená, že nemusí být "
"zpětně kompatibilní s verzí, kterou v současné době používáte. Doporučujeme "
"vám nejprve si přečíst Poznámky o vydání a pokračovat jen na vlastní riziko."

msgid "(Security update)"
msgstr "(Bezpečnostní aktualizace)"

msgid "(Unsupported)"
msgstr "(Nepodporováno)"

msgid "All of your projects are up to date."
msgstr "Všechny vaše projekty jsou aktualizovány."

msgid "Download these updates"
msgstr "Stáhnout aktualizace"

msgid "Manual updates required"
msgstr "Vyžaduje se ruční aktualizace"

msgid "Updates of Drupal core are not supported at this time."
msgstr "Aktualizace jádra Drupalu není v současnosti podporována."

msgid "You must select at least one project to update."
msgstr "Zvolte alespoň jeden projekt, který chcete aktualizovat."

msgid "Downloading updates"
msgstr "Stahování aktualizací"

msgid "Preparing to download selected updates"
msgstr "Přípravuje se stahování zvolených aktualizací"

msgid "Downloading updates failed:"
msgstr "Stahování aktualizací se nezdařilo:"

msgid "Updates downloaded successfully."
msgstr "Aktualizace úspěšně převzaty."

msgid "Fatal error trying to download."
msgstr "Při pokusu o stahování došlo k neopravitelné chybě."

msgid ""
"Back up your database and site before you continue. <a "
"href=\"@backup_url\">Learn how</a>."
msgstr ""
"Před tím, než budete pokračovat, zálohujte stránku a databázi. <a "
"href=\"@backup_url\">Zjistěte jak</a>."

msgid "Perform updates with site in maintenance mode (strongly recommended)"
msgstr "Aktualizace provádět s webem v režimu údržby (silně doporučeno)"

msgid "Install from a URL"
msgstr "Instalovat z URL adresy"

msgid "For example: %url"
msgstr "Například: %url"

msgid "Upload a module or theme archive to install"
msgstr "Nahrajte archiv modulu nebo témata k instalaci"

msgid "For example: %filename from your local computer"
msgstr "Například: %filename z vašeho lokálního počítače"

msgid "You must either provide a URL or upload an archive file to install."
msgstr "Musíte zadat URL adresu nebo nahrát soubor s archivem k instalaci."

msgid "The provided URL is invalid."
msgstr "Zadaná URL adresa je neplatná."

msgid "Unable to retrieve Drupal project from %url."
msgstr "Nebylo možné převzít projekt z %url."

msgid "Provided archive contains no files."
msgstr "Zadaný archiv neobsahuje soubory."

msgid "Unable to determine %project name."
msgstr "Nepodařilo se zjistit jméno pro %project."

msgid "%project is already installed."
msgstr "%project je již nainstalován."

msgid "Cannot extract %file, not a valid archive."
msgstr "Nepodařilo se rozbalit %file, není platný archiv."

msgid "Downloading %project"
msgstr "Stahování %project"

msgid "Failed to download %project from %url"
msgstr "Stahování projektu %project z %url"

msgid "Includes:"
msgstr "Zahrnuje:"

msgid "Enabled: %includes"
msgstr "Povoleno: %includes"

msgid "Disabled: %disabled"
msgstr "Zakázáno: %disabled"

msgid "%base_theme (!base_label)"
msgstr "%base_theme (!base_label)"

msgid "Depends on: !basethemes"
msgstr "Závisí na: !basethemes"

msgid "Required by: %subthemes"
msgstr "Vyžadováno od: %subthemes"

msgid ""
"The Update manager also allows administrators to update and install modules "
"and themes through the administration interface."
msgstr ""
"Manažer aktualizací umožňuje také administrátorům aktualizovat a instalovat "
"moduly a témata přes administrátorské rozhraní."

msgid "Checking for available updates"
msgstr "Kontrola dostupných aktualizací"

msgid "Performing updates through the user interface"
msgstr "Provedení aktualizace přes uživatelské rozhraní"

msgid "Installing new modules and themes through the user interface"
msgstr ""
"Instalace nových modulů a témat vzhledu použitím uživatelského rozhraní"

msgid ""
"No update information available. <a href=\"@run_cron\">Run cron</a> or <a "
"href=\"@check_manually\">check manually</a>."
msgstr ""
"Žádné informace o aktualizacích. <a href=\"@run_cron\">Spusťte cron</a> nebo"
" <a href=\"@check_manually\">zkontrolujte ručně</a>."

msgid ""
"You can automatically install your missing updates using the Update manager:"
msgstr ""
"Chybějící aktualizace můžete automaticky instalovat pomocí Manažera "
"aktualizací:"

msgid ""
"Your site is currently configured to send these emails when any updates are "
"available. To get notified only for security updates, !url."
msgstr ""
"Váš web je momentálně nastaven na posílání e-mailů v případě, že jsou "
"dostupné libovolné aktualizace. Chcete-li upozorňování pouze na bezpečnostní"
" aktualizace, !url."

msgid ""
"Your site is currently configured to send these emails only when security "
"updates are available. To get notified for any available updates, !url."
msgstr ""
"Váš web je momentálně nastaven na posílání e-mailů pouze v případě, že jsou "
"dostupné bezpečnostní aktualizace. Chcete-li upozorňování na všechny "
"aktualizace, !url."

msgid ""
"The installed version of at least one of your modules or themes is no longer"
" supported. Upgrading or disabling is strongly recommended. See the project "
"homepage for more details."
msgstr ""
"Některé z vašich modulů či témat již nejsou podporovány. Silně vám "
"doporučujeme jejich inovaci nebo vypnutí. Pro podrobnosti navštivte "
"domovskou stránku dotyčných projektů."

msgid ""
"There was a problem checking <a href=\"@update-report\">available "
"updates</a> for Drupal."
msgstr ""
"Nastal problém při kontrole <a href=\"@update-report\">dostupných "
"aktualizací</a> Drupalu."

msgid ""
"There was a problem checking <a href=\"@update-report\">available "
"updates</a> for your modules or themes."
msgstr ""
"Nastal problém při kontrole <a href=\"@update-report\">dostupných "
"aktualizací</a> vašich modulů a témat vzhledu."

msgid ""
"See the <a href=\"@available_updates\">available updates</a> page for more "
"information and to install your missing updates."
msgstr ""
"Pro více informací přejděte na stránku <a "
"href=\"@available_updates\">dostupných aktualizací</a> a nainstalujte "
"chybějící aktualizace."

msgid "Ready to update"
msgstr "Připraven aktualizovat"

msgid "Update manager"
msgstr "Manažer aktualizací"

msgid ""
"Checks for available updates, and can securely install or update modules and"
" themes via a web interface."
msgstr ""
"Vyhledá dostupné aktualizace a umožňuje přes webové rozhraní bezpečně "
"nainstalovat či aktualizovat moduly a témata vzhledu."

msgid "No people available."
msgstr "Nejsou dostupní žádní uživatelé."

msgid ""
"This role will be automatically assigned new permissions whenever a module "
"is enabled. Changing this setting will not affect existing permissions."
msgstr ""
"Této kategorii uživatelů budou automaticky přidělena oprávnění při povolení "
"modulu. Změna tohoto nastavení neovlivní stávající oprávnění."

msgid "Registration and cancellation"
msgstr "Registrace a zrušení"

msgid "Who can register accounts?"
msgstr "Kdo může zaregistrovat účty?"

msgid "Administrators only"
msgstr "Jen administrátoři"

msgid "Visitors, but administrator approval is required"
msgstr "Návštěvníci, vyžadované schválení administrátorem"

msgid "Require e-mail verification when a visitor creates an account."
msgstr "Požadovat ověření e-mailem když návštěvník vytvoří účet."

msgid ""
"New users will be required to validate their e-mail address prior to logging"
" into the site, and will be assigned a system-generated password. With this "
"setting disabled, users will be logged in immediately upon registering, and "
"may select their own passwords during registration."
msgstr ""
"Od nových uživatelů bude vyžadováno ověřit jejich e-mailovou adresu před "
"přihlášením se na stránku a bude jim přiřazeno systémově-generované heslo. "
"Pokud je tato možnost vypnuta, uživatelé budou přihlášeni okamžitě po "
"registraci a mohou zvolit vlastní hesla během registrace."

msgid "When cancelling a user account"
msgstr "Při zrušení uživatelského účtu"

msgid ""
"Users with the %select-cancel-method or %administer-users <a "
"href=\"@permissions-url\">permissions</a> can override this default method."
msgstr ""
"Uživatelé s <a href=\"@permissions-url\">oprávněními</a> %select-cancel-"
"method nebo %administer-users mohou změnit tuto výchozí metodu."

msgid "Select method for cancelling account"
msgstr "Zvolte metodu zrušení účtu"

msgid "Administer users"
msgstr "Spravovat uživatele"

msgid "Personalization"
msgstr "Personalizace"

msgid "Enable signatures."
msgstr "Povolit podpisy."

msgid "The directory %directory does not exist or is not writable."
msgstr "Adresář %directory neexistuje nebo není zapisovatelný."

msgid "Enable user pictures."
msgstr "Povolit uživatelské obrázky."

msgid "Picture directory"
msgstr "Adresář s obrázky"

msgid "Picture display style"
msgstr "Styl zobrazení obrázků"

msgid ""
"The style selected will be used on display, while the original image is "
"retained. Styles may be configured in the <a href=\"!url\">Image styles</a> "
"administration area."
msgstr ""
"Vybraný styl bude použit k zobrazení, dokud původní obrázek bude zachován. "
"Styly mohou být nastaveny v <a href=\"!url\">Stylech obrázků</a> správcovské"
" oblasti."

msgid "Picture upload dimensions"
msgstr "Rozměry nahrávaného obrázku"

msgid "Picture upload file size"
msgstr "Velikost souboru nahrávaného obrázku"

msgid "E-mails"
msgstr "E-maily"

msgid "Welcome (new user created by administrator)"
msgstr "Vítejte (nový uživatel vytvořený administrátorem)"

msgid ""
"Edit the welcome e-mail messages sent to new member accounts created by an "
"administrator."
msgstr ""
"Změnit přivítací zprávu, která se posílá novým členům vytvořených "
"administrátorem."

msgid "Welcome (awaiting approval)"
msgstr "Vítejte (čeká na povolení)"

msgid ""
"Edit the welcome e-mail messages sent to new members upon registering, when "
"administrative approval is required."
msgstr ""
"Změnit přivítací zprávu, která se zasílá novým členům po registraci, když je"
" požadováno schválení."

msgid "Welcome (no approval required)"
msgstr "Vítejte (nepožaduje se potvrzení)"

msgid ""
"Edit the welcome e-mail messages sent to new members upon registering, when "
"no administrator approval is required."
msgstr ""
"Změnit přivítací zprávu, která se zasílá novým členům po registraci, když se"
" schválení nevyžaduje."

msgid "Password recovery"
msgstr "Obnova hesla"

msgid "Edit the e-mail messages sent to users who request a new password."
msgstr ""
"Upravit e-mailové zprávy odeslané uživatelům, kteří požádají o nové heslo."

msgid "Account activation"
msgstr "Aktivace účtu"

msgid ""
"Enable and edit e-mail messages sent to users upon account activation (when "
"an administrator activates an account of a user who has already registered, "
"on a site where administrative approval is required)."
msgstr ""
"Povolit a změnit spávu, která se posílá uživatelům po aktivaci účtu (v "
"případě, že administrátor aktivuje účet uživatele, který se předtím "
"zaregistroval na web s vyžadovaným schvalováním)."

msgid ""
"Enable and edit e-mail messages sent to users when their accounts are "
"blocked."
msgstr ""
"Povolit a změnit zprávu, která se posílá uživatelům po zablokování účtu."

msgid "Account cancellation confirmation"
msgstr "Potvrzení zrušení účtu"

msgid ""
"Edit the e-mail messages sent to users when they attempt to cancel their "
"accounts."
msgstr ""
"Povolit a změnit zprávu, která se posílá uživatelům při pokusu o zrušení "
"účtu."

msgid "Account canceled"
msgstr "Účet zrušen"

msgid ""
"Enable and edit e-mail messages sent to users when their accounts are "
"canceled."
msgstr "Povolit a změnit zprávu, která se posílá uživatelům po zrušení účtu."

msgid "Notify user when account is canceled."
msgstr "Upozornit uživatele na zrušení účtu"

msgid "The role name %name already exists. Choose another role name."
msgstr ""
"Kategorie uživatelů %name již existuje. Zvolte jiný název kategorie "
"uživatelů."

msgid ""
"Another user (%other_user) is already logged into the site on this computer,"
" but you tried to use a one-time link for user %resetting_user. Please <a "
"href=\"!logout\">logout</a> and try using the link again."
msgstr ""
"Z tohoto počítače je již k tomuto webu přihlášen jiný uživatel "
"(%other_user). Pokusili jste se použít jednorázový odkaz pro uživatele "
"%resetting_user. Prosím <a href=\"!logout\">odhlaste se</a> a zkuste znovu."

msgid "The one-time login link you clicked is invalid."
msgstr "Váš jednorázový odkaz na přihlášení je neplatný."

msgid ""
"You have just used your one-time login link. It is no longer necessary to "
"use this link to log in. Please change your password."
msgstr ""
"Právě jste využili jednorázový odkaz k přihlášení. Dále již není třeba "
"používat tento odkaz k přihlašování. Prosím, nastavte si nové heslo."

msgid ""
"<p>This is a one-time login for %user_name and will expire on "
"%expiration_date.</p><p>Click on this button to log in to the site and "
"change your password.</p>"
msgstr ""
"<p>Toto je jednorázový odkaz na přihlášení pro uživatele %user_name. Jeho "
"platnost skončí %expiration_date.</p><p>Pro přihlášení klikněte na toto "
"tlačítko a následně změňte heslo.</p>"

msgid ""
"You have tried to use a one-time login link that has either been used or is "
"no longer valid. Please request a new one using the form below."
msgstr ""
"Pokusili jste se využít neplatný nebo již jednou použitý odkaz na "
"přihlášení. Pomocí níže uvedeného formuláře požádejte prosím o nový."

msgid "When cancelling your account"
msgstr "Při zrušení vašeho účtu"

msgid "When cancelling the account"
msgstr "Při zrušení účtu"

msgid "Require e-mail confirmation to cancel account."
msgstr "Před odstraněním účtu vyžádat potvrzení emailem."

msgid ""
"When enabled, the user must confirm the account cancellation via e-mail."
msgstr ""
"Pokud je povoleno, uživatel musí odsouhlasit odstranění účtu prostřednictvím"
" emailu."

msgid ""
"When enabled, the user will receive an e-mail notification after the account"
" has been cancelled."
msgstr "Pokud je povoleno, uživatel bude upozorněn po zrušení účtu e-mailem."

msgid "Are you sure you want to cancel your account?"
msgstr "Opravdu chcete zrušit váš účet?"

msgid "Are you sure you want to cancel the account %name?"
msgstr "Opravdu chcete zrušit účet %name?"

msgid "Select the method to cancel the account above."
msgstr "Zvolte metodu pro zrušení výše uvedeného účtu."

msgid ""
"A confirmation request to cancel your account has been sent to your e-mail "
"address."
msgstr ""
"Na vaši e-mailovou adresu byl odeslán požadavek o potvrzení zrušení účtu."

msgid ""
"Your account will be blocked and you will no longer be able to log in. All "
"of your content will remain attributed to your user name."
msgstr ""
"Váš účet bude zablokován a již více nebude možné se k němu přihlásit. "
"Veškerý vámi vytvořený obsah zůstane připsán vašemu uživatelskému jménu."

msgid ""
"Your account will be blocked and you will no longer be able to log in. All "
"of your content will be hidden from everyone but administrators."
msgstr ""
"Váš účet bude zablokován a již více nebude možné se k němu přihlásit. "
"Veškerý vámi vytvořený obsah bude skryt před všemi kromě administrátorů."

msgid ""
"Your account will be removed and all account information deleted. All of "
"your content will be assigned to the %anonymous-name user."
msgstr ""
"Váš účet bude odstraněn a veškeré informace z něj budou smazány. Veškerý "
"vámi vytvořený obsah bude připsán uživateli %anonymous."

msgid ""
"Your account will be removed and all account information deleted. All of "
"your content will also be deleted."
msgstr ""
"Váš účet bude odstraněn a veškeré informace z něj budou smazány. Veškerý "
"vámi vytvořený obsah bude smazán také."

msgid ""
"You have tried to use an account cancellation link that has expired. Please "
"request a new one using the form below."
msgstr ""
"Pokusili jste se využít neplatný nebo již jednou použitý odkaz na zrušení "
"účtu. Pomocí níže uvedeného formuláře požádejte prosím o nový."

msgid "Sent account cancellation request to %name %email."
msgstr "Požadavek o zrušení účtu %name byl zaslán na %email."

msgid "Tokens related to individual user accounts."
msgstr "Tokeny související s individuálními uživatelskými účty."

msgid "Tokens related to the currently logged in user."
msgstr "Tokeny momentálně přihlášeného uživatele."

msgid ""
"The User module allows users to register, log in, and log out. It also "
"allows users with proper permissions to manage user roles (used to classify "
"users) and permissions associated with those roles. For more information, "
"see the online handbook entry for <a href=\"@user\">User module</a>."
msgstr ""
"Modul User umožňuje uživatelům registraci, přihlášení a odhlášení. "
"Oprávněným uživatelům dává možnost spravovat kategorie uživatelů a "
"oprávnění, která jsou s těmito kategoriemi spojena. Více informací naleznete"
" v online příručce v sekci pro <a href=\"@user\">modul User</a>."

msgid "Creating and managing users"
msgstr "Vytváření a správa uživatelů"

msgid ""
"The User module allows users with the appropriate <a "
"href=\"@permissions\">permissions</a> to create user accounts through the <a"
" href=\"@people\">People administration page</a>, where they can also assign"
" users to one or more roles, and block or delete user accounts. If allowed, "
"users without accounts (anonymous users) can create their own accounts on "
"the <a href=\"@register\">Create new account</a> page."
msgstr ""
"Modul User umožňuje uživatelům s příslušnými <a "
"href=\"@permissions\">oprávněními</a> vytvářet uživatelské účty přes stránku"
" <a href=\"@people\">Lidé</a>, kde také lze zařazovat uživatele do "
"kategorií, blokovat či zrušit účet. Pokud je to povoleno, uživatelé bez účtů"
" (anonymní uživatelé) si mohou vytvořit vlastní účty na stránce <a "
"href=\"@register\">Vytvořit nový účet</a>."

msgid "User roles and permissions"
msgstr "Kategorie uživatelů a oprávnění"

msgid "By default, Drupal comes with two user roles:"
msgstr "Ve výchozím nastavení má Drupal dvě kategorie uživatelů:"

msgid ""
"Anonymous user: this role is used for users that don't have a user account "
"or that are not authenticated."
msgstr ""
"Anonymní uživatel: tato kategorie se přiděluje nepřihlášeným návštěvníkům "
"nebo návštěvníkům, kteří nemají uživatelský účet."

msgid ""
"Authenticated user: this role is automatically granted to all logged in "
"users."
msgstr ""
"Přihlášený uživatel: tato kategorie se přiděluje automaticky všem "
"přihlášeným návštěvníkům."

msgid ""
"This form lets administrators add, edit, and arrange fields for storing user"
" data."
msgstr ""
"Tento formulář dovoluje administrátorovi vložení, změnu a umístění polí pro "
"ukládání uživatelských údajů."

msgid ""
"This form lets administrators configure how fields should be displayed when "
"rendering a user profile page."
msgstr ""
"Tento formulář umožní administrátorům nastavit, jak budou pole zobrazena při"
" vykreslení stránky s profilem uživatele."

msgid "User module timezone form element."
msgstr "Formulářový prvek časových pásem modulu User"

msgid "User module history view element."
msgstr "Formulářový prvek prohlížení historie modulu User"

msgid "Administer permissions"
msgstr "Spravovat oprávnění"

msgid "View user profiles"
msgstr "Zobrazit uživatelské profily"

msgid "Change own username"
msgstr "Změnit vlastní uživatelské jméno"

msgid "Cancel own user account"
msgstr "Zrušit vlastní uživatelský účet"

msgid ""
"Note: content may be kept, unpublished, deleted or transferred to the "
"%anonymous-name user depending on the configured <a href=\"@user-settings-"
"url\">user settings</a>."
msgstr ""
"Upozornění: obsah může být ponechán, nezveřejněn, odstraněn nebo přemístěn "
"uživateli %anonymous-name v závislosti na aktuálním <a href=\"@user-"
"settings-url\">nastavení uživatele</a>."

msgid "Select method for cancelling own account"
msgstr "Zvolte způsob zrušení vlastního účtu"

msgid ""
"Spaces are allowed; punctuation is not allowed except for periods, hyphens, "
"apostrophes, and underscores."
msgstr ""
"Mezery jsou dovoleny; interpunkce s výjimkou tečky, spojovníku, apostrofu a "
"podtržítka není dovolena."

msgid "The signature is too long: it must be %max characters or less."
msgstr "Podpis je příliš dlouhý: musí mít maximálně %max znaků nebo méně."

msgid ""
"Sorry, too many failed login attempts from your IP address. This IP address "
"is temporarily blocked. Try again later or <a href=\"@url\">request a new "
"password</a>."
msgstr ""
"Promiňte, příliš mnoho neplatných pokusů o přihlášení z vaší IP adresy. "
"Adresa je dočasně zablokována. Zkuste později nebo <a "
"href=\"@url\">požádejte o nové heslo</a>."

msgid "Cancelling account"
msgstr "Probíhá zrušení účtu"

msgid "Cancelling user account"
msgstr "Probíhá zrušení uživatelského účtu"

msgid "%name has been disabled."
msgstr "%name byl zakázán."

msgid "Account details for [user:name] at [site:name]"
msgstr "Podrobnosti o účtu uživatele [user:name] na [site:name]"

msgid "An administrator created an account for you at [site:name]"
msgstr "Správce vám vytvořil účet na [site:name]"

msgid ""
"Account details for [user:name] at [site:name] (pending admin approval)"
msgstr ""
"Podrobnosti o účtu uživatele [user:name] na [site:name] (čeká se na "
"schválení správcem)"

msgid ""
"[user:name],\n"
"\n"
"Thank you for registering at [site:name]. Your application for an account is currently pending approval. Once it has been approved, you will receive another e-mail containing information about how to log in, set your password, and other details.\n"
"\n"
"\n"
"--  [site:name] team"
msgstr ""
"[user:name],\r\n"
"\r\n"
"děkujeme vám za registraci na [site:name]. Vaše žádost o přidělení účtu momentálně čeká na schválení. Hned po schválení obdržíte e-mail s informací o přihlašování, změně hesla a dalšími podrobnostmi.\r\n"
"\r\n"
"\r\n"
"-- Tým [site:name]"

msgid ""
"[user:name] has applied for an account.\n"
"\n"
"[user:edit-url]"
msgstr ""
"Uživatel [user:name] požádal o účet.\r\n"
"\r\n"
"[user:edit-url]"

msgid "Replacement login information for [user:name] at [site:name]"
msgstr "Nahradní přihlašovací údaje pro [user:name] na [site:name]"

msgid "Account details for [user:name] at [site:name] (approved)"
msgstr "Podrobnosti účtu pro [user:name] na [site:name] (schváleno)"

msgid "Account details for [user:name] at [site:name] (blocked)"
msgstr "Podrobnosti účtu pro [user:name] na [site:name] (blokováno)"

msgid "Account cancellation request for [user:name] at [site:name]"
msgstr "Žádost o zrušení účtu pro [user:name] na [site:name]"

msgid "Account details for [user:name] at [site:name] (canceled)"
msgstr "Podrobnosti účtu pro [user:name] na [site:name] (zrušeno)"

msgid "Cancel the selected user accounts"
msgstr "Zrušit vybrané uživatele"

msgid "The user account %name cannot be cancelled."
msgstr "Uživatelský účet %name nemůže být zrušen."

msgid "When cancelling these accounts"
msgstr "Při zrušení těchto účtů"

msgid "Are you sure you want to cancel these user accounts?"
msgstr "Opravdu chcete zrušit tyto uživatelské účty?"

msgid "Cancel accounts"
msgstr "Zrušit účty"

msgid "To make your password stronger:"
msgstr "Pro posílení kvality hesla:"

msgid "Make it at least 6 characters"
msgstr "Zadejte minimálně 6 znaků"

msgid "Add lowercase letters"
msgstr "Přidejte malá písmena"

msgid "Add uppercase letters"
msgstr "Přidejte velká písmena"

msgid "Add numbers"
msgstr "Přidejte čísla"

msgid "Add punctuation"
msgstr "Přidejte diakritiku"

msgid "Make it different from your username"
msgstr "Musí být jiné než vaše uživatelské jméno"

msgid "Weak"
msgstr "Slabé"

msgid "Fair"
msgstr "Uspokojivé"

msgid "Blocked user: %name %email."
msgstr "Blokovaný uživatel: %name %email."

msgid "There is currently 1 user online."
msgid_plural "There are currently @count users online."
msgstr[0] "Aktuálně je online 1 uživatel."
msgstr[1] "Aktuálně jsou online @count uživatelé."
msgstr[2] "Aktuálně jsou online @count uživatelé."

msgid ""
"Sorry, there has been more than one failed login attempt for this account. "
"It is temporarily blocked. Try again later or <a href=\"@url\">request a new"
" password</a>."
msgid_plural ""
"Sorry, there have been more than @count failed login attempts for this "
"account. It is temporarily blocked. Try again later or <a "
"href=\"@url\">request a new password</a>."
msgstr[0] ""
"Omlouváme se, ale zaznamenali jsme více než jeden neúspěšný pokus o "
"přihlášení k tomuto účtu. Účet je dočasně zablokován. Zkuste to později nebo"
" <a href=\"@url\">požádejte o nové heslo</a>."
msgstr[1] ""
"Omlouváme se, ale zaznamenali jsme více než @count neúspěšné pokusy o "
"přihlášení k tomuto účtu. Účet je dočasně zablokován. Zkuste to později nebo"
" <a href=\"@url\">požádejte o nové heslo</a>."
msgstr[2] ""
"Omlouváme se, ale zaznamenali jsme více než @count neúspěšných pokusů o "
"přihlášení k tomuto účtu. Účet je dočasně zablokován. Zkuste to později nebo"
" <a href=\"@url\">požádejte o nové heslo</a>."

msgid "Find and manage people interacting with your site."
msgstr "Najít a spravovat lidi, kteří jsou aktivní na vašich stránkách."

msgid "Confirm account cancellation"
msgstr "Potvrdit zrušení účtu"

msgid "User passwords rehashed to improve security"
msgstr "Pro vylepšení bezpečnosti byla všechna hesla přehešována"

msgid "Migrated user time zones"
msgstr "Premigrovaná uživatelská časová pásma"

msgid "Minimal"
msgstr "Min."

msgid "Start with only a few modules enabled."
msgstr "Začít jen s několika povolenými moduly."

msgid "Basic page"
msgstr "Základní stránka"

msgid ""
"Use <em>basic pages</em> for your static content, such as an 'About us' "
"page."
msgstr ""
"Použijte <em>základní stránky</em> pro statický obsah. stránka 'O nás'."

msgid "Use tags to group articles on similar topics into categories."
msgstr ""
"Použijte značky pro seskupení článků do kategorií podle podobných témat."

msgid "Enter a comma-separated list of words to describe your content."
msgstr "Zadejte seznam slov oddělených čárkou pro popis vašeho obsahu."

msgid "Install with commonly used features pre-configured."
msgstr "Nainstalovat a automaticky nastavit obvykle používané funkce."

msgid "Content width"
msgstr "Šířka obsahu"

msgid "Fluid width"
msgstr "Proměnlivá šířka"

msgid "Fixed width"
msgstr "Pevná šířka"

msgid ""
"Specify whether the content will wrap to a fixed width or will fluidly "
"expand to the width of the browser window."
msgstr ""
"Zvolte, zda se obsah bude zalamovat do pevné šířky nebo bude průběžně "
"zabírat celou šířku okna prohlížeče."

msgid ""
"A multi-column theme which can be configured to modify colors and switch "
"between fixed and fluid width layouts."
msgstr ""
"Více sloupcové téma vzhledu, které lze změnit barvy a přepínat mezi pevnou a"
" plovoucí šířkou."

msgid "A simple one-column, tableless, fluid width administration theme."
msgstr ""
"Jednoduchá jedno-sloupcová, beztabulková, téma administrace s plovoucí "
"šířkou."

msgid ""
"This theme demonstrates Drupal's default HTML markup and CSS styles. To "
"learn how to build your own theme and override Drupal's default code, see "
"the <a href=\"http://drupal.org/theme-guide\">Theming Guide</a>."
msgstr ""
"Toto téma demonstruje základní použití HTML značek a CSS stylů v Drupalu. "
"Více informací jak vytvářet vlastní témata, nebo změnit kód v tomto tématu, "
"naleznete v <a href=\"http://drupal.org/theme-guide\">Příručce pro tvorbu "
"témat vzhledu</a>."

msgid "Image style"
msgstr "Styl obrázku"

msgid ""
"1 pending update (@number_applied to be applied, @number_incompatible "
"skipped)"
msgid_plural ""
"@count pending updates (@number_applied to be applied, @number_incompatible "
"skipped)"
msgstr[0] ""
"1 čekající aktualizace (budou použity: @number_applied, přeskočeno: "
"@number_incompatible)"
msgstr[1] ""
"@count čekající aktualizace (budou použity: @number_applied, přeskočeno: "
"@number_incompatible)"
msgstr[2] ""
"@count čekajících aktualizací (budou použity: @number_applied, přeskočeno: "
"@number_incompatible)"

msgid ""
"The Blog module allows registered users to maintain an online journal, or "
"<em>blog</em>. Blogs are made up of individual <em>blog entries</em>. By "
"default, the blog entries are displayed by creation time in descending "
"order, with comments enabled, and are promoted to the site's front page. For"
" more information, see the online handbook entry for <a href='@blog'>Blog "
"module</a>."
msgstr ""
"Modul Blog umožňuje registrovaným uživatelům spravovat online časopis nebo "
"<em>blog</em>. Blogy tvoří jednotlivé <em>položky blogu</em>. Ve výchozím "
"nastavení jsou položky blogu zobrazeny podle času vytvoření sestupně se "
"zapnutými komentáři a zobrazeny na titulní straně. Více informací naleznete "
"v online příručce v sekci pro <a href='@blog'>modul Blog</a>."

msgid "Author textfield"
msgstr "Textové pole Autor"

msgid "Subject textfield"
msgstr "Textové pole Předmět"

msgid "A contact form with category %category already exists."
msgstr "Kontaktní formulář s kategorií %category již existuje."

msgid "Hello !recipient-name,"
msgstr "Ahoj !recipient-name,"

msgid ""
"Attempt to create an instance of a field @field_name that doesn't exist or "
"is currently inactive."
msgstr ""
"Pokus o vytvoření instance pole @field_name, které neexistuje, nebo zrovna "
"není aktivní."

msgid ""
"Attempt to create an instance of field @field_name on bundle @bundle that "
"already has an instance of that field."
msgstr ""
"Pokus o vytvoření instance pole @field_name ve svazku @bundle, který již "
"instanci tohoto pole obsahuje."

msgid "Field API to add fields to entities like nodes and users."
msgstr "Field API pro vytváření polí na entitách (např. uzly, uživatelé)."

msgid "Overview of fields on all entity types."
msgstr "Přehled polí na všech typech entity."

msgid "Configuring text formats"
msgstr "Konfigurace formátů textu"

msgid ""
"Text formats define the HTML tags, code, and other formatting that can be "
"used when entering text. <strong>Improper text format configuration is a "
"security risk</strong>. Learn more on the <a href=\"@filterhelp\">Filter "
"module help page</a>."
msgstr ""
"Textové formáty určují HTML kód a jiné formátování, které může být použito "
"při vkládání textu. <strong>Nesprávné nastavení textového formátu může "
"způsobit bezpečnostní riziko</strong>. Více informací na <a "
"href=\"@filterhelp\">stránce nápovědy modulu Filtr</a>."

msgid "Show more content"
msgstr "Ukázat další obsah"

msgid "Collapse"
msgstr "Sbalit"

msgid ""
"The testing framework requires the DOMDocument class to be available. Check "
"the configure command at the <a href=\"@link-phpinfo\">PHP info page</a>."
msgstr ""
"Testovací framework vyžaduje DOMDocument třídu. Zkontrolujte konfigurační "
"příkaz na <a href=\"@link-phpinfo\">PHP info stránce</a>."

msgid "Error messages to display"
msgstr "Zobrazit chybové zprávy"

msgid ""
"It is recommended that sites running on production environments do not "
"display any errors."
msgstr ""
"Doporučuje se nezobrazovat žádné chyby na stránkách běžících v ostrém "
"provozu."

msgid "Cannot open %file_path"
msgstr "Nepodařilo se otevřít %file_path"

msgid "Term name textfield"
msgstr "Textové pole Název termínu"

msgid "Term description textarea"
msgstr "Textový blok Popis termínu"

msgid ""
"Password reset instructions will be mailed to %email. You must log out to "
"use the password reset link in the e-mail."
msgstr ""
"Pokyny k obnovení hesla budou odeslány na %email. Před použitím zaslaného "
"odkazu na obnovu hesla se musíte odhlásit."

msgid ""
"Enter your current password to change the %mail or %pass. !request_new."
msgstr "Zadejte své aktuální heslo pro změnu %mail nebo %pass. !request_new."

msgid "Current password"
msgstr "Aktuální heslo"

msgid ""
"Your current password is missing or incorrect; it's required to change the "
"%name."
msgstr ""
"Vaše současné heslo chybí nebo je nesprávné; je třeba na ho zadat pro změnu "
"pole: %name."

msgid ""
"A welcome message with further instructions has been e-mailed to the new "
"user <a href=\"@url\">%name</a>."
msgstr ""
"Uvítací zpráva s dalšími instrukcemi byla zaslána e-mailem novému uživateli "
"<a href=\"@url\">%name</a>."

msgid ""
"A welcome message with further instructions has been sent to your e-mail "
"address."
msgstr ""
"Uvítací zpráva s dalšími instrukcemi byla zaslána na vaši e-mailovou adresu."

msgid "Configure user accounts."
msgstr "Nastavit uživatelské účty."

msgid ""
"Configure default behavior of users, including registration requirements, "
"e-mails, fields, and user pictures."
msgstr ""
"Nastavit výchozí chování uživatelů, včetně požadavků pro registraci, "
"e-maily, pole a uživatelské obrázky."

msgid "%module module installed."
msgstr "Modul %module byl nainstalován."

msgid "Use this page to create a new custom block."
msgstr "Použijte tuto stránku pro vytvoření nového vlastního bloku."

msgid "Number of recent blog posts to display"
msgstr "Počet zobrazených nejnovějších příspěvků blogu"

msgid "@node_type comment"
msgstr "Komentář pro @node_type"

msgid "Edit comment %comment"
msgstr "Upravit komentář %comment"

msgid "Planning fields"
msgstr "Plánování polí"

msgid "What the field will be called"
msgstr "Jak se pole bude jmenovat"

msgid "What type of data the field will store"
msgstr "Jaký typ dat bude pole ukládat"

msgid "How the data will be input and displayed"
msgstr "Způsob zadávání a zobrazení údajů"

msgid "How many values the field will store"
msgstr "Kolik hodnot bude pole ukládat"

msgid "Reusing fields"
msgstr "Znovupoužití polí"

msgid "Fields on content items"
msgstr "Pole na obsahových položkách"

msgid "Fields on taxonomy terms"
msgstr "Pole na termínech taxonomie"

msgid "Fields on user accounts"
msgstr "Pole na uživatelských účtech"

msgid "Fields on comments"
msgstr "Pole na komentářích"

msgid "Administer text formats and filters"
msgstr "Spravovat textové formáty a filtry"

msgid "@type language detection"
msgstr "@type zjišťování jazyka"

msgid ""
"Strings in the uploaded file replace existing ones, new ones are added. The "
"plural format is updated."
msgstr ""
"Řetězce v nahrávaném souboru nahradí stávající, nové se přidají. Formát "
"množného čísla se aktualizuje."

msgid ""
"Existing strings and the plural format are kept, only new strings are added."
msgstr ""
"Stávající řetězce a formát množného čísla se zachovají, přidány budou jen "
"nové řetězce."

msgid "User interface text"
msgstr "Text uživatelského rozhraní"

msgid "Use the detected interface language."
msgstr "Použít zjištěný jazyk rozhraní."

msgid "Add new %type"
msgstr "Přidat nový %type"

msgid ""
"The new set is created by copying items from your default shortcut set."
msgstr "Nová sada bude vytvořena nakopírováním položek z vaší výchozí sady."

msgid "The new set is created by copying items from the %default set."
msgstr "Novou sadu vytvoříte zkopírováním položek ze sady %default."

msgid "You are currently using the %set-name shortcut set."
msgstr "Právě používáte sadu zkratek %set-name."

msgid "edit set name"
msgstr "upravit název sady"

msgid "delete set"
msgstr "odstranit sadu"

msgid "Create new set"
msgstr "Vytvořit novou sadu"

msgid ""
"The %set_name shortcut set has been created. You can edit it from this page."
msgstr ""
"Sada zkratek %set_name byla vytvořena. Na této stránce ji můžete změnit."

msgid "Updated set name to %set-name."
msgstr "Aktualizovaný název sady: %set-name."

msgid ""
"If you have chosen this shortcut set as the default for some or all users, "
"they may also be affected by deleting it."
msgstr ""
"Pokud jste tuto sadu zkratek zvolili jako výchozí pro některé nebo všechny "
"uživatele, jejím odstraněním mohou být tito uživatelé dotčeni."

msgid "Are you sure you want to delete the shortcut set %title?"
msgstr "Opravdu odstranit sadu zkratek %title?"

msgid "The shortcut set %title has been deleted."
msgstr "Sada zkratek %title byla odstraněna."

msgid "1 user has chosen or been assigned to this shortcut set."
msgid_plural "@count users have chosen or been assigned to this shortcut set."
msgstr[0] "1 uživatel si vybral nebo byl přiřazen k této sadě zkratek."
msgstr[1] ""
"@count uživatelé si vybrali nebo byli přiřazeni k této sadě zkratek."
msgstr[2] ""
"@count uživatelů si vybralo nebo bylo přiřazeno k této sadě zkratek."

msgid "Administering shortcuts"
msgstr "Spravovat zkratky"

msgid "Choosing shortcut sets"
msgstr "Volba sady zkratek"

msgid ""
"Define which shortcut set you are using on the <a href=\"@shortcut-"
"link\">Shortcuts tab</a> of your account page."
msgstr ""
"Na stránce vašeho účtu na <a href=\"@shortcut-link\">kartě Zkratky</a> "
"určete, která sada zkratek se má použít."

msgid "Edit current shortcut set"
msgstr "Upravit aktuální sadu zkratek"

