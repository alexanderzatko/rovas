#: /admin/structure/views/view/work_reports/edit
msgid ""
"<?php\n"
"if (is_numeric(arg(1))) {\n"
"\t$prid = arg(1);\n"
"\t$project = node_load($prid);\n"
"\t$wrapper = entity_metadata_wrapper('node', $project);\n"
"\t$stage = $wrapper->field_status->value();\n"
"\n"
"\tglobal $user;\n"
"\t$obj = entity_metadata_wrapper('user', $user);\n"
"\t$vrfststus = $obj->field_verified->value();\n"
"\n"
"\n"
"\t$result = db_query(\"SELECT *\n"
"\tFROM {field_data_field_coworker} w, {field_data_field_project} p, {node} n\n"
"\tWHERE w.entity_id = p.entity_id\n"
"\tAND p.field_project_target_id = n.nid\n"
"\tAND p.bundle = 'co_worker_merit_allocation'\n"
"\tAND n.nid =:node\n"
"\tAND w.field_coworker_target_id =:usr\", array(':node' => arg(1), ':usr' => $user->uid));\n"
"\t$resarray = $result->fetchAll();\n"
"\n"
"\t//allow adding reports only for projects in stages 0 and 1\n"
"\n"
"//only verified and not accused users can add work report\n"
"\tif (!user_has_role(6) && $vrfststus == 1) {\n"
"\t\tif ($stage < 2) {\n"
"\t\t\t//allow adding report if user is in the list of share holders\n"
"\t\t\tif($resarray != NULL) {\n"
"\t\t\t\tprint '<a class=\"btn btn-default btn-xs\" style=\"color: white; background-color: green;\" role=\"button\" href=\"/node/add/work-report/' . arg(1) . '\">' . t('Add Report') . '</a><br/><br/>';\n"
"\t\t\t}\n"
"\t\t\telse {\n"
"\t\t\t\tprint '<a class=\"btn btn-default btn-xs disabled\" style=\"color: white; background-color: gray;\" role=\"button\" href=\"#\">' . t('Add Report') . '</a> <span style=\"color: lightgray;\">' . t('Only shareholders can add work reports.') . '</span><br/><br/>';\n"
"\t\t\t}\n"
"\t\t}\n"
"\t\telse {\n"
"\t\t\tprint '<a class=\"btn btn-default btn-xs disabled\" style=\"color: white; background-color: gray;\" role=\"button\" href=\"#\">' . t('Add Report') . '</a> <span style=\"color: lightgray;\">' . t('This project is closed because its product was sold or expired.') . '</span><br/><br/>';\n"
"\t\t}\n"
"\t}\n"
"}\n"
"?>"
msgstr ""

