msgstr ""
"Jazyk %language byl vytvořen a nyní může být použit. Více informací je "
"dostupných v <a href=\"@locale-help\">pomocníkovi</a>."

msgid "Domain and path prefix values should not be set at the same time."
msgstr "Doména a předpona by neměly být vyplněny současně."

msgid "The domain (%domain) is already tied to a language (%language)."
msgstr "Doména (%domain) je již použita pro jazyk (%language)."

msgid "Only the default language can have both the domain and prefix empty."
msgstr "Pouze výchozí jazyk může mít současně prázdnou doménu a předponu."

msgid "The prefix (%prefix) is already tied to a language (%language)."
msgstr "Předpona (%prefix) je již použita pro jazyk (%language)."

msgid "The English language cannot be deleted."
msgstr "Anglický jazyk nemůže být odstraněn."

msgid "The default language cannot be deleted."
msgstr "Přednastavený jazyk nemůže být odstraněn."

msgid ""
"Deleting a language will remove all interface translations associated with "
"it, and posts in this language will be set to be language neutral. This "
"action cannot be undone."
msgstr ""
"Odstranění jazyka způsobí, že všechny překlady spojené s rozhraním, které "
"jsou s jazykem asociovány a všechny příspěvky v tomto jazyce budou nastaveny"
" jako nezávislé na jazyku. Tento krok již nelze vrátit zpět."

msgid "Language negotiation configuration saved."
msgstr "Konfigurace pravidla pro výběr jazyka byla uložena."

msgid "English (built-in)"
msgstr "angličtina (integrovaná v Drupalu)"

msgid "String contains"
msgstr "Hledat řetězec"

msgid "Leave blank to show all strings. The search is case sensitive."
msgstr ""
"Necháte-li pole prázdné, zobrazí se všechny řetězce. Hledání rozlišuje velká"
" a malá písmena."

msgid "English (provided by Drupal)"
msgstr "angličtina (integrovaná v Drupalu)"

msgid "Search in"
msgstr "Hledat v"

msgid "Both translated and untranslated strings"
msgstr "Přeložené i nepřeložené řetězce"

msgid "Only translated strings"
msgstr "Pouze přeložené řetězce"

msgid "Only untranslated strings"
msgstr "Pouze nepřeložené řetězce"

msgid "Limit search to"
msgstr "Omezit na"

msgid "All text groups"
msgstr "Všechny textové skupiny"

msgid "Languages not yet added"
msgstr "Zatím nepřidané jazyky"

msgid "Import translation"
msgstr "Importovat překlad"

msgid "A Gettext Portable Object (<em>.po</em>) file."
msgstr "Soubor Gettext Portable Object (<em>.po</em>)."

msgid "Import into"
msgstr "Import do jazyka"

msgid ""
"Choose the language you want to add strings into. If you choose a language "
"which is not yet set up, it will be added."
msgstr ""
"Vyberte jazyk, do kterého chcete přidat řetězce. Pokud vyberete jazyk, který"
" ještě není nastaven, automaticky bude přidán."

msgid "Text group"
msgstr "Skupiny textů"

msgid "Imported translations will be added to this text group."
msgstr "Naimportované překlady budou přidány do vybrané skupiny textů."

msgid "The language %language has been created."
msgstr "Byl vytvořen jazyk: %language"

msgid "Export translation"
msgstr "Export překladu"

msgid ""
"Select the language to export in Gettext Portable Object (<em>.po</em>) "
"format."
msgstr ""
"Vyberte jazyk, který se bude exportovat do formátu Gettext Portable Object "
"(<em>.po</em>)"

msgid ""
"Generate a Gettext Portable Object Template (<em>.pot</em>) file with all "
"strings from the Drupal locale database."
msgstr ""
"Generovat Gettext Portable Object Template (<em>.pot</em>), soubor se všemi "
"řetězci z lokální databáze Drupalu."

msgid "String not found."
msgstr "Řetězec nenalezen."

msgid "The submitted string contains disallowed HTML: %string"
msgstr "Odeslaný řetězec obsahuje nepovolený HTML kód: %string"

msgid "The string has been saved."
msgstr "Řetězec byl uložen."

msgid "The string has been removed."
msgstr "Řetězec byl odstraněn."

msgid "The language selected for import is not supported."
msgstr "Jazyk zvolený pro import není podporován."

msgid ""
"The translation file %filename appears to have a missing or malformed "
"header."
msgstr "Soubor s překladem %filename zřejmě nemá nebo má vadnou hlavičku."

msgid ""
"The translation was successfully imported. There are %number newly created "
"translated strings, %update strings were updated and %delete strings were "
"removed."
msgstr ""
"Překlad byl úspěšně importován. Bylo vytvořeno %number nových řetězců, "
"%update řetězců bylo aktualizováno a %delete řetězců bylo vymazáno."

msgid "Importing interface translations"
msgstr "Importování překladu rozhraní"

msgid "Starting import"
msgstr "Spustit import"

msgid "Error importing interface translations"
msgstr "Chyba při importování překladu rozhraní"

msgid ""
"Attempted submission of a translation string with disallowed HTML: %string"
msgstr ""
"Nevydařené odeslání řetězce s překladem, který obsahuje nepovolený HTML kód:"
" %string"

msgid "The %language language (%code) has been created."
msgstr "Byl vytvořen jazyk %language(%code)."

msgid ""
"Imported %file into %locale: %number new strings added, %update updated and "
"%delete removed."
msgstr ""
"Byl naimportován %file do %locale: přidáno %number nových řetězců, "
"aktualizováno %update a odstraněno %delete."

msgid "Exported %locale translation file: %filename."
msgstr "Export překladového souboru %locale: %filename."

msgid "Exported translation file: %filename."
msgstr "Export překladového souboru: %filename."

msgid "Updated JavaScript translation file for the language %language."
msgstr "Byl aktualizován JavaScriptový překladový soubor pro jazyk %language."

msgid "Created JavaScript translation file for the language %language."
msgstr "Byl vytvořen JavaScriptový překladový soubor pro jazyk %language."

msgid ""
"Removed JavaScript translation file for the language %language, because no "
"translations currently exist for that language."
msgstr ""
"Bol vymazaný JavaScript súbor prekladu pre jazyk %language, pretože v "
"súčasnej dobe neexistujú žiadne preklady pre tento jazyk."

msgid ""
"An error occurred during creation of the JavaScript translation file for the"
" language %language."
msgstr ""
"Počas vytvárania prekladového súboru JavaScript pre jazyk %language nastala "
"chyba."

msgid ""
"One translation string was skipped because it contains disallowed HTML."
msgid_plural ""
"@count translation strings were skipped because they contain disallowed "
"HTML."
msgstr[0] ""
"Jeden preklad bol vynechaný, pretože obsahoval nepovolený HTML kód."
msgstr[1] ""
"@count preklady boli vynechané, pretože obsahovali nepovolený HTML kód."
msgstr[2] ""
"@count prekladov bolo vynechaných, pretože obsahovali nepovolený HTML kód."

msgid "One translation file imported for the newly installed modules."
msgid_plural ""
"@count translation files imported for the newly installed modules."
msgstr[0] "Novo nainštalované moduly importovali @count súbor s prekladom."
msgstr[1] "Novo nainštalované moduly importovali @count súbory s prekladom."
msgstr[2] "Novo nainštalované moduly importovali @count súborov s prekladom."

msgid "One translation file imported for the enabled modules."
msgid_plural "@count translation files imported for the enabled modules."
msgstr[0] "Zapnuté moduly importovali @count súbor s prekladom."
msgstr[1] "Zapnuté moduly importovali @count súbory s prekladom."
msgstr[2] "Zapnuté moduly importovali @count súborov s prekladom."

