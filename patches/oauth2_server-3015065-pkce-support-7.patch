+/**
+ * Adds the {oauth2_server_authorization_code} challenge and challenge_method fields.
+ */
+function oauth2_server_update_7108() {
+  $specs = array(
+    'challenge' => array(
+      'description' => 'The PCKE code_challenge parameter.',
+      'type' => 'varchar',
+      'length' => 128,
+      'not null' => FALSE,
+    ),
+    'challenge_method' => array(
+      'description' => 'The PCKE code_challenge_method parameter, if used, e.g. S256 or plain.',
+      'type' => 'varchar',
+      'length' => 255,
+      'not null' => FALSE,
+    ),
+  );
+  $table = 'oauth2_server_authorization_code';
+  foreach ($specs as $column => $spec) {
+    if (!db_field_exists($table, $column)) {
+      db_add_field($table, $column, $spec);
+    }
+  }
+}
