<?php
/**
 * @file
 * Rovas Site Rules module.
 *
 * Provides default Rules configurations via hook_default_rules_configuration()
 * in rovas_site_rules.rules_defaults.inc. Rule definitions are stored as JSON
 * in the rules/ subdirectory.
 *
 * Third-party account creation via Services is documented in README.txt
 * (rules_create_user, api client role, response fields).
 *
 * Batch migration callbacks live in rovas_site_rules.migration.inc; the Batch
 * API 'file' key loads that include on progressive batch requests (see
 * rovas_site_rules_migration_run_batch()).
 */

/**
 * Returns HybridAuth provider machine names that are enabled on this site.
 *
 * Uses hybridauth_get_enabled_providers() (HybridAuth admin configuration,
 * stored in the {variable} table and provider definitions). Modules may alter
 * the list via hook_rovas_site_rules_hybridauth_providers_alter().
 *
 * @return array
 *   Provider ids, e.g. Nabezky, Facebook.
 */
function rovas_site_rules_allowed_hybridauth_providers() {
  $allowed = array();
  if (module_exists('hybridauth') && function_exists('hybridauth_get_enabled_providers')) {
    $allowed = array_keys(hybridauth_get_enabled_providers());
  }
  return $allowed;
}

/**
 * TRUE if the provider id is enabled in HybridAuth (rules_create_user validation).
 *
 * @param string $provider
 *   Provider machine name (e.g. Nabezky).
 *
 * @return bool
 */
function rovas_site_rules_hybridauth_provider_is_allowed($provider) {
  if ($provider === '' || $provider === NULL) {
    return FALSE;
  }
  return in_array($provider, rovas_site_rules_allowed_hybridauth_providers(), TRUE);
}

/**
 * Implements hook_module_implements_alter().
 *
 * - Run before Node on user cancel/delete so system project cleanup happens first.
 * - Run before Rules on page_build so deferred Rules redirects can be suppressed
 *   during account cancellation (hook_user_cancel runs before the cancel batch).
 */
function rovas_site_rules_module_implements_alter(&$implementations, $hook) {
  $run_first = array(
    'user_cancel' => TRUE,
    'user_delete' => TRUE,
    'page_build' => TRUE,
    'mail_alter' => FALSE,
  );
  if (!empty($run_first[$hook]) && isset($implementations['rovas_site_rules'])) {
    $group = $implementations['rovas_site_rules'];
    unset($implementations['rovas_site_rules']);
    $implementations = array_merge(array('rovas_site_rules' => $group), $implementations);
  }
}

/**
 * TRUE while a user account is being canceled or deleted.
 *
 * Used to suppress UI-oriented Rules actions (redirects) that assume a project
 * delete form at node/N/delete, not the account cancel confirmation URL.
 */
function rovas_site_rules_in_account_deletion() {
  return (bool) drupal_static(__FUNCTION__, FALSE);
}

/**
 * Marks the start of account-deletion work (nested calls supported).
 */
function rovas_site_rules_account_deletion_begin() {
  $depth = &drupal_static(__FUNCTION__, 0);
  $depth++;
  drupal_static('rovas_site_rules_in_account_deletion', TRUE);
}

/**
 * Marks the end of account-deletion work.
 */
function rovas_site_rules_account_deletion_end() {
  $depth = &drupal_static('rovas_site_rules_account_deletion_begin', 0);
  $depth--;
  if ($depth <= 0) {
    drupal_static_reset('rovas_site_rules_account_deletion_begin');
    drupal_static_reset('rovas_site_rules_in_account_deletion');
  }
}

/**
 * Implements hook_page_build().
 *
 * Rules queues redirects in $GLOBALS during hook_user_cancel(); clear them
 * while account deletion is in progress so batch cancellation can finish.
 */
function rovas_site_rules_page_build(&$page) {
  if (rovas_site_rules_in_account_deletion() && isset($GLOBALS['_rules_action_drupal_goto_do'])) {
    unset($GLOBALS['_rules_action_drupal_goto_do']);
  }
}

/**
 * Implements hook_user_cancel().
 *
 * For user_cancel_reassign, Node reassigns all content to Anonymous in its own
 * hook_user_cancel(). Delete the system project first so it is fully cleaned up
 * instead of becoming an orphaned Anonymous-owned project.
 */
function rovas_site_rules_user_cancel($edit, $account, $method) {
  if ($method === 'user_cancel_reassign') {
    rovas_site_rules_account_deletion_begin();
    _rovas_site_rules_delete_user_system_project($account);
    rovas_site_rules_account_deletion_end();
  }
}

/**
 * Implements hook_user_delete().
 *
 * Delete the user's system project before core removes the user record. Also
 * covers user_cancel_delete, where hook_user_cancel() is not invoked.
 */
function rovas_site_rules_user_delete($account) {
  rovas_site_rules_account_deletion_begin();
  _rovas_site_rules_delete_user_system_project($account);
  rovas_site_rules_account_deletion_end();
}

/**
 * Delete a user's system project via the Rules delete-project action set.
 *
 * @param object $account
 *   The user account being canceled or deleted.
 */
function _rovas_site_rules_delete_user_system_project($account) {
  if (empty($account->uid) || !is_numeric($account->uid)) {
    return;
  }

  // If Rules is not available, fall back to doing nothing rather than partially
  // deleting a project without its business cleanup.
  if (!module_exists('rules') || !function_exists('rules_invoke_component')) {
    watchdog('rovas_site_rules', 'Skipping system project deletion for uid @uid because Rules is unavailable.', array('@uid' => $account->uid), WATCHDOG_WARNING);
    return;
  }

  // Match the lookup used by the Rules component `rules_find_system_project_for_user`.
  if (!db_table_exists('field_data_field_system_project')) {
    return;
  }

  $nids = db_query(
    "SELECT node.nid AS nid
     FROM {node} node
     INNER JOIN {field_data_field_system_project} s ON node.nid = s.entity_id
       AND s.entity_type = 'node'
     WHERE node.uid = :uid
       AND node.status = '1'
       AND node.type = 'project'
       AND s.field_system_project_value = '1'
     ORDER BY node.created ASC",
    array(':uid' => (int) $account->uid)
  )->fetchCol();

  if (count($nids) > 1) {
    watchdog('rovas_site_rules', 'More than one system project found for uid @uid (@nids). Deleting the oldest.', array('@uid' => $account->uid, '@nids' => implode(',', $nids)), WATCHDOG_WARNING);
  }

  $nid = !empty($nids) ? (int) $nids[0] : 0;
  if ($nid <= 0) {
    return;
  }

  $project = node_load($nid);
  if (!$project || empty($project->nid) || $project->type !== 'project') {
    return;
  }

  // Use the existing Rules action set for full project cleanup. Pass "REST api"
  // to avoid UI redirects in this non-interactive context.
  rules_invoke_component('rules_delete_project', $project, 'REST api');
}
