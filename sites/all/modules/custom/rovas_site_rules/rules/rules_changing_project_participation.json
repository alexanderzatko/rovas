{ "rules_changing_project_participation" : {
    "LABEL" : "Changing project participation",
    "PLUGIN" : "reaction rule",
    "OWNER" : "rules",
    "TAGS" : [ "project" ],
    "REQUIRES" : [ "rules", "rules_conditional", "views_bulk_operations", "php" ],
    "ON" : { "node_update--project" : { "bundle" : "project" } },
    "IF" : [
      { "php_eval" : { "code" : "return isset($node_unchanged) && !empty($node_unchanged);" } },
      { "NOT data_is" : {
          "data" : [ "node:field-participation" ],
          "value" : [ "node-unchanged:field-participation" ]
        }
      }
    ],
    "DO" : [
      { "CONDITIONAL" : [
          {
            "IF" : { "data_is" : { "data" : [ "node-unchanged:field-participation" ], "value" : "0" } },
            "DO" : [
              { "views_bulk_operations_action_load_list" : {
                  "USING" : {
                    "view" : "other_workers_work_reports|default",
                    "args" : "[node-unchanged:nid]\r\n[site:current-user:uid]"
                  },
                  "PROVIDE" : { "entity_list" : { "entity_list" : "A list of entities" } }
                }
              },
              { "CONDITIONAL" : [
                  {
                    "IF" : { "list_count_is" : { "list" : [ "entity-list" ], "op" : "\u003E", "value" : "1" } },
                    "DO" : [
                      { "data_set" : {
                          "data" : [ "node:field-participation" ],
                          "value" : [ "node-unchanged:field-participation" ]
                        }
                      },
                      { "drupal_message" : {
                          "message" : "Please make sure the project has only one shareholder and no work reports before changing its participation type.",
                          "type" : "error"
                        }
                      }
                    ]
                  },
                  { "ELSE" : [
                      { "entity_query" : {
                          "USING" : {
                            "type" : "node",
                            "property" : "field_project",
                            "value" : [ "node-unchanged" ],
                            "limit" : "1"
                          },
                          "PROVIDE" : { "entity_fetched" : { "ma_fetched" : "Fetched merit allocation" } }
                        }
                      },
                      { "CONDITIONAL" : [
                          {
                            "IF" : { "entity_is_of_bundle" : {
                                "entity" : [ "ma-fetched:0" ],
                                "type" : "node",
                                "bundle" : { "value" : { "co_worker_merit_allocation" : "co_worker_merit_allocation" } }
                              }
                            },
                            "DO" : [
                              { "CONDITIONAL" : [
                                  {
                                    "IF" : { "data_is" : { "data" : [ "node:field-participation" ], "value" : "1" } },
                                    "DO" : [
                                      { "data_set" : { "data" : [ "ma-fetched:0:field-merit-allocation" ], "value" : "0" } },
                                      { "data_set" : { "data" : [ "node:field-participation" ], "value" : "1" } }
                                    ]
                                  },
                                  {
                                    "ELSE IF" : { "data_is" : { "data" : [ "node:field-participation" ], "value" : "2" } },
                                    "DO" : [
                                      { "CONDITIONAL" : [
                                          {
                                            "IF" : { "data_is_empty" : { "data" : [ "node:field-parent-project" ] } },
                                            "DO" : [
                                              { "data_set" : { "data" : [ "node:field-participation" ], "value" : "0" } },
                                              { "drupal_message" : {
                                                  "message" : "If changing private project to parent dependent, you must choose the parent from the drop-down menu. To see the parent there, you will need to first make this project a project shareholder in the parent project. Then you can come back here and change the project type.",
                                                  "type" : "error"
                                                }
                                              }
                                            ]
                                          },
                                          { "ELSE" : [
                                              { "data_set" : { "data" : [ "ma-fetched:0:field-merit-allocation" ], "value" : "0" } },
                                              { "data_set" : { "data" : [ "node:field-participation" ], "value" : "2" } }
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          { "ELSE" : [
                              { "drupal_message" : {
                                  "message" : "The merit shareholder for this project is not \u0022worker\u0022 and that indicates data inconsistency in the database. Please report this problem to the Rovas administrator: rovas@merit.world and include a screenshot of this page.",
                                  "type" : "error"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
