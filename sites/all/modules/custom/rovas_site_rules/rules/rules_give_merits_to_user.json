{ "rules_give_merits_to_user" : {
    "LABEL" : "Give merits to user",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "TAGS" : [ "merits" ],
    "REQUIRES" : [ "rules", "php", "rules_conditional", "userpoints_rules" ],
    "USES VARIABLES" : {
      "user_object" : { "label" : "User object", "type" : "user" },
      "merits_given" : { "label" : "Merits given", "type" : "decimal" },
      "reward_entity" : { "label" : "Entity related to reward", "type" : "entity" },
      "description" : { "label" : "Description", "type" : "text", "allow null" : true },
      "operation" : { "label" : "Operation", "type" : "text" }
    },
    "IF" : [
      { "entity_is_of_bundle" : {
          "entity" : [ "user-object" ],
          "type" : "user",
          "bundle" : { "value" : { "user" : "user" } }
        }
      }
    ],
    "DO" : [
      { "variable_add" : {
          "USING" : {
            "type" : "decimal",
            "value" : [ "user-object:field-merit-decimal-part" ]
          },
          "PROVIDE" : { "variable_added" : { "merits_decimal_part" : "merits decimal part" } }
        }
      },
      { "data_calc" : {
          "USING" : {
            "input_1" : [ "merits-given" ],
            "op" : "+",
            "input_2" : [ "merits-decimal-part" ]
          },
          "PROVIDE" : { "result" : { "partial_merits" : "decimal part plus merits to add" } }
        }
      },
      { "variable_add" : {
          "USING" : {
            "type" : "decimal",
            "value" : {
              "select" : "partial-merits",
              "php" : { "code" : "return fmod($value, 1);" }
            }
          },
          "PROVIDE" : { "variable_added" : { "new_decimal_part" : "new decimal part" } }
        }
      },
      { "data_calc" : {
          "USING" : {
            "input_1" : [ "partial-merits" ],
            "op" : "-",
            "input_2" : [ "new-decimal-part" ]
          },
          "PROVIDE" : { "result" : { "new_whole_merits_decimal" : "new whole merits decimal" } }
        }
      },
      { "data_convert" : {
          "USING" : {
            "type" : "integer",
            "value" : [ "new-whole-merits-decimal" ],
            "rounding_behavior" : "down"
          },
          "PROVIDE" : { "conversion_result" : { "new_whole_merits" : "new whole merits" } }
        }
      },
      { "CONDITIONAL" : [
          {
            "IF" : { "data_is" : { "data" : [ "merits-decimal-part" ], "op" : "\u003E", "value" : "0" } },
            "DO" : [
              { "data_set" : {
                  "data" : [ "user-object:field-merit-decimal-part" ],
                  "value" : [ "new-decimal-part" ]
                }
              }
            ]
          }
        ]
      },
      { "userpoints_action_grant_points" : {
          "user" : [ "user-object" ],
          "points" : [ "new-whole-merits" ],
          "tid" : "0",
          "entity" : [ "reward-entity" ],
          "description" : "[description:value]",
          "operation" : "[operation:value]",
          "display" : "0",
          "moderate" : "approved"
        }
      }
    ]
  }
}
