{ "rules_give_merits_to_user" : {
    "LABEL" : "Give merits to user",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "TAGS" : [ "merits" ],
    "REQUIRES" : [ "rules", "php", "rules_conditional", "userpoints_rules", "rovas_merit" ],
    "USES VARIABLES" : {
      "user_object" : { "label" : "User object", "type" : "user" },
      "merits_given" : { "label" : "Merits given", "type" : "decimal" },
      "reward_entity" : { "label" : "Entity related to reward", "type" : "entity" },
      "description" : { "label" : "Description", "type" : "text", "allow null" : true },
      "operation" : { "label" : "Operation", "type" : "text" }
    },
    "IF" : [
      { "entity_is_of_bundle" : {
          "entity" : [ "user-object" ],
          "type" : "user",
          "bundle" : { "value" : { "user" : "user" } }
        }
      }
    ],
    "DO" : [
      { "variable_add" : {
          "USING" : {
            "type" : "text",
            "value" : "\u003C?php\r\nmodule_load_include(\u0027inc\u0027, \u0027rovas_merit\u0027, \u0027rovas_merit.ledger\u0027);\r\n$entity = isset($reward_entity) ? $reward_entity : $user_object;\r\n$op = !empty($operation) ? $operation : \u0027Insert\u0027;\r\n$desc = !empty($description) ? $description : \u0027\u0027;\r\nreturn rovas_merit_credit_wallet($user_object, (float) $merits_given, $entity, $desc, $op) ? 1 : 0;\r\n?\u003E"
          },
          "PROVIDE" : { "variable_added" : { "wallet_result" : "wallet result" } }
        }
      }
    ]
  }
}
