{ "rules_work_report_created" : {
    "LABEL" : "Work report created",
    "PLUGIN" : "reaction rule",
    "OWNER" : "rules",
    "TAGS" : [ "chrons", "work report" ],
    "REQUIRES" : [ "pathrules", "rules", "php" ],
    "ON" : { "node_insert--work_report" : { "bundle" : "work_report" } },
    "IF" : [
      { "pathrules_checkpath" : { "path" : "add" } },
      { "node_is_published" : { "node" : [ "node" ] } }
    ],
    "DO" : [
      { "component_rules_calculate_work_hours_per_day" : {
          "USING" : { "user_to_check" : [ "site:current-user" ] },
          "PROVIDE" : { "hours_per_day" : { "hours_per_day" : "hours per day" } }
        }
      },
      { "component_rules_update_user_s_labor_count_for_a_project_" : {
          "project_id" : [ "node:field-project:nid" ],
          "user_obj" : [ "node:author" ],
          "hours_delta" : [ "node:field-hours-worked" ]
        }
      },
      { "php_eval" : { "code" : "if (function_exists('rovas_user_handle_work_report_publish')) {\r\n  rovas_user_handle_work_report_publish($node);\r\n}\r\nelse {\r\n  rules_invoke_component('rules_create_verify_slot', (int) $node->uid, 0, '0', 0);\r\n  rules_invoke_component('rules_create_verify_slot', (int) $node->uid, 0, '0', 0);\r\n  $author = user_load($node->uid);\r\n  if ($author) {\r\n    $author->field_suspend_account[LANGUAGE_NONE][0]['value'] = 0;\r\n    user_save($author);\r\n  }\r\n}" } },
      { "redirect" : { "url" : "\u003C?php\r\nreturn \u0027\/node\/\u0027. arg(3);\r\n?\u003E" } }
    ]
  }
}
