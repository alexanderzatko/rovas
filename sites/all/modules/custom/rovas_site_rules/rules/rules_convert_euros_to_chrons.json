{ "rules_convert_euros_to_chrons" : {
    "LABEL" : "Convert Euros to Chrons",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "TAGS" : [ "api", "chrons" ],
    "REQUIRES" : [ "rules", "php", "rovas_forex" ],
    "USES VARIABLES" : {
      "euros" : { "label" : "euros to convert", "type" : "decimal" },
      "chrons" : { "label" : "resulting chrons", "type" : "decimal", "parameter" : false }
    },
    "DO" : [
      { "component_rules_retrieve_user_id_from_api_key_and_token" : { "USING" : {}, "PROVIDE" : { "uid" : { "uid" : "user id" } } } },
      { "variable_add" : {
          "USING" : {
            "type" : "text",
            "value" : "\u003C?php\r\n$params = calculate_forex_transaction_params(\u0027eur_to_chr\u0027, abs($euros));\r\necho $params[\u0027output\u0027];\r\n?\u003E"
          },
          "PROVIDE" : { "variable_added" : { "chrons_text" : "chrons text" } }
        }
      },
      { "data_convert" : {
          "USING" : { "type" : "decimal", "value" : [ "chrons-text" ] },
          "PROVIDE" : { "conversion_result" : { "chrons_dec" : "chrons decimal" } }
        }
      },
      { "data_set" : { "data" : [ "chrons" ], "value" : [ "chrons-dec" ] } }
    ],
    "PROVIDES VARIABLES" : [ "chrons" ]
  }
}
