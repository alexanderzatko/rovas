{ "rules_proxy_delete_work_report" : {
    "LABEL" : "proxy - delete work report",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "TAGS" : [ "api", "work report" ],
    "REQUIRES" : [ "rules", "rules_conditional" ],
    "USES VARIABLES" : {
      "result" : { "label" : "result", "type" : "integer", "parameter" : false },
      "wr_id" : { "label" : "work report ID", "type" : "integer" }
    },
    "DO" : [
      { "component_rules_retrieve_user_id_from_api_key_and_token" : { "USING" : {}, "PROVIDE" : { "uid" : { "uid" : "user id" } } } },
      { "entity_fetch" : {
          "USING" : { "type" : "user", "id" : [ "uid" ] },
          "PROVIDE" : { "entity_fetched" : { "user" : "user" } }
        }
      },
      { "entity_fetch" : {
          "USING" : { "type" : "node", "id" : [ "wr-id" ] },
          "PROVIDE" : { "entity_fetched" : { "fetched_wr" : "Fetched work report" } }
        }
      },
      { "component_rules_work_report_deletability" : {
          "USING" : { "wr_object" : [ "fetched-wr" ], "user_object" : [ "user" ] },
          "PROVIDE" : { "deletable" : { "deletable" : "deletable" } }
        }
      },
      { "CONDITIONAL" : [
          {
            "IF" : { "data_is" : { "data" : [ "deletable" ], "value" : "1" } },
            "DO" : [
              { "component_rules_delete_work_report" : { "node" : [ "fetched-wr" ], "triggering_actor" : "user" } },
              { "data_set" : { "data" : [ "result" ], "value" : "1" } }
            ]
          },
          { "ELSE" : [ { "data_set" : { "data" : [ "result" ], "value" : "-1" } } ] }
        ]
      }
    ],
    "PROVIDES VARIABLES" : [ "result" ]
  }
}
