{ "rules_merit_allocation_record_updated" : {
    "LABEL" : "Merit allocation record updated",
    "PLUGIN" : "reaction rule",
    "OWNER" : "rules",
    "TAGS" : [ "logic" ],
    "REQUIRES" : [ "pathrules", "rules", "php" ],
    "ON" : {
      "node_update--co_worker_merit_allocation" : { "bundle" : "co_worker_merit_allocation" },
      "node_update--project_merit_allocation" : { "bundle" : "project_merit_allocation" }
    },
    "IF" : [ { "pathrules_checkpath" : { "path" : "edit" } } ],
    "DO" : [
      { "variable_add" : {
          "USING" : { "type" : "integer", "value" : [ "node:field-project:nid" ] },
          "PROVIDE" : { "variable_added" : { "project_id" : "project id" } }
        }
      },
      { "component_rules_recalculate_total_project_shares" : {
          "USING" : { "project_id" : [ "project_id" ] },
          "PROVIDE" : { "total_project_shares" : { "total_project_shares" : "Total project shares" } }
        }
      },
      { "php_eval" : { "code" : "\/\/watchdog(\u0027debug\u0027, \u0027writing total shares into project record. $tps_provided = \u0027. $total_project_shares);\r\n$newshares = $total_project_shares;\r\n\r\n$prnode = node_load($project_id);\r\n$wrapper = entity_metadata_wrapper(\u0027node\u0027, $prnode);\r\n$wrapper-\u003Efield_total_shares = $newshares;\r\n\/\/reset field \u0022status\u0022 to \u0022not ready for purchase\u0022\r\nif($total_project_shares \u003E 100) {\r\n$wrapper-\u003Efield_status = 0;\r\n}\r\n$wrapper-\u003Esave(); " } },
      { "redirect" : { "url" : "\u003C?php\r\nreturn \u0027\/node\/\u0027. $project_id;\r\n?\u003E" } }
    ]
  }
}
