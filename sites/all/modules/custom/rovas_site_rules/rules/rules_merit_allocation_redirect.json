{ "rules_merit_allocation_redirect" : {
    "LABEL" : "Worker Merit allocation record deleted",
    "PLUGIN" : "reaction rule",
    "OWNER" : "rules",
    "TAGS" : [ "logic" ],
    "REQUIRES" : [ "commerce", "rules_conditional", "rules", "php" ],
    "ON" : { "node_delete--co_worker_merit_allocation" : { "bundle" : "co_worker_merit_allocation" } },
    "IF" : [
      { "entity_exists" : {
          "type" : "node",
          "property" : "nid",
          "value" : [ "node:field-project:nid" ]
        }
      }
    ],
    "DO" : [
      { "CONDITIONAL" : [
          {
            "IF" : { "NOT data_is_empty" : { "data" : [ "node:field-coworker" ] } },
            "DO" : [
              { "variable_add" : {
                  "USING" : { "type" : "integer", "value" : [ "node:field-project:nid" ] },
                  "PROVIDE" : { "variable_added" : { "project_id" : "project id" } }
                }
              },
              { "CONDITIONAL" : [
                  {
                    "IF" : { "data_is_empty" : { "data" : [ "node:field-merit-allocation" ] } },
                    "DO" : [
                      { "variable_add" : {
                          "USING" : { "type" : "decimal", "value" : "0" },
                          "PROVIDE" : { "variable_added" : { "deleted_share" : "deleted share" } }
                        }
                      }
                    ]
                  },
                  { "ELSE" : [
                      { "variable_add" : {
                          "USING" : { "type" : "text", "value" : [ "node:field-merit-allocation" ] },
                          "PROVIDE" : { "variable_added" : { "deleted_share" : "deleted share" } }
                        }
                      }
                    ]
                  }
                ]
              },
              { "component_rules_recalculate_total_project_shares" : {
                  "USING" : { "project_id" : [ "project_id" ] },
                  "PROVIDE" : { "total_project_shares" : { "total_project_shares" : "Total project shares" } }
                }
              },
              { "php_eval" : { "code" : "\/\/watchdog(\u0027debug\u0027,\u0027total_project_shares is \u0027 . $total_project_shares);\r\n\r\nif (!isset($deleted_share) || !is_numeric($deleted_share)) {\r\n  $deleted_share = 0;\r\n}\r\n$ds = $deleted_share;\r\n\r\n$newshares = $total_project_shares - $ds;\r\n\r\n$prnode = node_load($project_id);\r\nif (!$prnode) {\r\n  return;\r\n}\r\n$wrapper = entity_metadata_wrapper(\u0027node\u0027, $prnode);\r\n$wrapper-\u003Efield_total_shares = $newshares;\r\n\/\/reset field \u0022status\u0022 to \u0022not ready for purchase\u0022\r\nif($total_project_shares \u003E 100) {\r\n$wrapper-\u003Efield_status = 0;\r\n}\r\n$wrapper-\u003Esave(); " } },
              { "component_rules_merit_allocation_deleted_send_email" : { "deleted_ma" : [ "node" ] } },
              { "CONDITIONAL" : [
                  {
                    "IF" : { "php_eval" : { "code" : "return arg(0) == \u0027node\u0027 && arg(2) == \u0027delete\u0027 && is_numeric(arg(3));" } },
                    "DO" : [
                      { "redirect" : { "url" : "\u003C?php\r\nreturn \u0027\/node\/\u0027. arg(3);\r\n?\u003E" } }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
