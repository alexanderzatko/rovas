{ "rules_process_time_share_order" : {
    "LABEL" : "Process time share order",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "REQUIRES" : [ "rules", "commerce_order", "rules_conditional", "php" ],
    "USES VARIABLES" : { "order" : { "label" : "Order", "type" : "commerce_order" } },
    "IF" : [
      { "entity_is_of_bundle" : {
          "entity" : [ "order" ],
          "type" : "commerce_order",
          "bundle" : { "value" : { "commerce_order" : "commerce_order" } }
        }
      },
      { "commerce_order_contains_product" : {
          "commerce_order" : [ "order" ],
          "product_id" : "time-share",
          "operator" : "\u003E=",
          "value" : "1"
        }
      }
    ],
    "DO" : [
      { "variable_add" : {
          "USING" : {
            "type" : "text",
            "value" : "Purchased [order:commerce-line-items:0:quantity] minutes of time share"
          },
          "PROVIDE" : { "variable_added" : { "note" : "note" } }
        }
      },
      { "entity_fetch" : {
          "USING" : {
            "type" : "node",
            "id" : [ "order:field-payment-recipient" ],
            "revision_id" : "0"
          },
          "PROVIDE" : { "entity_fetched" : { "recipient_project" : "recipient project" } }
        }
      },
      { "component_rules_check_or_add_time_shareholder_core" : {
          "USING" : { "project" : [ "recipient-project" ], "user" : [ "order:owner" ] },
          "PROVIDE" : { "result" : { "timeshare" : "timeshare" } }
        }
      },
      { "entity_fetch" : {
          "USING" : { "type" : "node", "id" : [ "timeshare" ], "revision_id" : "0" },
          "PROVIDE" : { "entity_fetched" : { "timeshare_node" : "timeshare node" } }
        }
      },
      { "CONDITIONAL" : [
          {
            "IF" : { "entity_is_of_bundle" : {
                "entity" : [ "timeshare-node" ],
                "type" : "node",
                "bundle" : { "value" : { "timeshare_merit_allocation" : "timeshare_merit_allocation" } }
              }
            },
            "DO" : [
              { "variable_add" : {
                  "USING" : {
                    "type" : "decimal",
                    "value" : [ "timeshare-node:field-total-hours-worked" ]
                  },
                  "PROVIDE" : { "variable_added" : { "old_share" : "old share" } }
                }
              },
              { "data_calc" : {
                  "USING" : {
                    "input_1" : [ "old-share" ],
                    "op" : "+",
                    "input_2" : {
                      "select" : "order:commerce-line-items:0:quantity",
                      "php" : { "code" : "return $value \/ 60;" }
                    }
                  },
                  "PROVIDE" : { "result" : { "new_share" : "new share" } }
                }
              },
              { "data_set" : {
                  "data" : [ "timeshare-node:field-total-hours-worked" ],
                  "value" : [ "new-share" ]
                }
              },
              { "entity_save" : { "data" : [ "timeshare-node" ], "immediate" : "1" } }
            ]
          }
        ]
      }
    ]
  }
}
