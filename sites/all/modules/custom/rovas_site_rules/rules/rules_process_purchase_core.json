{
  "rules_process_purchase_core": {
    "LABEL": "Process purchase core",
    "PLUGIN": "action set",
    "OWNER": "rules",
    "REQUIRES": [
      "rules",
      "rules_conditional",
      "php",
      "rovas_forex",
      "rovas_base",
      "rovas_project_reward"
    ],
    "USES VARIABLES": {
      "purchased_product_id": {
        "label": "Purchased product ID",
        "type": "integer"
      },
      "amount_paid": {
        "label": "Amount paid",
        "type": "decimal"
      },
      "logged_in_user": {
        "label": "Current user",
