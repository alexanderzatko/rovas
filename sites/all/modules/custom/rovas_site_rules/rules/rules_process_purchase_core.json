                }
              },
              {
                "php_eval": {
                  "code": "$buyeruid = $logged_in_user->uid;\r\n\r\nif (!function_exists('labor_merit_rewarder')) {\r\n\tfunction labor_merit_rewarder($purchased_product_id,$userid,$merits) {\r\n\t\t$result = db_query(\"SELECT DISTINCT c.field_classification_tid AS cat, SUM(h.field_hours_worked_value) AS hours\r\n\t\tFROM {node} node\r\n\t\tLEFT JOIN {field_data_field_project} p ON node.nid = p.entity_id AND (p.entity_type = 'node' AND p.deleted = '0')\r\n\t\tLEFT JOIN {field_data_field_classification} c ON node.nid = c.entity_id AND (c.entity_type = 'node' AND c.deleted = '0')\r\n\t\tLEFT JOIN {field_data_field_hours_worked} h ON node.nid = h.entity_id AND (h.entity_type = 'node' AND h.deleted = '0')\r\n\t\tWHERE p.field_project_target_id = :prid\r\n\t\tAND c.delta = 0\r\n\t\tAND node.uid = :uid \r\n\t\tAND node.status = '1'\r\n\t\tAND node.type IN  ('work_report')\r\n\t\tGROUP BY c.field_classification_tid\", array(':prid' => $purchased_product_id, ':uid' => $userid));\r\n\t\t$resarray = $result->fetchAll();\r\n\r\n\t\t$total_time = 0;\r\n\t\tforeach ($resarray as $row) {\r\n\t\t\t$total_time += $row->hours;\r\n\t\t}\r\n\t\tif ($total_time > 0) {\r\n\t\t\tforeach ($resarray as $row) {\r\n\t\t\t\t$time_share = $row->hours / $total_time;\r\n\t\t\t\trules_invoke_component('rules_update_user_expertise',$time_share,$merits,$row->cat,$userid);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\nif (!function_exists('shares_merit_rewarder')) {\r\n\tfunction shares_merit_rewarder($purchased_product_id,$userid,$merits) {\r\n\r\n\t\t$now = time();\r\n\t\t$total_time = rovas_purchase_shares_project_share_hours ($purchased_product_id,$userid);\r\n\r\n\t\tif ($total_time > 0) {\r\n\r\n\t\t\t//64.99 Other financial service activities, except insurance and pension funding n.e.c.\r\n\t\t\t$cat = 1601;\r\n\t\t\t//load the expert table node corresponding to the current category in order to find its existing Merit value\r\n\t\t\t$result = db_query(\"SELECT node.nid AS nid, m.field_merits_value AS merits\r\n\t\t\tFROM {node} node\r\n\t\t\tLEFT JOIN {field_data_field_expert} x ON node.nid = x.entity_id AND (x.entity_type = 'node' AND x.deleted = '0')\r\n\t\t\tLEFT JOIN {field_data_field_category} c ON node.nid = c.entity_id AND (c.entity_type = 'node' AND c.deleted = '0')\r\n\t\t\tLEFT JOIN {field_data_field_merits} m ON node.nid = m.entity_id AND (m.entity_type = 'node' AND m.deleted = '0')\r\n\t\t\tWHERE node.type = 'user_expertise'\r\n\t\t\tAND field_expert_target_id = :uid\r\n\t\t\tAND c.field_category_tid = :cat\r\n\t\t\t\", array(':uid' => $userid, ':cat' => $cat));\r\n\r\n\t\t\t$record = $result->fetchAssoc();\r\n\t\t\t//for some users and category IDs we will have to create a new user_expertise node\t\t\t\r\n\t\t\tif (empty($record)) {\r\n\t\t\t\t$node = new stdClass();\r\n\t\t\t\t$node->type = 'user_expertise';\r\n\t\t\t\t$node->title = 'UX-' . $userid . '-' . $cat;\r\n\t\t\t\t$node->language = LANGUAGE_NONE;\r\n\t\t\t\tnode_object_prepare($node);\r\n\t\t\t\t$node->uid = $userid;\r\n\r\n\t\t\t\t$node->field_expert[LANGUAGE_NONE][0]['target_id'] = $userid;\r\n\t\t\t\t$node->field_category[LANGUAGE_NONE][0]['tid'] = $cat;\r\n\r\n\t\t\t\t$old_merits = 0;\r\n\t\t\t\t$node->field_merits[LANGUAGE_NONE][0]['value'] = $old_merits;\r\n\r\n\t\t\t\t$node->created = $now;\r\n\t\t\t\t$node->changed = $now;\r\n\r\n\t\t\t\t$node = node_submit($node);\r\n\t\t\t\tnode_save($node);\r\n\t\t\t\t$nid = $node->nid;\r\n\r\n\t\t\t}\r\n\t\t\telse {\r\n\t\t\t\t$old_merits = $record['merits'];\r\n\t\t\t\t$nid = $record['nid'];\r\n\t\t\t}\r\n\r\n\t\t\t$cur_merits = $old_merits + $merits;\r\n\r\n\t\t\t//updating the node with new merit value\r\n\t\t\t$xobject = entity_metadata_wrapper('node', $nid);\r\n\t\t\t$xobject->field_merits = $cur_merits;\r\n\t\t\t$xobject->save();\r\n\t\t\t\r\n\t\t}\r\n\t}\r\n}\r\n\r\nif (!function_exists('mrewarder')) {\r\n\tfunction mrewarder($purchased_product_id,$amount_paid,$buyeruid,$receipt_id,$note,&$loopcheck=array()) {\r\n\r\n\t\tif (in_array($purchased_product_id,$loopcheck)) {\r\n\t\t\treturn;\r\n\t\t}\r\n\t\telse {\r\n\t\t\t$loopcheck[]=$purchased_product_id;\r\n\r\n\t\t\t//find total shares and total hours for the purchased project\r\n\t\t\t$res = db_query(\"SELECT MIN(node.nid) AS projectid, SUM(ma.field_merit_allocation_value) AS shares, SUM(hw.field_total_hours_worked_value) AS hours\r\n\t\t\tFROM {node} node\r\n\t\t\tLEFT JOIN {field_data_field_project} fpr ON node.nid = fpr.entity_id AND (fpr.entity_type = 'node' AND fpr.deleted = '0')\r\n\t\t\tLEFT JOIN {node} n ON fpr.field_project_target_id = n.nid\r\n\t\t\tLEFT JOIN {field_data_field_merit_allocation} ma ON node.nid = ma.entity_id AND (ma.entity_type = 'node' AND ma.deleted = '0')\r\n\t\t\tLEFT JOIN {field_data_field_total_hours_worked} hw ON node.nid = hw.entity_id AND (hw.entity_type = 'node' AND hw.deleted = '0')\r\n\t\t\tWHERE n.nid = :prid\r\n\t\t\tAND (node.status = '1' AND node.type IN  ('project_merit_allocation', 'co_worker_merit_allocation', 'timeshare_merit_allocation'))\r\n\t\t\t\", array(':prid' => $purchased_product_id));\r\n\r\n\t\t\t$sumarray = $res->fetchAll();\r\n\t\t\t//the sum of all partial shares (and hours) from worker and project shareholders\r\n\t\t\t$tsdiff = 100 - $sumarray[0]->shares;\r\n\t\t\t$total_hours = $sumarray[0]->hours;\r\n\r\n\t\t\t$result = db_query(\"SELECT p.entity_id \r\n\t\t\tFROM {field_data_field_project} p , {node} n\r\n\t\t\tWHERE p.bundle IN ('co_worker_merit_allocation','project_merit_allocation','timeshare_merit_allocation')\r\n\t\t\tAND n.status = 1\r\n\t\t\tAND n.nid = p.field_project_target_id\r\n\t\t\tAND p.field_project_target_id = :prid\r\n\t\t\tORDER BY p.bundle ASC\", array(':prid' => $purchased_product_id));\r\n\r\n\t\t\t$resarray = $result->fetchAll();\r\n\r\n\t\t\t//loop through all shareholders (all types)\r\n\t\t\tforeach ($resarray as $row) {\r\n\t\t\t\t$meritalloc_wrp = entity_metadata_wrapper('node', $row->entity_id);\r\n\t\t\t\t$share = $meritalloc_wrp->field_merit_allocation->value();\r\n\t\t\t\t$bundle = $meritalloc_wrp->getBundle();\r\n\r\n\t\t\t\t//processing worker shares, or purchased shares\r\n\t\t\t\tif($bundle == 'co_worker_merit_allocation' || $bundle == 'timeshare_merit_allocation') {\r\n\r\n\t\t\t\t\t$userid = $meritalloc_wrp->field_coworker->uid->value();\r\n\t\t\t\t\t$hours = $meritalloc_wrp->field_total_hours_worked->value();\r\n\r\n\t\t\t\t\t//retrieve the merit decimal part from the user profile\r\n\t\t\t\t\t$merits = ($share/100) * $amount_paid;\r\n\t\t\t\t\t//calculate the total time value of merit reward and add it to the share merit reward\r\n\t\t\t\t\tif($total_hours > 0) {\r\n\t\t\t\t\t\t$merits = $merits + ($tsdiff/100) * $amount_paid * ($hours/$total_hours);\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\tswitch ($bundle) {\r\n\t\t\t\t\t\t//reward a user's timeshare with Merits\r\n\t\t\t\t\t\tcase ('timeshare_merit_allocation'):\r\n\t\t\t\t\t\t\tshares_merit_rewarder($purchased_product_id,$userid,$merits);\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t//reward a user's labor time with Merits\r\n\t\t\t\t\t\tdefault:\r\n\t\t\t\t\t\t\tlabor_merit_rewarder($purchased_product_id,$userid,$merits);\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\t//read the merit reward for the user from the merit alloc. record\r\n\t\t\t\t\t$old_merit_val = $meritalloc_wrp->field_merits_earned->value();\r\n\t\t\t\t\t$new_merit_val = $old_merit_val + $merits;\r\n\t\t\t\t\t//update the merit count for the SHAREHOLDER in this project\r\n\t\t\t\t\t$meritalloc_wrp->field_merits_earned = $new_merit_val;\r\n\t\t\t\t\t$meritalloc_wrp->save();\r\n\r\n\t\t\t\t\t$user_merit_decimal_part = $meritalloc_wrp->field_coworker->field_merit_decimal_part->value();\r\n\t\t\t\t\t$merits_usrpoints = $merits + $user_merit_decimal_part;\r\n\r\n\t\t\t\t\t//calculate whole and decimal part of the reward\r\n\t\t\t\t\t$whole = floor($merits_usrpoints);\r\n\t\t\t\t\t$fraction = $merits_usrpoints - $whole;\r\n\r\n\t\t\t\t\t//save the merit decimal part\r\n\t\t\t\t\t$user_wrp = entity_metadata_wrapper('user', $userid);\r\n\t\t\t\t\t$user_wrp->field_merit_decimal_part = $fraction;\r\n\t\t\t\t\t$user_wrp->save(); \r\n\r\n\t\t\t\t\t//record Merits if there are any to reward\r\n\t\t\t\t\tif ($whole != 0) {\r\n\t\t\t\t\t\tif ($whole > 0)\r\n\t\t\t\t\t\t\t$xplain = t('purchased goods or services');\r\n\t\t\t\t\t\telse\r\n\t\t\t\t\t\t\t$xplain = t('was reimbursed for canceled purchase');\r\n\t\t\t\t\t\t$usrobj = entity_metadata_wrapper('user', $buyeruid);\r\n\t\t\t\t\t\t$buyername = $usrobj->name->value();\r\n\t\t\t\t\t\t$buyerfullname = $usrobj->field_full_name->value();\r\n\t\t\t\t\t\t$params = array (\r\n\t\t\t\t\t\t\t\t'uid' => $userid,\r\n\t\t\t\t\t\t\t\t'points' => $whole,\r\n\t\t\t\t\t\t\t\t'description' => $buyername . ' (' . $buyerfullname . ') ' . $xplain,\r\n\t\t\t\t\t\t\t\t'display' => 0,\r\n\t\t\t\t\t\t\t\t'entity_id' => $purchased_product_id,\r\n\t\t\t\t\t\t\t\t'entity_type' => 'node',\r\n\t\t\t\t\t\t\t);\r\n\t\t\t\t\t\t\tuserpoints_userpointsapi($params);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t\t\t//create disbursement record, if the user is getting any Merits\r\n\t\t\t\t\t\tif ($receipt_id > 0 && $merits > 0) {\r\n\t\t\t\t\t\t\tif (!function_exists('rovas_merit_source_for_project_share_reward')) {\r\n\t\t\t\t\t\t\t\tmodule_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t$merit_source = rovas_merit_source_for_project_share_reward($bundle, $hours);\r\n\t\t\t\t\t\t\t$disburs_id = rules_invoke_component('rules_create_merit_disbursement', $receipt_id, $userid, $merits, $merit_source);\r\n\t\t\t\t\t\t}\t\t\t\t\t\r\n\t\t\t\t}\r\n\t\t\t\t//processing project_merit_allocation shares\r\n\t\t\t\telse if($bundle == 'project_merit_allocation') {\r\n\t\t\t\t\t$shareprojectid = $meritalloc_wrp->field_shareholder_project->nid->value();\r\n\t\t\t\t\t$sh_project_wrp = entity_metadata_wrapper('node', $shareprojectid);\r\n\t\t\t\t\t$timeshare_project_alloc = $meritalloc_wrp->field_share_project_time->value();\r\n\r\n\t\t\t\t\t//do not process when the project shareholder nid is the same as the ordered project nid\r\n\t\t\t\t\t//this seems to be an useless/insufficient condition - refactor?\r\n\t\t\t\t\tif ($purchased_product_id != $shareprojectid) {\r\n\t\t\t\t\t\t//time share product\r\n\t\t\t\t\t\tif ($timeshare_project_alloc) {\r\n\r\n\t\t\t\t\t\t\t$hours = $meritalloc_wrp->field_total_hours_worked->value();\r\n\r\n\t\t\t\t\t\t\t//calculate the total time value of merit reward and add it to the share merit reward\r\n\t\t\t\t\t\t\tif($total_hours > 0) {\r\n\t\t\t\t\t\t\t\t$merits = ($tsdiff/100) * $amount_paid * ($hours/$total_hours);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\telse {\r\n\t\t\t\t\t\t\t\t$merits = 0;\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t//normal product\r\n\t\t\t\t\t\telse {\r\n\t\t\t\t\t\t\t//calculate the total value of merit reward\r\n\t\t\t\t\t\t\t$merits = ($share/100) * $amount_paid;\r\n\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t//Update the shareholder project merit score\r\n\t\t\t\t\t\t$calc_merit_val = project_merit_updater($shareprojectid,$merits);\r\n\t\t\t\t\t\t$meritalloc_wrp->field_merits_earned = $calc_merit_val;\r\n\t\t\t\t\t\t$meritalloc_wrp->save();\r\n\r\n\t\t\t\t\t\t//only process amounts greater than the smallest value the table can hold.\r\n\t\t\t\t\t\tif($merits > 0.0000000001) {\r\n\t\t\t\t\t\t\t$merit_share = $sh_project_wrp->field_reward_merit_allocation->value()/100;\r\n\r\n\t\t\t\t\t\t\t//subtract the chron share of the reward and process both parts\r\n\t\t\t\t\t\t\tif (!empty($merit_share) && $merit_share < 1) {\r\n\t\t\t\t\t\t\t\t$shareratio = $merit_share / 100;\r\n\t\t\t\t\t\t\t\t$new_merits = $shareratio * $merits;\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t//transfer a portion of the reward to the project beneficiary\r\n\t\t\t\t\t\t\t\t$chrons4bene = $merits - $new_merits;\r\n\t\r\n\t\t\t\t\t\t\t\t$benef_object = $sh_project_wrp->field_chron_beneficiary->value();\r\n\t\r\n\t\t\t\t\t\t\t\tif ($benef_object) {\r\n\t\t\t\t\t\t\t\t\t$beneficiary = $benef_object->uid;\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\telse {\r\n\t\t\t\t\t\t\t\t\t$beneficiary = $sh_project_wrp->author->value();\r\n\t\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\t\t$buyer = user_load($buyeruid);\r\n\t\t\t\t\t\t\t\t//transfer the chrons\r\n\t\t\t\t\t\t\t\trules_invoke_component('rules_make_money_transfer',$buyer,$beneficiary,$chrons4bene,$note,TRUE);\r\n\r\n\t\t\t\t\t\t\t\t//process the remaining merits\r\n\t\t\t\t\t\t\t\tmrewarder($shareprojectid,$new_merits,$buyeruid,$receipt_id,$note,$loopcheck);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\telse {\r\n\t\t\t\t\t\t\t\tmrewarder($shareprojectid,$merits,$buyeruid,$receipt_id,$note,$loopcheck);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\telse {\r\n//\t\t\t\t\t\t\twatchdog('rule','rules_process_purchase_core; the rules_process_purchase_core asked to store merit reward smaller than allowed by DB schema:' . $merits . ' ME | alloc node ID: ' . $shareprojectid);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\r\n\t\t\t}\r\n\r\n\t\treturn 'OK';\r\n\t\t//watchdog('debug','END' );\r\n\t\t}\r\n\t}\r\n}\r\n\r\nini_set('max_execution_time', 300);\r\n\r\nmrewarder($purchased_product_id,$amount_paid,$buyeruid,$receipt_id,$note);"
                }
              },
              {
                "data_set": {
                  "data": [
                    "p-receipt-id"
                  ],
                  "value": [
                    "receipt-id"
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "PROVIDES VARIABLES": [
      "p_receipt_id"
    ]
  }
