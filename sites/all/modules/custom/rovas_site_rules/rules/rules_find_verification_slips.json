      "nid" : { "label" : "work report nid", "type" : "integer" },
      "uid" : { "label" : "slip owner", "type" : "integer", "allow null" : true },
      "slips" : {
        "label" : "slips",
        "type" : "list\u003Cnode\u003E",
        "parameter" : false
      }
    },
    "DO" : [
      { "views_bulk_operations_action_load_list" : {
          "USING" : {
            "view" : "find_slot_for_verifiaction|default",
