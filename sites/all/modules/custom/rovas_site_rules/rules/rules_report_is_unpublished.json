{ "rules_report_is_unpublished" : {
    "LABEL" : "report is unpublished",
    "PLUGIN" : "reaction rule",
    "OWNER" : "rules",
    "REQUIRES" : [ "rules", "views_bulk_operations", "rules_conditional" ],
    "ON" : { "node_update--work_report" : { "bundle" : "work_report" } },
    "IF" : [
      { "data_is" : { "data" : [ "node-unchanged:status" ], "value" : "1" } },
      { "data_is" : { "data" : [ "node:status" ], "value" : "0" } },
      { "NOT data_is" : {
          "data" : [ "node-unchanged:field-verification-status" ],
          "op" : "IN",
          "value" : { "value" : { "1" : "1", "2" : "2" } }
        }
      }
    ],
    "DO" : [
      { "views_bulk_operations_action_load_list" : {
          "USING" : { "view" : "report_slots|default", "args" : "[node:nid]" },
          "PROVIDE" : { "entity_list" : { "report_slots" : "report slots" } }
        }
      },
      { "LOOP" : {
          "USING" : { "list" : [ "report-slots" ] },
          "ITEM" : { "slot" : "slot" },
          "DO" : [
            { "CONDITIONAL" : [
                {
                  "IF" : { "entity_is_of_bundle" : {
                      "entity" : [ "slot" ],
                      "type" : "node",
                      "bundle" : { "value" : { "verification_slot" : "verification_slot" } }
                    }
                  },
                  "DO" : [
                    { "drupal_message" : { "message" : "[slot:title] | [slot:nid]" } },
                    { "data_set" : { "data" : [ "slot:field-report-to-verify" ] } },
                    { "data_set" : { "data" : [ "slot:field-verify-date" ] } },
                    { "component_rules_send_email" : {
                        "recipient" : [ "slot:field-slip-owner:mail" ],
                        "subject" : "Rovas - request to verify was cancelled",
                        "message" : "The \u003Cstrong\u003E[node:title]\u003C\/strong\u003E report (ID = [node:nid]) you were asked to verify, was unpublished. Please disregard the request to verify this report, that was sent to you previously.",
                        "language" : [ "slot:field-slip-owner:language" ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
