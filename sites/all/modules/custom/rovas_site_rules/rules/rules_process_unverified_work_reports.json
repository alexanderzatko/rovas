{ "rules_process_unverified_work_reports" : {
    "LABEL" : "process unverified work reports",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "TAGS" : [ "work report" ],
    "REQUIRES" : [
      "php",
      "rules",
      "rules_data_transforms",
      "views_bulk_operations",
      "rules_conditional",
      "rules_scheduler"
    ],
    "DO" : [
      { "variable_add" : {
          "USING" : {
            "type" : "text",
            "value" : "\u003C?php \r\n\r\n\/\/find all unverified, for-verification unscheduled work reports\r\n$found = _find_unprocessed_reports();\r\n\r\necho implode(\u0027|\u0027,$found);\r\n?\u003E"
          },
          "PROVIDE" : { "variable_added" : { "reports" : "reports" } }
        }
      },
      { "explode" : {
          "USING" : { "input_text" : [ "reports" ], "delimiter" : "|" },
          "PROVIDE" : { "output_list" : { "reports_list" : "reports list" } }
        }
      },
      { "LOOP" : {
          "USING" : { "list" : [ "reports-list" ] },
          "ITEM" : { "cur_report" : "Current report" },
          "DO" : [
            { "data_convert" : {
                "USING" : { "type" : "integer", "value" : [ "cur-report" ] },
                "PROVIDE" : { "conversion_result" : { "current_report_nid" : "current report nid" } }
              }
            },
            { "views_bulk_operations_action_load_list" : {
                "USING" : { "view" : "report_slots|default", "args" : "[current-report-nid:value]" },
                "PROVIDE" : { "entity_list" : { "found_slots" : "found slots" } }
              }
            },
            { "entity_fetch" : {
                "USING" : { "type" : "node", "id" : [ "current-report-nid" ] },
                "PROVIDE" : { "entity_fetched" : { "report_fetched" : "Fetched report" } }
              }
            },
            { "component_rules_determine_verification_outcome" : {
                "USING" : { "wr_object" : [ "report-fetched" ] },
                "PROVIDE" : { "outcome" : { "outcome" : "outcome" }, "count" : { "count" : "count" } }
              }
            },
            { "variable_add" : {
                "USING" : {
                  "type" : "text",
                  "value" : "\u003C?php \r\n\/\/$countslots = filled request to verify\r\n\/\/$count = number of verifications\r\n\r\n$countslots = count($found_slots);\r\n\r\nif (((int)$countslots === 0 \u0026\u0026 (int)$count \u003E 0) || ((int)$countslots == 1 \u0026\u0026 (int)$count === 0)) {\r\n\t$extra = 0;\r\n\t$findverifier = 1;\r\n}\r\nelse if ((int)$countslots === 0 \u0026\u0026 (int)$count === 0) {\r\n\t$extra = 1;\r\n\t$findverifier = 1;\r\n}\r\nelse {\r\n\t$extra = 0;\r\n\t$findverifier = 0;\r\n}\r\n\r\necho $findverifier + $extra;\r\n\r\n?\u003E"
                },
                "PROVIDE" : { "variable_added" : { "find_verifier" : "find verifier" } }
              }
            },
            { "data_convert" : {
                "USING" : { "type" : "integer", "value" : [ "find-verifier" ] },
                "PROVIDE" : { "conversion_result" : { "find_verifier_int" : "find verifier integer" } }
              }
            },
            { "CONDITIONAL" : [
                {
                  "IF" : { "data_is" : { "data" : [ "find-verifier-int" ], "op" : "\u003E", "value" : "0" } },
                  "DO" : [
                    { "component_rules_find_verifier" : {
                        "USING" : { "wr_object" : [ "report-fetched" ] },
                        "PROVIDE" : { "verifier_found" : { "verifier_found" : "verifier found" } }
                      }
                    }
                  ]
                }
              ]
            },
            { "CONDITIONAL" : [
                {
                  "IF" : { "data_is" : { "data" : [ "find-verifier-int" ], "value" : "2" } },
                  "DO" : [
                    { "component_rules_find_verifier" : {
                        "USING" : { "wr_object" : [ "report-fetched" ] },
                        "PROVIDE" : { "verifier_found" : { "verifier_found2" : "verifier found 2" } }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      { "schedule" : {
          "component" : "rules_process_unverified_work_reports",
          "date" : "+1 day",
          "identifier" : "unverified_reports"
        }
      }
    ]
  }
}
