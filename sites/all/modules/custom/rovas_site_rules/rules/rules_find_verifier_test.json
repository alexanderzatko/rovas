{ "rules_find_verifier_test" : {
    "LABEL" : "Find verifier test",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "TAGS" : [ "verification", "work report" ],
    "REQUIRES" : [ "rules", "php", "rules_conditional", "rules_reldate" ],
    "USES VARIABLES" : {
      "wr_object" : { "label" : "work report", "type" : "node" },
      "verifier_found" : { "label" : "verifier found", "type" : "integer", "parameter" : false }
    },
    "IF" : [
      { "entity_is_of_bundle" : {
          "entity" : [ "wr-object" ],
          "type" : "node",
          "bundle" : { "value" : { "work_report" : "work_report" } }
        }
      },
      { "php_eval" : { "code" : "return TRUE;" } }
    ],
    "DO" : [
      { "variable_add" : {
          "USING" : {
            "type" : "text",
            "value" : "\u003C?php\r\n$verf_id = rovas_verify_find_verifier($wr_object-\u003Enid);\r\n\/\/watchdog(\u0027rule\u0027,\u0027rules_find_verifier 1 \u0027 . print_r($verf_id,1));\r\necho $verf_id;\r\n?\u003E"
          },
          "PROVIDE" : { "variable_added" : { "verifier_uid" : "verifier uid" } }
        }
      },
      { "data_convert" : {
          "USING" : { "type" : "integer", "value" : [ "verifier-uid" ] },
          "PROVIDE" : { "conversion_result" : { "verifier_uid_int" : "verifier uid int" } }
        }
      },
      { "CONDITIONAL" : [
          {
            "IF" : { "data_is" : { "data" : [ "verifier-uid-int" ], "op" : "\u003E", "value" : "0" } },
            "DO" : [
              { "entity_fetch" : {
                  "USING" : { "type" : "user", "id" : [ "verifier-uid-int" ] },
                  "PROVIDE" : { "entity_fetched" : { "verifier_object" : "verifier object" } }
                }
              },
              { "CONDITIONAL" : [
                  {
                    "IF" : { "data_is" : {
                        "data" : [ "verifier-object:field-verification-score" ],
                        "op" : "\u003C",
                        "value" : "0"
                      }
                    },
                    "DO" : [
                      { "rules_reldate_rules_action_calculate_relative_date" : {
                          "USING" : {
                            "date" : "now",
                            "offset" : "\u003C?php\r\n\t$cifra =  variable_get(\u0027rv_restrict_period\u0027) ? variable_get(\u0027rv_restrict_period\u0027) : 0;\r\n\techo \u0027+ \u0027 . $cifra . \u0027 hours\u0027;\r\n?\u003E\r\n"
                          },
                          "PROVIDE" : { "adjusted_date" : { "adjusted_date" : "Adjusted Date" } }
                        }
                      }
                    ]
                  },
                  { "ELSE" : [
                      { "rules_reldate_rules_action_calculate_relative_date" : {
                          "USING" : {
                            "date" : "now",
                            "offset" : "\u003C?php\r\n\t$cifra =  variable_get(\u0027rv_normal_period\u0027) ? variable_get(\u0027rv_normal_period\u0027) : 0;\r\n\techo \u0027+ \u0027 . $cifra . \u0027 hours\u0027;\r\n?\u003E\r\n"
                          },
                          "PROVIDE" : { "adjusted_date" : { "adjusted_date" : "Adjusted Date" } }
                        }
                      }
                    ]
                  }
                ]
              },
              { "variable_add" : {
                  "USING" : {
                    "type" : "text",
                    "value" : "\u003C?php \r\n\/\/find an available slot ID\r\n$slots = _find_user_verif_slots($verifier_uid);\r\necho isset($slots[0]) ? $slots[0] : 0;\r\n?\u003E"
                  },
                  "PROVIDE" : { "variable_added" : { "slot_id" : "slot ID" } }
                }
              },
              { "data_convert" : {
                  "USING" : { "type" : "integer", "value" : [ "slot-id" ] },
                  "PROVIDE" : { "conversion_result" : { "slot_id_int" : "slot ID int" } }
                }
              },
              { "drupal_watchdog" : {
                  "type" : "rule",
                  "message" : "debug info: verifier-found:value = [verifier-found:value] | verifier-uid:value = [verifier-uid:value] | deadline:value = [adjusted-date:value] | slot-id:value = [slot-id:value]\r\n\r\nrule \u0022rules_find_verifier_test\u0022",
                  "severity" : "6"
                }
              },
              { "CONDITIONAL" : [
                  {
                    "IF" : { "data_is" : { "data" : [ "slot-id-int" ], "op" : "\u003E", "value" : "0" } },
                    "DO" : [
                      { "entity_fetch" : {
                          "USING" : { "type" : "node", "id" : [ "slot-id-int" ], "revision_id" : "0" },
                          "PROVIDE" : { "entity_fetched" : { "slot_object" : "slot object" } }
                        }
                      },
                      { "component_rules_translate_node" : { "lang" : [ "verifier-object:language" ], "node" : [ "wr-object" ] } },
                      { "CONDITIONAL" : [
                          {
                            "IF" : { "entity_is_of_bundle" : {
                                "entity" : [ "slot-object" ],
                                "type" : "node",
                                "bundle" : { "value" : { "verification_slot" : "verification_slot" } }
                              }
                            },
                            "DO" : [
                              { "data_set" : {
                                  "data" : [ "slot-object:field-report-to-verify" ],
                                  "value" : [ "wr-object" ]
                                }
                              },
                              { "data_set" : {
                                  "data" : [ "slot-object:field-verify-date" ],
                                  "value" : [ "adjusted-date" ]
                                }
                              },
                              { "entity_save" : { "data" : [ "slot-object" ], "immediate" : "1" } }
                            ]
                          }
                        ]
                      },
                      { "variable_add" : {
                          "USING" : {
                            "type" : "text",
                            "value" : "\u003C?php\r\n\r\n$report = entity_metadata_wrapper(\u0027node\u0027, $wr_object);\r\n$ex_node = $report-\u003Efield_web_address-\u003Evalue();\r\n$ex_token = $report-\u003Efield_content_access_token-\u003Evalue();\r\n\r\nif (count($ex_node) == 1) {\r\n\t$web = $ex_node[0];\r\n\t$septyp = strpos($web, \u0027?\u0027);\r\n\t$doubles = strpos($web, \u0027\u0022\u0027);\r\n\r\n\tif ($septyp) {\r\n\t\t$separator = \u0027\u0026\u0027;\r\n\t}\r\n\telse {\r\n\t\t$separator = \u0027?\u0027;\r\n\t}\r\n\r\n$quotsrc = array(\u0027[\u0027,\u0022]\u0022,\u0027{\u0027,\u0022}\u0022,\u0027\u0022\u0027,\u0022\u0027\u0022);\r\n$quotrepl = array(\u0027%5B\u0027,\u0027%5D\u0027,\u0027%7B\u0027,\u0027%7D\u0027,\u0027%22\u0027,\u0027%27\u0027);\r\n\t\r\n\tif ($doubles) {\r\n\t\r\n\t\t$url = $web . $separator . \u0022cbt=\u0022 . $ex_token . \u0022\u0026vrfier=\u0022 . $verifier_uid_int;\r\n\t\t$ary = explode(\u0027?\u0027,$url);\r\n\t\t$encoded = str_replace($quotsrc,$quotrepl,$ary[1]);\r\n\t\t$url = $ary[0] . \u0027?\u0027 . $encoded;\r\n\r\n\t\t$link = $url;\r\n\t}\r\n\telse {\r\n\t\t$url = $web . $separator . \u0027cbt=\u0027 . $ex_token . \u0027\u0026vrfier=\u0027 . $verifier_uid_int;\r\n\t\t$ary = explode(\u0027?\u0027,$url);\r\n\t\t$encoded = str_replace($quotsrc,$quotrepl,$ary[1]);\r\n\t\t$url = $ary[0] . \u0027?\u0027 . $encoded;\r\n\r\n\t\t$link = $url;\r\n\t}\r\n}\r\nelse {\r\n\t$link = \u0027\u0027;\r\n}\r\necho $link;\r\n?\u003E"
                          },
                          "PROVIDE" : { "variable_added" : { "proof_url" : "proof url" } }
                        }
                      },
                      { "CONDITIONAL" : [
                          {
                            "IF" : { "data_is_empty" : { "data" : [ "proof-url" ] } },
                            "DO" : [
                              { "mail" : {
                                  "to" : "orders.az@gmail.com",
                                  "subject" : "Rovas verification request",
                                  "message" : "You have been chosen to verify work report \u003Cstrong\u003E[wr-object:title]\u003C\/strong\u003E filed by \u003Ca href=\u0022[site:url]user\/[wr-object:author:uid]\u0022\u003E[wr-object:author]\u003C\/a\u003E.\r\n\r\nYou can \u003Ca href=\u0022[wr-object:url]\u0022\u003Everify the report in Rovas\u003C\/a\u003E.\r\n\r\nThe deadline to verify the report is [adjusted-date:value], please do so, as soon as possible.\r\nAccording to \u003Ca href=\u0022[site:url]rules\u0022\u003ENEO rules\u003C\/a\u003E, verification of other users\u0027 work reports is mandatory for all users who file their own work reports.",
                                  "language" : [ "verifier-object:language" ]
                                }
                              }
                            ]
                          },
                          { "ELSE" : [
                              { "mail" : {
                                  "to" : "orders.az@gmail.com",
                                  "subject" : "Rovas verification request",
                                  "message" : "You have been chosen to verify work report \u003Cstrong\u003E[wr-object:title]\u003C\/strong\u003E filed by \u003Ca href=\u0022[site:url]user\/[wr-object:author:uid]\u0022\u003E[wr-object:author]\u003C\/a\u003E.\r\n\r\nYou can see (and possibly also verify) the report proof of work on \u003Ca href=\u0027[proof-url:value]\u0027\u003Ethis address\u003C\/a\u003E. The report can be verified also in \u003Ca href=\u0027[wr-object:url]\u0027\u003ERovas\u003C\/a\u003E.\r\n\r\nTo log into Rovas, click the appropriate icon in the login block:\r\n\u003Cimg src=\u0022\/sites\/default\/files\/pictures\/services_icons.jpg\u0022 \/\u003E\r\n\r\nThe deadline to verify the report is [adjusted-date:value], please do so, as soon as possible.\r\nAccording to \u003Ca href=\u0022[site:url]rules\u0022\u003ENEO rules\u003C\/a\u003E, verification of other users\u0027 work reports is mandatory for all users who file their own work reports.",
                                  "language" : [ "verifier-object:language" ]
                                }
                              }
                            ]
                          }
                        ]
                      },
                      { "data_set" : { "data" : [ "verifier-found" ], "value" : [ "verifier-uid-int" ] } }
                    ]
                  },
                  { "ELSE" : [
                      { "data_set" : { "data" : [ "verifier-found" ], "value" : "0" } },
                      { "drupal_watchdog" : {
                          "type" : "rule",
                          "message" : "No verifier was found to verify report \u003Ca href=\u0022[wr-object:url]\u0022\u003E[wr-object:title]\u003C\/a\u003E\r\nrule \u0022rules_find_verifier\u0022",
                          "severity" : "6"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          { "ELSE" : [ { "data_set" : { "data" : [ "verifier-found" ] } } ] }
        ]
      }
    ],
    "PROVIDES VARIABLES" : [ "verifier_found" ]
  }
}
