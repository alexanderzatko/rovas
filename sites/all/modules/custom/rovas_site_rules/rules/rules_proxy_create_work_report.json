                                                  "USING" : {
                                                    "type" : "text",
                                                    "value" : "\u003C?php\r\nif (strpos($merge_function,\u0027http\u0027) === 0) {\r\n\techo \u0027http\u0027;\r\n}\r\nelse if (function_exists($merge_function)) {\r\n\techo \u0027function\u0027;\r\n}\r\nelse {\r\n\techo NULL;\r\n}\r\n?\u003E"
