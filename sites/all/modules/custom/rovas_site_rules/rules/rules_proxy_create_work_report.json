                                                          "data" : [ "work-reports:0:field-web-address" ],
                                                          "value" : [ "web-sites" ]
                                                        }
                                                      },
                                                      { "variable_add" : {
                                                          "USING" : {
                                                            "type" : "text",
                                                            "value" : "\u003C?php \r\n$lang = $work_reports[0]-\u003Elanguage;\r\n$counter = count($web_sites);\r\n$old_body = $work_reports[0]-\u003Ebody[$lang][0][\u0027value\u0027];\r\n\r\n$time = $wr_hours;\r\n\r\n$hours = floor($time);\r\n$hours_formated = $hours ? $hours . \u0027 \u0027 . t(\u0027hrs\u0027) : \u0027\u0027;\r\n$minutes = ($time - $hours) * 60;\r\n$minutes_formated = $minutes ? round($minutes,0) . \u0027 \u0027 . t(\u0027min\u0027) : \u0027\u0027;\r\n$comma = !empty($hours_formated) \u0026\u0026 !empty($minutes_formated) ? \u0027 \u0027 : \u0027\u0027;\r\n\r\nif ($counter == 2) {\r\n\techo t(\u0027This is a work report for multiple sessions. The descriptions and times reported in them are shown below.\u0027);\r\n\techo \u0027\r\n\r\n\t\u0027;\r\n\techo t(\u0027Session No.\u0027) . \u0027 1\u0027;\r\n\techo \u0027\r\n\t\u0027;\r\n}\r\necho $old_body;\r\necho \u0027\r\n\r\n\u0027;\r\necho t(\u0027Session No.\u0027) . \u0027 \u0027 . $counter . \u0027 (\u0027 . $hours_formated . $comma . $minutes_formated . \u0027)\u0027 ;\r\necho \u0027\r\n\u0027;\r\necho $wr_description;\r\n?\u003E"
                                                          },
                                                          "PROVIDE" : { "variable_added" : { "new_body" : "new body" } }
                                                        }
                                                      },
                                                      { "data_set" : { "data" : [ "work-reports:0:body:value" ], "value" : [ "new-body" ] } }
                                                    ]
                                                  }
                                                ]
