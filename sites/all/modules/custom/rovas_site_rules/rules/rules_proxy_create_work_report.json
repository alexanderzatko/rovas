                                          { "ELSE" : [ { "data_set" : { "data" : [ "created-wr-nid" ], "value" : "-4" } } ] }
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              },
                              { "php_eval" : { "code" : "if (function_exists(\u0027rovas_repmerger_same_day_lock_release\u0027)) {\r\n  rovas_repmerger_same_day_lock_release((int) $user-\u003Euid, (int) $parent_project_nid, $tstamp, (int) $wr_classification);\r\n}" } }
                            ]
                          },
                          { "ELSE" : [
                              { "data_set" : { "data" : [ "created-wr-nid" ], "value" : "-5" } }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  { "ELSE" : [
                      { "component_rules_create_work_report" : {
                          "USING" : {
                            "wr_activity_name" : [ "wr_activity_name" ],
                            "wr_web_address" : [ "wr_web_address" ],
                            "wr_hours" : [ "wr_hours" ],
                            "parent_project" : [ "parent-project" ],
                            "wr_description" : [ "wr_description" ],
                            "verif_sources" : { "value" : [ "1" ] },
                            "systemreport" : "0",
                            "verificationstatus" : "0",
                            "access_token" : [ "access_token" ],
                            "language" : [ "user:language" ],
                            "date_started" : [ "calc-date" ],
                            "publish_status" : [ "publish_status" ],
                            "author" : [ "user" ],
                            "wr_classification" : [ "term-fetched" ]
                          },
                          "PROVIDE" : {
                            "result" : { "result" : "result" },
                            "created_wr" : { "created_wr" : "Created WR" }
                          }
                        }
                      },
                      { "data_set" : { "data" : [ "created-wr-nid" ], "value" : [ "created-wr:nid" ] } },
                      { "CONDITIONAL" : [
                          {
                            "IF" : { "data_is" : { "data" : [ "result" ], "value" : "-2" } },
                            "DO" : [ { "data_set" : { "data" : [ "created-wr-nid" ], "value" : "-3" } } ]
                          },
                          {
                            "ELSE IF" : { "data_is" : { "data" : [ "result" ], "value" : "-3" } },
                            "DO" : [ { "data_set" : { "data" : [ "created-wr-nid" ], "value" : "-2" } } ]
                          },
