      { "php_eval" : { "code" : "if (!empty($created_wr_nid) && (int) $created_wr_nid > 0 && !empty($user->uid)) {\n  module_load_include('inc', 'rovas_civic', 'rovas_civic.reward');\n  if (function_exists('rovas_civic_persist_wr_reward_preference')) {\n    $kind = isset($reward_kind) ? $reward_kind : 'chrons';\n    rovas_civic_persist_wr_reward_preference((int) $created_wr_nid, (int) $user->uid, $kind);\n  }\n}" } }
    ],
