                                                    "DO" : [
                                                      { "variable_add" : {
                                                          "USING" : {
                                                            "type" : "text",
                                                            "value" : "\u003C?php\r\n\/\/an actual implementation will be here usingon the drupal_http_request function\r\n?\u003E"
                                                          },
                                                          "PROVIDE" : { "variable_added" : { "variable_added" : "Added variable" } }
                                                        }
                                                      }
                                                    ]
                                                  },
