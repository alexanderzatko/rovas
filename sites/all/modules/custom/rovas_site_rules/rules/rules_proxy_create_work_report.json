                                    "ELSE IF" : { "php_eval" : { "code" : "return empty($work_reports[0]) || !function_exists(\u0027rovas_repmerger_wr_is_mergeable\u0027) || !rovas_repmerger_wr_is_mergeable($work_reports[0]);" } },
                                    "DO" : [
