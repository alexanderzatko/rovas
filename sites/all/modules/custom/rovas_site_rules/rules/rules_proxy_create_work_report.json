                                                  "data" : [ "work-reports:0:field-hours-worked" ],
                                                  "value" : [ "updated-time" ]
                                                }
                                              },
                                              { "php_eval" : { "code" : "if (!empty($work_reports[0]) \u0026\u0026 function_exists(\u0027rovas_repmerger_sync_auto_approved_chrons\u0027)) {\r\n  rovas_repmerger_sync_auto_approved_chrons($work_reports[0]);\r\n}" } },
                                              { "data_set" : { "data" : [ "created-wr-nid" ], "value" : [ "work-reports:0:nid" ] } },
                                              { "data_set" : {
                                                  "data" : [ "work-reports:0:field-content-access-token" ],
                                                  "value" : [ "access-token" ]
                                                }
                                              }
                                            ]
