{ "rules_create_merit_purchase_record" : {
    "LABEL" : "Create Merit purchase record",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "REQUIRES" : [ "rules" ],
    "USES VARIABLES" : {
      "buyer" : { "label" : "Buyer", "type" : "user" },
      "amount_paid" : { "label" : "Amount paid", "type" : "decimal" },
      "note" : { "label" : "Note", "type" : "text" },
      "nid" : { "label" : "Node ID", "type" : "integer", "parameter" : false }
    },
    "IF" : [
      { "NOT data_is_empty" : { "data" : [ "buyer" ] } },
      { "data_is" : { "data" : [ "amount-paid" ], "op" : "\u003E", "value" : "0" } }
    ],
    "DO" : [
      { "entity_create" : {
          "USING" : {
            "type" : "node",
            "param_type" : "purchase_merits",
            "param_title" : "temp",
            "param_author" : [ "buyer" ]
          },
          "PROVIDE" : { "entity_created" : { "merit_purchase" : "Merit purchase" } }
        }
      },
      { "entity_modify" : {
          "entity" : [ "merit-purchase" ],
          "properties" : { "value" : {
              "field_buyer" : "field_buyer",
              "field_note" : "field_note",
              "field_amount_paid" : "field_amount_paid",
              "language" : "language"
            }
          },
          "param_field_buyer" : [ "buyer" ],
          "param_field_amount_paid" : [ "amount-paid" ],
          "param_field_note" : [ "note" ],
          "param_language" : [ "buyer:language" ]
        }
      },
      { "entity_save" : { "data" : [ "merit-purchase" ], "immediate" : "1" } },
      { "data_set" : { "data" : [ "nid" ], "value" : [ "merit-purchase:nid" ] } }
    ],
    "PROVIDES VARIABLES" : [ "nid" ]
  }
}
