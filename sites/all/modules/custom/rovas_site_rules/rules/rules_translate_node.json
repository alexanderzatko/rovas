{ "rules_translate_node" : {
    "LABEL" : "translate node",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "REQUIRES" : [ "rules", "php", "rules_conditional" ],
    "USES VARIABLES" : {
      "lang" : { "label" : "target language", "type" : "text" },
      "node" : { "label" : "node", "type" : "node" }
    },
    "IF" : [
      { "entity_is_of_bundle" : {
          "entity" : [ "node" ],
          "type" : "node",
          "bundle" : { "value" : { "project" : "project", "work_report" : "work_report", "page" : "page" } }
        }
      },
      { "NOT data_is" : { "data" : [ "node:language" ], "value" : "und" } },
      { "NOT text_matches" : { "text" : [ "node:language" ], "match" : [ "lang" ] } },
      { "php_eval" : { "code" : "$_tv = isset($node-\u003Etitle_field[$lang][0][\u0027value\u0027]) ? trim($node-\u003Etitle_field[$lang][0][\u0027value\u0027]) : \u0027\u0027;\r\n$_bv = isset($node-\u003Ebody[$lang][0][\u0027value\u0027]) ? trim($node-\u003Ebody[$lang][0][\u0027value\u0027]) : \u0027\u0027;\r\nreturn $_tv === \u0027\u0027 || $_bv === \u0027\u0027;" } }
    ],
    "DO" : [
      { "variable_add" : {
          "USING" : { "type" : "text", "value" : [ "node:language" ] },
          "PROVIDE" : { "variable_added" : { "node_lang" : "node language" } }
        }
      },
      { "variable_add" : {
          "USING" : { "type" : "text", "value" : [ "site:current-user:language" ] },
          "PROVIDE" : { "variable_added" : { "user_lang" : "user language" } }
        }
      },
      { "variable_add" : {
          "USING" : {
            "type" : "text",
            "value" : "\u003C?php\r\n$_tv = isset($node-\u003Etitle_field[$lang][0][\u0027value\u0027]) ? trim($node-\u003Etitle_field[$lang][0][\u0027value\u0027]) : \u0027\u0027;\r\n$_bv = isset($node-\u003Ebody[$lang][0][\u0027value\u0027]) ? trim($node-\u003Ebody[$lang][0][\u0027value\u0027]) : \u0027\u0027;\r\necho ($_tv !== \u0027\u0027 \u0026\u0026 $_bv !== \u0027\u0027) ? \u00271\u0027 : \u00270\u0027;\r\n?\u003E"
          },
          "PROVIDE" : { "variable_added" : { "translation_exists" : "exist translation for user" } }
        }
      },
      { "CONDITIONAL" : [
          {
            "IF" : { "data_is" : { "data" : [ "translation-exists" ], "value" : "0" } },
            "DO" : [
              { "variable_add" : {
                  "USING" : {
                    "type" : "text",
                    "value" : "\u003C?php\r\n$_nt = isset($node-\u003Etitle_field[$lang][0][\u0027value\u0027]) ? trim($node-\u003Etitle_field[$lang][0][\u0027value\u0027]) : \u0027\u0027;\r\necho ($_nt === \u0027\u0027) ? \u00271\u0027 : \u00270\u0027;\r\n?\u003E"
                  },
                  "PROVIDE" : { "variable_added" : { "need_title_trans" : "Need title translation" } }
                }
              },
              { "variable_add" : {
                  "USING" : {
                    "type" : "text",
                    "value" : "\u003C?php\r\n$_nb = isset($node-\u003Ebody[$lang][0][\u0027value\u0027]) ? trim($node-\u003Ebody[$lang][0][\u0027value\u0027]) : \u0027\u0027;\r\necho ($_nb === \u0027\u0027) ? \u00271\u0027 : \u00270\u0027;\r\n?\u003E"
                  },
                  "PROVIDE" : { "variable_added" : { "need_body_trans" : "Need body translation" } }
                }
              },
              { "variable_add" : {
                  "USING" : {
                    "type" : "text",
                    "value" : "\u003C?php\r\n$order = array(\u0027sk\u0027, \u0027en\u0027, \u0027und\u0027);\r\nforeach ($order as $lc) {\r\n  $k = ($lc === \u0027und\u0027) ? LANGUAGE_NONE : $lc;\r\n  if (!empty($node-\u003Etitle_field[$k][0][\u0027value\u0027])) {\r\n    echo $node-\u003Etitle_field[$k][0][\u0027value\u0027];\r\n    return;\r\n  }\r\n}\r\necho \u0027\u0027;\r\n?\u003E"
                  },
                  "PROVIDE" : { "variable_added" : { "title" : "title" } }
                }
              },
              { "variable_add" : {
                  "USING" : {
                    "type" : "text",
                    "value" : "\u003C?php\r\n$order = array(\u0027sk\u0027, \u0027en\u0027, \u0027und\u0027);\r\nforeach ($order as $lc) {\r\n  $k = ($lc === \u0027und\u0027) ? LANGUAGE_NONE : $lc;\r\n  if (!empty($node-\u003Ebody[$k][0][\u0027value\u0027])) {\r\n    echo $node-\u003Ebody[$k][0][\u0027value\u0027];\r\n    return;\r\n  }\r\n}\r\necho \u0027\u0027;\r\n?\u003E"
                  },
                  "PROVIDE" : { "variable_added" : { "body_check" : "body check" } }
                }
              },
              { "variable_add" : {
                  "USING" : {
                    "type" : "text",
                    "value" : "\u003C?php\r\n$order = array(\u0027sk\u0027, \u0027en\u0027, \u0027und\u0027);\r\nforeach ($order as $lc) {\r\n  $k = ($lc === \u0027und\u0027) ? LANGUAGE_NONE : $lc;\r\n  if (!empty($node-\u003Etitle_field[$k][0][\u0027value\u0027])) {\r\n    echo $lc;\r\n    return;\r\n  }\r\n}\r\necho \u0027\u0027;\r\n?\u003E"
                  },
                  "PROVIDE" : { "variable_added" : { "title_src_lang" : "Title source language" } }
                }
              },
              { "variable_add" : {
                  "USING" : {
                    "type" : "text",
                    "value" : "\u003C?php\r\n$order = array(\u0027sk\u0027, \u0027en\u0027, \u0027und\u0027);\r\nforeach ($order as $lc) {\r\n  $k = ($lc === \u0027und\u0027) ? LANGUAGE_NONE : $lc;\r\n  if (!empty($node-\u003Ebody[$k][0][\u0027value\u0027])) {\r\n    echo $lc;\r\n    return;\r\n  }\r\n}\r\necho \u0027\u0027;\r\n?\u003E"
                  },
                  "PROVIDE" : { "variable_added" : { "body_src_lang" : "Body source language" } }
                }
              },
              { "variable_add" : {
                  "USING" : {
                    "type" : "text",
                    "value" : "\u003C?php\r\nif (empty($body_src_lang) || $body_src_lang === \u0027und\u0027) {\r\n  echo \u0027xx\u0027;\r\n}\r\nelse {\r\n  echo $body_src_lang;\r\n}\r\n?\u003E"
                  },
                  "PROVIDE" : { "variable_added" : { "body_google_from" : "Body Google from code" } }
                }
              },
              { "variable_add" : {
                  "USING" : {
                    "type" : "text",
                    "value" : "\u003C?php\r\nif (empty($title_src_lang) || $title_src_lang === \u0027und\u0027) {\r\n  echo \u0027xx\u0027;\r\n}\r\nelse {\r\n  echo $title_src_lang;\r\n}\r\n?\u003E"
                  },
                  "PROVIDE" : { "variable_added" : { "title_google_from" : "Title Google from code" } }
                }
              },
              { "CONDITIONAL" : [
                  {
                    "IF" : { "data_is" : { "data" : [ "need-body-trans" ], "value" : "1" } },
                    "DO" : [
                      { "CONDITIONAL" : [
                          {
                            "IF" : { "data_is_empty" : { "data" : [ "body-check" ] } },
                            "DO" : [
                              { "variable_add" : {
                                  "USING" : { "type" : "text" },
                                  "PROVIDE" : { "variable_added" : { "new_body" : "new body" } }
                                }
                              }
                            ]
                          },
                          { "ELSE" : [
                              { "variable_add" : {
                                  "USING" : {
                                    "type" : "text",
                                    "value" : "\u003C?php\r\n$qry = \u0022SELECT f.body_value AS new_body\r\nFROM {field_data_body} s\r\nLEFT JOIN {field_data_body} f ON s.entity_id = f.entity_id\r\nWHERE s.body_value = :intext\r\nAND s.language = :lang\r\nAND f.language = :outlang\r\nLIMIT 1\u0022;\r\n\r\n$result =  db_query($qry,array(\u0027:intext\u0027 =\u003E $body_check, \u0027:lang\u0027 =\u003E $body_src_lang, \u0027:outlang\u0027 =\u003E $lang));\r\n$resarray = $result-\u003EfetchAll();\r\n\r\necho empty($resarray) ? \u0027\u0027 : $resarray[0]-\u003Enew_body;\r\n?\u003E"
