{ "rules_erase_merits_in_punishment" : {
    "LABEL" : "Erase Merits in punishment",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "TAGS" : [ "dispute" ],
    "REQUIRES" : [ "rules", "rules_conditional", "userpoints_rules" ],
    "USES VARIABLES" : {
      "reason" : { "label" : "reason", "type" : "text" },
      "dispute" : { "label" : "dispute node", "type" : "node" },
      "amount" : { "label" : "merit amount", "type" : "integer" }
    },
    "IF" : [
      { "entity_is_of_bundle" : {
          "entity" : [ "dispute" ],
          "type" : "node",
          "bundle" : { "value" : { "dispute" : "dispute" } }
        }
      }
    ],
    "DO" : [
      { "CONDITIONAL" : [
          {
            "IF" : { "data_is" : { "data" : [ "amount" ], "op" : "\u003E", "value" : "0" } },
            "DO" : [
              { "data_calc" : {
                  "USING" : { "input_1" : [ "amount" ], "op" : "*", "input_2" : "-1" },
                  "PROVIDE" : { "result" : { "negative_amount" : "negative amount" } }
                }
              }
            ]
          },
          { "ELSE" : [
              { "variable_add" : {
                  "USING" : { "type" : "integer", "value" : [ "amount" ] },
                  "PROVIDE" : { "variable_added" : { "negative_amount" : "negative amount" } }
                }
              }
            ]
          }
        ]
      },
      { "entity_create" : {
          "USING" : {
            "type" : "node",
            "param_type" : "merit_penalty",
            "param_title" : "temp",
            "param_author" : "1"
          },
          "PROVIDE" : { "entity_created" : { "merit_penalty" : "merit penalty" } }
        }
      },
      { "data_set" : {
          "data" : [ "merit-penalty:field-reward-recipient" ],
          "value" : [ "dispute:field-accused" ]
        }
      },
      { "data_set" : {
          "data" : [ "merit-penalty:field-reward-amount" ],
          "value" : [ "negative-amount" ]
        }
      },
      { "data_set" : {
          "data" : [ "merit-penalty:body:value" ],
          "value" : "Penalty for failing to rectify a dispute \u003Ca href=\u0022[dispute:url]\u0022\u003E[dispute:title]\u003C\/a\u003E"
        }
      },
      { "userpoints_action_grant_points" : {
          "user" : [ "dispute:field-accused" ],
          "points" : [ "negative-amount" ],
          "tid" : "0",
          "entity" : [ "dispute" ],
          "description" : "[reason:value]",
          "operation" : "Remove",
          "display" : "0",
          "moderate" : "approved"
        }
      }
    ]
  }
}
