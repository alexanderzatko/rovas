{ "rules_proxy_delete_project" : {
    "LABEL" : "proxy - delete project",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "TAGS" : [ "api", "project" ],
    "REQUIRES" : [ "rules", "rules_conditional" ],
    "USES VARIABLES" : {
      "project_id" : { "label" : "project ID", "type" : "integer" },
      "result" : { "label" : "result", "type" : "boolean", "parameter" : false },
      "result_explain" : {
        "label" : "result explanation",
        "type" : "integer",
        "parameter" : false
      }
    },
    "DO" : [
      { "component_rules_retrieve_user_id_from_api_key_and_token" : { "USING" : {}, "PROVIDE" : { "uid" : { "uid" : "user id" } } } },
      { "entity_fetch" : {
          "USING" : { "type" : "user", "id" : [ "uid" ] },
          "PROVIDE" : { "entity_fetched" : { "found_user" : "found user" } }
        }
      },
      { "entity_fetch" : {
          "USING" : { "type" : "node", "id" : [ "project-id" ] },
          "PROVIDE" : { "entity_fetched" : { "found_project" : "found project" } }
        }
      },
      { "CONDITIONAL" : [
          {
            "IF" : { "entity_is_of_bundle" : {
                "entity" : [ "found-project" ],
                "type" : "node",
                "bundle" : { "value" : { "project" : "project" } }
              }
            },
            "DO" : [
              { "CONDITIONAL" : [
                  {
                    "IF" : { "component_rules_delete_project_permissive" : {
                        "user_checked" : [ "found-user" ],
                        "node_checked" : [ "found-project" ]
                      }
                    },
                    "DO" : [
                      { "component_rules_delete_project" : { "project_node" : [ "found-project" ], "triggering_actor" : "REST api" } },
                      { "data_set" : { "data" : [ "result" ], "value" : "1" } },
                      { "data_set" : { "data" : [ "result-explain" ], "value" : "0" } }
                    ]
                  },
                  { "ELSE" : [
                      { "data_set" : { "data" : [ "result" ], "value" : "0" } },
                      { "data_set" : { "data" : [ "result-explain" ], "value" : "1" } }
                    ]
                  }
                ]
              }
            ]
          },
          { "ELSE" : [
              { "data_set" : { "data" : [ "result" ], "value" : "0" } },
              { "data_set" : { "data" : [ "result-explain" ], "value" : "2" } }
            ]
          }
        ]
      }
    ],
    "PROVIDES VARIABLES" : [ "result", "result_explain" ]
  }
}
