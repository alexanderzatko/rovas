{ "rules_process_unverified_work_reports_test" : {
    "LABEL" : "process unverified work reports test",
    "PLUGIN" : "rule",
    "OWNER" : "rules",
    "TAGS" : [ "work report" ],
    "REQUIRES" : [
      "php",
      "rules",
      "rules_data_transforms",
      "views_bulk_operations",
      "rules_conditional",
      "rules_scheduler"
    ],
    "DO" : [
      { "variable_add" : {
          "USING" : {
            "type" : "text",
            "value" : "\u003C?php \r\n\r\n\/\/find all unverified, for-verification unscheduled work reports\r\n$found = _find_unprocessed_reports();\r\n\r\necho implode(\u0027|\u0027,$found);\r\n?\u003E"
          },
          "PROVIDE" : { "variable_added" : { "reports" : "reports" } }
        }
      },
      { "explode" : {
          "USING" : { "input_text" : [ "reports" ], "delimiter" : "|" },
          "PROVIDE" : { "output_list" : { "reports_list" : "reports list" } }
        }
      },
      { "drupal_message" : { "message" : "[reports:value]" } },
      { "LOOP" : {
          "USING" : { "list" : [ "reports-list" ] },
          "ITEM" : { "cur_report" : "Current report" },
          "DO" : [
            { "data_convert" : {
                "USING" : { "type" : "integer", "value" : [ "cur-report" ] },
                "PROVIDE" : { "conversion_result" : { "current_report_nid" : "current report nid" } }
              }
            },
            { "views_bulk_operations_action_load_list" : {
                "USING" : { "view" : "report_slots|default", "args" : "[current-report-nid:value]" },
                "PROVIDE" : { "entity_list" : { "found_slots" : "found slots" } }
              }
            },
            { "entity_fetch" : {
                "USING" : { "type" : "node", "id" : [ "current-report-nid" ] },
                "PROVIDE" : { "entity_fetched" : { "report_fetched" : "Fetched report" } }
              }
            },
            { "component_rules_determine_verification_outcome" : {
                "USING" : { "wr_object" : [ "report-fetched" ] },
                "PROVIDE" : { "outcome" : { "outcome" : "outcome" }, "count" : { "count" : "count" } }
              }
            },
            { "variable_add" : {
                "USING" : {
                  "type" : "text",
                  "value" : "\u003C?php \r\n\r\n$countslots = count($found_slots);\r\n\r\nif ($countslots == 0 || ($countslots == 1 \u0026\u0026 $count === 0)) {\r\n\t$findverifier = 1;\r\n}\r\nelse {\r\n\t$findverifier = 0;\r\n}\r\n\r\necho $findverifier;\r\n\r\n?\u003E"
                },
                "PROVIDE" : { "variable_added" : { "find_verifier" : "find verifier" } }
              }
            },
            { "CONDITIONAL" : [
                {
                  "IF" : { "data_is" : { "data" : [ "find-verifier" ], "value" : "1" } },
                  "DO" : [
                    { "drupal_message" : { "message" : "report 1 [current-report-nid:value] [report-fetched:title]; outcome [outcome:value]; count [count:value]; condition result [find-verifier:value]" } }
                  ]
                }
              ]
            },
            { "CONDITIONAL" : [
                {
                  "IF" : { "data_is" : { "data" : [ "count" ], "value" : "0" } },
                  "DO" : [
                    { "drupal_message" : { "message" : "report 2 [current-report-nid:value] [report-fetched:title]; outcome [outcome:value]; count [count:value]; condition result [find-verifier:value]" } }
                  ]
                }
              ]
            }
          ]
        }
      },
      { "schedule" : {
          "component" : "rules_process_unverified_work_reports",
          "date" : "+1 day",
          "identifier" : "unverified_reports"
        }
      }
    ]
  }
}
