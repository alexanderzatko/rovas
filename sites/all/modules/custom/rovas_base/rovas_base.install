<?php

/**
 * Implements hook_schema().
 */
function rovas_base_schema() {
  $schema['rovas_translation_freshness'] = array(
    'description' => 'Stores source hashes used for generated node translations.',
    'fields' => array(
      'nid' => array(
        'description' => 'Node ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'target_lang' => array(
        'description' => 'Target translation language code.',
        'type' => 'varchar',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
      ),
      'field_name' => array(
        'description' => 'Translated field machine name.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ),
      'source_lang' => array(
        'description' => 'Source language used for this translation snapshot.',
        'type' => 'varchar',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
      ),
      'source_hash' => array(
        'description' => 'Hash of canonical source text (SHA-256).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ),
      'changed' => array(
        'description' => 'Unix timestamp of the latest hash update.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('nid', 'target_lang', 'field_name'),
    'indexes' => array(
      'nid_lang' => array('nid', 'target_lang'),
    ),
  );

  return $schema;
}

/**
 * Create translation freshness table for existing installs.
 */
function rovas_base_update_7001() {
  if (!db_table_exists('rovas_translation_freshness')) {
    $schema = drupal_get_schema_unprocessed('rovas_base', 'rovas_translation_freshness');
    db_create_table('rovas_translation_freshness', $schema);
  }
}

/**
 * Fix entity_translation rows with empty source (breaks /node/N/translate overview).
 */
function rovas_base_update_7002() {
  if (!db_table_exists('entity_translation')) {
    return;
  }
  $broken = db_select('entity_translation', 'et')
    ->fields('et', array('entity_id', 'language'))
    ->condition('entity_type', 'node')
    ->condition('source', '')
    ->execute();
  foreach ($broken as $row) {
    $node = node_load($row->entity_id);
    if (!$node || !function_exists('entity_translation_enabled') || !entity_translation_enabled('node', $node)) {
      continue;
    }
    $handler = entity_translation_get_handler('node', $node, TRUE);
    $tr = $handler->getTranslations();
    $orig = !empty($tr->original) ? $tr->original : $node->language;
    $orig = drupal_strtolower(trim((string) $orig));
    if ($orig === '') {
      $orig = 'en';
    }
    db_update('entity_translation')
      ->fields(array('source' => $orig))
      ->condition('entity_type', 'node')
      ->condition('entity_id', $row->entity_id)
      ->condition('language', $row->language)
      ->condition('source', '')
      ->execute();
  }
}
