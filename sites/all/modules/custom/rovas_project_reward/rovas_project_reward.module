}

/**
 * Implements hook_rules_action_info().
 */
function rovas_project_reward_rules_action_info() {
  return array(
    'project_merit_updater' => array(
      'label' => t('Update project merits'),
      'group' => t('Rovas'),
      'parameter' => array(
        'node' => array(
          'type' => 'node', 
          'label' => t('Node'),
          'save' => FALSE,
        ),
        'project_merits' => array(
          'type' => 'decimal', 
          'label' => t('Merits to add')
        ),
      ),
      'provides' => array(
        'new_merit_value' => array(
          'type' => 'decimal',
          'label' => t('New merit value'),
        ),
      ),
    ),
  );
}

function project_merit_updater($node, $project_merits) {
  $project_merits = (float) $project_merits;
  
  if (is_numeric($node)) {
    $node = node_load($node);
  }
  
  if (!isset($node->nid)) {
    watchdog('rovas_project_reward', 'Invalid node passed to project_merit_updater', array(), WATCHDOG_ERROR);
    return array('new_merit_value' => 0);
  }
  
  $wrapper = entity_metadata_wrapper('node', $node);
  
  try {
    $current_val = $wrapper->field_merit_reward->value();
    $new_value = $current_val + $project_merits;
    
    $wrapper->field_merit_reward->set($new_value);
    
    $wrapper->save();
    
    return array('new_merit_value' => $new_value);
  }
  catch (Exception $e) {
    watchdog('rovas_project_reward', 'Error updating project merits: @error', array('@error' => $e->getMessage()), WATCHDOG_ERROR);
    return array('new_merit_value' => isset($current_val) ? $current_val : 0);
  }
}

/**
 * Implements hook_cron().
 */
function rovas_project_reward_cron() {
  rovas_project_reward_process_callback_delivery_queue();
}

/**
 * Returns TRUE if the order's selected Commerce payment method is bank transfer.
 */
function rovas_project_reward_order_is_bank_transfer_selected($order) {
  if (empty($order)) {
    return FALSE;
  }
  // Primary check: Commerce payment_method field.
  if (function_exists('commerce_payment_rules_compare_selected_payment_method') &&
      commerce_payment_rules_compare_selected_payment_method($order, 'bank_transfer')) {
    return TRUE;
  }
  // Fallback: rpr_paytype is set at order creation and is not cleared by
  // Commerce's payment-pane submit handler, making it a reliable indicator
  // even when payment_method has been wiped on the review step.
  return isset($order->data['rpr_paytype']) && $order->data['rpr_paytype'] === 'pay-choice-bank';
}

/**
 * TRUE when the order matches the former Rules rule "rules_process_bank_payment_orders"
 * guards (bank transfer + payment recipient set). Used to schedule shutdown work.
 */
function rovas_project_reward_checkout_complete_needs_bank_pipeline($order) {
  if (empty($order->order_id) || empty($order->type) || $order->type !== 'commerce_order') {
    return FALSE;
  }
  if (!rovas_project_reward_order_is_bank_transfer_selected($order)) {
    return FALSE;
  }
  $recipient_items = field_get_items('commerce_order', $order, 'field_payment_recipient');
  if (empty($recipient_items[0]['value'])) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Replaces the disabled Rules reaction rules_process_bank_payment_orders:
 * set status to processing, create forex node via rules_process_forex_order,
 * send invoice receipt mail. Guards match the rule (not rewpro-specific).
 *
 * @param object $order
 *   Commerce order entity.
 *
 * @return bool
 *   TRUE if this order was handled (or already processed), FALSE if guards failed.
 */
function rovas_project_reward_process_bank_transfer_checkout_complete($order) {
  if (!rovas_project_reward_checkout_complete_needs_bank_pipeline($order)) {
    return FALSE;
  }
  if (!empty($order->data['rovas_bank_checkout_complete_processed'])) {
    return TRUE;
  }
  if (!function_exists('commerce_order_status_update') || !function_exists('rovas_forex_transaction_params')) {
    return FALSE;
  }

  $order = commerce_order_status_update($order, 'processing', FALSE);
  $order = commerce_order_load($order->order_id);
  if (!$order) {
    return FALSE;
  }

  $wrapper = entity_metadata_wrapper('commerce_order', $order);
  $order_total = $wrapper->commerce_order_total->amount->value() / 100;

  // Create the PENDING bank_transfer transaction so the payment is immediately
  // visible at /admin/commerce/orders/NNN/payment. Guarded: skip if a
  // bank_transfer transaction already exists (e.g. contrib created it via the
  // standard payment pane on an older order).
  $existing_txn_query = new EntityFieldQuery();
  $existing_txn_query->entityCondition('entity_type', 'commerce_payment_transaction')
    ->propertyCondition('order_id', $order->order_id)
    ->propertyCondition('payment_method', 'bank_transfer')
    ->range(0, 1);
  $existing_txn = $existing_txn_query->execute();

  if (empty($existing_txn['commerce_payment_transaction'])) {
    $payment_method = commerce_payment_method_instance_load('bank_transfer|commerce_payment_bank_transfer');
    if ($payment_method && function_exists('commerce_bank_transfer_transaction')) {
      $charge = array(
        'amount' => $wrapper->commerce_order_total->amount->value(),
        'currency_code' => $wrapper->commerce_order_total->currency_code->value(),
      );
      commerce_bank_transfer_transaction($payment_method, $order, $charge);
    }
  }

  $forex_params = rovas_forex_transaction_params('eur_to_chr', $order_total, 0, TRUE);
  $eur_basket = $forex_params['eur_basket'];
  $chr_basket = $forex_params['chr_basket'];
  $output_amount = $forex_params['output_amount'];

  if (module_exists('rules') && function_exists('rules_invoke_component')) {
    $config = rules_config_load('rules_process_forex_order');
    if ($config && !empty($config->active)) {
      rules_invoke_component(
        'rules_process_forex_order',
        $order->order_id,
        0,
        $eur_basket,
        $chr_basket,
        'euros_to_chrons',
        $order_total,
        $output_amount,
        0,
        $order->uid
      );
    }
  }

  if (function_exists('commerce_invoice_receipt_action_mail')) {
    $to = token_replace('[commerce-order:owner] <[commerce-order:mail]>', array('commerce-order' => $order), array('clear' => TRUE));
    $subject = token_replace('[site:name]: Order #[commerce-order:order-id]', array('commerce-order' => $order), array('clear' => TRUE));
    commerce_invoice_receipt_action_mail($order, $to, $subject, NULL);
  }

  $order = commerce_order_load($order->order_id);
  if ($order) {
    $order->data['rovas_bank_checkout_complete_processed'] = REQUEST_TIME;
    commerce_order_save($order);
  }

  return TRUE;
}

/**
 * Queues signed partner webhook (order-placed) when a bank intent has callback data.
 */
function rovas_project_reward_order_placed_partner_notify($order) {
  if (empty($order->order_id)) {
    return;
  }
  if (!empty($order->data['rovas_order_placed_callback_sent'])) {
    return;
  }
  if (!rovas_project_reward_enqueue_delayed_callback($order, 'order-placed')) {
    return;
  }
  $order->data['rovas_order_placed_callback_sent'] = REQUEST_TIME;
  commerce_order_save($order);
  rovas_project_reward_process_callback_delivery_queue(3);
}

/**
 * Shutdown: runs after Rules and other modules on commerce_checkout_complete.
 */
function _rovas_project_reward_checkout_complete_bank_shutdown($order_id) {
  $order = commerce_order_load($order_id);
  if (!$order) {
    return;
  }
  rovas_project_reward_process_bank_transfer_checkout_complete($order);
  // Immediately notify 3rd-party partners that an order was placed but is
  // awaiting settlement. This avoids relying on the buyer clicking the "Return
  // to site" link on the complete page (which is a best-effort UX convenience).
  rovas_project_reward_order_placed_partner_notify($order);
}

/**
 * Implements hook_commerce_checkout_complete().
 *
 * Bank transfer orders with field_payment_recipient: run the former Rules
 * actions in code and notify 3rd-party partners (order-placed) after checkout
 * submission. Deferred to shutdown so Rules such as commerce_checkout_order_convert
 * run first.
 */
function rovas_project_reward_commerce_checkout_complete($order) {
  if (empty($order->order_id)) {
    return;
  }
  if (!rovas_project_reward_checkout_complete_needs_bank_pipeline($order)) {
    return;
  }
  drupal_register_shutdown_function('_rovas_project_reward_checkout_complete_bank_shutdown', array($order->order_id));
}

/**
 * Build/refresh a SEPA bank intent for a rewpro order.
 */
function rovas_project_reward_create_bank_intent($order, $paytype, $recipient_id, array $session_data = array()) {
  if (empty($order->order_id)) {
    return FALSE;
  }

  $intent_id = 'rpr_' . $order->order_id . '_' . substr(hash('sha256', microtime(TRUE) . mt_rand()), 0, 12);
  $amount = round(commerce_currency_amount_to_decimal($order->commerce_order_total[LANGUAGE_NONE][0]['amount'], 'EUR'), 2);
  $reference = (string) $order->order_id;
  $provider = variable_get('rovas_bank_provider', 'fio');
  $bank_details = rovas_project_reward_get_bank_transfer_details($order);
  $beneficiary = !empty($bank_details['account_owner']) ? $bank_details['account_owner'] : variable_get('rovas_bank_beneficiary_name', variable_get('site_name', 'Rovas'));
  $iban = !empty($bank_details['account_iban']) ? $bank_details['account_iban'] : variable_get('rovas_bank_iban', '');
  $bic = !empty($bank_details['account_swift']) ? $bank_details['account_swift'] : variable_get('rovas_bank_bic', 'FIOZSKBAXXX');
  $message = t('Order @id', array('@id' => $order->order_id));
  $epc_remittance = rovas_project_reward_format_epc_vs_remittance($order->order_id);
  $epc_payload = rovas_project_reward_build_epc_qr_payload($beneficiary, $iban, $bic, $amount, $epc_remittance, $message);
  $callback_expires = REQUEST_TIME + (int) variable_get('rovas_bank_delayed_token_ttl', 3 * 24 * 3600);

  $intent_fields = array(
    'intent_id' => $intent_id,
    'provider' => $provider,
    'status' => 'pending_settlement',
    'reference' => $reference,
    'amount' => $amount,
    'currency' => 'EUR',
    'paytype' => $paytype,
    'recipient_id' => is_numeric($recipient_id) ? (int) $recipient_id : NULL,
    'callback_url' => isset($session_data['callback_url']) ? $session_data['callback_url'] : '',
    'callback_token' => isset($session_data['token']) ? $session_data['token'] : '',
    'callback_expires' => $callback_expires,
    'epc_payload' => $epc_payload,
    'meta' => drupal_json_encode(array(
      'callback_context' => isset($session_data['original_url']) ? $session_data['original_url'] : '',
      'product_name'     => isset($session_data['name']) ? $session_data['name'] : '',
      'expiration'       => isset($session_data['expiration']) ? $session_data['expiration'] : NULL,
    )),
    'changed' => REQUEST_TIME,
  );

  $existing_intent_id = db_select('rovas_bank_payment_intent', 'i')
    ->fields('i', array('id'))
    ->condition('order_id', $order->order_id)
    ->range(0, 1)
    ->execute()
    ->fetchField();

  if ($existing_intent_id) {
    db_update('rovas_bank_payment_intent')
      ->fields($intent_fields)
      ->condition('order_id', $order->order_id)
      ->execute();
  }
  else {
    db_insert('rovas_bank_payment_intent')
      ->fields($intent_fields + array(
        'order_id' => (int) $order->order_id,
        'created' => REQUEST_TIME,
      ))
      ->execute();
  }

  $order->data['sepa'] = array(
    'intent_id' => $intent_id,
    'provider' => $provider,
    'status' => 'pending_settlement',
    'reference' => $reference,
    'amount' => number_format($amount, 2, '.', ''),
    'currency' => 'EUR',
    'beneficiary_name' => $beneficiary,
    'iban' => $iban,
    'bic' => $bic,
    'epc_payload' => $epc_payload,
    'callback_url' => isset($session_data['callback_url']) ? $session_data['callback_url'] : '',
  );
  rovas_project_reward_attach_bank_pi_to_order_data($order, $intent_fields + array(
    'order_id' => (int) $order->order_id,
    'created' => REQUEST_TIME,
  ));
  commerce_order_save($order);

  watchdog('rovas_project_reward', 'Created bank intent @intent for order @order.', array('@intent' => $intent_id, '@order' => $order->order_id), WATCHDOG_INFO);

  return $intent_id;
}

/**
 * Build a Stripe-like payment_intent payload for bank transfer orders.
 *
 * Persists a complete bank intent snapshot on order->data['bank_pi'] so
 * integrations can consume a stable PI-shaped object similarly to Stripe.
 *
 * @param array|object $intent
 *   A rovas_bank_payment_intent row.
 *
 * @return array
 *   Normalized payment intent payload.
 */
function rovas_project_reward_build_bank_pi_payload($intent) {
  if (is_object($intent)) {
    $intent = (array) $intent;
  }
  if (!is_array($intent)) {
    return array();
  }

  $meta = array();
  if (!empty($intent['meta'])) {
    $decoded = drupal_json_decode($intent['meta']);
    if (is_array($decoded)) {
      $meta = $decoded;
    }
  }

  $amount_decimal = isset($intent['amount']) ? number_format((float) $intent['amount'], 2, '.', '') : '0.00';
  $amount_minor = (int) round((float) $amount_decimal * 100);
  $currency = !empty($intent['currency']) ? strtoupper((string) $intent['currency']) : 'EUR';

  // Keep PI-like shape for parity with Stripe while preserving bank specifics.
  $pi = array(
    'id' => !empty($intent['intent_id']) ? (string) $intent['intent_id'] : '',
    'object' => 'payment_intent',
    'payment_method' => 'bank_transfer',
    'payment_method_types' => array('bank_transfer'),
    'provider' => !empty($intent['provider']) ? (string) $intent['provider'] : 'fio',
    'provider_payment_id' => !empty($intent['provider_payment_id']) ? (string) $intent['provider_payment_id'] : '',
    'status' => !empty($intent['status']) ? (string) $intent['status'] : '',
    'reference' => !empty($intent['reference']) ? (string) $intent['reference'] : '',
    'amount' => $amount_minor,
    'amount_received' => $amount_minor,
    'amount_decimal' => $amount_decimal,
    'currency' => strtolower($currency),
    'metadata' => $meta + array(
      'paytype' => !empty($intent['paytype']) ? (string) $intent['paytype'] : '',
      'recipient_id' => !empty($intent['recipient_id']) ? (int) $intent['recipient_id'] : 0,
      'callback_url' => !empty($intent['callback_url']) ? (string) $intent['callback_url'] : '',
      'callback_expires' => !empty($intent['callback_expires']) ? (int) $intent['callback_expires'] : NULL,
      'product_name' => !empty($meta['product_name']) ? (string) $meta['product_name'] : '',
      'epc_payload' => !empty($intent['epc_payload']) ? (string) $intent['epc_payload'] : '',
    ),
    'created' => !empty($intent['created']) ? (int) $intent['created'] : REQUEST_TIME,
    'updated' => !empty($intent['changed']) ? (int) $intent['changed'] : REQUEST_TIME,
  );

  // Keep the full original row for consumers that need all fields unchanged.
  $pi['rovas_bank_intent_raw'] = $intent;
  $pi['rovas_bank_intent_raw']['meta_decoded'] = $meta;

  return $pi;
}

/**
 * Attach bank PI payload to order data.
 *
 * @param object $order
 *   Loaded commerce order entity (mutated in-place).
 * @param array|object|null $intent
 *   Optional intent row. If omitted, loaded by order_id.
 *
 * @return bool
 *   TRUE when attached, FALSE when intent was unavailable.
 */
function rovas_project_reward_attach_bank_pi_to_order_data(&$order, $intent = NULL) {
  if (empty($order->order_id)) {
    return FALSE;
  }

  if ($intent === NULL) {
    $intent = db_select('rovas_bank_payment_intent', 'i')
      ->fields('i')
      ->condition('order_id', (int) $order->order_id)
      ->range(0, 1)
      ->execute()
      ->fetchObject();
  }
  if (!$intent) {
    return FALSE;
  }

  $payload = rovas_project_reward_build_bank_pi_payload($intent);
  if (empty($payload)) {
    return FALSE;
  }

  if (!isset($order->data) || !is_array($order->data)) {
    $order->data = array();
  }
  if (empty($order->data['bank_pi']) || !is_array($order->data['bank_pi'])) {
    $order->data['bank_pi'] = array();
  }
  $order->data['bank_pi']['payment_intent'] = $payload;

  return TRUE;
}

/**
 * Formats an order id for the EPC unstructured remittance line (Slovak/CZ style).
 *
 * Prefixes with /VS so domestic banks may map the value to variable symbol.
 * Uses up to 10 numeric digits (national VS length); longer ids use the last 10 digits.
 *
 * @param int|string $order_id
 *   Commerce order id.
 *
 * @return string
 *   Value for EPC line 10 (e.g. "/VS12345").
 */
function rovas_project_reward_format_epc_vs_remittance($order_id) {
  $digits = preg_replace('/\D/', '', (string) $order_id);
  if ($digits === '') {
    $fallback = trim((string) $order_id);
    return $fallback !== '' ? $fallback : '0';
  }
  if (strlen($digits) > 10) {
    $digits = substr($digits, -10);
  }
  return '/VS' . $digits;
}

/**
 * Build EPC QR payload (SCT).
 */
function rovas_project_reward_build_epc_qr_payload($beneficiary, $iban, $bic, $amount, $reference, $message = '') {
  $beneficiary = trim((string) $beneficiary);
  $iban = preg_replace('/\s+/', '', strtoupper((string) $iban));
  $bic = trim((string) $bic);
  $amount = number_format((float) $amount, 2, '.', '');
  $reference = trim((string) $reference);
  $message = trim((string) $message);

  $lines = array(
    'BCD',
    '002',
    '1',
    'SCT',
    $bic,
    $beneficiary,
    $iban,
    'EUR' . $amount,
    '',
    $reference,
    $message,
  );
  return implode("\n", $lines);
}

/**
 * Render bank transfer instructions block for the complete page and invoice email.
 *
 * @param object      $order    Loaded commerce order.
 * @param string|null $langcode Optional language code for translated strings.
 */
function rovas_project_reward_render_bank_transfer_info($order, $langcode = NULL) {
  if (empty($order->data['sepa']) || empty($order->data['sepa']['reference'])) {
    return '';
  }

  $t_opts = $langcode ? array('langcode' => $langcode) : array();

  $sepa = $order->data['sepa'];
  $payload = isset($sepa['epc_payload']) ? $sepa['epc_payload'] : '';
  $qr_url = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' . rawurlencode($payload);
  $amount = isset($sepa['amount']) ? $sepa['amount'] : '0.00';
  $currency = isset($sepa['currency']) ? $sepa['currency'] : 'EUR';
  $beneficiary = isset($sepa['beneficiary_name']) ? $sepa['beneficiary_name'] : '';
  $iban = isset($sepa['iban']) ? $sepa['iban'] : '';
  $bic = isset($sepa['bic']) ? $sepa['bic'] : '';
  $reference = $sepa['reference'];
  $bank_details = rovas_project_reward_get_bank_transfer_details($order);

  $out = '<div class="rovas-bank-transfer-box" style="padding:12px;margin:10px 0 16px 0;">';
  $out .= '<p>' . check_plain(t('Please complete your order by transferring the amount to the bank account below.', array(), $t_opts)) . '</p>';
  $out .= '<ul style="margin-left:16px;">';
  $out .= '<li><strong>' . check_plain(t('Beneficiary', array(), $t_opts)) . ':</strong> ' . check_plain($beneficiary) . '</li>';
  $out .= '<li><strong>IBAN:</strong> ' . check_plain($iban) . '</li>';
  $out .= '<li><strong>BIC:</strong> ' . check_plain($bic) . '</li>';
  $out .= '<li><strong>' . check_plain(t('Amount', array(), $t_opts)) . ':</strong> ' . check_plain($amount . ' ' . $currency) . '</li>';
  $out .= '<li><strong>' . check_plain(t('Reference (VS)', array(), $t_opts)) . ':</strong> ' . check_plain($reference) . '</li>';
  $out .= '</ul>';
  if (!empty($bank_details['policy'])) {
    $out .= '<p><small>' . check_plain($bank_details['policy']) . '</small></p>';
  }
  if (!empty($payload)) {
    $out .= '<div><img src="' . check_plain($qr_url) . '" alt="' . check_plain(t('SEPA QR code', array(), $t_opts)) . '" /></div>';
  }
  $out .= '<p><small>' . check_plain(t('Your order remains pending until payment is confirmed by bank settlement.', array(), $t_opts)) . '</small></p>';
  $out .= '</div>';

  return $out;
}

/**
 * Get bank transfer account details from Commerce method settings.
 *
 * Uses the active bank transfer payment method instance as source of truth
 * (including details enabled through Rules action), then falls back to legacy
 * variables when needed.
 */
function rovas_project_reward_get_bank_transfer_details($order = NULL) {
  $details = array(
    'account_owner' => '',
    'account_number' => '',
    'account_iban' => '',
    'account_swift' => '',
    'account_bank' => '',
    'policy' => '',
  );

  $instance = commerce_payment_method_instance_load('bank_transfer|commerce_payment_bank_transfer');
  if ($instance && !empty($instance['settings']) && is_array($instance['settings'])) {
    if (!empty($instance['settings']['details']) && is_array($instance['settings']['details'])) {
      $details = array_merge($details, $instance['settings']['details']);
    }
    if (!empty($instance['settings']['policy'])) {
      $details['policy'] = $instance['settings']['policy'];
    }
  }

  // Tokenize policy for current order if available.
  if (!empty($details['policy']) && $order) {
    $details['policy'] = token_replace($details['policy'], array('commerce-order' => $order), array('clear' => TRUE));
  }

  // Fallback for older local configuration style.
  if (empty($details['account_owner'])) {
    $details['account_owner'] = variable_get('rovas_bank_beneficiary_name', variable_get('site_name', 'Rovas'));
  }
  if (empty($details['account_iban'])) {
    $details['account_iban'] = variable_get('rovas_bank_iban', '');
  }
  if (empty($details['account_swift'])) {
    $details['account_swift'] = variable_get('rovas_bank_bic', 'FIOZSKBAXXX');
  }
  if (empty($details['policy'])) {
    $details['policy'] = t('Variable symbol: @vs', array('@vs' => !empty($order->order_id) ? $order->order_id : ''));
  }

  return $details;
}

/**
 * Logs bank webhook traffic for debugging (filter dblog by type: rovas_bank_webhook).
 *
 * @param string $direction
 *   Short label, e.g. "inbound" or "outbound".
 * @param string $path_or_url
 *   Request URI (inbound) or full endpoint URL (outbound).
 * @param mixed $payload
 *   Raw string or array/object to JSON-encode for the log line.
 */
function _rovas_project_reward_log_bank_webhook($direction, $path_or_url, $payload) {
  if (is_array($payload) || is_object($payload)) {
    $payload_str = drupal_json_encode($payload);
    if ($payload_str === FALSE) {
      $payload_str = '(json_encode failed)';
    }
  }
  else {
    $payload_str = (string) $payload;
  }
  if ($payload_str === '') {
    $payload_str = '(empty)';
  }
  // Keep dblog rows bounded; large bodies are rare for these webhooks.
  if (strlen($payload_str) > 32000) {
    $payload_str = substr($payload_str, 0, 31990) . '…[truncated]';
  }
  watchdog('rovas_bank_webhook', '@dir @target @payload', array(
    '@dir' => $direction,
    '@target' => $path_or_url,
    '@payload' => $payload_str,
  ), WATCHDOG_INFO);
}

/**
 * Persist outbound webhook attempt when logging module is enabled.
 */
function _rovas_project_reward_record_outbound_webhook($record) {
  if (module_exists('rovas_outbound_webhook_log') && function_exists('rovas_outbound_webhook_log_record')) {
    rovas_outbound_webhook_log_record($record);
  }
}

/**
 * Admin table listing intents requiring manual review.
 */
function rovas_project_reward_bank_manual_review_page() {
  return drupal_get_form('rovas_project_reward_bank_manual_review_form');
}

/**
 * Admin table listing bank intents requiring manual review.
 *
 * Includes received amount (when available) and an action for overpayments.
 */
function rovas_project_reward_bank_manual_review_form($form, &$form_state) {
  $form['#method'] = 'post';

  // Ensure this admin listing renders as a readable table regardless of theme.
  $css_path = drupal_get_path('module', 'rovas_project_reward') . '/rovas_project_reward.admin.css';
  drupal_add_css($css_path, array('group' => CSS_DEFAULT, 'every_page' => FALSE));

  // Use a numeric header array. Drupal 7's theme_table expects this shape.
  $header = array(
    t('Order'),
    t('Status'),
    t('Reference'),
    t('Requested'),
    t('Received'),
    t('Updated'),
    t('Action'),
  );

  $form['intents'] = array(
    '#theme' => 'table',
    '#header' => $header,
    '#attributes' => array('class' => array('rovas-bank-review-table')),
    '#rows' => array(),
  );

  $result = db_select('rovas_bank_payment_intent', 'i')
    ->fields('i', array('order_id', 'status', 'reference', 'amount', 'currency', 'changed', 'meta', 'provider_payment_id'))
    ->condition('status', array('manual_review', 'failed', 'expired'), 'IN')
    ->orderBy('changed', 'DESC')
    ->range(0, 200)
    ->execute();

  $form_state['review_intents'] = array();

  foreach ($result as $row) {
    $intent_meta = array();
    if (!empty($row->meta)) {
      $decoded = drupal_json_decode($row->meta);
      if (is_array($decoded)) {
        $intent_meta = $decoded;
      }
    }

    $mismatch = !empty($intent_meta['mismatch']) && is_array($intent_meta['mismatch'])
      ? $intent_meta['mismatch']
      : array();

    $expected = isset($mismatch['expected']) ? (float) $mismatch['expected'] : (float) $row->amount;
    $actual   = isset($mismatch['actual'])   ? (float) $mismatch['actual']   : (float) $row->amount;

    $currency = !empty($row->currency) ? $row->currency : 'EUR';

    $requested_str = check_plain(number_format($expected, 2, '.', '') . ' ' . $currency);
    $received_str  = check_plain(number_format($actual, 2, '.', '') . ' ' . $currency);

    $is_overpayment = ($row->status === 'manual_review' && $actual > $expected + 0.009);

    $oid = (int) $row->order_id;
    $form['intents_actions'][$oid] = array('#type' => 'markup', '#markup' => '');

    if ($is_overpayment) {
      // Store context server-side; the button only needs an order id.
      $form_state['review_intents'][$row->order_id] = array(
        'expected' => $expected,
        'actual' => $actual,
        'currency' => $currency,
        'provider_payment_id' => !empty($row->provider_payment_id) ? $row->provider_payment_id : NULL,
      );

      $form['intents_actions'][$oid] = array(
        '#type' => 'submit',
        '#value' => t('Accept overpayment'),
        '#order_id' => (int) $row->order_id,
        '#submit' => array('rovas_project_reward_bank_manual_review_form_submit'),
      );
    }

    // Build the themed table row. Use a reference for the action cell so the
    // same form element is rendered (avoids duplicate IDs and keeps submit
    // handling intact).
    $row_cells = array(
      array('data' => l('#' . $row->order_id, 'admin/commerce/orders/' . $row->order_id)),
      array('data' => check_plain($row->status)),
      array('data' => check_plain($row->reference)),
      array('data' => $requested_str),
      array('data' => $received_str),
      array('data' => check_plain(format_date($row->changed, 'short'))),
      array('data' => &$form['intents_actions'][$oid]),
    );
    $form['intents']['#rows'][$oid] = $row_cells;
  }

  if (empty($form['intents']['#rows'])) {
    $form['intents']['#rows'][] = array(
      array(
        'data' => t('No bank intents waiting for manual review.'),
        'colspan' => count($header),
      ),
    );
  }

  // Provide an overall submit handler; per-row buttons override it.
  $form['#submit'] = array('rovas_project_reward_bank_manual_review_form_dummy_submit');

  return $form;
}

/**
 * Dummy submit for the form-level handler.
 */
function rovas_project_reward_bank_manual_review_form_dummy_submit(&$form, &$form_state) {
  // No-op.
}

/**
 * Submit handler: accept an overpayment from the manual review page.
 */
function rovas_project_reward_bank_manual_review_form_submit(&$form, &$form_state) {
  $clicked = !empty($form_state['clicked_button']) ? $form_state['clicked_button'] : array();
  $order_id = !empty($clicked['#order_id']) ? (int) $clicked['#order_id'] : 0;
  if (!$order_id) {
    return;
  }

  // Retrieve intended context from server-side store when available.
  $ctx = !empty($form_state['review_intents'][$order_id]) ? $form_state['review_intents'][$order_id] : array();
  $actual   = isset($ctx['actual']) ? (float) $ctx['actual'] : NULL;
  $currency = !empty($ctx['currency']) ? $ctx['currency'] : 'EUR';
  $provider_payment_id = isset($ctx['provider_payment_id']) ? $ctx['provider_payment_id'] : NULL;

  // Ensure correctness even if the state is missing.
  if ($actual === NULL) {
    $intent = db_select('rovas_bank_payment_intent', 'i')
      ->fields('i')
      ->condition('order_id', $order_id)
      ->execute()
      ->fetchObject();
    if (!$intent) {
      drupal_set_message(t('No bank intent found for Order #@id.', array('@id' => $order_id)), 'error');
      return;
    }

    $intent_meta = array();
    if (!empty($intent->meta)) {
      $decoded = drupal_json_decode($intent->meta);
      if (is_array($decoded)) {
        $intent_meta = $decoded;
      }
    }
    $mismatch = !empty($intent_meta['mismatch']) && is_array($intent_meta['mismatch'])
      ? $intent_meta['mismatch']
      : array();
    $expected = isset($mismatch['expected']) ? (float) $mismatch['expected'] : (float) $intent->amount;
    $actual   = isset($mismatch['actual']) ? (float) $mismatch['actual'] : (float) $intent->amount;
    $provider_payment_id = !empty($intent->provider_payment_id) ? $intent->provider_payment_id : NULL;
    $currency = !empty($intent->currency) ? $intent->currency : 'EUR';

    if (!($intent->status === 'manual_review' && $actual > $expected + 0.009)) {
      drupal_set_message(t('This order is not eligible for overpayment acceptance anymore.'), 'warning');
      return;
    }
  }

  $order = commerce_order_load($order_id);
  if (!$order) {
    drupal_set_message(t('Could not load Order #@id.', array('@id' => $order_id)), 'error');
    return;
  }
  if (!empty($order->data['sepa']['status']) && $order->data['sepa']['status'] === 'paid') {
    drupal_set_message(t('Order #@id is already marked as paid.', array('@id' => $order_id)));
    return;
  }

  // Load the pending bank_transfer transaction created at checkout.
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'commerce_payment_transaction')
    ->propertyCondition('order_id', $order_id)
    ->propertyCondition('payment_method', 'bank_transfer')
    ->propertyCondition('status', COMMERCE_PAYMENT_STATUS_PENDING);
  $result = $query->execute();

  if (!empty($result['commerce_payment_transaction'])) {
    $txn_ids = array_keys($result['commerce_payment_transaction']);
    $transaction = commerce_payment_transaction_load(reset($txn_ids));
  }
  else {
    // Fallback for legacy/odd states.
    $transaction = commerce_payment_transaction_new('bank_transfer', $order_id);
    $transaction->instance_id = 'bank_transfer|commerce_payment_bank_transfer';
    $transaction->currency_code = $currency;
  }

  // Overpayment acceptance must update the order total before the SUCCESS
  // transaction save triggers reward distribution logic.
  rovas_project_reward_apply_bank_settled_amount_to_order(
    $order_id,
    $actual,
    $currency,
    'admin_overpayment_accept'
  );

  $transaction->amount = commerce_currency_decimal_to_amount($actual, $currency);
  $transaction->status = COMMERCE_PAYMENT_STATUS_SUCCESS;
  if ($provider_payment_id) {
    $transaction->remote_id = $provider_payment_id;
  }
  $transaction->message .= t('Confirmed by admin overpayment acceptance: @date', array('@date' => format_date(REQUEST_TIME, 'short')));

  commerce_payment_transaction_save($transaction);

  // Notify the buyer about successful manual reconciliation using the actual
  // received amount (overpayment accepted by admin).
  rovas_project_reward_send_bank_transfer_notification($order, 'bank_transfer_confirmed', array(
    'actual_amount' => $actual,
  ));

  drupal_set_message(t('Overpayment accepted for Order #@id.', array('@id' => $order_id)));
  drupal_goto('admin/commerce/orders/rewpro-bank-review');
}

/**
 * Persist accepted bank-settlement amount as the order total.
 *
 * Keeps an audit trail in order->data so original quoted amount remains visible
 * after an overpayment is accepted.
 *
 * @param int $order_id
 *   Commerce order ID.
 * @param float $actual_amount
 *   Accepted/settled decimal amount (major units, e.g. EUR).
 * @param string $currency
 *   Currency code (defaults to EUR when empty).
 * @param string $reason
 *   Short internal reason tag for the adjustment audit trail.
 *
 * @return bool
 *   TRUE when save succeeded or no change was necessary, FALSE on failure.
 */
function rovas_project_reward_apply_bank_settled_amount_to_order($order_id, $actual_amount, $currency = 'EUR', $reason = 'bank_settlement_adjustment') {
  $order = commerce_order_load($order_id);
  if (!$order) {
    return FALSE;
  }

  $currency = !empty($currency) ? strtoupper($currency) : 'EUR';
  $new_minor = commerce_currency_decimal_to_amount((float) $actual_amount, $currency);
  if ($new_minor <= 0) {
    return FALSE;
  }

  $current_minor = 0;
  $current_currency = $currency;
  if (!empty($order->commerce_order_total[LANGUAGE_NONE][0]['amount'])) {
    $current_minor = (int) $order->commerce_order_total[LANGUAGE_NONE][0]['amount'];
    $current_currency = !empty($order->commerce_order_total[LANGUAGE_NONE][0]['currency_code'])
      ? $order->commerce_order_total[LANGUAGE_NONE][0]['currency_code']
      : $currency;
  }

  // Nothing to change.
  if ($current_minor === $new_minor && $current_currency === $currency) {
    return TRUE;
  }

  if (!isset($order->data) || !is_array($order->data)) {
    $order->data = array();
  }
  if (empty($order->data['rpr_original_order_total_minor'])) {
    $order->data['rpr_original_order_total_minor'] = (int) $current_minor;
    $order->data['rpr_original_order_total_currency'] = (string) $current_currency;
    $order->data['rpr_original_order_total_recorded_at'] = REQUEST_TIME;
  }
  if (empty($order->data['rpr_bank_amount_adjustments']) || !is_array($order->data['rpr_bank_amount_adjustments'])) {
    $order->data['rpr_bank_amount_adjustments'] = array();
  }
  global $user;
  $order->data['rpr_bank_amount_adjustments'][] = array(
    'from_minor' => (int) $current_minor,
    'to_minor' => (int) $new_minor,
    'currency' => $currency,
    'reason' => (string) $reason,
    'changed' => REQUEST_TIME,
    'uid' => !empty($user->uid) ? (int) $user->uid : 0,
  );
  $order->data['rpr_settled_amount_minor'] = (int) $new_minor;
  $order->data['rpr_settled_amount_currency'] = $currency;

  // Keep product line-item custom price in sync for rewpro flows so future
  // refresh/rebase operations preserve the accepted amount.
  $line_items = field_get_items('commerce_order', $order, 'commerce_line_items');
  if (!empty($line_items)) {
    foreach ($line_items as $item_ref) {
      $line_item = commerce_line_item_load($item_ref['line_item_id']);
      if (!$line_item || $line_item->type !== 'product') {
        continue;
      }
      $quantity = !empty($line_item->quantity) ? (int) $line_item->quantity : 1;
      if ($quantity < 1) {
        $quantity = 1;
      }
      $unit_minor = (int) round($new_minor / $quantity);
      if (!isset($line_item->data) || !is_array($line_item->data)) {
        $line_item->data = array();
      }
      $line_item->data['rpr_custom_unit_price'] = $unit_minor;
      $line_item->data['rpr_custom_currency'] = $currency;
      $line_item->commerce_unit_price[LANGUAGE_NONE][0]['amount'] = $unit_minor;
      $line_item->commerce_unit_price[LANGUAGE_NONE][0]['currency_code'] = $currency;
      commerce_line_item_rebase_unit_price($line_item);
      commerce_line_item_save($line_item);
      // Rewpro orders are expected to contain a single priced product line.
      break;
    }
  }

  // Force order total to the accepted settlement amount.
  $order->commerce_order_total[LANGUAGE_NONE][0] = array(
    'amount' => (int) $new_minor,
    'currency_code' => $currency,
    'data' => array(),
  );
  $order->revision = TRUE;
  $order->log = t('Bank settlement amount accepted: order total changed from @from to @to @cur (@reason).', array(
    '@from' => number_format((float) $current_minor / 100, 2, '.', ''),
    '@to' => number_format((float) $new_minor / 100, 2, '.', ''),
    '@cur' => $currency,
    '@reason' => $reason,
  ));
  commerce_order_save($order);

  watchdog('rovas_project_reward', 'bank_settlement_adjusted: order @oid total changed from @from to @to @cur (@reason).', array(
    '@oid' => (int) $order_id,
    '@from' => number_format((float) $current_minor / 100, 2, '.', ''),
    '@to' => number_format((float) $new_minor / 100, 2, '.', ''),
    '@cur' => $currency,
    '@reason' => $reason,
  ), WATCHDOG_INFO);

  return TRUE;
}

/**
 * Sync the bank intent record and order data to 'paid' and queue partner callback.
 *
 * Extracted from mark_bank_order_success() so the admin-confirmation hook can
 * reuse it without re-firing the Rules paid_in_full event (Commerce core already
 * does that for admin confirmations via commerce_payment_transaction_save()).
 *
 * @param int $order_id
 *   Commerce order ID.
 * @param string|null $provider_payment_id
 *   Provider-side payment identifier, if available.
 * @param array $meta
 *   Additional metadata to persist on the intent row.
 *
 * @return bool
 *   TRUE if the sync completed (or was already done), FALSE on hard failure.
 */
function rovas_project_reward_sync_bank_intent_paid($order_id, $provider_payment_id = NULL, array $meta = array(), $actual_amount = NULL) {
  $order = commerce_order_load($order_id);
  if (!$order) {
    watchdog('rovas_project_reward', 'sync_bank_intent_paid: missing order @order.', array('@order' => $order_id), WATCHDOG_WARNING);
    return FALSE;
  }

  if (!empty($order->data['sepa']['status']) && $order->data['sepa']['status'] === 'paid') {
    return TRUE;
  }

  // Preserve existing intent meta (e.g. mismatch details from Fio polling)
  // and merge any new keys.
  $intent_meta = array();
  $existing_meta_json = db_select('rovas_bank_payment_intent', 'i')
    ->fields('i', array('meta'))
    ->condition('order_id', $order_id)
    ->execute()
    ->fetchField();
  if (!empty($existing_meta_json)) {
    $decoded = drupal_json_decode($existing_meta_json);
    if (is_array($decoded)) {
      $intent_meta = $decoded;
    }
  }
  if (!empty($meta)) {
    $intent_meta = array_merge($intent_meta, $meta);
  }

  $db_fields = array(
    'status' => 'paid',
    'provider_payment_id' => $provider_payment_id,
    'meta' => drupal_json_encode($intent_meta),
    'changed' => REQUEST_TIME,
  );
  if ($actual_amount !== NULL) {
    $db_fields['amount'] = round((float) $actual_amount, 2);
  }

  db_update('rovas_bank_payment_intent')
    ->fields($db_fields)
    ->condition('order_id', $order_id)
    ->execute();

  $order->data['sepa']['status'] = 'paid';
  if (!empty($provider_payment_id)) {
    $order->data['sepa']['provider_payment_id'] = $provider_payment_id;
  }
  if ($actual_amount !== NULL) {
    $order->data['sepa']['amount'] = number_format((float) $actual_amount, 2, '.', '');
  }
  rovas_project_reward_attach_bank_pi_to_order_data($order);
  commerce_order_save($order);

  rovas_project_reward_enqueue_delayed_callback($order, 'delayed-confirmed');

  return TRUE;
}

/**
 * Mark bank order as paid and enqueue delayed-confirmed callback.
 */
function rovas_project_reward_mark_bank_order_success($order_id, $provider_payment_id = NULL, $actual_amount = NULL, array $meta = array()) {
  $order = commerce_order_load($order_id);
  if (!$order) {
    watchdog('rovas_project_reward', 'Bank settlement references missing order @order.', array('@order' => $order_id), WATCHDOG_WARNING);
    return FALSE;
  }

  $intent = db_select('rovas_bank_payment_intent', 'i')
    ->fields('i')
    ->condition('order_id', $order_id)
    ->execute()
    ->fetchObject();
  if (!$intent) {
    watchdog('rovas_project_reward', 'No bank intent found for order @order.', array('@order' => $order_id), WATCHDOG_WARNING);
    return FALSE;
  }

  if (!empty($order->data['sepa']['status']) && $order->data['sepa']['status'] === 'paid') {
    // Allow recovery if a prior run marked SEPA paid but skipped time-share fulfillment.
    watchdog('rovas_project_reward', 'Bank reconcile: order @oid already had SEPA paid; running time-share finalize recovery if applicable.', array(
      '@oid' => $order_id,
    ), WATCHDOG_INFO);
    if (function_exists('rovas_purchase_shares_finalize_bank_paid_time_share_if_applicable')) {
      rovas_purchase_shares_finalize_bank_paid_time_share_if_applicable($order);
    }
    return TRUE;
  }

  $expected = isset($order->data['sepa']['amount']) ? (float) $order->data['sepa']['amount'] : (float) $intent->amount;
  if ($actual_amount !== NULL && abs($actual_amount - $expected) > 0.009) {
    $intent_meta = array();
    if (!empty($intent->meta)) {
      $decoded = drupal_json_decode($intent->meta);
      if (is_array($decoded)) {
        $intent_meta = $decoded;
      }
    }

    $is_overpayment = ($actual_amount > $expected + 0.009);
    $admin_notified_already = !empty($intent_meta['admin_overpayment_notified']);
    $notify_admin_now = ($is_overpayment && !$admin_notified_already);

    $manual_meta = array(
      'mismatch' => array('expected' => $expected, 'actual' => $actual_amount),
      'payload' => $meta,
    );
    if ($notify_admin_now) {
      rovas_project_reward_notify_site_admin_overpayment($order, $expected, $actual_amount);
      $manual_meta['admin_overpayment_notified'] = REQUEST_TIME;
    }

    db_update('rovas_bank_payment_intent')
      ->fields(array(
        'status' => 'manual_review',
        'provider_payment_id' => $provider_payment_id,
        'meta' => drupal_json_encode($manual_meta),
        'changed' => REQUEST_TIME,
      ))
      ->condition('order_id', $order_id)
      ->execute();
    rovas_project_reward_attach_bank_pi_to_order_data($order);
    commerce_order_save($order);
    watchdog('rovas_project_reward', 'Amount mismatch for order @order. Expected @exp, got @got.', array('@order' => $order_id, '@exp' => $expected, '@got' => $actual_amount), WATCHDOG_WARNING);

    // Notify the buyer about the mismatch so they can take action.
    rovas_project_reward_send_bank_transfer_notification($order, 'bank_transfer_mismatch', array(
      'actual_amount'   => $actual_amount,
      'expected_amount' => $expected,
    ));

    // Also notify partner webhook consumers that settlement cannot be finalized.
    // Payload still carries bank_intent_status=manual_review for exact reason.
    rovas_project_reward_enqueue_delayed_callback($order, 'delayed-rejected');
    rovas_project_reward_process_callback_delivery_queue(5);

    return FALSE;
  }

  rovas_project_reward_sync_bank_intent_paid($order_id, $provider_payment_id, $meta, $actual_amount);

  // Reload order so it reflects the sepa status saved by sync helper.
  $order = commerce_order_load($order_id);

  // Load the existing PENDING bank_transfer transaction created at checkout.
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'commerce_payment_transaction')
    ->propertyCondition('order_id', $order_id)
    ->propertyCondition('payment_method', 'bank_transfer')
    ->propertyCondition('status', COMMERCE_PAYMENT_STATUS_PENDING);
  $result = $query->execute();

  if (!empty($result['commerce_payment_transaction'])) {
    $txn_ids = array_keys($result['commerce_payment_transaction']);
    $transaction = commerce_payment_transaction_load(reset($txn_ids));
  }
  else {
    // Fallback: no PENDING row found (e.g. legacy order placed before the
    // contrib module was active). Create a fresh transaction.
    $transaction = commerce_payment_transaction_new('bank_transfer', $order_id);
    $transaction->instance_id = 'bank_transfer|commerce_payment_bank_transfer';
    $transaction->currency_code = 'EUR';
    $transaction->amount = commerce_currency_decimal_to_amount($expected, 'EUR');
  }

  $transaction->status = COMMERCE_PAYMENT_STATUS_SUCCESS;
  if ($provider_payment_id) {
    $transaction->remote_id = $provider_payment_id;
  }
  $transaction->message .= t('Confirmed by FIO: @date',
    array('@date' => format_date(REQUEST_TIME, 'short')));

  // Saving the transaction triggers:
  //  - Commerce core hook → rules_invoke_all('commerce_payment_order_paid_in_full')
  //    → rules_change_status_for_paid_bank_transfer_orders → order = completed.
  //  - rovas_project_reward_commerce_payment_transaction_update() →
  //    sync_bank_intent_paid (skipped, already paid) + process_bank_order_reward
  //    (lock-guarded against double execution).
  commerce_payment_transaction_save($transaction);

  // time-share bank orders are excluded from rules_process_card_payment_orders;
  // rovas_purchase_shares_commerce_payment_order_paid_in_full should run during
  // Commerce's paid_in_full hook chain. Call the finalize helper again here so
  // reconciliation still grants shares if that hook exited early (e.g.
  // payment_method missing while rpr_paytype is pay-choice-bank).
  watchdog('rovas_project_reward', 'Bank reconcile: invoking time-share finalize helper after payment save for order @oid.', array(
    '@oid' => $order_id,
  ), WATCHDOG_INFO);
  if (function_exists('rovas_purchase_shares_finalize_bank_paid_time_share_if_applicable')) {
    rovas_purchase_shares_finalize_bank_paid_time_share_if_applicable(commerce_order_load($order_id));
  }

  rovas_project_reward_process_callback_delivery_queue(5);
  watchdog('rovas_project_reward', 'Bank order @order marked as paid.', array('@order' => $order_id), WATCHDOG_INFO);

  // Notify the buyer that their payment has been confirmed.
  rovas_project_reward_send_bank_transfer_notification($order, 'bank_transfer_confirmed');

  return TRUE;
}

/**
 * Complete the merit/chron reward distribution for a confirmed bank transfer order.
 *
 * At checkout-complete time a forex_transaction node is created (pending) with a
 * full-order quote; this function commits it using the same EUR ladder as card
 * payments: NA1 = order total, Rovas base fee on NA1, merit % of NA2, remainder
 * via process_preferred_allocation_payment(), then fee-free EUR→CHR for the
 * merit slice (baskets at confirmation time, matching the Stripe webhook path).
 *
 * Skips orders containing SKU time-share (same guard as
 * _rovas_process_stripe_fees_for_order()).
 *
 * @param object $order
 *   Loaded Commerce order entity.
 *
 * @return bool
 *   TRUE on success or if already processed, FALSE on error.
 */
function rovas_project_reward_process_bank_order_reward($order) {
  if (empty($order->order_id)) {
    return FALSE;
  }

  if (!rovas_project_reward_checkout_complete_needs_bank_pipeline($order)) {
    return FALSE;
  }

  // Match _rovas_process_stripe_fees_for_order(): skip time-share orders.
  if (module_exists('commerce') && function_exists('commerce_order_rules_contains_product')) {
    if (commerce_order_rules_contains_product($order, 'time-share', '>=', 1)) {
      return FALSE;
    }
  }
  else {
    $product_id = db_query("SELECT product_id FROM {commerce_product} WHERE sku = :sku", array(':sku' => 'time-share'))->fetchField();
    if ($product_id && !empty($order->commerce_line_items)) {
      $items = field_get_items('commerce_order', $order, 'commerce_line_items');
      if ($items) {
        foreach ($items as $item) {
          $li = commerce_line_item_load($item['line_item_id']);
          if ($li && isset($li->commerce_product) && $li->commerce_product[LANGUAGE_NONE][0]['product_id'] == $product_id) {
            return FALSE;
          }
        }
      }
    }
  }

  $wrapper = entity_metadata_wrapper('commerce_order', $order);
  $order_total = $wrapper->commerce_order_total->amount->value() / 100;

  $lock_key = 'bank_reward_order_' . $order->order_id;
  if (!lock_acquire($lock_key, 60)) {
    lock_wait($lock_key, 15);
    // Check whether a concurrent process already finished.
    $q2 = new EntityFieldQuery();
    $q2->entityCondition('entity_type', 'node')
      ->entityCondition('bundle', 'forex_transaction')
      ->fieldCondition('field_order_record', 'target_id', $order->order_id);
    $r2 = $q2->execute();
    if (!empty($r2['node'])) {
      $fn2 = node_load(key($r2['node']));
      if ($fn2 && entity_metadata_wrapper('node', $fn2)->field_payment_status->value() == 1) {
        watchdog('rovas_project_reward', 'bank_order_reward: order @oid — concurrent process finished; skipping.', array('@oid' => $order->order_id), WATCHDOG_INFO);
        return TRUE;
      }
    }
    watchdog('rovas_project_reward', 'bank_order_reward: order @oid — could not acquire lock; aborting to prevent double-processing.', array('@oid' => $order->order_id), WATCHDOG_WARNING);
    return FALSE;
  }

  // Find the pending forex_transaction node created at checkout-complete time.
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
    ->entityCondition('bundle', 'forex_transaction')
    ->fieldCondition('field_order_record', 'target_id', $order->order_id);
  $result = $query->execute();

  if (empty($result['node'])) {
    lock_release($lock_key);
    watchdog('rovas_project_reward', 'bank_order_reward: forex node not found for order @oid.', array('@oid' => $order->order_id), WATCHDOG_ERROR);
    return FALSE;
  }

  $forex_node = node_load(key($result['node']));
  if (!$forex_node || $forex_node->type !== 'forex_transaction') {
    lock_release($lock_key);
    return FALSE;
  }

  $forex_wrapper = entity_metadata_wrapper('node', $forex_node);

  // Idempotency: another process may have committed between our pre-lock check
  // and lock acquisition.
  if ($forex_wrapper->field_payment_status->value() == 1) {
    lock_release($lock_key);
    return TRUE;
  }

  if ($order_total <= 0) {
    lock_release($lock_key);
    watchdog('rovas_project_reward', 'bank_order_reward: non-positive order total for order @oid; skipping reward.', array('@oid' => $order->order_id), WATCHDOG_WARNING);
    return FALSE;
  }

  if (!function_exists('rovas_forex_transaction_params')) {
    lock_release($lock_key);
    return FALSE;
  }

  // NA1 for bank = full order total (no card processor fee). Same merit/Rovas
  // split as _rovas_process_stripe_fees_for_order(); EUR→CHR uses baskets at
  // confirmation time (matches Stripe webhook), not the checkout-time quote on
  // the pending forex node.
  $merit_allocation_multiplier = 1.0;
  $payer_type = $wrapper->field_payer_type->value();
  $recipient_id = $wrapper->field_payment_recipient->value();
  $rewarded_project = NULL;
  if ($recipient_id) {
    $rewarded_project = node_load($recipient_id);
  }

  if ($payer_type === 'project' && $rewarded_project && $rewarded_project->type === 'project') {
    $proj_wrapper = entity_metadata_wrapper('node', $rewarded_project);
    $alloc = $proj_wrapper->field_reward_merit_allocation->value();
    if (isset($alloc) && is_numeric($alloc)) {
      $merit_allocation_multiplier = (float) $alloc / 100;
    }
  }

  $split = _rovas_project_reward_split_net_for_project_reward($order_total, $merit_allocation_multiplier);
  $merit_fee_eur = $split['merit_fee_eur'];
  $net_after_merit_eur = $split['net_after_merit_eur'];
  $rovas_fee_eur = $split['rovas_fee_eur'];

  // Remainder after Rovas + merit slice → euro distribution (same as Stripe).
  if ($net_after_merit_eur > 0 && $rewarded_project) {
    _process_preferred_allocation_payment_impl($rewarded_project, $net_after_merit_eur, TRUE);
  }

  // Fee-free EUR→CHR for merit leg (same as Stripe: charge_fees = FALSE).
  $forex_params = rovas_forex_transaction_params('eur_to_chr', $merit_fee_eur, 0, FALSE);
  $eur_basket = $forex_params['eur_basket'];
  $chr_basket = $forex_params['chr_basket'];
  $merit_chr_output = $forex_params['output_amount'];
  $use_temp_baskets = $forex_params['use_temp_baskets'];

  if (module_exists('rules') && function_exists('rules_invoke_component')) {
    $config = rules_config_load('rules_process_recipient_order_core');
    if ($config && !empty($config->active)) {
      rules_invoke_component('rules_process_recipient_order_core', $merit_chr_output, 1, $order);
    }
    else {
      lock_release($lock_key);
      watchdog('rovas_project_reward', 'bank_order_reward: rules_process_recipient_order_core not found/active for order @oid.', array('@oid' => $order->order_id), WATCHDOG_ERROR);
      return FALSE;
    }
  }

  $new_universal_forex_baskets = array(
    'ch_basket' => $chr_basket - $merit_chr_output,
    'eur_basket' => $eur_basket + $merit_fee_eur,
  );

  if (!empty($use_temp_baskets)) {
    variable_set('forex_baskets_temp', $new_universal_forex_baskets);
  }
  else {
    if (variable_get('forex_baskets_temp')) {
      variable_del('forex_baskets_temp');
    }
    variable_set('forex_baskets', $new_universal_forex_baskets);
  }

  // Commit the forex node. field_payment_status=1 is the idempotency marker.
  $forex_wrapper->field_chron_basket->set($chr_basket);
  $forex_wrapper->field_euro_basket->set($eur_basket);
  $forex_wrapper->field_input_amount->set($merit_fee_eur);
  $forex_wrapper->field_conversion_fee->set($rovas_fee_eur);
  $forex_wrapper->field_output_amount->set($merit_chr_output);
  $forex_wrapper->field_payment_status->set(1);
  $forex_wrapper->save();

  lock_release($lock_key);

  // Bank flows: do NOT send the synchronous `payment-completed` webhook here.
  // Rely on the bank callback queue (`delayed-confirmed`, etc.) enqueued by
  // sync_bank_intent_paid().
  //
  // Rationale: partners currently treat `payment-completed` as a different
  // moment in the lifecycle, and sending it during bank reconciliation causes
  // duplicate/early events.

  watchdog('rovas_project_reward', 'bank_order_reward: reward distributed for order @oid (merit @merit_eur EUR → @merit_chr CHR, net_after_merit @nae EUR, multiplier @mult).', array(
    '@oid' => $order->order_id,
    '@merit_eur' => $merit_fee_eur,
    '@merit_chr' => $merit_chr_output,
    '@nae' => $net_after_merit_eur,
    '@mult' => $merit_allocation_multiplier,
  ), WATCHDOG_INFO);
  return TRUE;
}

/**
 * Notify the originating 3rd party website after a bank transfer order is confirmed.
 *
 * Sends the same synchronous payload shape as rovas_project_reward_notify_purchase()
 * ({event, token, signature, amount_paid in minor units, currency, email}) for card/express
 * orders,
 * but sources the callback token from the rovas_bank_payment_intent record (stored
 * at order-creation time) rather than the PHP session (which is gone by the time
 * the bank payment is confirmed).
 *
 * Only fires when:
 *  - payer_type is 'project' (only project purchases have a webhook endpoint)
 *  - the intent has a non-empty callback_token (order originated from a 3rd party)
 *  - not already sent (guarded by order->data['rovas_bank_purchase_notified'])
 *
 * @param object $order
 *   Loaded Commerce order entity.
 */
function rovas_project_reward_notify_bank_purchase_confirmed($order) {
  if (empty($order->order_id)) {
    return;
  }

  // Only project-payer orders have a webhook on the rewarded node.
  $wrapper = entity_metadata_wrapper('commerce_order', $order);
  $payer_type = $wrapper->field_payer_type->value();
  if ($payer_type !== 'project') {
    return;
  }

  // Idempotency: only send once per order.
  if (!empty($order->data['rovas_bank_purchase_notified'])) {
    return;
  }

  // Fetch the bank intent to retrieve the stored callback token.
  $intent = db_select('rovas_bank_payment_intent', 'i')
    ->fields('i')
    ->condition('order_id', $order->order_id)
    ->execute()
    ->fetchObject();
  if (!$intent || empty($intent->callback_token)) {
    // Order was not initiated from a 3rd party site — nothing to notify.
    return;
  }

  $recipient_id = $wrapper->field_payment_recipient->value();
  if (empty($recipient_id)) {
    return;
  }

  $rewarded_project = node_load($recipient_id);
  if (!$rewarded_project) {
    return;
  }

  $endpoint = isset($rewarded_project->field_webhook_url[LANGUAGE_NONE][0]['value'])
    ? $rewarded_project->field_webhook_url[LANGUAGE_NONE][0]['value']
    : '';
  if (empty($endpoint)) {
    return;
  }

  // Derive signature using the project owner's API secret, identical to
  // what rovas_project_reward_notify_purchase() does for card/express orders.
  $owner_uid = $rewarded_project->uid;
  $keys = rules_invoke_component('rules_retrieve_user_s_api_key_and_token', $owner_uid, 'rovas_endpoint');
  $secret = $keys[0];

  $token = $intent->callback_token;
  $signature = strtolower(hash_hmac('sha256', $token, $secret));

  $order_total_minor = (int) $wrapper->commerce_order_total->amount->value();
  $email = $order->mail;

  $expiration_webhook = NULL;
  if (!empty($intent->meta)) {
    $meta = drupal_json_decode($intent->meta);
    if (is_array($meta) && isset($meta['expiration']) && is_numeric($meta['expiration'])) {
      $expiration_webhook = (int) $meta['expiration'];
    }
  }
  if ($expiration_webhook === NULL && !empty($intent->callback_expires)) {
    $expiration_webhook = (int) $intent->callback_expires;
  }

  $payload_bank = array(
    'event' => 'payment-completed',
    'token' => $token,
    'signature' => $signature,
    'amount_paid' => $order_total_minor,
    'currency' => 'EUR',
    'email' => $email,
    'occurred_at' => (int) REQUEST_TIME,
  );
  if ($expiration_webhook !== NULL) {
    $payload_bank['expiration'] = $expiration_webhook;
  }

  $options = array(
    'method' => 'POST',
    'data' => drupal_json_encode($payload_bank),
    'headers' => array(
      'Content-Type' => 'application/json',
      'X-Rovas-Event' => 'payment-completed',
    ),
    'timeout' => 5,
  );

  _rovas_project_reward_log_bank_webhook('outbound', $endpoint, $payload_bank);

  $response = drupal_http_request($endpoint, $options);

  _rovas_project_reward_record_outbound_webhook(array(
    'source_module' => 'rovas_project_reward',
    'payment_type' => 'bank',
    'event_type' => 'payment-completed',
    'order_id' => (int) $order->order_id,
    'endpoint' => $endpoint,
    'request_headers' => isset($options['headers']) ? $options['headers'] : array(),
    'request_payload' => $payload_bank,
    'http_code' => isset($response->code) ? (int) $response->code : NULL,
    'response_error' => isset($response->error) ? $response->error : '',
    'response_body' => isset($response->data) ? $response->data : '',
    'status' => (isset($response->code) && (int) $response->code >= 200 && (int) $response->code < 300) ? 'delivered' : 'failed',
  ));

  // Mark as notified before saving, so a concurrent call cannot also send.
  $order->data['rovas_bank_purchase_notified'] = REQUEST_TIME;
  commerce_order_save($order);

  watchdog('rovas_project_reward', 'Bank purchase confirmed: notified 3rd party for order @oid (HTTP @code).', array('@oid' => $order->order_id, '@code' => isset($response->code) ? $response->code : '?'), WATCHDOG_INFO);

  if ((int) $response->code !== 204) {
    $message = 'Bank transfer: unexpected response notifying project <a href="/node/' . $rewarded_project->nid . '">' . $rewarded_project->nid . '</a> for order ' . $order->order_id . '.<p>Response: <pre>' . print_r($response, 1) . '</pre></p>';
    rules_invoke_component('rules_send_email', 'alexanderz@neofund.sk', 'Bank payment notification failure', $message, 'en');
  }
}

/**
 * Implements hook_commerce_payment_transaction_update().
 *
 * Intercepts the admin "confirm bank transfer" form submit path. When a
 * bank_transfer transaction is saved as SUCCESS by commerce_bank_transfer_confirm_form_submit(),
 * Commerce core fires commerce_payment_order_paid_in_full on its own (via
 * hook_commerce_payment_transaction_update in commerce_payment.module). This hook
 * handles the operations that the admin path would otherwise miss:
 *   1. Syncing the rovas_bank_payment_intent record and order->data['sepa'] to 'paid'.
 *   2. Running the merit/chron reward distribution.
 *   3. Sending the buyer bank_transfer_confirmed e-mail (deduped with the Fio path).
 */
function rovas_project_reward_commerce_payment_transaction_update($transaction) {
  if (empty($transaction->payment_method) || $transaction->payment_method !== 'bank_transfer') {
    return;
  }
  if ($transaction->status !== COMMERCE_PAYMENT_STATUS_SUCCESS) {
    return;
  }
  // Skip if the transaction was already SUCCESS before this save (no transition).
  if (isset($transaction->original) && $transaction->original->status === COMMERCE_PAYMENT_STATUS_SUCCESS) {
    return;
  }

  $order = commerce_order_load($transaction->order_id);
  if (!$order) {
    return;
  }

  $did_sync = FALSE;
  // Sync intent table / order->data['sepa'] / partner callback if not already done
  // (e.g. Fio cron may have already called mark_bank_order_success()).
  if (empty($order->data['sepa']['status']) || $order->data['sepa']['status'] !== 'paid') {
    $actual_decimal_amount = commerce_currency_amount_to_decimal($transaction->amount, $transaction->currency_code);
    rovas_project_reward_sync_bank_intent_paid(
      $transaction->order_id,
      !empty($transaction->remote_id) ? $transaction->remote_id : NULL,
      array('confirmed_by_admin' => REQUEST_TIME),
      $actual_decimal_amount
    );
    $did_sync = TRUE;
    // Reload so process_bank_order_reward sees the updated order data.
    $order = commerce_order_load($transaction->order_id);
  }

  rovas_project_reward_process_bank_order_reward($order);

  $order = commerce_order_load($transaction->order_id);
  if ($order) {
    rovas_project_reward_send_bank_transfer_notification($order, 'bank_transfer_confirmed');
  }

  // Match the automatic reconciliation path and deliver the delayed
  // `delayed-confirmed` webhook immediately after the admin-confirmed
  // payment has been persisted and rewards are processed.
  if ($did_sync) {
    rovas_project_reward_process_callback_delivery_queue(5);
  }
}

/**
 * Mark bank order as failed/expired and enqueue delayed-rejected callback.
 */
function rovas_project_reward_mark_bank_order_failed($order_id, $status = 'failed', array $meta = array()) {
  $order = commerce_order_load($order_id);
  if (!$order) {
    return FALSE;
  }

  db_update('rovas_bank_payment_intent')
    ->fields(array(
      'status' => in_array($status, array('expired', 'failed', 'rejected')) ? $status : 'failed',
      'meta' => drupal_json_encode($meta),
      'changed' => REQUEST_TIME,
    ))
    ->condition('order_id', $order_id)
    ->execute();

  $order->data['sepa']['status'] = ($status === 'expired') ? 'expired' : 'failed';
  rovas_project_reward_attach_bank_pi_to_order_data($order);
  commerce_order_save($order);

  // Mirror the success path: update the PENDING Commerce transaction so the
  // failure is visible in the admin payment UI.
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'commerce_payment_transaction')
    ->propertyCondition('order_id', $order_id)
    ->propertyCondition('payment_method', 'bank_transfer')
    ->propertyCondition('status', COMMERCE_PAYMENT_STATUS_PENDING);
  $result = $query->execute();

  if (!empty($result['commerce_payment_transaction'])) {
    $txn_ids = array_keys($result['commerce_payment_transaction']);
    $transaction = commerce_payment_transaction_load(reset($txn_ids));
    $transaction->status = COMMERCE_PAYMENT_STATUS_FAILURE;
    $transaction->message .= '<br />' . t('Failed/rejected: @date',
      array('@date' => format_date(REQUEST_TIME, 'short')));
    commerce_payment_transaction_save($transaction);
  }

  rovas_project_reward_enqueue_delayed_callback($order, 'delayed-rejected');
  rovas_project_reward_process_callback_delivery_queue(5);
  watchdog('rovas_project_reward', 'Bank order @order marked as @status.', array('@order' => $order_id, '@status' => $status), WATCHDOG_WARNING);

  // Notify the buyer about the failure or expiry.
  $mail_key = ($status === 'expired') ? 'bank_transfer_expired' : 'bank_transfer_failed';
  rovas_project_reward_send_bank_transfer_notification($order, $mail_key);

  return TRUE;
}

/**
 * Add delayed callback event to delivery queue.
 */
function rovas_project_reward_enqueue_delayed_callback($order, $event_type) {
  if (empty($order->order_id)) {
    return FALSE;
  }
  if (!in_array($event_type, array('delayed-confirmed', 'delayed-rejected', 'order-placed'), TRUE)) {
    return FALSE;
  }

  $intent = db_select('rovas_bank_payment_intent', 'i')
    ->fields('i')
    ->condition('order_id', $order->order_id)
    ->execute()
    ->fetchObject();
  if (!$intent || empty($intent->callback_token)) {
    return FALSE;
  }

  $endpoint = rovas_project_reward_resolve_partner_endpoint($intent->paytype, $intent->recipient_id);
  if (empty($endpoint)) {
    return FALSE;
  }

  // Include legacy top-level fields (token/signature/amount_paid/currency/email)
  // so existing partner webhook handlers can reuse their immediate-payment logic.
  $token = $intent->callback_token;
  $sig = rovas_project_reward_sign_delayed_payload($token, $intent->recipient_id, $intent->paytype);
  if ($sig === FALSE) {
    return FALSE;
  }
  $amount_paid = isset($intent->amount) ? (int) round((float) $intent->amount * 100) : 0;
  $currency = !empty($intent->currency) ? $intent->currency : 'EUR';
  $email = !empty($order->mail) ? $order->mail : '';

  $expiration_delayed = NULL;
  if (!empty($intent->meta)) {
    $meta_dec = drupal_json_decode($intent->meta);
    if (is_array($meta_dec) && isset($meta_dec['expiration']) && is_numeric($meta_dec['expiration'])) {
      $expiration_delayed = (int) $meta_dec['expiration'];
    }
  }
  if ($expiration_delayed === NULL && !empty($intent->callback_expires)) {
    $expiration_delayed = (int) $intent->callback_expires;
  }

  $delivery_id = 'cb_' . substr(hash('sha256', microtime(TRUE) . mt_rand() . $order->order_id . $event_type), 0, 40);
  $payload = array(
    'event' => $event_type,
    'delivery_id' => $delivery_id,
    // Use integer timestamps for partner simplicity (UNIX epoch seconds).
    'occurred_at' => (int) REQUEST_TIME,
    'token' => $token,
    'signature' => $sig,
    'amount_paid' => $amount_paid,
    'currency' => $currency,
    'email' => $email,
    // Bank intent row status; enum documented in docs/integration/RovasWebhookDelayedEvent.schema.json
    'bank_intent_status' => !empty($intent->status) ? $intent->status : '',
  );
  if ($expiration_delayed !== NULL) {
    $payload['expiration'] = $expiration_delayed;
  }
  // Extra fields for partner debugging and compatibility.
  $payload += array(
    'order' => array(
      'id' => (int) $order->order_id,
      'status' => !empty($order->status) ? $order->status : '',
      'amount' => $amount_paid,
      'currency' => $currency,
      'reference' => !empty($intent->reference) ? $intent->reference : (string) $order->order_id,
    ),
    'payment' => array(
      'method' => 'bank_transfer',
      'provider' => !empty($intent->provider) ? $intent->provider : 'fio',
      'provider_payment_id' => !empty($intent->provider_payment_id) ? $intent->provider_payment_id : '',
    ),
    'context' => array(
      'paytype' => !empty($intent->paytype) ? $intent->paytype : '',
      'recipient_id' => !empty($intent->recipient_id) ? (int) $intent->recipient_id : 0,
      'callback_url' => !empty($intent->callback_url) ? $intent->callback_url : '',
      'token' => $token,
    ),
  );

  db_insert('rovas_bank_callback_delivery')
    ->fields(array(
      'delivery_id' => $delivery_id,
      'order_id' => (int) $order->order_id,
      'intent_id' => $intent->intent_id,
      'event_type' => $event_type,
      'endpoint' => $endpoint,
      'payload' => drupal_json_encode($payload),
      'status' => 'queued',
      'attempts' => 0,
      'next_attempt' => REQUEST_TIME,
      'created' => REQUEST_TIME,
      'changed' => REQUEST_TIME,
    ))
    ->execute();

  return TRUE;
}

/**
 * Deliver queued delayed callbacks.
 */
function rovas_project_reward_process_callback_delivery_queue($limit = 20) {
  // Each attempt may wait for HTTP timeout; many retries in one cron run can
  // exceed default max_execution_time and leave newer queue rows unprocessed.
  if (function_exists('drupal_set_time_limit')) {
    drupal_set_time_limit(240);
  }
  elseif (function_exists('set_time_limit')) {
    @set_time_limit(240);
  }

  $result = db_select('rovas_bank_callback_delivery', 'd')
    ->fields('d')
    ->condition('status', array('queued', 'retrying'), 'IN')
    ->condition('next_attempt', REQUEST_TIME, '<=')
    ->orderBy('next_attempt', 'ASC')
    ->range(0, $limit)
    ->execute();

  foreach ($result as $row) {
    $payload_arr = drupal_json_decode($row->payload);
    if (!is_array($payload_arr)) {
      rovas_project_reward_mark_callback_delivery_dead($row->id, 0, 'Invalid JSON payload');
      continue;
    }
    // Spec uses top-level token; nested context.token is for compatibility.
    $has_token = !empty($payload_arr['token']);
    if (!$has_token && isset($payload_arr['context']) && is_array($payload_arr['context'])) {
      $has_token = !empty($payload_arr['context']['token']);
    }
    if (!$has_token) {
      rovas_project_reward_mark_callback_delivery_dead($row->id, 0, 'Missing token');
      continue;
    }

    $idempotency = $row->delivery_id;
    $headers = array(
      'X-Rovas-Event' => $row->event_type,
      'X-Rovas-Delivery-Id' => $idempotency,
    );

    // Deliver delayed callbacks via POST with JSON payload.
    $payload_arr['event'] = isset($payload_arr['event']) ? $payload_arr['event'] : $row->event_type;
    $payload_arr['delivery_id'] = isset($payload_arr['delivery_id']) ? $payload_arr['delivery_id'] : $idempotency;
    $payload_arr['occurred_at'] = isset($payload_arr['occurred_at']) ? (int) $payload_arr['occurred_at'] : (int) REQUEST_TIME;
    unset($payload_arr['delayed']);
    if (isset($payload_arr['amount_paid'])) {
      $payload_arr['amount_paid'] = (int) $payload_arr['amount_paid'];
    }

    _rovas_project_reward_log_bank_webhook('outbound', $row->endpoint, $payload_arr);

    $response = drupal_http_request($row->endpoint, array(
      'method' => 'POST',
      'data' => drupal_json_encode($payload_arr),
      'headers' => $headers + array('Content-Type' => 'application/json'),
      'timeout' => 8,
    ));

    _rovas_project_reward_record_outbound_webhook(array(
      'source_module' => 'rovas_project_reward',
      'payment_type' => 'bank',
      'event_type' => !empty($row->event_type) ? $row->event_type : 'delayed',
      'order_id' => isset($row->order_id) ? (int) $row->order_id : NULL,
      'delivery_id' => !empty($row->delivery_id) ? $row->delivery_id : '',
      'attempt' => isset($row->attempts) ? ((int) $row->attempts + 1) : 1,
      'endpoint' => $row->endpoint,
      'request_headers' => $headers + array('Content-Type' => 'application/json'),
      'request_payload' => $payload_arr,
      'http_code' => isset($response->code) ? (int) $response->code : NULL,
      'response_error' => isset($response->error) ? $response->error : '',
      'response_body' => isset($response->data) ? $response->data : '',
      'status' => (isset($response->code) && (int) $response->code >= 200 && (int) $response->code < 300) ? 'delivered' : 'failed',
    ));

    $code = isset($response->code) ? (int) $response->code : 0;
    if ($code >= 200 && $code < 300) {
      db_update('rovas_bank_callback_delivery')
        ->fields(array(
          'status' => 'delivered',
          'attempts' => (int) $row->attempts + 1,
          'last_http_code' => $code,
          'last_error' => '',
          'changed' => REQUEST_TIME,
        ))
        ->condition('id', $row->id)
        ->execute();
    }
    else {
      $error = !empty($response->error) ? $response->error : 'HTTP ' . $code;
      rovas_project_reward_mark_callback_delivery_retry($row, $code, $error);
    }
  }
}

/**
 * Retry/backoff handling for callback queue.
 */
function rovas_project_reward_mark_callback_delivery_retry($row, $http_code, $error) {
  $attempts = (int) $row->attempts + 1;
  $max_attempts = (int) variable_get('rovas_bank_callback_max_attempts', 6);
  if ($attempts >= $max_attempts) {
    rovas_project_reward_mark_callback_delivery_dead($row->id, $http_code, $error);
    return;
  }

  $backoff = array(60, 300, 900, 3600, 21600, 86400);
  $delay = isset($backoff[$attempts - 1]) ? $backoff[$attempts - 1] : 86400;
  db_update('rovas_bank_callback_delivery')
    ->fields(array(
      'status' => 'retrying',
      'attempts' => $attempts,
      'next_attempt' => REQUEST_TIME + $delay,
      'last_http_code' => $http_code,
      'last_error' => substr((string) $error, 0, 1024),
      'changed' => REQUEST_TIME,
    ))
    ->condition('id', $row->id)
    ->execute();
}

/**
 * Move callback delivery to dead-letter terminal state.
 */
function rovas_project_reward_mark_callback_delivery_dead($id, $http_code, $error) {
  db_update('rovas_bank_callback_delivery')
    ->fields(array(
      'status' => 'dead_letter',
      'last_http_code' => $http_code,
      'last_error' => substr((string) $error, 0, 1024),
      'changed' => REQUEST_TIME,
    ))
    ->condition('id', $id)
    ->execute();
}

/**
 * Resolve partner webhook endpoint from reward target.
 */
function rovas_project_reward_resolve_partner_endpoint($paytype, $recipient_id) {
  if (!is_numeric($recipient_id)) {
    return '';
  }

  if ($paytype === 'project') {
    $node = node_load($recipient_id);
    return (!empty($node->field_webhook_url[LANGUAGE_NONE][0]['value'])) ? $node->field_webhook_url[LANGUAGE_NONE][0]['value'] : '';
  }
  if ($paytype === 'wreport') {
    $report = node_load($recipient_id);
    if (!empty($report->field__asset_owning_project[LANGUAGE_NONE][0]['target_id'])) {
      $project = node_load($report->field__asset_owning_project[LANGUAGE_NONE][0]['target_id']);
      if (!empty($project->field_webhook_url[LANGUAGE_NONE][0]['value'])) {
        return $project->field_webhook_url[LANGUAGE_NONE][0]['value'];
      }
    }
  }
  return '';
}

/**
 * Return secret used for delayed callback signature generation.
 */
function rovas_project_reward_sign_delayed_payload($token, $recipient_id, $paytype) {
  if (empty($token) || !is_numeric($recipient_id)) {
    return FALSE;
  }

  $owner_uid = 0;
  if ($paytype === 'project') {
    $node = node_load($recipient_id);
    if (!empty($node->uid)) {
      $owner_uid = $node->uid;
    }
  }
  elseif ($paytype === 'wreport') {
    $node = node_load($recipient_id);
    if (!empty($node->uid)) {
      $owner_uid = $node->uid;
    }
  }

  if (!$owner_uid) {
    return FALSE;
  }

  $keys = rules_invoke_component('rules_retrieve_user_s_api_key_and_token', $owner_uid, 'rovas_endpoint');
  if (empty($keys[0])) {
    return FALSE;
  }

  return strtolower(hash_hmac('sha256', $token, $keys[0]));
}

// ---------------------------------------------------------------------------
// Bank transfer reconciliation notification emails
// ---------------------------------------------------------------------------

/**
 * Implements hook_theme().
 */
function rovas_project_reward_theme() {
  return array(
    'commerce_bank_transfer_notification' => array(
      'variables' => array(
        'mail_key'    => NULL,
        'content'     => '',
        'order_id'    => NULL,
        'target_lang' => NULL,
        'base_url'    => '',
        'site_mail'   => '',
      ),
      'template' => 'commerce-bank-transfer-notification',
      'path'     => drupal_get_path('module', 'rovas_project_reward') . '/templates',
    ),
  );
}

/**
 * Implements hook_mail().
 *
 * Handles four reconciliation-outcome mail keys:
 *   bank_transfer_confirmed, bank_transfer_mismatch,
 *   bank_transfer_failed,    bank_transfer_expired.
 */
function rovas_project_reward_mail($key, &$message, $params) {
  $allowed = array(
    'bank_transfer_confirmed',
    'bank_transfer_mismatch',
    'bank_transfer_failed',
    'bank_transfer_expired',
    'bank_transfer_overpayment_admin',
  );
  if (!in_array($key, $allowed, TRUE)) {
    return;
  }

  $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
  $message['subject'] = isset($params['subject']) ? $params['subject'] : '';
  if ($key === 'bank_transfer_overpayment_admin') {
    $message['body'][] = _rovas_project_reward_admin_overpayment_notification_content($params);
    return;
  }

  $message['body'][] = theme('commerce_bank_transfer_notification', array(
    'mail_key'    => $key,
    'content'     => _rovas_project_reward_bank_notification_content($key, $params),
    'order_id'    => isset($params['order_id']) ? $params['order_id'] : '',
    'target_lang' => isset($params['target_lang']) ? $params['target_lang'] : language_default()->language,
    'base_url'    => isset($params['base_url']) ? $params['base_url'] : url('', array('absolute' => TRUE)),
    'site_mail'   => variable_get('site_mail', ''),
  ));
}

/**
 * Build the HTML body for site-admin overpayment notifications.
 */
function _rovas_project_reward_admin_overpayment_notification_content(array $params) {
  $order_id = isset($params['order_id']) ? (int) $params['order_id'] : 0;
  $expected_amount = isset($params['expected_amount']) ? (float) $params['expected_amount'] : 0.0;
  $actual_amount   = isset($params['actual_amount']) ? (float) $params['actual_amount'] : 0.0;
  $currency = isset($params['currency']) && !empty($params['currency']) ? (string) $params['currency'] : 'EUR';
  $review_url = isset($params['review_url']) ? (string) $params['review_url'] : '';

  $expected_str = number_format($expected_amount, 2, '.', '') . ' ' . $currency;
  $actual_str   = number_format($actual_amount, 2, '.', '') . ' ' . $currency;

  $review_link = !empty($review_url)
    ? '<a href="' . check_url($review_url) . '">' . check_plain(t('Rewpro bank payment review')) . '</a>'
    : '';

  $content  = '<p>' . t('Overpayment received for Order #@id.', array('@id' => $order_id)) . '</p>';
  $content .= '<p>' . t('Requested amount: <strong>@expected</strong>', array('@expected' => $expected_str)) . '</p>';
  $content .= '<p>' . t('Actually paid: <strong>@actual</strong>', array('@actual' => $actual_str)) . '</p>';

  if ($review_link) {
    $content .= '<p>' . t('Reconcile here: !review', array('!review' => $review_link)) . '</p>';
  }

  return $content;
}

/**
 * Implements hook_rules_action_info_alter().
 *
 * Routes invoice send action through custom wrapper so express-checkout
 * buyshares can be deferred until webhook processing fully finalizes.
 */
function rovas_project_reward_rules_action_info_alter(&$actions) {
  if (isset($actions['commerce_invoice_receipt_action_mail']['callbacks']['execute'])) {
    $actions['commerce_invoice_receipt_action_mail']['callbacks']['execute'] = 'rovas_project_reward_commerce_invoice_receipt_action_mail_execute';
  }
}

/**
 * Wrapper for commerce invoice action mail with express buyshares timing guard.
 */
function rovas_project_reward_commerce_invoice_receipt_action_mail_execute($order, $to, $subject, $from = NULL) {
  if (empty($order->order_id) || !function_exists('commerce_invoice_receipt_action_mail')) {
    return;
  }

  $order = commerce_order_load($order->order_id, TRUE);
  if (!$order) {
    return;
  }

  if (rovas_project_reward_is_express_buyshares_order($order)) {
    if (!empty($order->data['rovas_express_invoice_sent'])) {
      return;
    }
    if (empty($order->data['rovas_express_invoice_ready'])) {
      return;
    }
  }

  global $user;
  $original_user = $user;
  $acting_user = user_load($order->uid);
  if ($acting_user && !empty($acting_user->uid)) {
    $user = $acting_user;
  }
  commerce_invoice_receipt_action_mail($order, $to, $subject, $from);
  $user = $original_user;

  if (rovas_project_reward_is_express_buyshares_order($order)) {
    $order = commerce_order_load($order->order_id, TRUE);
    if ($order) {
      if (!isset($order->data) || !is_array($order->data)) {
        $order->data = array();
      }
      $order->data['rovas_express_invoice_sent'] = REQUEST_TIME;
      commerce_order_save($order);
    }
  }
}

/**
 * TRUE when order came from express checkout buyshares flow.
 */
function rovas_project_reward_is_express_buyshares_order($order) {
  if (empty($order) || empty($order->order_id)) {
    return FALSE;
  }
  if (empty($order->data) || !is_array($order->data)) {
    return FALSE;
  }
  if (empty($order->data['stripe_pi']['payment_intent']['metadata'])) {
    return FALSE;
  }
  $meta = $order->data['stripe_pi']['payment_intent']['metadata'];
  if (empty($meta['context']) || $meta['context'] !== 'express_checkout') {
    return FALSE;
  }
  return !empty($meta['paytype']) && ($meta['paytype'] === 'buyshares' || $meta['paytype'] === 'buymerits');
}

/**
 * Implements hook_mail_alter().
 *
 * Safety net for Express buyshares invoices: if invoice render returns
 * "No line items found.", replace it with direct line-item markup.
 */
/**
 * Notify the site admin when a bank transfer overpayment is detected.
 */
function rovas_project_reward_notify_site_admin_overpayment($order, $expected_amount, $actual_amount) {
  $admin_email = variable_get('site_mail', '');
  if (empty($admin_email)) {
    return FALSE;
  }

  $currency = !empty($order->data['sepa']['currency']) ? $order->data['sepa']['currency'] : 'EUR';
  $review_url = url('admin/commerce/orders/rewpro-bank-review', array(), array('absolute' => TRUE));

  drupal_mail(
    'rovas_project_reward',
    'bank_transfer_overpayment_admin',
    $admin_email,
    language_default()->language,
    array(
      'subject' => t('Rovas: Overpayment received – Order #@id', array('@id' => $order->order_id)),
      'order_id' => (int) $order->order_id,
      'expected_amount' => (float) $expected_amount,
      'actual_amount' => (float) $actual_amount,
      'currency' => $currency,
      'review_url' => $review_url,
    )
  );

  return TRUE;
}

/**
 * Send a bank transfer reconciliation notification to the buyer.
 *
 * @param object $order
 *   Loaded Commerce order entity.
 * @param string $mail_key
 *   One of: bank_transfer_confirmed, bank_transfer_mismatch,
 *            bank_transfer_failed, bank_transfer_expired.
 * @param array $extra_params
 *   Extra key/value pairs merged into $params (e.g. actual_amount for
 *   confirmed/mismatch and expected_amount for mismatch).
 *
 * @return bool
 *   TRUE if the message was sent or bank_transfer_confirmed was already sent
 *   for this order; FALSE if there is no e-mail address or sending failed.
 */
function rovas_project_reward_send_bank_transfer_notification($order, $mail_key, array $extra_params = array()) {
  if (empty($order->mail)) {
    return FALSE;
  }

  if ($mail_key === 'bank_transfer_confirmed') {
    $existing = commerce_order_load($order->order_id);
    if ($existing && !empty($existing->data['rpr_bank_transfer_confirmed_mail_sent'])) {
      watchdog('rovas_project_reward', 'Skipped duplicate @key notification for order @oid (already sent).', array('@key' => $mail_key, '@oid' => $order->order_id), WATCHDOG_INFO);
      return TRUE;
    }
  }

  // Determine target language, mirroring the invoice template logic.
  $target_lang = language_default()->language;
  if (!empty($order->data['stripe_pi']['payment_intent']['metadata']['language_mapped'])) {
    $target_lang = $order->data['stripe_pi']['payment_intent']['metadata']['language_mapped'];
  }
  elseif (!empty($order->uid)) {
    $account = user_load($order->uid);
    if ($account && !empty($account->language)) {
      $target_lang = $account->language;
    }
  }

  // Resolve recipient display name.
  $recipient_name = '';
  if (!empty($order->field_payment_recipient[LANGUAGE_NONE][0]['value'])) {
    $recipient_id = $order->field_payment_recipient[LANGUAGE_NONE][0]['value'];
    $payer_type = !empty($order->field_payer_type[LANGUAGE_NONE][0]['value'])
      ? $order->field_payer_type[LANGUAGE_NONE][0]['value']
      : 'project';
    try {
      if ($payer_type === 'user') {
        $wrapper = entity_metadata_wrapper('user', $recipient_id);
        $recipient_name = $wrapper->field_full_name->value() . ' (' . $wrapper->label() . ')';
      }
      else {
        $wrapper = entity_metadata_wrapper('node', $recipient_id);
        $recipient_name = $wrapper->label();
      }
    }
    catch (Exception $e) {
      watchdog('rovas_project_reward', 'Could not resolve recipient name for order @oid: @err', array('@oid' => $order->order_id, '@err' => $e->getMessage()), WATCHDOG_WARNING);
    }
  }

  // Load bank intent for 3rd-party context (callback_token, callback_context,
  // product_name persisted in intent->meta at order creation).
  $callback_token   = '';
  $callback_context = '';
  $product_name     = '';
  $intent = db_select('rovas_bank_payment_intent', 'i')
    ->fields('i')
    ->condition('order_id', (int) $order->order_id)
    ->execute()
    ->fetchObject();
  if ($intent) {
    $callback_token = !empty($intent->callback_token) ? $intent->callback_token : '';
    $meta = !empty($intent->meta) ? drupal_json_decode($intent->meta) : array();
    $callback_context = !empty($meta['callback_context']) ? $meta['callback_context'] : '';
    $product_name     = !empty($meta['product_name'])     ? $meta['product_name']     : '';
  }

  global $base_url;

  $display_amount = NULL;
  if (isset($extra_params['actual_amount']) && is_numeric($extra_params['actual_amount'])) {
    $display_amount = (float) $extra_params['actual_amount'];
  }
  elseif (!empty($order->data['sepa']['amount']) && is_numeric($order->data['sepa']['amount'])) {
    $display_amount = (float) $order->data['sepa']['amount'];
  }
  $order_amount = ($display_amount !== NULL) ? number_format($display_amount, 2, '.', '') : '';
  $order_date = !empty($order->created) ? format_date($order->created, 'medium') : '';

  $params = array(
    'order'            => $order,
    'order_id'         => $order->order_id,
    'order_amount'     => $order_amount,
    'order_date'       => $order_date,
    'order_mail'       => $order->mail,
    'recipient_name'   => $recipient_name,
    'target_lang'      => $target_lang,
    'callback_token'   => $callback_token,
    'callback_context' => $callback_context,
    'product_name'     => $product_name,
    'base_url'         => $base_url,
  ) + $extra_params;

  // Build localised subject line.
  switch ($mail_key) {
    case 'bank_transfer_confirmed':
      $params['subject'] = t('Rovas: Payment confirmed – Order #@id', array('@id' => $order->order_id), array('langcode' => $target_lang));
      break;

    case 'bank_transfer_mismatch':
      $actual   = isset($extra_params['actual_amount'])   ? (float) $extra_params['actual_amount']   : 0;
      $expected = isset($extra_params['expected_amount']) ? (float) $extra_params['expected_amount'] : 0;
      if ($actual < $expected) {
        $params['subject'] = t('Rovas: Incomplete payment received – Order #@id', array('@id' => $order->order_id), array('langcode' => $target_lang));
      }
      else {
        $params['subject'] = t('Rovas: Overpayment received – Order #@id', array('@id' => $order->order_id), array('langcode' => $target_lang));
      }
      break;

    case 'bank_transfer_failed':
      $params['subject'] = t('Rovas: Payment could not be processed – Order #@id', array('@id' => $order->order_id), array('langcode' => $target_lang));
      break;

    case 'bank_transfer_expired':
      $params['subject'] = t('Rovas: Payment window expired – Order #@id', array('@id' => $order->order_id), array('langcode' => $target_lang));
      break;

    default:
      $params['subject'] = t('Rovas: Order #@id notification', array('@id' => $order->order_id), array('langcode' => $target_lang));
  }

  $mail_result = drupal_mail('rovas_project_reward', $mail_key, $order->mail, $target_lang, $params);
  if (empty($mail_result['result'])) {
    watchdog('rovas_project_reward', 'Failed to send @key notification for order @oid to @mail.', array('@key' => $mail_key, '@oid' => $order->order_id, '@mail' => $order->mail), WATCHDOG_WARNING);
    return FALSE;
  }

  watchdog('rovas_project_reward', 'Sent @key notification for order @oid to @mail.', array('@key' => $mail_key, '@oid' => $order->order_id, '@mail' => $order->mail), WATCHDOG_INFO);

  if ($mail_key === 'bank_transfer_confirmed') {
    $order_reload = commerce_order_load($order->order_id);
    if ($order_reload) {
      if (!isset($order_reload->data) || !is_array($order_reload->data)) {
        $order_reload->data = array();
      }
      $order_reload->data['rpr_bank_transfer_confirmed_mail_sent'] = REQUEST_TIME;
      commerce_order_save($order_reload);
    }
  }

  return TRUE;
}

/**
 * Build the outcome-specific HTML content block for the notification email.
 *
 * Returns an HTML string with <p> elements only — the wrapper chrome (logo,
 * header, footer) is handled by the template.
 *
 * @param string $mail_key
 *   The mail key identifying the outcome.
 * @param array $params
 *   Parameters array from rovas_project_reward_send_bank_transfer_notification().
 *
 * @return string
 *   HTML content block.
 */
function _rovas_project_reward_bank_notification_content($mail_key, array $params) {
  $order_id      = isset($params['order_id'])      ? check_plain($params['order_id'])      : '';
  $order_amount  = isset($params['order_amount'])  ? check_plain($params['order_amount'])  : '';
  $order_date    = isset($params['order_date'])     ? check_plain($params['order_date'])    : '';
  $recipient_name = isset($params['recipient_name']) ? check_plain($params['recipient_name']) : '';
  $target_lang   = isset($params['target_lang'])   ? $params['target_lang']                : language_default()->language;

  $content = '';

  switch ($mail_key) {

    case 'bank_transfer_confirmed':
      $content .= '<p>' . t('We have received and confirmed your bank transfer of <strong>€@amount</strong> for Order #@id placed on @date.',
        array('@amount' => $order_amount, '@id' => $order_id, '@date' => $order_date),
        array('langcode' => $target_lang)) . '</p>';

      if ($recipient_name) {
        $content .= '<p>' . t('Your order is now complete and your payment was sent to <strong>@recipient</strong>.',
          array('@recipient' => $recipient_name),
          array('langcode' => $target_lang)) . '</p>';
      }
      else {
        $content .= '<p>' . t('Your order is now complete.', array(), array('langcode' => $target_lang)) . '</p>';
      }

      // 3rd-party return sentence — only when the order originated from an
      // external site (non-empty callback_token) and a return URL is known.
      if (!empty($params['callback_token']) && !empty($params['callback_context'])) {
        $site_url   = $params['callback_context'];
        $site_host  = @parse_url($site_url, PHP_URL_HOST);
        $site_label = $site_host ? check_plain($site_host) : check_plain($site_url);
        $site_link  = '<a href="' . check_url($site_url) . '">' . $site_label . '</a>';

        if (!empty($params['product_name'])) {
          $content .= '<p>' . t('You can now access the product or service <strong>@product</strong> you purchased at !site_link.',
            array('@product' => check_plain($params['product_name']), '!site_link' => $site_link),
            array('langcode' => $target_lang)) . '</p>';
        }
        else {
          $content .= '<p>' . t('You can now return to !site_link to access your purchase.',
            array('!site_link' => $site_link),
            array('langcode' => $target_lang)) . '</p>';
        }
      }

      $content .= '<p>' . t('Thank you for your support.', array(), array('langcode' => $target_lang)) . '</p>';
      break;

    case 'bank_transfer_mismatch':
      $actual_f   = isset($params['actual_amount'])   ? (float) $params['actual_amount']   : NULL;
      $expected_f = isset($params['expected_amount']) ? (float) $params['expected_amount'] : NULL;
      $actual_str   = $actual_f   !== NULL ? number_format($actual_f,   2, '.', '') : '?';
      $expected_str = $expected_f !== NULL ? number_format($expected_f, 2, '.', '') : '?';
      $diff_str     = ($actual_f !== NULL && $expected_f !== NULL)
        ? number_format(abs($actual_f - $expected_f), 2, '.', '')
        : '?';

      if ($actual_f !== NULL && $expected_f !== NULL && $actual_f < $expected_f) {
        $content .= '<p>' . t('We received a bank transfer of <strong>€@actual</strong> for Order #@id, but the expected amount was <strong>€@expected</strong> (difference: <strong>€@diff</strong>).',
          array('@actual' => $actual_str, '@id' => $order_id, '@expected' => $expected_str, '@diff' => $diff_str),
          array('langcode' => $target_lang)) . '</p>';
        $content .= '<p>' . t('Your order is currently on hold pending manual review. To resolve this, please transfer the outstanding <strong>€@diff</strong> using the same payment reference, or contact us for assistance.',
          array('@diff' => $diff_str),
          array('langcode' => $target_lang)) . '</p>';
      }
      else {
        $content .= '<p>' . t('We received a bank transfer of <strong>€@actual</strong> for Order #@id, but the expected amount was only <strong>€@expected</strong> (overpayment: <strong>€@diff</strong>).',
          array('@actual' => $actual_str, '@id' => $order_id, '@expected' => $expected_str, '@diff' => $diff_str),
          array('langcode' => $target_lang)) . '</p>';
        $content .= '<p>' . t('Your order is on hold pending manual review. Please contact us to arrange return of the overpaid amount.',
          array(), array('langcode' => $target_lang)) . '</p>';
      }
      break;

    case 'bank_transfer_failed':
      $content .= '<p>' . t('Unfortunately, your bank transfer payment for Order #@id has been rejected or could not be processed by your bank.',
        array('@id' => $order_id),
        array('langcode' => $target_lang)) . '</p>';
      $content .= '<p>' . t('If you believe this is an error, please contact your bank or reach out to us quoting your order number.',
        array(), array('langcode' => $target_lang)) . '</p>';
      break;

    case 'bank_transfer_expired':
      $content .= '<p>' . t('The payment window for Order #@id has expired. We have not received a matching bank transfer for this order.',
        array('@id' => $order_id),
        array('langcode' => $target_lang)) . '</p>';
      $content .= '<p>' . t('If you still wish to complete your purchase, please place a new order or contact us.',
        array(), array('langcode' => $target_lang)) . '</p>';
      break;
  }

  return $content;
}