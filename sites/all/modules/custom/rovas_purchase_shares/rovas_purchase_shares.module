<?php

/**
 * @file
 * Code for the purchase shares feature.
 */

include_once 'rovas_purchase_shares.inc';


/**
* Implementation of hook_menu().
*/
function rovas_purchase_shares_menu() {
  $items = array();

  $items['buyshares/%'] = array(
    'title' => t('Project investing'),
    'description' => t('Redirect to unified purchase flow.'),
    'page callback' => 'rovas_purchase_shares_redirect_to_rewpro',
    'page arguments' => array(1),
    'access callback' => 'rovas_purchase_shares_access',
  );

  return $items;
}

/**
 * Menu callback: legacy /buyshares/{nid} → unified rewpro flow.
 */
function rovas_purchase_shares_redirect_to_rewpro($proj_id) {
  if (!is_numeric($proj_id) || (int) $proj_id < 1) {
    drupal_not_found();
    return;
  }
  drupal_goto('rewpro', array(
    'query' => array(
      'paytype' => 'buyshares',
      'recipient' => (string) (int) $proj_id,
    ),
  ));
}

//render a page that allows users to purchase shares
function rovas_purchase_shares_form ($form, &$form_state,$proj_id) {

	//the project info
	$obj = entity_metadata_wrapper('node',$proj_id);

	if($obj->field_allow_purchasing_shares->value() == 1) {

		$storage = isset($form_state['storage']['old-payment-choice']) ? $form_state['storage']['old-payment-choice'] : -1;
		$payment_choice = isset($form_state['values']['payment-choice']) ? $form_state['values']['payment-choice'] : -1;

		//erase the buy amount when switching currencies
		if ($storage != $payment_choice) {
			$paymentChanged = TRUE;
			$form_state['input']['buy_amount'] = NULL;
		}
		else {
			$paymentChanged = FALSE;
		}

		global $user;

		//the buyer info
		$chronsary = rules_invoke_component('rules_chrons_actually_available',$user);
		$chrons = $chronsary[0];

		$rate_chrons = $obj->field_rate->value();
		$rate_euros = $obj->field_time_share_cost_euros->value() ?: NULL;
		$minimum_amount_time = $obj->field_minimum_time->value() > 0 ? $obj->field_minimum_time->value() : 0;
		
		$currency = isset($form_state['values']['payment-choice']) ? ((int)$form_state['values']['payment-choice'] === 1 ? 'EUR' : 'CHR') : 'CHR';

		if ($currency == 'EUR') {
			$sub_label = t('Next');
			$cur_suffix = t('€');
			$minimum_payment = $minimum_amount_time * $rate_euros;
			$widget_default = round($minimum_payment > 0 ? $minimum_payment : 1);
			$input_displ = 'block';
		}
		else if ($currency == 'CHR') {
			$sub_label = t('Buy');
			$cur_suffix = t('CH');
			$minimum_payment = $minimum_amount_time * $rate_chrons;
			$widget_default = round($minimum_payment > 0 ? $minimum_payment : 1);
			$input_displ = 'block';
		}
		else {
			$sub_label = t('Next');
			$cur_suffix = NULL;
			$minimum_payment = NULL;
			$widget_default = NULL;
			$input_displ = 'none';
		}

		$author_uid = $obj->author->uid->value();

		$projname = $obj->label();
		$projurl = '/node/' . $proj_id;

		$note = '<div class="note">';
		$note .= '<div class="note-strong">';
		$note .= t('Project');
		$note .= ': <a href="'.$projurl.'">';
		$note .= $projname;
		$note .= '</a>';
		$note .= '</div>';
		$note .= t('Use your Chrons or Euros to buy timeshares for this project.');
		$note .= '<br>';
		$note .= t('One timeshare will earn the same amount of Merits as one hour of time, worked in the project.');
		$note .= '</div>';

		$form['description'] = array(
			'#type' => 'markup',
			'#markup' => $note,
			'#weight' => 1,
		);
	
		$form['chrons'] = array('#type' => 'hidden','#value' => $chrons);
		$form['widget_default'] = array('#type' => 'hidden','#value' => $widget_default);
		$form['minimum_payment'] = array('#type' => 'hidden','#value' => $minimum_payment);
		$form['proj_id'] = array('#type' => 'hidden','#value' => $proj_id);

		if ($currency == 'EUR') {
			if ($paymentChanged || !isset($form_state['values']['buy_amount']) || empty($form_state['values']['buy_amount'])) {
				$hour_shares = $widget_default / $rate_euros;
				$convary = rovas_purchase_shares_stripe_convertor($widget_default, $hour_shares * 60);
				$hour_shares = $convary['units']/60;
			}
			else {
				$hour_shares = $form_state['values']['buy_amount'] / $rate_euros;
				$convary = rovas_purchase_shares_stripe_convertor($form_state['values']['buy_amount'], $hour_shares * 60);
				$hour_shares = $convary['units']/60;
			}
		}
		else if ($currency == 'CHR') {
			if ($paymentChanged || !isset($form_state['values']['buy_amount']) || empty($form_state['values']['buy_amount'])) {
				$hour_shares = $widget_default / $rate_chrons;
			}
			else {
				$hour_shares = $form_state['values']['buy_amount'] / $rate_chrons;
			}
		}
		else {
			$hour_shares = 0;
		}

		$form['performance'] = array(
			'#type' => 'fieldset', 
			'#title' => t('Project data'), 
			'#weight' => 3, 
			'#attributes' => array('class' => array('collapsed collapsed')),
			'#collapsible' => TRUE, 
			'#collapsed' => TRUE,
		);

		$me_view = views_embed_view('project_merit_rewards_chart','page',$proj_id);

		$me_history = '<div class="form-item form-item-chart form-type-textfield">';
		$me_history .= '<label class="field-label">';
		$me_history .= t('Labor time and Merit reward history');
		$me_history .= '</label>';
		$me_history .= '<div class="me-history">';
		$me_history .= $me_view;
		$me_history .= '</div>';
		$me_history .= '</div>';

		$yield = rovas_purchase_shares_yield($obj);
		$yield = round($yield,2);

		$yield_markup = '<div class="form-item form-item-yield form-type-textfield">';
		$yield_markup .= '<label class="field-label">';
		$yield_markup .= t('Current yield');
		$yield_markup .= '</label>';
		$yield_markup .= '<div class="yield">';
		$yield_markup .= '<span class="yield-value">';
		$yield_markup .= $yield;
		$yield_markup .= ' ';
		$yield_markup .= '</span>';
		$yield_markup .= '<span class="yield-unit">';
		$yield_markup .= t('ME/100 CH /1 hour');
		$yield_markup .= '</span>';
		$yield_markup .= '</div>';
		$yield_markup .= '<div class="help-block">';
		$yield_markup .= t('The number of Merits one (hour) timeshare receives when the project is rewarded  with 100 Chrons');
		$yield_markup .= '</div>';
		$yield_markup .= '</div>';

		$form['performance']['yield'] = array(
			'#type' => 'markup', 
			'#markup' => $yield_markup,
		);

		$rateEuros = $obj->field_time_share_cost_euros->value();

		$rate_markup = '<div class="form-item form-item-rate form-type-textfield field-label-inline">';
		$rate_markup .= '<label class="field-label">';
		$rate_markup .= t('Timeshare cost') . ': ';
		$rate_markup .= '</label>';
		$rate_markup .= '<div class="rate">';
		$rate_markup .= '<span class="rate-value">';
		$rate_markup .= $rate_chrons;
		$rate_markup .= ' ';
		$rate_markup .= '</span>';
		$rate_markup .= '<span class="rate-unit">';
		$rate_markup .= t('CH');
		$rate_markup .= '</span>';
		if ($rateEuros) {
			$rate_markup .= '<span class="rate-value">';
			$rate_markup .= ' / ' . $rateEuros;
			$rate_markup .= ' ';
			$rate_markup .= '</span>';
			$rate_markup .= '<span class="rate-unit">';
			$rate_markup .= t('€');
			$rate_markup .= '</span>';
		}
		$rate_markup .= '</div>';
		$rate_markup .= '<div class="help-block">';
		$rate_markup .= t('The cost of one hour share');
		$rate_markup .= '</div>';
		$rate_markup .= '</div>';

		$form['performance']['rate'] = array(
			'#type' => 'markup', 
			'#markup' => $rate_markup,
		);


		$form['performance']['chart'] = array(
			'#type' => 'markup', 
			'#markup' => $me_history,
		);


	/* Buy Shares */

		$form['buy-hrs'] = [
			'#type' => 'markup',
			'#prefix' => '<div class="buy-hrs-wrapper">',
			'#suffix' => '</div>',
			'#weight' => 6,
		];

		$form['buy-hrs']['buy-hrs-markup'] = array(
			'#type' => 'markup',
			'#markup' => '<div class="forex subhead">' . t('Buy time share') . '</div>',
		);
		
		//payment type selector
		$form['buy-hrs']['payment-choice'] = [
			'#type' => 'radios',
			'#title' => t('Select payment type'),
			'#default_value' => 0,
			'#options' => [
				0 => t('Chrons'),
				1 => t('Euros')
			],
			'#ajax' => [
				'callback' => '_switch_payment_currency',
				'effect' => 'fade',
				],
		];

		$balance_text = '<div class="chron-balance">';
		$balance_text .= '<h2 class="block-title">';
		$balance_text .= t('Chron balance');
		$balance_text .= '</h2>';
		$balance_text .= '<div class="available-chrons">';
		$balance_text .= '<div class="field-content">';
		$balance_text .= $chrons . ' ' . t('CH');
		$balance_text .= '</div>';
		$balance_text .= '</div>';
		$balance_text .= '</div>';

		$form['buy-hrs']['balance'] = [
			'#markup' => $balance_text,
			'#access' => TRUE,
		];

		$form['buy-hrs']['newline'] = [
			'#markup' => '<div id="newline" style="display:block"></div>',
		];

		$form['buy-hrs']['buy_amount'] = [	
			'#type' => 'textfield', 
			'#default_value' => $widget_default,
			'#field_suffix' => $cur_suffix,
			'#attributes' => array('class' => array('input')),
			'#size' => 60,
			'#maxlength' => 128,
			'#required' => TRUE,
		];

		$form['buy-hrs']['convert']['button'] = [
			'#type' => 'button',
			'#name' => 'con_chr_hrs',
			'#button_type' => 'button',
			'#value' => '<span class="glyphicon glyphicon-refresh"> </span>', //recalculate icon
			"#submit" => [],
			'#ajax' => [
				'callback' => '_convert_chr_hrs',
				'effect' => 'fade',
				],
		];

		$form['buy-hrs-converted-value'] = array(
				'#type' => 'hidden',
				'#value' => $hour_shares,
			);

		$hours = floor($hour_shares);
		$hours_formated = $hours ? $hours . '<span class="to-unit"> ' . t('hrs') . '</span>' : '';
		$minutes = ($hour_shares - $hours) * 60;
		$minutes_formated = $minutes ? round($minutes,0) . '<span class="to-unit"> ' . t('min') . '</span>' : '';
		$comma = !empty($hours_formated) && !empty($minutes_formated) ? ' ' : '';

		$form['buy-hrs']['buy-hrs-converted'] = [
			'#type' => 'item',
			'#prefix' => '<div id="buy-hrs-converted">',
			'#suffix' => '</div>',
			'#markup' => $hours_formated . $comma . $minutes_formated,
		];
	
		$new_yield = rovas_purchase_shares_yield($obj,$hour_shares);

		$applyeld = round($hour_shares * $new_yield,2);
		$convert_note = t('Estimated yield is <strong>@aplyield Merits</strong> for 100 Chrons of reward',array('@aplyield' => $applyeld));
		$btn_type = 'btn-success';
		$css_class = '';
		$button_note = '';

	//do not allow submission if the amt paid is less than the minimum asked
	if (!isset($form_state['values']['buy_amount'])) {
		$sub_act = FALSE;
		if ($currency == 'CHR') {
			$button_note = '<div style="font-weight: bold; color:#4cae4c;">' . t('Clicking the button finalizes the transaction') . '</div>';
 		}
 		else if ($currency == 'EUR') {
			$button_note = '<div style="font-weight: bold; color:#4cae4c;">' . t('Continue to Payment Information') . '</div>';
 		}
	}
	else if (!$paymentChanged && is_numeric($form_state['values']['buy_amount']) && $form_state['values']['buy_amount'] < $minimum_payment) {
		if ($currency == 'CHR'){
			$convert_note =  t('Please enter value equal to, or greater than @chr Chrons',array('@chr' => $minimum_payment));
		}
		else if ($currency == 'EUR') {
			$convert_note =  t('Please enter value equal to, or greater than @eur Euros',array('@eur' => $minimum_payment));
		}
		$sub_act = TRUE;
		$css_class = 'color:red;';
	}
	else if ($currency == 'CHR' && $form_state['values']['buy_amount'] > $chrons) {
		$convert_note =  t('Please enter value lower than your account balance of @chr Chrons',array('@chr' => $chrons));
		$sub_act = TRUE;
		$css_class = 'color:red;';
	}
	else {
		$sub_act = FALSE;
		if ($currency == 'CHR') {
			$button_note = '<div style="font-weight: bold; color:#4cae4c;">' . t('Clicking the button finalizes the transaction') . '</div>';
 		}
 		else if ($currency == 'EUR') {
			$button_note = '<div style="font-weight: bold; color:#4cae4c;">' . t('Continue to Payment Information') . '</div>';
 		}
	}	

	$form['buy-hrs']['submit-explain'] = array(
		'#markup' => $convert_note,
		'#prefix' => '<div id="submit-explain" style="'.$css_class.'">',
		'#suffix' => '</div>',
	);

		$form['final-note'] = array(
			'#markup' => $button_note,
			'#prefix' => '<div id="final-note">',
			'#suffix' => '</div>',
			'#weight' => 10,
		);

		$form['submit'] = array(
			'#type' => 'submit',
			'#value' => $sub_label,
			'#attributes' => array('id' => array('pay-choice'),'class' => array('btn',$btn_type),'role' => array('button')),
			'#disabled' => $sub_act,
			'#prefix' => '<div id="buy-hrs-subbutton">',
			'#suffix' => '</div>',
			'#weight' => 20,
		);
		
		$form['not-guaranteed-note'] = array(
			'#type' => 'markup',
			'#prefix' => '<div id="not-guaranteed-note">',
			'#suffix' => '</div>',
			'#markup' => t('Please note, that the yield amount as shown on this page is not guaranteed. Its value depends on many variables and can both - decrease and increase in the future.'),
			'#weight' => 100,
		);

	}
	else {
		$form['description'] = array(
			'#type' => 'markup',
			'#markup' => t('This project is not set up to allow buying shares'),
		);
	}

		$old_payment_choice = isset($form_state['values']['payment-choice']) ? $form_state['values']['payment-choice'] : -1;
		$form_state['storage']['old-payment-choice'] = $old_payment_choice;

	return $form;
}

/**
 * Discretizes total paid and unit count for Commerce/Stripe line items.
 *
 * Whole units are rounded up; unit price is floored to 2 decimal places so
 * units × unit_price never exceeds total_reward.
 *
 * @param float $total_reward
 *   Amount in major units (e.g. EUR or CHR depending on caller).
 * @param float $units
 *   Raw unit count (e.g. minutes of time share, or merit count); may be fractional.
 *
 * @return array
 *   Keys: units (int), unit_price (float).
 */
function rovas_purchase_shares_stripe_convertor($total_reward, $units) {
  $total_reward = is_numeric($total_reward) ? (float) $total_reward : 0.0;
  $units = is_numeric($units) ? (float) $units : 0.0;
  if ($units <= 0 || $total_reward <= 0) {
    watchdog('rovas_purchase_shares', 'rovas_purchase_shares_stripe_convertor: invalid total_reward=@reward units=@units', array(
      '@reward' => $total_reward,
      '@units' => $units,
    ), WATCHDOG_WARNING);
    return array('units' => 0, 'unit_price' => 0);
  }

  $units = (int) ceil($units);
  $unit_price = floor(($total_reward / $units) * 100) / 100;

  if ($unit_price <= 0) {
    return array('units' => 0, 'unit_price' => 0);
  }

  return array('units' => $units, 'unit_price' => $unit_price);
}

/**
 * Commerce line-total cents for a typed EUR buyshares payment (no order saved).
 *
 * @param object $proj_wrap
 *   Entity metadata wrapper for the project node.
 * @param float $paid_eur
 *   Buyer-entered amount in EUR (major units).
 *
 * @return int|false
 *   Line total in euro cents, or FALSE if invalid.
 */
function rovas_purchase_shares_eur_buyshares_line_total_cents($proj_wrap, $paid_eur) {
  $paid_eur = is_numeric($paid_eur) ? (float) $paid_eur : 0.0;
  if ($paid_eur <= 0) {
    return FALSE;
  }
  $share = rovas_purchase_shares_compute_share_hours_for_payment($proj_wrap, 'EUR', $paid_eur);
  $time_in_minutes = max(0.0, (float) $share) * 60.0;
  $converted_ary = rovas_purchase_shares_stripe_convertor($paid_eur, $time_in_minutes);
  $quantity = (int) $converted_ary['units'];
  $unit_price = (float) $converted_ary['unit_price'];
  if ($quantity < 1 || $unit_price <= 0) {
    return FALSE;
  }
  $unit_price_cents = (int) round(100 * $unit_price);
  if ($unit_price_cents > 2147483647 || $quantity * $unit_price_cents > 2147483647) {
    return FALSE;
  }
  return $quantity * $unit_price_cents;
}

/**
 * Rewpro buyshares EUR preview: normalized charge, display hours, adjustment text.
 *
 * @param object $proj_wrap
 *   Entity metadata wrapper for the project node.
 * @param float $typed_eur
 *   Amount the user entered (major units).
 *
 * @return array|null
 *   Keys: normalized_eur, normalized_display, hour_shares_display, adjusted,
 *   message (plain string, empty when not adjusted).
 */
function rovas_purchase_shares_eur_buyshares_form_preview_data($proj_wrap, $typed_eur) {
  $typed_eur = is_numeric($typed_eur) ? (float) $typed_eur : 0.0;
  if ($typed_eur <= 0) {
    return NULL;
  }
  $line_cents = rovas_purchase_shares_eur_buyshares_line_total_cents($proj_wrap, $typed_eur);
  if ($line_cents === FALSE || $line_cents < 1) {
    return NULL;
  }
  $normalized_eur = $line_cents / 100.0;
  $share = rovas_purchase_shares_compute_share_hours_for_payment($proj_wrap, 'EUR', $typed_eur);
  $time_in_minutes = max(0.0, (float) $share) * 60.0;
  $conv = rovas_purchase_shares_stripe_convertor($typed_eur, $time_in_minutes);
  $qty = (int) $conv['units'];
  $unit_price = (float) $conv['unit_price'];
  if ($qty < 1 || $unit_price <= 0) {
    return NULL;
  }
  $mins = rovas_purchase_shares_buyshares_minimums($proj_wrap);
  $rate_eur = (isset($mins['rate_eur']) && $mins['rate_eur'] !== '' && is_numeric($mins['rate_eur'])) ? (float) $mins['rate_eur'] : 0.0;
  if ($rate_eur > 0) {
    $hour_shares_display = $normalized_eur / $rate_eur;
  }
  else {
    $implied_hourly = rovas_purchase_shares_effective_eur_per_timeshare_hour($proj_wrap);
    if ($implied_hourly > 0) {
      $hour_shares_display = $normalized_eur / $implied_hourly;
    }
    else {
      $hour_shares_display = $qty / 60.0;
    }
  }
  $typed_cents = (int) round($typed_eur * 100);
  $adjusted = ($typed_cents !== $line_cents);
  $message = '';
  if ($adjusted) {
    $message = t('The amount you entered (@orig €) was adjusted to @adj € to accommodate accounting constraints.', array(
      '@orig' => number_format($typed_eur, 2, '.', ''),
      '@adj' => number_format($normalized_eur, 2, '.', ''),
    ));
  }
  $norm_display = (abs($normalized_eur - round($normalized_eur)) < 0.00001)
    ? (string) (int) round($normalized_eur)
    : number_format($normalized_eur, 2, '.', '');
  return array(
    'normalized_eur' => $normalized_eur,
    'normalized_display' => $norm_display,
    'hour_shares_display' => $hour_shares_display,
    'adjusted' => $adjusted,
    'message' => $message,
  );
}

/**
 * Returns TRUE if the node is a project that allows purchasing time shares.
 */
function rovas_purchase_shares_project_allows_buyshares($node) {
  if (!$node || empty($node->nid) || $node->type !== 'project') {
    return FALSE;
  }
  $w = entity_metadata_wrapper('node', $node);
  return (int) $w->field_allow_purchasing_shares->value() === 1;
}

/**
 * Minimum CHR and EUR amounts for buyshares (major units).
 *
 * @param object $obj
 *   Entity metadata wrapper for the project node.
 *
 * @return array
 *   Keys: min_chr (float), min_eur (float), rate_chr, rate_eur (nullable).
 */
function rovas_purchase_shares_buyshares_minimums($obj) {
  $rate_chrons = (float) $obj->field_rate->value();
  $rate_euros = $obj->field_time_share_cost_euros->value();
  $rate_euros = is_numeric($rate_euros) ? (float) $rate_euros : NULL;
  $minimum_amount_time = $obj->field_minimum_time->value() > 0 ? (float) $obj->field_minimum_time->value() : 0.0;
  // If project minimum share is not configured, default to one minute.
  $minimum_hours = $minimum_amount_time > 0 ? $minimum_amount_time : (1.0 / 60.0);

  $min_chr_raw = $minimum_hours * $rate_chrons;

  if ($rate_euros !== NULL && $rate_euros > 0) {
    $min_eur_raw = $minimum_hours * $rate_euros;
  }
  else {
    $min_eur_raw = 0.0;
    if ($rate_chrons > 0 && function_exists('calculate_forex_transaction_params')) {
      $fx = calculate_forex_transaction_params('chr_to_eur', $rate_chrons, NULL, FALSE);
      if (isset($fx['output']) && is_numeric($fx['output']) && (float) $fx['output'] > 0) {
        $min_eur_raw = $minimum_hours * (float) $fx['output'];
      }
    }
  }

  $min_chr = max(1, (int) ceil($min_chr_raw));
  $min_eur = max(0.01, ceil(($min_eur_raw > 0 ? $min_eur_raw : 0.01) * 100) / 100);
  return array(
    'min_chr' => $min_chr,
    'min_eur' => $min_eur,
    'rate_chr' => $rate_chrons,
    'rate_eur' => $rate_euros,
  );
}

/**
 * Effective € cost per one timeshare hour for preview and share math.
 *
 * Uses field_time_share_cost_euros when set; otherwise derives €/hour from the
 * CHR timeshare rate (field_rate) via forex so EUR flows do not pin to 1 hour.
 *
 * @param object $proj_wrap
 *   Entity metadata wrapper for a project node.
 *
 * @return float
 *   Major EUR per hour, or 0.0 if unavailable.
 */
function rovas_purchase_shares_effective_eur_per_timeshare_hour($proj_wrap) {
  $mins = rovas_purchase_shares_buyshares_minimums($proj_wrap);
  $rate_eur = (isset($mins['rate_eur']) && $mins['rate_eur'] !== '' && is_numeric($mins['rate_eur'])) ? (float) $mins['rate_eur'] : 0.0;
  if ($rate_eur > 0) {
    return $rate_eur;
  }
  $rate_chr = isset($mins['rate_chr']) ? (float) $mins['rate_chr'] : 0.0;
  if ($rate_chr <= 0 || !function_exists('calculate_forex_transaction_params')) {
    return 0.0;
  }
  $fx = calculate_forex_transaction_params('chr_to_eur', $rate_chr, NULL, FALSE);
  if (!isset($fx['output']) || !is_numeric($fx['output'])) {
    return 0.0;
  }
  $out = (float) $fx['output'];
  return $out > 0 ? $out : 0.0;
}

/**
 * Creates a Commerce order for EUR time-share purchase (no shared product save).
 *
 * @param int $uid
 * @param int $project_nid
 * @param float $total_reward
 *   Euro amount (major units) entered by the buyer.
 * @param float $share_hours
 *   Purchased time share in hours (same semantics as legacy buyshares form).
 * @param string|null $rpr_paytype
 *   One of pay-choice-card, pay-choice-bank, or NULL to omit checkout filtering.
 *
 * @return object|null
 *   The commerce order entity, or NULL on failure.
 */
function rovas_purchase_shares_create_eur_time_share_order($uid, $project_nid, $total_reward, $share_hours, $rpr_paytype = NULL) {
  if (!function_exists('commerce_order_new') || !function_exists('commerce_product_load_by_sku')) {
    return NULL;
  }
  $project = node_load($project_nid);
  if (!rovas_purchase_shares_project_allows_buyshares($project)) {
    return NULL;
  }

  $product_obj = commerce_product_load_by_sku('time-share');
  if (!$product_obj) {
    watchdog('rovas_purchase_shares', 'time-share product missing', array(), WATCHDOG_ERROR);
    return NULL;
  }
  $anonpay_product_nid = $product_obj->product_id;

  $time_in_minutes = max(0.0, (float) $share_hours) * 60.0;
  $converted_ary = rovas_purchase_shares_stripe_convertor((float) $total_reward, $time_in_minutes);
  $unit_price = $converted_ary['unit_price'];
  $quantity = (int) round($converted_ary['units']);
  if ($quantity < 1 || $unit_price <= 0) {
    watchdog('rovas_purchase_shares', 'Invalid line item for EUR buyshares order: qty=@q unit=@u', array('@q' => $quantity, '@u' => $unit_price), WATCHDOG_WARNING);
    return NULL;
  }

  $fee_variable = variable_get('buy_ch_fee');
  $fee_fixed = variable_get('buy_ch_fixed_fee');
  $fee = $fee_fixed + $fee_variable * ($quantity * $unit_price);
  $unit_price_cents = (int) round(100 * $unit_price);

  if ($unit_price_cents > 2147483647 || $quantity * $unit_price_cents > 2147483647) {
    return NULL;
  }

  $order = commerce_order_new($uid, 'checkout_checkout');
  commerce_order_save($order);

  $product = commerce_product_load($anonpay_product_nid);
  $line_item = commerce_product_line_item_new($product, $quantity, $order->order_id);
  $line_item_wrapper = entity_metadata_wrapper('commerce_line_item', $line_item);
  $line_item_wrapper->commerce_unit_price->amount->set($unit_price_cents);
  $line_item_wrapper->commerce_unit_price->currency_code->set('EUR');

  if (!isset($line_item->data) || !is_array($line_item->data)) {
    $line_item->data = array();
  }
  $line_item->data['rpr_custom_unit_price'] = (int) $unit_price_cents;
  $line_item->data['rpr_custom_currency'] = 'EUR';

  commerce_line_item_rebase_unit_price($line_item);
  commerce_line_item_save($line_item);

  $order_wrapper = entity_metadata_wrapper('commerce_order', $order);
  $order_wrapper->commerce_line_items[] = $line_item;
  $order_wrapper->field_conversion_fee = $fee;
  $order_wrapper->field_payer_type = 'project';
  $order_wrapper->field_payment_recipient = $project_nid;

  if ($rpr_paytype !== NULL && $rpr_paytype !== '') {
    $order->data['rpr_paytype'] = $rpr_paytype;
    if (function_exists('_rovas_project_reward_commerce_method_for_rpr_paytype')) {
      $commerce_method = _rovas_project_reward_commerce_method_for_rpr_paytype($rpr_paytype);
      if ($commerce_method !== NULL) {
        $order->data['payment_method'] = $commerce_method;
        $order->data['rovas_payment_method'] = $commerce_method;
      }
    }
  }

  $order->placed = REQUEST_TIME;
  commerce_order_save($order);
  commerce_cart_order_session_save($order->order_id);

  return commerce_order_load($order->order_id);
}

/**
 * TRUE if the order has at least one product line referencing the given SKU.
 *
 * commerce_order_rules_contains_product() can return FALSE when the legacy
 * $order->commerce_line_items property is unset even though the field has
 * values; this follows the same EFQ logic but only uses field_get_items().
 */
function _rovas_purchase_shares_order_line_items_contain_sku($order, $sku) {
  if (empty($order) || empty($order->order_id) || !function_exists('commerce_product_line_item_types')) {
    return FALSE;
  }
  $line_item_ids = array();
  if ($items = field_get_items('commerce_order', $order, 'commerce_line_items')) {
    foreach ($items as $item) {
      if (!empty($item['line_item_id'])) {
        $line_item_ids[] = (int) $item['line_item_id'];
      }
    }
  }
  if (empty($line_item_ids)) {
    return FALSE;
  }
  $product_id = db_query("SELECT product_id FROM {commerce_product} WHERE sku = :sku", array(':sku' => $sku))->fetchField();
  if (!$product_id) {
    return FALSE;
  }
  $query = new EntityFieldQuery();
  $query
    ->entityCondition('entity_type', 'commerce_line_item')
    ->entityCondition('bundle', commerce_product_line_item_types(), 'IN')
    ->entityCondition('entity_id', $line_item_ids, 'IN')
    ->fieldCondition('commerce_product', 'product_id', $product_id);
  $result = $query->execute();
  if (empty($result['commerce_line_item'])) {
    return FALSE;
  }
  $count = function_exists('commerce_line_items_quantity_by_id')
    ? commerce_line_items_quantity_by_id(array_keys($result['commerce_line_item']))
    : count($result['commerce_line_item']);
  return $count >= 1;
}

/**
 * Commits the pending forex_transaction created at bank checkout (field_payment_status=1).
 *
 * Uses the same confirmation-time quote as the finalize path (rovas_forex_transaction_params
 * with charge_fees TRUE). Skips if no node or already committed.
 *
 * @param int $order_id
 * @param float $order_total
 *   Order total in EUR (major units).
 * @param float $output_amount
 *   CHR output from rovas_forex_transaction_params.
 * @param float $eur_basket
 * @param float $chr_basket
 * @param float $conversion_fee_eur
 *   Total conversion fee in EUR (variable + fixed), same as card Rule fee_amount.
 *
 * @return bool
 *   TRUE if committed or already paid, FALSE if no forex node found.
 */
function _rovas_purchase_shares_commit_forex_transaction_for_bank_time_share_order($order_id, $order_total, $output_amount, $eur_basket, $chr_basket, $conversion_fee_eur) {
  $order_id = (int) $order_id;
  if ($order_id < 1) {
    return FALSE;
  }
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
    ->entityCondition('bundle', 'forex_transaction')
    ->fieldCondition('field_order_record', 'target_id', $order_id);
  $result = $query->execute();
  if (empty($result['node'])) {
    watchdog('rovas_purchase_shares', 'Bank time-share finalize: no forex_transaction node linked to order @oid; payment_status left unchanged.', array('@oid' => $order_id), WATCHDOG_WARNING);
    return FALSE;
  }
  $nid = (int) key($result['node']);
  $node = node_load($nid);
  if (!$node || $node->type !== 'forex_transaction') {
    return FALSE;
  }
  $w = entity_metadata_wrapper('node', $node);
  if ((int) $w->field_payment_status->value() === 1) {
    return TRUE;
  }
  $w->field_chron_basket->set($chr_basket);
  $w->field_euro_basket->set($eur_basket);
  $w->field_input_amount->set($order_total);
  $w->field_output_amount->set($output_amount);
  $w->field_conversion_fee->set($conversion_fee_eur);
  $w->field_payment_status->set(1);
  $w->save();
  watchdog('rovas_purchase_shares', 'Bank time-share finalize: forex_transaction @nid for order @oid marked paid (field_payment_status=1).', array(
    '@nid' => $nid,
    '@oid' => $order_id,
  ), WATCHDOG_INFO);
  return TRUE;
}

/**
 * Finalize EUR time-share when a bank transfer order is paid in full.
 *
 * rules_process_card_payment_orders intentionally skips bank_transfer and
 * pay-choice-bank; this path mirrors its time-share + recipient handling.
 *
 * @param object $order
 *   Commerce order (may be a stale in-memory copy; reloaded internally).
 */
function rovas_purchase_shares_finalize_bank_paid_time_share_if_applicable($order) {
  if (empty($order->order_id)) {
    return;
  }
  if (!module_exists('rules')) {
    watchdog('rovas_purchase_shares', 'Bank time-share finalize skipped for order @oid: Rules module not enabled.', array('@oid' => $order->order_id), WATCHDOG_WARNING);
    return;
  }

  $oid = (int) $order->order_id;
  $orders = entity_load('commerce_order', array($oid), array(), TRUE);
  $order = !empty($orders[$oid]) ? $orders[$oid] : FALSE;
  if (!$order) {
    watchdog('rovas_purchase_shares', 'Bank time-share finalize skipped: could not load order @oid.', array('@oid' => $oid), WATCHDOG_WARNING);
    return;
  }

  if (!empty($order->data['rovas_bank_ts_paid_full_handled'])) {
    watchdog('rovas_purchase_shares', 'Bank time-share finalize skipped for order @oid: already completed at @ts.', array(
      '@oid' => $order->order_id,
      '@ts' => format_date((int) $order->data['rovas_bank_ts_paid_full_handled'], 'short'),
    ), WATCHDOG_INFO);
    return;
  }

  // Commerce checkout can clear payment_method on the review step while
  // rpr_paytype remains set (see rovas_project_reward_review_finalize_payment()).
  if (!empty($order->data['rpr_paytype']) && $order->data['rpr_paytype'] === 'pay-choice-bank' && empty($order->data['payment_method'])) {
    if (function_exists('_rovas_project_reward_commerce_method_for_rpr_paytype')) {
      $commerce_method = _rovas_project_reward_commerce_method_for_rpr_paytype('pay-choice-bank');
      if ($commerce_method !== NULL) {
        $order->data['payment_method'] = $commerce_method;
        $order->data['rovas_payment_method'] = $commerce_method;
        commerce_order_save($order);
        watchdog('rovas_purchase_shares', 'Restored payment_method on order @oid from rpr_paytype for bank time-share finalize (@method).', array(
          '@oid' => $order->order_id,
          '@method' => $commerce_method,
        ), WATCHDOG_INFO);
        $order = commerce_order_load($order->order_id);
        if (!$order) {
          return;
        }
      }
    }
  }

  $has_time_share = _rovas_purchase_shares_order_line_items_contain_sku($order, 'time-share');
  if (!$has_time_share) {
    $n = 0;
    if ($items = field_get_items('commerce_order', $order, 'commerce_line_items')) {
      $n = count($items);
    }
    $legacy_prop_empty = empty($order->commerce_line_items);
    watchdog('rovas_purchase_shares', 'Bank time-share finalize skipped for order @oid: no time-share SKU on order line items (commerce_line_items field rows=@n, legacy commerce_line_items property empty=@e).', array(
      '@oid' => $order->order_id,
      '@n' => $n,
      '@e' => $legacy_prop_empty ? 'yes' : 'no',
    ), WATCHDOG_INFO);
    return;
  }
  // Do not call commerce_payment_rules_compare_selected_payment_method(): it lives
  // in commerce_payment.rules.inc and is often not loaded during reconcile/cron.
  $selected_method_id = '-none-';
  if (!empty($order->data['payment_method']) && is_string($order->data['payment_method'])) {
    $pm_parts = explode('|', $order->data['payment_method'], 2);
    $selected_method_id = isset($pm_parts[0]) ? trim($pm_parts[0]) : '-none-';
  }
  elseif (!empty($order->data['rpr_paytype']) && $order->data['rpr_paytype'] === 'pay-choice-bank') {
    $selected_method_id = 'bank_transfer';
  }
  // Card / Stripe (and other non-bank) orders also fire paid_in_full; this helper
  // is only for bank settlement. Exit quietly — not an error condition.
  if ($selected_method_id !== 'bank_transfer') {
    return;
  }
  $wrapper = entity_metadata_wrapper('commerce_order', $order);
  $recipient = $wrapper->field_payment_recipient->value();
  if ($recipient === NULL || $recipient === '') {
    watchdog('rovas_purchase_shares', 'Bank time-share finalize aborted for order @oid: missing field_payment_recipient.', array(
      '@oid' => $order->order_id,
    ), WATCHDOG_WARNING);
    return;
  }

  $order_total = (float) $wrapper->commerce_order_total->amount->value() / 100.0;
  if ($order_total <= 0) {
    watchdog('rovas_purchase_shares', 'Bank time-share finalize aborted for order @oid: non-positive order total (@amt).', array(
      '@oid' => $order->order_id,
      '@amt' => $order_total,
    ), WATCHDOG_WARNING);
    return;
  }

  $fp = rovas_forex_transaction_params('eur_to_chr', $order_total, 0, TRUE);
  $output_amount = isset($fp['output_amount']) ? (float) $fp['output_amount'] : 0.0;
  $eur_basket = $fp['eur_basket'];
  $chr_basket = $fp['chr_basket'];
  $variable_fee = $fp['variable_fee'];
  $fixed_fee_amount = $fp['fixed_fee_amount'];
  $use_temp_baskets = !empty($fp['use_temp_baskets']);

  rules_invoke_component('rules_process_time_share_order', $order);

  rovas_forex_settle_trade('eur_to_chr', $order_total, $chr_basket, $eur_basket, $variable_fee, $fixed_fee_amount, FALSE, TRUE, $use_temp_baskets);

  rules_invoke_component('rules_process_recipient_order_core', $output_amount, 1, $order);

  $partial_fee = $variable_fee * $order_total;
  $conversion_fee_eur = $fixed_fee_amount + $partial_fee;
  _rovas_purchase_shares_commit_forex_transaction_for_bank_time_share_order(
    $order->order_id,
    $order_total,
    $output_amount,
    $eur_basket,
    $chr_basket,
    $conversion_fee_eur
  );

  $order = commerce_order_load($order->order_id);
  if ($order) {
    $order->data['rovas_bank_ts_paid_full_handled'] = REQUEST_TIME;
    commerce_order_save($order);
    watchdog('rovas_purchase_shares', 'Bank time-share finalize completed for order @oid (recipient @rid, @eur EUR, CHR output @chr).', array(
      '@oid' => $order->order_id,
      '@rid' => $recipient,
      '@eur' => number_format($order_total, 2, '.', ''),
      '@chr' => number_format($output_amount, 4, '.', ''),
    ), WATCHDOG_INFO);
  }
}

/**
 * Implements hook_commerce_payment_order_paid_in_full().
 */
function rovas_purchase_shares_commerce_payment_order_paid_in_full($order, $transaction = NULL) {
  rovas_purchase_shares_finalize_bank_paid_time_share_if_applicable($order);
}

/**
 * Time share hours implied by payment amount and project rates.
 *
 * @param object $obj
 *   Project entity metadata wrapper.
 * @param string $currency
 *   'EUR' or 'CHR'.
 * @param float $paid_amt
 *   Major units (euros or chrons).
 */
function rovas_purchase_shares_compute_share_hours_for_payment($obj, $currency, $paid_amt) {
  $mins = rovas_purchase_shares_buyshares_minimums($obj);
  $paid_amt = (float) $paid_amt;
  if ($currency === 'EUR') {
    $rate_eur = (isset($mins['rate_eur']) && $mins['rate_eur'] !== '' && is_numeric($mins['rate_eur'])) ? (float) $mins['rate_eur'] : 0.0;
    if ($rate_eur > 0) {
      return $paid_amt / $rate_eur;
    }
    $implied = rovas_purchase_shares_effective_eur_per_timeshare_hour($obj);
    if ($implied > 0) {
      return $paid_amt / $implied;
    }
    // Stripe minute bootstrap only when neither €/hr nor CHR→€ path exists.
    return 1.0;
  }
  $rate = max(0.0001, (float) $mins['rate_chr']);
  return $paid_amt / $rate;
}

/**
 * HTML for the “time share” hours/minutes line (legacy buy-hrs-converted styling).
 */
function rovas_purchase_shares_buyshares_hours_preview_markup($hour_shares) {
  $hour_shares = (float) $hour_shares;
  $hours = floor($hour_shares);
  $hours_formated = $hours ? $hours . '<span class="to-unit"> ' . t('hrs') . '</span>' : '';
  $minutes = ($hour_shares - $hours) * 60;
  $minutes_formated = $minutes ? round($minutes, 0) . '<span class="to-unit"> ' . t('min') . '</span>' : '';
  $comma = !empty($hours_formated) && !empty($minutes_formated) ? ' ' : '';
  return $hours_formated . $comma . $minutes_formated;
}

/**
 * “Estimated yield …” line for a hypothetical purchase size (legacy submit-explain).
 */
function rovas_purchase_shares_buyshares_yield_estimate_markup($obj, $hour_shares) {
  $new_yield = rovas_purchase_shares_yield($obj, $hour_shares);
  $applyeld = round($hour_shares * $new_yield, 2);
  return t('Estimated yield is <strong>@aplyield Merits</strong> for 100 Chrons of reward', array('@aplyield' => $applyeld));
}

/**
 * CHR buyshares: shareholder update, AUR, time share (same as legacy form).
 */
function rovas_purchase_shares_process_chr_buyshares($project, $user, $total_reward, $share) {
  $hours = floor($share);
  $hours_formated = $hours ? $hours . ' ' . t('hrs') : '';
  $minutes = ($share - $hours) * 60;
  $minutes_formated = $minutes ? round($minutes, 0) . ' ' . t('min') : '';
  $comma = !empty($hours_formated) && !empty($minutes_formated) ? ', ' : '';
  $timeshare = $hours_formated . $comma . $minutes_formated;

  $share_ary = rules_invoke_component('rules_check_or_add_time_shareholder_core', $project, $user->uid);
  $tshare_obj = entity_metadata_wrapper('node', $share_ary[0]);
  $old_share = $tshare_obj->field_total_hours_worked->value();
  $tshare_obj->field_total_hours_worked->set($old_share + $share);
  $tshare_obj->save();

  $description = t('Purchased @hrs time share', array('@hrs' => $timeshare));
  $result = rules_invoke_component('rules_create_aur', $project, $total_reward, $user, $description);
  $proof = node_load($result[0]);
  rules_invoke_component('rules_create_time_share', $project, $proof, $total_reward, $share);

  return array(
    'message' => t('Your purchase of @shr time share for @chr Chrons was scheduled for processing.', array('@shr' => $timeshare, '@chr' => $total_reward)),
    'destination' => drupal_get_path_alias('node/' . $project->nid),
  );
}

/**
 * Markup for rewpro buyshares "Project data" fieldset (yield, rates, chart).
 */
function rovas_purchase_shares_buyshares_performance_markup($proj_nid) {
  $obj = entity_metadata_wrapper('node', $proj_nid);
  $yield = round(rovas_purchase_shares_yield($obj), 2);
  $rate_chrons = $obj->field_rate->value();
  $rate_euros = $obj->field_time_share_cost_euros->value();

  $yield_markup = '<div class="form-item form-item-yield form-type-textfield">';
  $yield_markup .= '<label class="field-label">' . t('Current yield') . '</label>';
  $yield_markup .= '<div class="yield"><span class="yield-value">' . check_plain($yield) . ' </span>';
  $yield_markup .= '<span class="yield-unit">' . t('ME/100 CH /1 hour') . '</span></div>';
  $yield_markup .= '<div class="help-block">' . t('The number of Merits one (hour) timeshare receives when the project is rewarded  with 100 Chrons') . '</div></div>';

  $rate_markup = '<div class="form-item form-item-rate form-type-textfield field-label-inline">';
  $rate_markup .= '<label class="field-label">' . t('Timeshare cost') . ': </label><div class="rate">';
  $rate_markup .= '<span class="rate-value">' . check_plain($rate_chrons) . ' </span><span class="rate-unit">' . t('CH') . '</span>';
  if ($rate_euros) {
    $rate_markup .= '<span class="rate-value"> / ' . check_plain($rate_euros) . ' </span><span class="rate-unit">' . t('€') . '</span>';
  }
  $rate_markup .= '</div><div class="help-block">' . t('The cost of one hour share') . '</div></div>';

  $me_view = views_embed_view('project_merit_rewards_chart', 'page', $proj_nid);
  $me_history = '<div class="form-item form-item-chart form-type-textfield"><label class="field-label">';
  $me_history .= t('Labor time and Merit reward history') . '</label><div class="me-history">' . $me_view . '</div></div>';

  return $yield_markup . $rate_markup . $me_history;
}

function rovas_purchase_shares_form_submit ($form, &$form_state) {

//watchdog('module','rovas_purchase_shares submit ' . print_r($form_state['values'],1));
//dsm($form_state);

	global $user;

	$product_id = $form_state['values']['proj_id'];
	$usr_chr = $form_state['values']['chrons'];
	$total_reward = isset($form_state['values']['buy_amount']) ? $form_state['values']['buy_amount'] : 0;
	$share = $form_state['values']['buy-hrs-converted-value'] ?: 1;
	$currency = $form_state['values']['payment-choice'] == 1 ? 'EUR' : ($form_state['values']['payment-choice'] == 0 ? 'CHR' : NULL);

	$minimum_payment = isset($form_state['values']['minimum_payment']) ? $form_state['values']['minimum_payment'] : 0;

	if ($total_reward == 0) {
		$message = t('Please enter value greater than 0');
		$mestyp ='error';
		$form_state["rebuild"] = TRUE;
		$dest = FALSE;
	}
	else if ($total_reward < $minimum_payment) {
		if ($currency == 'CHR'){
			$message =  t('Please enter value equal to, or greater than @chr Chrons',array('@chr' => $minimum_payment));
		}
		else if ($currency == 'EUR') {
			$message =  t('Please enter value equal to, or greater than @eur Euros',array('@eur' => $minimum_payment));
		}
		$mestyp ='error';
		$form_state["rebuild"] = TRUE;
		$dest = FALSE;
	}
	else if ($currency == 'CHR' && $total_reward > $usr_chr) {
		$message =  t('Please enter value lower than your account balance of @chr Chrons',array('@chr' => $usr_chr));
		$mestyp ='error';
		$form_state["rebuild"] = TRUE;
		$dest = FALSE;
	}

	if ($currency == 'CHR') {

		$project = node_load($product_id); 

		$hours = floor($share);
		$hours_formated = $hours ? $hours . ' ' . t('hrs') : '';
		$minutes = ($share - $hours) * 60;
		$minutes_formated = $minutes ? round($minutes,0) . ' ' . t('min') : '';
		$comma = !empty($hours_formated) && !empty($minutes_formated) ? ', ' : '';

		$timeshare = $hours_formated . $comma . $minutes_formated;

		//to give the buyer a stake in the project, they have to have a share there
		$share_ary = rules_invoke_component('rules_check_or_add_time_shareholder_core',$project,$user->uid);

		//update the user's share
		$tshare_obj = entity_metadata_wrapper('node',$share_ary[0]);
		$old_share = $tshare_obj->field_total_hours_worked->value();
		$new_share = $old_share + $share;
		$tshare_obj->field_total_hours_worked->set($new_share);
		$tshare_obj->save();

		$description = t('Purchased @hrs time share',array('@hrs' => $timeshare));

		//create an asset usage record to process the purchase in the background
		$result = rules_invoke_component('rules_create_aur',$project,$total_reward,$user,$description);
		$proof = node_load($result[0]);

		//this is an equivalent to creating a work report
		rules_invoke_component('rules_create_time_share',$project,$proof,$total_reward,$share);

		$message =  t('Your purchase of @shr time share for @chr Chrons was scheduled for processing.',array('@shr' => $timeshare, '@chr' => $total_reward));
		$mestyp ='status';
		$dest = drupal_get_path_alias('node/' . $product_id);
	}
	else if ($currency == 'EUR') {

		$uid = $user->uid;
		$order = rovas_purchase_shares_create_eur_time_share_order($uid, $product_id, $total_reward, $share, NULL);
		if (!$order) {
			$message = t('The amount paid can not be processed. Please split your payment into multiple smaller amounts.');
			$mestyp = 'status';
			$dest = FALSE;
		}
		else {
			drupal_goto('checkout/' . $order->order_id);
		}
	}

	drupal_set_message($message,$mestyp);

	if ($dest) {
		drupal_goto($dest);
	}

}


//set access to the purchase shares page
function rovas_purchase_shares_access() {
	return user_has_role(2);
}

//callback to switch gui for the chosen currency
function _switch_payment_currency($form,&$form_state) {

//watchdog('module','rovas_purchase_shares callback ' . print_r([$form_state['values'],$form_state['input']],1));

	$commands = [
		ajax_command_replace("#buy-hrs-subbutton", render($form['submit'])),
		ajax_command_replace(".form-item-buy-amount", render($form['buy-hrs']['buy_amount'])),
		ajax_command_css(".form-item-buy-amount", ['display' => 'inline-block']),
		ajax_command_css("#edit-button", ['display' => 'inline-block']),
		ajax_command_replace("#buy-hrs-converted", render($form['buy-hrs']['buy-hrs-converted'])),
		ajax_command_css("#buy-hrs-converted", ['display' => 'inline-block']),
		ajax_command_css("#submit-explain", ['display' => 'block']),
		ajax_command_replace("#submit-explain", render($form['buy-hrs']['submit-explain'])),
		ajax_command_replace("#final-note", render($form['final-note'])),
	];

	if ($form_state['values']['payment-choice'] == 0) {
		$commands[] = ajax_command_css(".chron-balance", ['display' => 'block']);
		$commands[] = ajax_command_css("#newline", ['display' => 'none']);
	}
	else if ($form_state['values']['payment-choice'] == 1) {
		$commands[] = ajax_command_css(".chron-balance", ['display' => 'none']);
		$commands[] = ajax_command_css("#newline", ['display' => 'block']);
	}
	else {
		$commands = [];
	}

	return [
		'#type' => 'ajax',
		'#commands' => $commands
	];
}

//callback to recalculate CH/EUR -> time share
function _convert_chr_hrs($form, $form_state) {
//watchdog('module','rovas_purchase_shares callback 2 ' . print_r([$form_state['values'],$form_state['input']],1));
	return array(
		'#type' => 'ajax',
		'#commands' => array(
			ajax_command_replace("#buy-hrs-converted", render($form['buy-hrs']['buy-hrs-converted'])),
			ajax_command_css("#buy-hrs-converted", ['display' => 'inline-block']),
			ajax_command_replace("#final-note", render($form['final-note'])),
			ajax_command_replace("#buy-hrs-subbutton", render($form['submit'])),
			ajax_command_replace("#submit-explain", render($form['buy-hrs']['submit-explain'])),
		)
	);
}

/*
* calculates the project reward yield
* @obj is the project metadata wrapper object
* @add_time - additional time to add to the time exisiting in the project, to estimate a hypothetical yield
*/
function rovas_purchase_shares_yield ($obj,$add_time=NULL) {

	$nid = $obj->getIdentifier();

	$res = db_query("SELECT SUM(ma.field_merit_allocation_value) AS shares, SUM(hw.field_total_hours_worked_value) AS hours
	FROM {node} node
	LEFT JOIN {field_data_field_project} fpr ON node.nid = fpr.entity_id AND (fpr.entity_type = 'node' AND fpr.deleted = '0')
	LEFT JOIN {node} n ON fpr.field_project_target_id = n.nid
	LEFT JOIN {field_data_field_merit_allocation} ma ON node.nid = ma.entity_id AND (ma.entity_type = 'node' AND ma.deleted = '0')
	LEFT JOIN {field_data_field_total_hours_worked} hw ON node.nid = hw.entity_id AND (hw.entity_type = 'node' AND hw.deleted = '0')
	WHERE n.nid = :prid
	AND (node.status = '1' AND node.type IN  ('project_merit_allocation', 'co_worker_merit_allocation','timeshare_merit_allocation'))
	", array(':prid' => $nid));

	$sumarray = $res->fetchAll();

	//project merit share
	$proj_me_share = $obj->field_reward_merit_allocation->value();

	//the sum of all partial shares (and hours) from worker and project shareholders
	$partial = $proj_me_share >0 ? $proj_me_share : 100;
	$tsdiff = $partial - $partial * ($sumarray[0]->shares/100);
	$partial2 = $sumarray[0]->hours > 0 ? $sumarray[0]->hours : 1;
	$total_hours = $add_time + $partial2;

	return $tsdiff / $total_hours;
}

/**
 * Alter an individual chart's raw library representation.
 *
 * This hook is called AFTER hook_chart_alter(), after Charts module has
 * converted the renderable into the chart definition that will be used by the
 * library. Note that the structure of $definition will differ based on the
 * charting library used. Switching charting libraries may cause your code
 * to break when using this hook.
 *
 * Even though this hook may be fragile, it may provide developers with access
 * to library-specific functionality.
 *
 * @param $definition
 *   The chart definition to be modified. The raw values are passed directly to
 *   the charting library.
 * @param $chart
 *   The chart renderable. This may be used for reference (or read to add
 *   support for new properties), but any changes to this variable will not
 *   have an effect on output.
 * @param $chart_id
 *   The chart ID, derived from the $chart['#chart_id'] property. Note that not
 *   all charts may have a $chart_id.
 */
function rovas_purchase_shares_chart_definition_alter(&$definition, $chart, $chart_id) {

		//WARNING! modifying the $chart array has no effect in this hook
		$definition['options']['animation']['duration'] = 1;
}
