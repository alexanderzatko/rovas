<?php

/**
 * @file
 * Install / update hooks for Rovas OAuth.
 */

/**
 * Implements hook_install().
 */
function rovas_oauth_install() {
  // Defer entity create until oauth2_server schema is present; bootstrap is
  // also available from admin/config/services/rovas-oauth.
  if (module_exists('oauth2_server') && function_exists('rovas_oauth_ensure_client')) {
    try {
      rovas_oauth_ensure_server();
      rovas_oauth_ensure_client();
    }
    catch (Exception $e) {
      watchdog_exception('rovas_oauth', $e);
    }
  }
}

/**
 * Implements hook_enable().
 */
function rovas_oauth_enable() {
  if (function_exists('rovas_oauth_ensure_client')) {
    try {
      rovas_oauth_ensure_server();
      rovas_oauth_ensure_client();
    }
    catch (Exception $e) {
      watchdog_exception('rovas_oauth', $e);
    }
  }
  if (function_exists('rovas_oauth_ensure_civic_resources')) {
    try {
      rovas_oauth_ensure_civic_resources();
    }
    catch (Exception $e) {
      watchdog_exception('rovas_oauth', $e);
    }
  }
}

/**
 * Enable Civic home-read Services resources on rovas_endpoint.
 */
function rovas_oauth_update_7001() {
  if (function_exists('rovas_oauth_ensure_civic_resources')) {
    rovas_oauth_ensure_civic_resources();
  }
  return t('Civic Services resources (/me, /contributions/aggregate, merit_distribution) enabled on rovas_endpoint.');
}

/**
 * Enable automatic authorization on the Civic OAuth client.
 *
 * After HybridAuth (or password) login, oauth2/authorize issues the code
 * immediately and redirects to civic://oauth/callback — no consent screen.
 */
function rovas_oauth_update_7002() {
  if (function_exists('rovas_oauth_ensure_client')) {
    rovas_oauth_ensure_client();
  }
  return t('Civic OAuth client automatic_authorization enabled.');
}

/**
 * Enable POST /rovas/civic_auth_session on rovas_endpoint (native Google/Apple).
 *
 * Technical API-client accounts need the new permission
 * "mint civic auth session" (and HybridAuth Google/Apple enabled).
 */
function rovas_oauth_update_7003() {
  if (function_exists('rovas_oauth_ensure_civic_resources')) {
    rovas_oauth_ensure_civic_resources();
  }
  return t('Civic native auth bridge POST /rovas/civic_auth_session enabled on rovas_endpoint. Grant "mint civic auth session" to the Civic technical API client and enable HybridAuth Google/Apple.');
}

/**
 * Enable POST /rovas/civic_update_profile on rovas_endpoint (Bearer).
 */
function rovas_oauth_update_7004() {
  if (function_exists('rovas_oauth_ensure_civic_resources')) {
    rovas_oauth_ensure_civic_resources();
  }
  return t('Civic profile update API (POST /rovas/civic_update_profile) enabled on rovas_endpoint.');
}

/**
 * Enable POST /rovas/civic_auth_register + civic_auth_login on rovas_endpoint.
 *
 * Same technical API-KEY + TOKEN permission as civic_auth_session
 * ("mint civic auth session").
 */
function rovas_oauth_update_7005() {
  if (function_exists('rovas_oauth_ensure_civic_resources')) {
    rovas_oauth_ensure_civic_resources();
  }
  return t('Civic email/password auth APIs (POST /rovas/civic_auth_register, civic_auth_login) enabled on rovas_endpoint.');
}
