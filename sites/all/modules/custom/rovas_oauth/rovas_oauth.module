<?php

/**
 * @file
 * Civic / mobile OAuth glue on top of oauth2_server + HybridAuth.
 *
 * Responsibilities (see civic docs/plan.md §8a):
 * - Ensure a default OAuth2 server ("civic") exists with PKCE enforced.
 * - Ensure the public "civic" mobile client exists (no client secret).
 * - Civic-brand the login/register/authorize chrome when client_id=civic.
 * - Helpers to resolve a Bearer access token to a Drupal uid.
 * - Civic home-read Services resources: GET /rovas/me,
 *   GET /rovas/contributions/aggregate (Bearer / public).
 *
 * oauth2_server provides Services authentication; wire it on rovas_endpoint
 * (server machine name "civic") and disable API-key auth on Civic resources.
 */

/**
 * Machine name of the OAuth2 server entity used by Civic.
 */
define('ROVAS_OAUTH_SERVER', 'civic');

/**
 * Client key (OAuth client_id) for the Civic Expo app.
 */
define('ROVAS_OAUTH_CLIENT_KEY', 'civic');

/**
 * Production redirect URI for Expo (custom scheme).
 */
define('ROVAS_OAUTH_REDIRECT_PROD', 'civic://oauth/callback');

/**
 * Session key for Civic UI locale during OAuth authorize (anonymous login).
 */
define('ROVAS_OAUTH_CIVIC_UI_LANG_SESSION', 'rovas_oauth_civic_ui_lang');

/**
 * Session key for Civic authorize landing intent (login vs register).
 */
define('ROVAS_OAUTH_CIVIC_INTENT_SESSION', 'rovas_oauth_civic_intent');

/**
 * Services endpoint machine name used by Rovas REST APIs.
 */
define('ROVAS_OAUTH_SERVICES_ENDPOINT', 'rovas_endpoint');

/**
 * Implements hook_permission().
 */
function rovas_oauth_permission() {
  return array(
    'administer rovas oauth' => array(
      'title' => t('Administer Rovas OAuth (Civic)'),
      'description' => t('Bootstrap and inspect the Civic OAuth2 server and client.'),
      'restrict access' => TRUE,
    ),
  );
}

/**
 * Implements hook_menu().
 */
function rovas_oauth_menu() {
  $items = array();
  $items['admin/config/services/rovas-oauth'] = array(
    'title' => 'Rovas OAuth (Civic)',
    'description' => 'Bootstrap the Civic OAuth2 server and mobile client.',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('rovas_oauth_admin_form'),
    'access arguments' => array('administer rovas oauth'),
    'file' => 'rovas_oauth.admin.inc',
  );
  return $items;
}

/**
 * Whether the current request is Civic OAuth authorize UX.
 *
 * Brands / keeps locale for:
 * - `/oauth2/authorize` for client `civic`
 * - `/user/login|register|password` when `destination=oauth2/authorize` and the
 *   authorize session is for client `civic`
 * - `/hybridauth/window/*` and `/hybridauth/endpoint` when the HybridAuth
 *   destination is `oauth2/authorize` (provider round-trip + additional-info
 *   form). Without this, stashed `lang` is cleared mid-flow and OSM/etc.
 *   registration forms fall back to English.
 *
 * Plain `/user/login` (no destination) stays the normal Rovas chrome even if a
 * prior authorize session is still in $_SESSION.
 *
 * @return bool
 */
function rovas_oauth_is_civic_authorize_context() {
  $session_client = '';
  if (!empty($_SESSION['oauth2_server_authorize']['client_id'])) {
    $session_client = $_SESSION['oauth2_server_authorize']['client_id'];
  }

  // Consent / authorize endpoint.
  if (arg(0) === 'oauth2' && arg(1) === 'authorize') {
    $client_id = $session_client !== '' ? $session_client : (isset($_GET['client_id']) ? $_GET['client_id'] : '');
    return $client_id === ROVAS_OAUTH_CLIENT_KEY;
  }

  // HybridAuth provider round-trip during Civic authorize.
  if (arg(0) === 'hybridauth' && in_array(arg(1), array('window', 'endpoint'), TRUE)) {
    return rovas_oauth_is_civic_hybridauth_destination($session_client);
  }

  // Login / register / password (and bare /user → login for anonymous).
  if (arg(0) !== 'user') {
    return FALSE;
  }
  $arg1 = arg(1);
  if ($arg1 !== NULL && $arg1 !== '' && !in_array($arg1, array('login', 'register', 'password'), TRUE)) {
    return FALSE;
  }

  $destination = isset($_GET['destination']) ? $_GET['destination'] : '';
  if (strpos($destination, 'oauth2/authorize') !== 0) {
    return FALSE;
  }

  if ($session_client !== '') {
    return $session_client === ROVAS_OAUTH_CLIENT_KEY;
  }

  // Destination present; session params exist but client_id key missing.
  return !empty($_SESSION['oauth2_server_authorize']);
}

/**
 * Whether a HybridAuth request is part of the Civic authorize login/register.
 *
 * @param string $session_client
 *   client_id from $_SESSION['oauth2_server_authorize'], or empty.
 *
 * @return bool
 */
function rovas_oauth_is_civic_hybridauth_destination($session_client = '') {
  // Prefer live query (window start); endpoint callback uses the session stash
  // written by hybridauth_window_start() / destination-survive patch.
  $destination = isset($_GET['destination']) ? $_GET['destination'] : '';
  if ($destination === '' && !empty($_SESSION['hybridauth_destination'])) {
    $destination = $_SESSION['hybridauth_destination'];
  }
  if (strpos($destination, 'oauth2/authorize') !== 0) {
    return FALSE;
  }

  if ($session_client !== '') {
    return $session_client === ROVAS_OAUTH_CLIENT_KEY;
  }

  return !empty($_SESSION['oauth2_server_authorize']);
}

/**
 * Implements hook_init().
 *
 * Capture Civic `lang` / `ui_locales` and `intent` on authorize; force interface
 * language for the Civic-branded login/register path.
 */
function rovas_oauth_init() {
  rovas_oauth_civic_ui_lang_capture_from_request();
  rovas_oauth_civic_intent_capture_from_request();
  rovas_oauth_civic_ui_lang_apply_or_clear();
  rovas_oauth_civic_intent_clear_outside_context();
}

/**
 * Implements hook_drupal_goto_alter().
 *
 * Honor Civic authorize `intent=register` (land on Create account) and keep
 * `lang=` / `intent=` on the redirect query for debuggability. Session is SoT.
 */
function rovas_oauth_drupal_goto_alter(&$path, &$options, &$http_response_code) {
  if ($path !== 'user/login' && $path !== 'user/register') {
    return;
  }

  $intent = !empty($_SESSION[ROVAS_OAUTH_CIVIC_INTENT_SESSION])
    ? $_SESSION[ROVAS_OAUTH_CIVIC_INTENT_SESSION]
    : '';
  $langcode = !empty($_SESSION[ROVAS_OAUTH_CIVIC_UI_LANG_SESSION])
    ? $_SESSION[ROVAS_OAUTH_CIVIC_UI_LANG_SESSION]
    : '';
  if ($intent === '' && $langcode === '') {
    return;
  }

  if (!isset($options['query']) || !is_array($options['query'])) {
    $options['query'] = array();
  }

  if ($path === 'user/login' && $intent === 'register') {
    $path = 'user/register';
  }

  if ($intent !== '' && empty($options['query']['intent'])) {
    $options['query']['intent'] = $intent;
  }
  if ($langcode !== '' && empty($options['query']['lang'])) {
    $options['query']['lang'] = $langcode;
  }
}

/**
 * Read `lang` / `ui_locales` on Civic authorize and stash an enabled langcode.
 */
function rovas_oauth_civic_ui_lang_capture_from_request() {
  // Only capture on the authorize endpoint for client civic.
  if (!(arg(0) === 'oauth2' && arg(1) === 'authorize')) {
    return;
  }
  $client_id = '';
  if (!empty($_GET['client_id'])) {
    $client_id = $_GET['client_id'];
  }
  elseif (!empty($_SESSION['oauth2_server_authorize']['client_id'])) {
    $client_id = $_SESSION['oauth2_server_authorize']['client_id'];
  }
  if ($client_id !== ROVAS_OAUTH_CLIENT_KEY) {
    return;
  }

  // Prefer live query (first hit); fall back to oauth2 session (return after
  // login — authorize query params were moved into $_SESSION).
  $langcode = rovas_oauth_civic_ui_lang_from_params($_GET);
  if ($langcode === FALSE && !empty($_SESSION['oauth2_server_authorize']) && is_array($_SESSION['oauth2_server_authorize'])) {
    $langcode = rovas_oauth_civic_ui_lang_from_params($_SESSION['oauth2_server_authorize']);
  }

  if ($langcode === FALSE) {
    // Query explicitly sent an unrecognized lang — do not force a fallback.
    if (isset($_GET['lang']) || isset($_GET['ui_locales'])) {
      unset($_SESSION[ROVAS_OAUTH_CIVIC_UI_LANG_SESSION]);
    }
    return;
  }

  $_SESSION[ROVAS_OAUTH_CIVIC_UI_LANG_SESSION] = $langcode;
  drupal_page_is_cacheable(FALSE);
}

/**
 * Parse lang / ui_locales from a parameter bag into an enabled langcode.
 *
 * @param array $params
 *   Query or oauth2 authorize session parameters.
 *
 * @return string|false
 *   Enabled langcode, or FALSE when missing / unsupported.
 */
function rovas_oauth_civic_ui_lang_from_params(array $params) {
  $candidates = array();
  if (isset($params['lang']) && trim((string) $params['lang']) !== '') {
    $candidates[] = trim((string) $params['lang']);
  }
  elseif (isset($params['ui_locales']) && trim((string) $params['ui_locales']) !== '') {
    $candidates = preg_split('/\s+/', trim((string) $params['ui_locales']));
  }
  if (empty($candidates)) {
    return FALSE;
  }

  $enabled = language_list('enabled');
  if (empty($enabled[1]) || !is_array($enabled[1])) {
    return FALSE;
  }
  $languages = $enabled[1];

  foreach ($candidates as $raw) {
    $langcode = rovas_oauth_map_civic_lang_candidate($raw, $languages);
    if ($langcode !== FALSE) {
      return $langcode;
    }
  }
  return FALSE;
}

/**
 * Map one Civic locale tag to an enabled Drupal language, or FALSE.
 *
 * Accepts sk / en (primary) and cs / cz → sk. Unknown tags are ignored.
 *
 * @param string $raw
 *   Raw lang or BCP47 tag.
 * @param array $languages
 *   Enabled language objects keyed by langcode.
 *
 * @return string|false
 */
function rovas_oauth_map_civic_lang_candidate($raw, array $languages) {
  $raw = trim((string) $raw);
  if ($raw === '') {
    return FALSE;
  }
  $lower = drupal_strtolower($raw);
  $parts = preg_split('/[-_]/', $lower, 2);
  $primary = $parts[0];

  // Contract: cs / cz → Slovak when available.
  if ($primary === 'cs' || $primary === 'cz') {
    if (isset($languages['sk'])) {
      return 'sk';
    }
    if (isset($languages['cs'])) {
      return 'cs';
    }
    return FALSE;
  }

  if (isset($languages[$primary])) {
    return $primary;
  }

  // sk-SK etc. via partner mapper when primary prefix matches result.
  if (function_exists('rovas_base_map_partner_user_language')) {
    $mapped = rovas_base_map_partner_user_language($raw);
    if (isset($languages[$mapped]) && (strpos($lower, $mapped) === 0 || $mapped === $primary)) {
      return $mapped;
    }
  }

  return FALSE;
}

/**
 * Force or clear Civic OAuth UI language for the current request.
 */
function rovas_oauth_civic_ui_lang_apply_or_clear() {
  if (empty($_SESSION[ROVAS_OAUTH_CIVIC_UI_LANG_SESSION])) {
    return;
  }

  if (!rovas_oauth_is_civic_authorize_context()) {
    // Do not leak into plain /user/login or the rest of the site.
    unset($_SESSION[ROVAS_OAUTH_CIVIC_UI_LANG_SESSION]);
    return;
  }

  $langcode = $_SESSION[ROVAS_OAUTH_CIVIC_UI_LANG_SESSION];
  $enabled = language_list('enabled');
  if (empty($enabled[1][$langcode])) {
    unset($_SESSION[ROVAS_OAUTH_CIVIC_UI_LANG_SESSION]);
    return;
  }

  rovas_oauth_force_interface_langcode($langcode, $enabled[1]);
  drupal_page_is_cacheable(FALSE);
}

/**
 * Capture Civic authorize `intent` (login|register) into session.
 *
 * Missing or invalid values keep / default to login landing (never 400).
 */
function rovas_oauth_civic_intent_capture_from_request() {
  if (!(arg(0) === 'oauth2' && arg(1) === 'authorize')) {
    return;
  }

  $client_id = '';
  if (!empty($_GET['client_id'])) {
    $client_id = $_GET['client_id'];
  }
  elseif (!empty($_SESSION['oauth2_server_authorize']['client_id'])) {
    $client_id = $_SESSION['oauth2_server_authorize']['client_id'];
  }
  if ($client_id !== ROVAS_OAUTH_CLIENT_KEY) {
    return;
  }

  $raw = NULL;
  if (isset($_GET['intent'])) {
    $raw = $_GET['intent'];
  }
  elseif (!empty($_SESSION['oauth2_server_authorize']) && is_array($_SESSION['oauth2_server_authorize']) && isset($_SESSION['oauth2_server_authorize']['intent'])) {
    $raw = $_SESSION['oauth2_server_authorize']['intent'];
  }

  if ($raw === NULL) {
    return;
  }

  $intent = drupal_strtolower(trim((string) $raw));
  if ($intent === 'register' || $intent === 'login') {
    $_SESSION[ROVAS_OAUTH_CIVIC_INTENT_SESSION] = $intent;
  }
  else {
    // Invalid → same landing as missing (login); do not 400 authorize.
    $_SESSION[ROVAS_OAUTH_CIVIC_INTENT_SESSION] = 'login';
  }
  drupal_page_is_cacheable(FALSE);
}

/**
 * Drop authorize intent when leaving Civic-branded OAuth chrome.
 */
function rovas_oauth_civic_intent_clear_outside_context() {
  if (empty($_SESSION[ROVAS_OAUTH_CIVIC_INTENT_SESSION])) {
    return;
  }
  if (!rovas_oauth_is_civic_authorize_context()) {
    unset($_SESSION[ROVAS_OAUTH_CIVIC_INTENT_SESSION]);
  }
}

/**
 * Overwrite Drupal globals so t() / .po strings use $langcode.
 *
 * @param string $langcode
 *   Enabled langcode.
 * @param array $languages
 *   Enabled language objects keyed by langcode.
 */
function rovas_oauth_force_interface_langcode($langcode, array $languages) {
  if (!isset($languages[$langcode])) {
    return;
  }
  $language = $languages[$langcode];
  $GLOBALS['language'] = $language;
  if (isset($GLOBALS['language_content'])) {
    $GLOBALS['language_content'] = $language;
  }
}

/**
 * Absolute URL for the Civic wordmark shipped with this module.
 *
 * @return string
 */
function rovas_oauth_civic_logo_url() {
  global $base_url;
  return $base_url . '/' . drupal_get_path('module', 'rovas_oauth') . '/images/civic-wordmark.svg';
}

/**
 * Attach Civic OAuth chrome CSS when in Civic authorize context.
 */
function rovas_oauth_attach_civic_chrome() {
  static $attached = FALSE;
  if ($attached || !rovas_oauth_is_civic_authorize_context()) {
    return;
  }
  $attached = TRUE;
  drupal_add_css(drupal_get_path('module', 'rovas_oauth') . '/css/civic-oauth.css', array(
    'group' => CSS_DEFAULT,
    'every_page' => FALSE,
    'weight' => 50,
  ));
}

/**
 * Implements hook_preprocess_html().
 */
function rovas_oauth_preprocess_html(&$variables) {
  if (!rovas_oauth_is_civic_authorize_context()) {
    return;
  }
  $variables['classes_array'][] = 'rovas-oauth-civic';
  if (!empty($variables['head_title_array']['name'])) {
    $variables['head_title_array']['name'] = t('Your Civic account');
    $variables['head_title'] = implode(' | ', array_filter($variables['head_title_array']));
  }
  rovas_oauth_attach_civic_chrome();
}

/**
 * Implements hook_preprocess_page().
 *
 * Swap Rovas navbar/footer chrome for Civic branding on the authorize path.
 */
function rovas_oauth_preprocess_page(&$variables) {
  if (!rovas_oauth_is_civic_authorize_context()) {
    return;
  }

  rovas_oauth_attach_civic_chrome();

  $variables['logo'] = rovas_oauth_civic_logo_url();
  $variables['site_name'] = t('Your Civic account');
  $variables['site_slogan'] = '';
  // Login/register/password: brand lives in the navbar. Keep consent page title.
  if (arg(0) === 'user') {
    $variables['title'] = '';
  }
  $variables['primary_nav'] = NULL;
  $variables['secondary_nav'] = NULL;
  if (isset($variables['main_menu'])) {
    $variables['main_menu'] = NULL;
  }
  if (isset($variables['secondary_menu'])) {
    $variables['secondary_menu'] = NULL;
  }

  // Replace Rovas marketing footer with a quiet identity line.
  $variables['page']['footer'] = array(
    'civic_oauth_footer' => array(
      '#markup' => '<p class="civic-oauth-footer">'
        . t('Your Civic account on Rovas')
        . ' · <a href="' . check_url(url('privacy')) . '">' . t('Privacy') . '</a></p>',
    ),
  );
}

/**
 * Implements hook_preprocess_menu_local_task().
 *
 * Keep destination=oauth2/authorize on Log in / Create new account tabs so
 * register completes the OAuth flow instead of dropping the user on /user.
 * Shorten Civic tab labels.
 */
function rovas_oauth_preprocess_menu_local_task(&$variables) {
  if (!rovas_oauth_is_civic_authorize_context()) {
    return;
  }
  if (empty($variables['element']['#link']['href'])) {
    return;
  }
  $href = $variables['element']['#link']['href'];
  if (!in_array($href, array('user', 'user/login', 'user/register', 'user/password'), TRUE)) {
    return;
  }
  if (!isset($variables['element']['#link']['localized_options'])) {
    $variables['element']['#link']['localized_options'] = array();
  }
  if (!isset($variables['element']['#link']['localized_options']['query'])) {
    $variables['element']['#link']['localized_options']['query'] = array();
  }
  $variables['element']['#link']['localized_options']['query']['destination'] = 'oauth2/authorize';

  $titles = array(
    'user/register' => t('Create account'),
    'user/login' => t('Log in'),
    'user' => t('Log in'),
    'user/password' => t('Reset password'),
  );
  if (isset($titles[$href])) {
    $variables['element']['#link']['title'] = $titles[$href];
  }
  if (!isset($variables['element']['#link']['localized_options']['attributes']['class'])) {
    $variables['element']['#link']['localized_options']['attributes']['class'] = array();
  }
  elseif (!is_array($variables['element']['#link']['localized_options']['attributes']['class'])) {
    $variables['element']['#link']['localized_options']['attributes']['class'] = array(
      $variables['element']['#link']['localized_options']['attributes']['class'],
    );
  }
  $variables['element']['#link']['localized_options']['attributes']['class'][] = 'civic-oauth-auth-tab';
}

/**
 * Implements hook_form_FORM_ID_alter() for oauth2_server_authorize_form.
 *
 * Re-apply authorize UI strings through t() so locale translations (sk/cs/it)
 * apply, including the Civic scope description (entity i18n alone does not).
 */
function rovas_oauth_form_oauth2_server_authorize_form_alter(&$form, &$form_state) {
  $client = isset($form_state['build_info']['args'][0]) ? $form_state['build_info']['args'][0] : NULL;
  $scopes = isset($form_state['build_info']['args'][2]) ? $form_state['build_info']['args'][2] : array();
  $is_civic = $client && !empty($client->client_key) && $client->client_key === ROVAS_OAUTH_CLIENT_KEY;

  if ($is_civic) {
    drupal_set_title(t('Continue to Civic'));
  }
  elseif ($client && !empty($client->label)) {
    drupal_set_title(t('Authorize @client to use your account?', array('@client' => $client->label)));
  }

  $list = array(
    'title' => t('This application will be able to:'),
    'items' => array(),
    'type' => 'ul',
  );
  if (is_array($scopes)) {
    foreach ($scopes as $scope) {
      $description = !empty($scope->description) ? $scope->description : '';
      // Fixed scope copy from rovas_oauth_ensure_server(); t() enables .po import.
      $list['items'][] = array('data' => $description !== '' ? t($description) : '');
    }
  }
  $form['scopes']['#markup'] = theme('item_list', $list);

  if (isset($form['authorize'])) {
    $form['authorize']['#value'] = $is_civic
      ? t('Continue')
      : t('Yes, I authorize this request.');
  }
  if (isset($form['cancel'])) {
    $form['cancel']['#value'] = t('Cancel');
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login.
 *
 * When the user lands here from Civic /oauth2/authorize, brand the form.
 * HybridAuth already injects its widget onto the standard login forms.
 */
function rovas_oauth_form_user_login_alter(&$form, &$form_state) {
  rovas_oauth_annotate_civic_auth_form($form, 'login');
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_block.
 */
function rovas_oauth_form_user_login_block_alter(&$form, &$form_state) {
  rovas_oauth_annotate_civic_auth_form($form, 'login');
}

/**
 * Implements hook_form_FORM_ID_alter() for user_register_form.
 */
function rovas_oauth_form_user_register_form_alter(&$form, &$form_state) {
  rovas_oauth_annotate_civic_auth_form($form, 'register');
}

/**
 * Implements hook_form_FORM_ID_alter() for user_pass.
 */
function rovas_oauth_form_user_pass_alter(&$form, &$form_state) {
  rovas_oauth_annotate_civic_auth_form($form, 'password');
}

/**
 * Brand login/register/password forms for Civic OAuth authorize.
 *
 * @param array $form
 *   Form array (by reference).
 * @param string $mode
 *   'login', 'register', or 'password'.
 */
function rovas_oauth_annotate_civic_auth_form(&$form, $mode = 'login') {
  if (!rovas_oauth_is_civic_authorize_context()) {
    return;
  }

  rovas_oauth_attach_civic_chrome();

  // Navbar carries the brand label; keep a short browser/document title only.
  drupal_set_title(t('Your Civic account'));

  if ($mode === 'register') {
    // Ensure post-register lands back on authorize (session holds PKCE params).
    $form['#action'] = url('user/register', array(
      'query' => array('destination' => 'oauth2/authorize'),
    ));
  }

  // HybridAuth under the intro (above form fields) on login and register.
  if ($mode !== 'password' && user_access('use hybridauth') && function_exists('hybridauth_get_enabled_providers')) {
    if (empty($form['hybridauth'])) {
      $form['hybridauth'] = array(
        '#type' => 'hybridauth_widget',
      );
    }
    $form['hybridauth']['#title'] = '';
    $form['hybridauth']['#weight'] = -50;
  }

  // Drop site-name suffix (“… Rovas”) from the login username help.
  if ($mode === 'login' && !empty($form['name'])) {
    $form['name']['#description'] = t('Enter your username.');
  }

  if ($mode === 'password') {
    $intro = t('Request a link to reset a lost or forgotten password. The link will be sent to the e-mail address you provide below. If you do not receive it within 10 minutes, please check your spam folder.');
    // Keep destination so a successful reset request returns to authorize flow.
    $form['#action'] = url('user/password', array(
      'query' => array('destination' => 'oauth2/authorize'),
    ));
  }
  elseif ($mode === 'register') {
    $intro = t('You can sign in via a service represented by an icon, or create an account with a password by filling in the form under the icons.');
  }
  else {
    $intro = t('Sign in via a service represented by an icon, or enter your username and password in the form under the icons. Your Civic login credentials are the same as your Rovas login credentials.');
  }

  // Plain markup (not #type item) so Bootstrap does not emit an empty label
  // / .form-group that pushes card content down.
  $form['rovas_oauth_intro'] = array(
    '#markup' => '<p class="rovas-oauth-intro">' . $intro . '</p>',
    '#weight' => -100,
  );

  // HybridAuth's form_alter may run after ours; re-assert order in after_build.
  if (!isset($form['#after_build']) || !is_array($form['#after_build'])) {
    $form['#after_build'] = array();
  }
  if (!in_array('rovas_oauth_civic_auth_form_after_build', $form['#after_build'], TRUE)) {
    $form['#after_build'][] = 'rovas_oauth_civic_auth_form_after_build';
  }
}

/**
 * After-build: keep intro → HybridAuth → fields order on Civic auth forms.
 */
function rovas_oauth_civic_auth_form_after_build($form, &$form_state) {
  if (!empty($form['rovas_oauth_intro'])) {
    $form['rovas_oauth_intro']['#weight'] = -100;
  }
  if (!empty($form['hybridauth'])) {
    $form['hybridauth']['#title'] = '';
    $form['hybridauth']['#weight'] = -50;
  }
  return $form;
}

/**
 * Ensure the Civic OAuth2 server entity exists (idempotent).
 *
 * @return \OAuth2Server
 *   The server entity.
 */
function rovas_oauth_ensure_server() {
  $server = oauth2_server_load(ROVAS_OAUTH_SERVER);
  if ($server) {
    $needs_save = FALSE;
    // Keep PKCE enforced if an older export lacked it.
    if (empty($server->settings['enforce_pkce'])) {
      $server->settings['enforce_pkce'] = TRUE;
      $needs_save = TRUE;
    }
    // Civic mobile needs a new refresh token on each use (14-day lifetime).
    if (empty($server->settings['always_issue_new_refresh_token'])) {
      $server->settings['always_issue_new_refresh_token'] = TRUE;
      $needs_save = TRUE;
    }
    // Authorization codes default to 30s; allow time for mobile code exchange.
    if (empty($server->settings['auth_code_lifetime']) || (int) $server->settings['auth_code_lifetime'] < 120) {
      $server->settings['auth_code_lifetime'] = 120;
      $needs_save = TRUE;
    }
    if ($needs_save) {
      $server->save();
    }
    return $server;
  }

  $server = entity_create('oauth2_server', array(
    'name' => ROVAS_OAUTH_SERVER,
    'label' => 'Civic',
    'status' => 1,
    'settings' => array(
      'default_scope' => 'user_profile',
      'enforce_state' => TRUE,
      'allow_implicit' => FALSE,
      'enforce_pkce' => TRUE,
      'use_openid_connect' => FALSE,
      'use_crypto_tokens' => FALSE,
      'require_exact_redirect_uri' => TRUE,
      'grant_types' => array(
        'authorization_code' => 'authorization_code',
        'refresh_token' => 'refresh_token',
      ),
      'access_lifetime' => 3600,
      'refresh_token_lifetime' => 1209600,
      'always_issue_new_refresh_token' => TRUE,
      'auth_code_lifetime' => 120,
    ),
  ));
  $server->save();

  // Default scope used by the Civic mobile client.
  if (!oauth2_server_scope_load(ROVAS_OAUTH_SERVER, 'user_profile')) {
    $scope = entity_create('oauth2_server_scope', array(
      'server' => ROVAS_OAUTH_SERVER,
      'name' => 'user_profile',
      'description' => 'Read your Rovas username and grant Merits on your behalf.',
    ));
    $scope->save();
  }

  return $server;
}

/**
 * Ensure the Civic public OAuth client exists (idempotent).
 *
 * Redirect URIs are newline-separated. Expo Go / dev client URIs can be added
 * later via the admin UI without code changes.
 *
 * @param string|null $extra_redirect
 *   Optional additional redirect URI (e.g. Expo auth proxy).
 *
 * @return \OAuth2ServerClient
 *   The client entity.
 */
function rovas_oauth_ensure_client($extra_redirect = NULL) {
  rovas_oauth_ensure_server();

  $redirects = array(ROVAS_OAUTH_REDIRECT_PROD);
  if ($extra_redirect) {
    $redirects[] = $extra_redirect;
  }

  $client = oauth2_server_client_load(ROVAS_OAUTH_CLIENT_KEY);
  if ($client) {
    $needs_save = FALSE;
    // Merge redirect URIs if missing.
    $existing = preg_split('/\s+/', trim($client->redirect_uri));
    $merged = array_unique(array_filter(array_merge($existing, $redirects)));
    $new_uri = implode("\n", $merged);
    if ($new_uri !== $client->redirect_uri) {
      $client->redirect_uri = $new_uri;
      $needs_save = TRUE;
    }
    // Public native client — no secret.
    if (!empty($client->client_secret)) {
      $client->client_secret = '';
      $needs_save = TRUE;
    }
    // Skip the consent screen; Civic already authenticated the user on Rovas.
    if (empty($client->automatic_authorization)) {
      $client->automatic_authorization = TRUE;
      $needs_save = TRUE;
    }
    if ($needs_save) {
      $client->save();
    }
    return $client;
  }

  $client = entity_create('oauth2_server_client', array(
    'server' => ROVAS_OAUTH_SERVER,
    'label' => 'Civic mobile',
    'client_key' => ROVAS_OAUTH_CLIENT_KEY,
    'client_secret' => '',
    'redirect_uri' => implode("\n", $redirects),
    'automatic_authorization' => TRUE,
    'settings' => array(
      'override_grant_types' => FALSE,
      'grant_types' => array(
        'authorization_code' => 'authorization_code',
        'refresh_token' => 'refresh_token',
      ),
    ),
  ));
  $client->save();
  return $client;
}

/**
 * Resolve the current request's OAuth2 Bearer token to a Drupal user id.
 *
 * Relies on oauth2_server_check_access(), which reads Authorization from the
 * incoming request (Authorization: Bearer …).
 *
 * @param string|null $scope
 *   Optional space-separated required scopes.
 *
 * @return int|false
 *   Drupal uid, or FALSE if invalid / expired / missing.
 */
function rovas_oauth_uid_from_bearer($scope = NULL) {
  $result = oauth2_server_check_access(ROVAS_OAUTH_SERVER, $scope);
  if (is_array($result) && !empty($result['user_id'])) {
    return (int) $result['user_id'];
  }
  return FALSE;
}

/**
 * Implements hook_services_resources().
 *
 * Civic home reads. Resources must also be enabled on rovas_endpoint
 * (see rovas_oauth_ensure_civic_resources()).
 */
function rovas_oauth_services_resources() {
  return array(
    'me' => array(
      'operations' => array(
        'index' => array(
          'help' => 'Profile + Merit total for the Bearer-authenticated user.',
          'callback' => 'rovas_oauth_me_index',
          'access callback' => 'rovas_oauth_me_access',
          'access arguments' => array(),
          'access arguments append' => FALSE,
          'args' => array(),
        ),
      ),
    ),
    'contributions' => array(
      'operations' => array(
        'retrieve' => array(
          'help' => 'Community contribution aggregates. Path id "aggregate" returns total ME (and optional category zeros).',
          'callback' => 'rovas_oauth_contributions_retrieve',
          'access callback' => 'services_access_menu',
          'args' => array(
            array(
              'name' => 'id',
              'type' => 'string',
              'description' => 'Use "aggregate" for community Merit totals.',
              'source' => array('path' => 0),
              'optional' => FALSE,
            ),
          ),
        ),
      ),
    ),
  );
}

/**
 * Access callback for GET /rovas/me.
 */
function rovas_oauth_me_access() {
  global $user;
  if (!empty($user->uid)) {
    return TRUE;
  }
  // Fallback if Services OAuth2 plugin did not switch $user.
  return (bool) rovas_oauth_uid_from_bearer('user_profile');
}

/**
 * Services callback: GET /rovas/me.
 *
 * @return array
 *   uid, username, display_name, total_me, total_chr, created (ISO-8601 or null),
 *   language (Drupal langcode or null).
 */
function rovas_oauth_me_index() {
  global $user;

  $uid = !empty($user->uid) ? (int) $user->uid : (int) rovas_oauth_uid_from_bearer('user_profile');
  if ($uid < 1) {
    return services_error(t('Authentication required'), 401);
  }

  $account = user_load($uid);
  if (!$account || empty($account->uid)) {
    return services_error(t('User not found'), 404);
  }

  $display_name = $account->name;
  $items = field_get_items('user', $account, 'field_full_name');
  if (!empty($items[0]['value'])) {
    $display_name = $items[0]['value'];
  }

  $total_me = 0.0;
  if (function_exists('_rovas_merit_distribution_user_merits')) {
    $merits = _rovas_merit_distribution_user_merits($uid);
    $total_me = $merits !== NULL ? (float) $merits : 0.0;
  }
  else {
    $total_me = (float) rovas_oauth_user_merits_fallback($uid);
  }

  $created = NULL;
  if (!empty($account->created) && (int) $account->created > 0) {
    $created = gmdate('c', (int) $account->created);
  }

  // Raw Drupal preferred language; Civic maps cs/cz → sk for its catalog.
  $language = NULL;
  if (!empty($account->language)) {
    $language = trim((string) $account->language);
    if ($language === '' || $language === 'und') {
      $language = NULL;
    }
  }

  $total_chr = 0.0;
  $chr_items = field_get_items('user', $account, 'field_chrons_balance');
  if (!empty($chr_items[0]['value']) && is_numeric($chr_items[0]['value'])) {
    $total_chr = (float) $chr_items[0]['value'];
  }

  return array(
    'uid' => $uid,
    'username' => $account->name,
    'display_name' => $display_name,
    'total_me' => $total_me,
    'total_chr' => $total_chr,
    'created' => $created,
    'language' => $language,
  );
}

/**
 * Services callback: GET /rovas/contributions/{id}.
 *
 * @param string $id
 *   Only "aggregate" is supported in v1.
 *
 * @return array
 */
function rovas_oauth_contributions_retrieve($id) {
  if ($id !== 'aggregate') {
    return services_error(t('Unknown contributions resource'), 404);
  }

  $total_me = 0.0;
  if (function_exists('_rovas_merit_distribution_collect_merits')) {
    foreach (_rovas_merit_distribution_collect_merits() as $row) {
      $total_me += (float) $row->merits;
    }
  }
  else {
    $total_me = (float) rovas_oauth_community_merits_fallback();
  }

  return array(
    'total_me' => round($total_me, 2),
    'by_category' => array(
      'taxes' => 0,
      'charity' => 0,
      'volunteer' => 0,
    ),
  );
}

/**
 * Fallback single-user Merit total when merit_distribution is unavailable.
 */
function rovas_oauth_user_merits_fallback($uid) {
  $uid = (int) $uid;
  if ($uid <= 1) {
    return 0.0;
  }
  $row = db_query("
    SELECT (IFNULL(pt.points, 0) + IFNULL(d.field_merit_decimal_part_value, 0)) AS merits
    FROM {users} u
    LEFT JOIN {userpoints_total} pt ON u.uid = pt.uid
    LEFT JOIN {field_data_field_merit_decimal_part} d
      ON u.uid = d.entity_id
      AND d.entity_type = 'user'
      AND d.deleted = 0
    WHERE u.uid = :uid AND u.status <> 0
  ", array(':uid' => $uid))->fetchField();
  return $row !== FALSE ? (float) $row : 0.0;
}

/**
 * Fallback community Merit sum (uncached) when merit_distribution is unavailable.
 */
function rovas_oauth_community_merits_fallback() {
  return (float) db_query("
    SELECT SUM(IFNULL(pt.points, 0) + IFNULL(d.field_merit_decimal_part_value, 0))
    FROM {users} u
    LEFT JOIN {userpoints_total} pt ON u.uid = pt.uid
    LEFT JOIN {field_data_field_merit_decimal_part} d
      ON u.uid = d.entity_id
      AND d.entity_type = 'user'
      AND d.deleted = 0
    WHERE u.status <> 0 AND u.uid > 1
  ")->fetchField();
}

/**
 * Ensure rovas_endpoint has OAuth2 server "civic" and Civic home resources enabled.
 *
 * Idempotent. Disables API-key auth on Civic resources so Bearer-only callers
 * work. Keeps services_auth_apikeys for existing partner/API-key clients.
 *
 * @return bool
 *   TRUE if the endpoint was saved (or already correct), FALSE if missing.
 */
function rovas_oauth_ensure_civic_resources() {
  if (!function_exists('services_endpoint_load') || !function_exists('services_endpoint_save')) {
    return FALSE;
  }

  $endpoint = services_endpoint_load(ROVAS_OAUTH_SERVICES_ENDPOINT);
  if (!$endpoint) {
    watchdog('rovas_oauth', 'Services endpoint @name not found; cannot enable Civic resources.', array(
      '@name' => ROVAS_OAUTH_SERVICES_ENDPOINT,
    ), WATCHDOG_WARNING);
    return FALSE;
  }

  $changed = FALSE;

  // Endpoint-level OAuth2 must be an array with server = civic (checkbox-only
  // leaves a bare module string that cannot authenticate).
  $oauth_settings = isset($endpoint->authentication['oauth2_server'])
    ? $endpoint->authentication['oauth2_server']
    : NULL;
  if (!is_array($oauth_settings) || empty($oauth_settings['server']) || $oauth_settings['server'] !== ROVAS_OAUTH_SERVER) {
    $endpoint->authentication['oauth2_server'] = array(
      'server' => ROVAS_OAUTH_SERVER,
    );
    $changed = TRUE;
  }

  $civic_ops = array(
    'me' => array(
      'operations' => array(
        'index' => array(
          'enabled' => 1,
          'settings' => array(
            'services_auth_apikeys' => array(
              'disable_authentication' => 1,
            ),
            'oauth2_server' => array(
              'require_authentication' => 1,
              'scope' => 'user_profile',
            ),
          ),
        ),
      ),
    ),
    'contributions' => array(
      'operations' => array(
        'retrieve' => array(
          'enabled' => 1,
          'settings' => array(
            'services_auth_apikeys' => array(
              'disable_authentication' => 1,
            ),
            'oauth2_server' => array(
              'require_authentication' => 0,
              'scope' => '',
            ),
          ),
        ),
      ),
    ),
  );

  // JSON histogram from rovas_merit_distribution (optional Bearer).
  if (module_exists('rovas_merit_distribution')) {
    $civic_ops['merit_distribution'] = array(
      'operations' => array(
        'index' => array(
          'enabled' => 1,
          'settings' => array(
            'services_auth_apikeys' => array(
              'disable_authentication' => 1,
            ),
            'oauth2_server' => array(
              'require_authentication' => 0,
              'scope' => '',
            ),
          ),
        ),
      ),
    );
  }

  foreach ($civic_ops as $resource => $def) {
    if (empty($endpoint->resources[$resource]) || $endpoint->resources[$resource] != $def) {
      $endpoint->resources[$resource] = $def;
      $changed = TRUE;
    }
  }

  if ($changed) {
    services_endpoint_save($endpoint);
  }

  return TRUE;
}
