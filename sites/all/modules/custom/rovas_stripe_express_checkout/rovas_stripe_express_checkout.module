<?php

require_once DRUPAL_ROOT . '/sites/all/libraries/stripe-php/init.php';

/**
 * Implements hook_menu().
 */
function rovas_stripe_express_checkout_menu() {
  $items = [];

  $items['stripe/express-checkout/init'] = array(
    'page callback' => 'rovas_stripe_express_checkout_init_x',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  $items['stripe/express-checkout/thank-you'] = array(
    'page callback' => 'rovas_stripe_express_checkout_thanks',
    'access callback' => TRUE,
    'type' => MENU_CALLBACK,
  );

  $items['stripe/express-checkout/init-buyshares'] = array(
    'page callback' => 'rovas_stripe_express_checkout_init_buyshares',
    'access callback' => 'user_access',
    'access arguments' => array('access content'),
    'type' => MENU_CALLBACK,
  );

  $items['stripe/express-checkout/init-buymerits'] = array(
    'page callback' => 'rovas_stripe_express_checkout_init_buymerits',
    'access callback' => 'user_access',
    'access arguments' => array('access content'),
    'type' => MENU_CALLBACK,
  );

  return $items;
}

function rovas_stripe_express_checkout_add_js() {
  drupal_add_js(drupal_get_path('module', 'rovas_stripe_express_checkout') . '/js/express_checkout.js');
  global $user, $language;
  drupal_add_js(array(
    'rovasStripeExpressCheckout' => array(
      'uid' => !empty($user->uid) ? (int) $user->uid : 0,
      'uiLang' => !empty($language->language) ? (string) $language->language : '',
    ),
  ), 'setting');
}

function rovas_stripe_express_checkout_init_x() {
  module_load_include('inc', 'rovas_stripe_express_checkout', 'includes/init');
  return _rovas_stripe_express_checkout_init();
}

/**
 * Menu callback: Express init for buyshares (Commerce order-first).
 */
function rovas_stripe_express_checkout_init_buyshares() {
  module_load_include('inc', 'rovas_stripe_express_checkout', 'includes/init_buyshares');
  return _rovas_stripe_express_checkout_init_buyshares();
}

/**
 * Menu callback: Express init for buymerits (Commerce order-first).
 */
function rovas_stripe_express_checkout_init_buymerits() {
  module_load_include('inc', 'rovas_stripe_express_checkout', 'includes/init_buymerits');
  return _rovas_stripe_express_checkout_init_buymerits();
}

function rovas_stripe_express_checkout_thanks() {
    /*
    https://dev.rovas.app/stripe/express-checkout/thank-you?
    payment_intent=pi_3RSwIbDM0rK3al8P1gUwGvgt&
    payment_intent_client_secret=pi_3RSwIbDM0rK3al8P1gUwGvgt_secret_gDDr73ZBgAVfPlXRqkLKCKNyD&
    redirect_status=succeeded
    */

	global $user;

	$parameters = drupal_get_query_parameters();
	
	$payment_intent_id = isset($parameters['payment_intent']) ? $parameters['payment_intent'] : null;
	$redirect_status = isset($parameters['redirect_status']) ? $parameters['redirect_status'] : '';

	if (!$payment_intent_id) {
			drupal_goto('rewpro');
			return;
	}

	$buyshares_redirect = NULL;

	try {
			\Stripe\Stripe::setApiKey(variable_get('stripe_secret_key'));        
			$intent = \Stripe\PaymentIntent::retrieve($payment_intent_id);

			$meta_paytype = isset($intent->metadata->paytype) ? (string) $intent->metadata->paytype : '';
			if ($meta_paytype === 'buymerits' && !empty($intent->metadata->commerce_order_id)) {
				$merits_uid = !empty($intent->metadata->user_id) ? (int) $intent->metadata->user_id : (int) $user->uid;
				$rewpro_retry = url('rewpro', array(
					'absolute' => TRUE,
					'query' => array(
						'paytype' => 'buymerits',
						'recipient' => $merits_uid > 0 ? $merits_uid : $user->uid,
					),
				));
				$pi_status = isset($intent->status) ? (string) $intent->status : '';
				$payment_failed = ($redirect_status === 'failed' || $redirect_status === 'canceled')
					|| ($pi_status !== '' && $pi_status !== 'succeeded');
				if ($payment_failed) {
					drupal_set_message(t('Your payment was not completed. You have not been charged. You can try again from the purchase page.'), 'error');
					$buyshares_redirect = $rewpro_retry;
				}
				else {
					$order_label = '';
					if (!empty($intent->metadata->commerce_order_id) && function_exists('commerce_order_load')) {
						$buy_oid = (int) $intent->metadata->commerce_order_id;
						$buy_order = commerce_order_load($buy_oid);
						if ($buy_order && !empty($buy_order->order_number)) {
							$order_label = $buy_order->order_number;
						}
						elseif ($buy_oid > 0) {
							$order_label = (string) $buy_oid;
						}
					}
					$thanks_parts = array(t('Thank you! Your payment for Merits was received.'));
					if ($order_label !== '') {
						$thanks_parts[] = t('Your order number is @number.', array('@number' => $order_label));
					}
					if (!empty($user->uid) && !empty($intent->metadata->commerce_order_id)) {
						$buy_oid = (int) $intent->metadata->commerce_order_id;
						$thanks_parts[] = t('You can !order_link or !forex_link.', array(
							'!order_link' => l(t('view your order'), 'user/' . $user->uid . '/orders/' . $buy_oid),
							'!forex_link' => l(t('return to Forex'), 'forex'),
						));
					}
					else {
						$thanks_parts[] = t('You can !forex_link.', array(
							'!forex_link' => l(t('continue to Forex'), 'forex'),
						));
					}
					drupal_set_message(implode(' ', $thanks_parts));
					$buyshares_redirect = url('forex', array('absolute' => TRUE));
				}
			}
			elseif ($meta_paytype === 'buyshares' && !empty($intent->metadata->project_id)) {
				$recipient_nid = (int) $intent->metadata->project_id;
				$rewpro_retry = url('rewpro', array(
					'absolute' => TRUE,
					'query' => array(
						'paytype' => 'buyshares',
						'recipient' => $recipient_nid,
					),
				));
				$pi_status = isset($intent->status) ? (string) $intent->status : '';
				$payment_failed = ($redirect_status === 'failed' || $redirect_status === 'canceled')
					|| ($pi_status !== '' && $pi_status !== 'succeeded');
				if ($payment_failed) {
					drupal_set_message(t('Your payment was not completed. You have not been charged. You can try again from the purchase page.'), 'error');
					$buyshares_redirect = $rewpro_retry;
				}
				else {
					$order_label = '';
					if (!empty($intent->metadata->commerce_order_id) && function_exists('commerce_order_load')) {
						$buy_oid = (int) $intent->metadata->commerce_order_id;
						$buy_order = commerce_order_load($buy_oid);
						if ($buy_order && !empty($buy_order->order_number)) {
							$order_label = $buy_order->order_number;
						}
						elseif ($buy_oid > 0) {
							$order_label = (string) $buy_oid;
						}
					}
					$project_url = url('node/' . $recipient_nid, array('absolute' => TRUE));
					$thanks_parts = array(t('Thank you! Your payment for time shares was received.'));
					if ($order_label !== '') {
						$thanks_parts[] = t('Your order number is @number.', array('@number' => $order_label));
					}
					if (!empty($user->uid) && !empty($intent->metadata->commerce_order_id)) {
						$buy_oid = (int) $intent->metadata->commerce_order_id;
						$thanks_parts[] = t('You can !order_link or !project_link.', array(
							'!order_link' => l(t('view your order'), 'user/' . $user->uid . '/orders/' . $buy_oid),
							'!project_link' => l(t('return to the project'), 'node/' . $recipient_nid),
						));
					}
					else {
						$thanks_parts[] = t('You can !project_link.', array(
							'!project_link' => l(t('continue to the project'), 'node/' . $recipient_nid),
						));
					}
					drupal_set_message(implode(' ', $thanks_parts));
					$buyshares_redirect = $project_url;
				}
			}
			else {
			$project_id = isset($intent->metadata->project_id) ? $intent->metadata->project_id : null;
			$paid_minor = isset($intent->amount_received) ? (int) $intent->amount_received : 0;
			$email = isset($intent->charges->data[0]->receipt_email) ? $intent->charges->data[0]->receipt_email : null;

			if ($project_id && $project_id !== 'none') {
					$project = node_load($project_id);
					if ($project) {
						// Populate rewpro session with order_id for outbound webhook logs
						// and dedupe: if webhook already notified, don't POST again here.
						$order_id = _rovas_stripe_express_checkout_find_order_id_by_payment_intent($payment_intent_id, $intent);
						if ($order_id && function_exists('rovas_project_reward_session_get') && function_exists('rovas_project_reward_session_set')) {
							$sessary = rovas_project_reward_session_get('rovas_project_reward', array());
							$sessary['commerce_order_id'] = (int) $order_id;
							rovas_project_reward_session_set('rovas_project_reward', $sessary);
						}

						$already_notified = FALSE;
						if ($order_id && function_exists('commerce_order_load')) {
							$o = commerce_order_load((int) $order_id);
							$already_notified = ($o && !empty($o->data['rovas_stripe_purchase_notified']));
						}

						if ($already_notified) {
							// Webhook already notified; keep UX redirect without duplicating the POST.
							if (!isset($sessary) && function_exists('rovas_project_reward_session_get')) {
								$sessary = rovas_project_reward_session_get('rovas_project_reward', array());
							}
							if (!empty($sessary['callback_url']) && is_string($sessary['callback_url'])) {
								$buyshares_redirect = $sessary['callback_url'];
							}
						}
						else {
							rovas_project_reward_notify_purchase($project, $paid_minor, 'EUR', $email);
						}
					} else {
						watchdog('rovas_stripe', 'Project @nid not found for PI: @pi_id', array('@nid' => $project_id, '@pi_id' => $payment_intent_id), WATCHDOG_WARNING);
					}
			} else {
					watchdog('rovas_stripe', 'No project_id found in PaymentIntent metadata for PI: @pi_id', array('@pi_id' => $payment_intent_id), WATCHDOG_WARNING);
			}
			}
			
	} catch (Exception $e) {
			watchdog('rovas_stripe', 'Error retrieving PaymentIntent: @error', array('@error' => $e->getMessage()), WATCHDOG_ERROR);
	}

	// rovas_project_reward_notify_purchase() queues a redirect via
	// _rovas_project_reward_queue_redirect() (e.g. to the 3rd party callback_url).
	// Unlike the Commerce checkout flow (which executes it from
	// rovas_project_reward_review_finalize_payment), we must run it here.
	$redirect = $buyshares_redirect;
	if (!$redirect) {
		$redirect = _rovas_project_reward_queue_redirect();
	}
	if (!$redirect) {
		$redirect = url('rewpro', array('absolute' => TRUE));
	}

	// Commit session before redirecting so the session lock is released.
	if (drupal_get_bootstrap_phase() >= DRUPAL_BOOTSTRAP_SESSION) {
		drupal_session_commit();
	}

	// Send HTTP 302. In some environments (early output from a concurrent
	// request or a module hook) header() may fail silently because headers are
	// already sent. The HTML/JS fallback below ensures the browser redirects
	// regardless of whether the Location header was actually transmitted.
	header('Location: ' . $redirect, TRUE, 302);
	print '<!DOCTYPE html><html><head>'
		. '<meta http-equiv="refresh" content="0;url=' . check_plain($redirect) . '">'
		. '<script>window.location.replace(' . drupal_json_encode($redirect) . ');</script>'
		. '</head><body>Redirecting...</body></html>';
	drupal_exit();
}

/**
 * Best-effort lookup: map Stripe PaymentIntent id to Commerce order id.
 *
 * Used by the thank-you path to enrich outbound webhook logs (order column)
 * and to avoid duplicate third-party notifications when the webhook already ran.
 */
function _rovas_stripe_express_checkout_find_order_id_by_payment_intent($payment_intent_id, $intent = NULL) {
	if (empty($payment_intent_id) || !is_string($payment_intent_id)) {
		return NULL;
	}

	// If intent includes commerce_order_id (buyshares/buymerits), trust it.
	if ($intent && is_object($intent) && isset($intent->metadata) && !empty($intent->metadata->commerce_order_id)) {
		$oid = (int) $intent->metadata->commerce_order_id;
		if ($oid > 0) {
			return $oid;
		}
	}

	// Primary: transaction remote_id points to PI id.
	$oid = db_select('commerce_payment_transaction', 'cpt')
		->fields('cpt', array('order_id'))
		->condition('cpt.remote_id', $payment_intent_id)
		->condition('cpt.payment_method', 'commerce_stripe_pi')
		->range(0, 1)
		->execute()
		->fetchField();
	if ($oid) {
		return (int) $oid;
	}

	// Fallback: order data sometimes stores PI payload.
	$oid = db_select('commerce_order', 'co')
		->fields('co', array('order_id'))
		->condition('co.data', '%' . db_like($payment_intent_id) . '%', 'LIKE')
		->range(0, 1)
		->execute()
		->fetchField();
	if ($oid) {
		return (int) $oid;
	}

	return NULL;
}