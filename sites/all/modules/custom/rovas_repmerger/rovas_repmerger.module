<?php

/**
 * Registry of known work-report merge functions for the Project form.
 *
 * @return array
 *   Machine name => human label. Empty key means no special merger.
 */
function rovas_repmerger_merge_function_options() {
  return array(
    '' => t('None (default session append)'),
    '_rovas_repmerger_osm' => t('OpenStreetMap changesets (OSMCha)'),
    '_rovas_repmerger_code' => t('Code commits (GitHub/GitLab compare)'),
  );
}

/**
 * Implements hook_form_FORM_ID_alter() for project_node_form.
 *
 * Replaces the free-text merge-function field with a select of known mergers.
 */
function rovas_repmerger_form_project_node_form_alter(&$form, &$form_state, $form_id) {
  if (empty($form['field_merge_reports_function'][LANGUAGE_NONE][0]['value'])) {
    return;
  }

  $element = &$form['field_merge_reports_function'][LANGUAGE_NONE][0]['value'];
  $options = rovas_repmerger_merge_function_options();

  $current = '';
  if (isset($element['#default_value'])) {
    $current = $element['#default_value'];
  }
  elseif (isset($element['#value'])) {
    $current = $element['#value'];
  }
  if ($current !== '' && $current !== NULL && !isset($options[$current])) {
    $options[$current] = t('Custom (current value): @name', array('@name' => $current));
  }

  $element['#type'] = 'select';
  $element['#options'] = $options;
  unset($element['#maxlength'], $element['#size'], $element['#empty_option']);
  $element['#description'] = t('Choose how same-day work reports for this project merge their proof-of-work URLs and descriptions. Leave as “None” to append each session separately.');
}

/* 
* Report merger for the Openstreetmap project - ID 1998
*/
function _rovas_repmerger_osm ($field_name,$existing,$newdata,$params=NULL) {

	if ($field_name == 'field-web-address') {
		//extract changeset ID from the new report website URL
		$tary = explode('=',$newdata);
		$tary = explode('&',$tary[1]);
		$chset_id = is_numeric($tary[0]) ? $tary[0] : -1;

		//the new URL poits to the achavi service
		if ($chset_id > 0) {

			if (strpos($existing,'achavi')) {

				$tary = explode('=',$existing);
				$tary = explode('&',$tary[1]);
				$old_chset_id = is_numeric($tary[0]) ? $tary[0] : -1;

				$osmchaset = new stdClass();
				$id = new stdClass();
				$id->label = $old_chset_id;
				$id->value = $old_chset_id;
				$osmchaset->ids[] = $id;

				$restring = rovas_repmerge_omcha_url($chset_id,$osmchaset);
			}
			//the URL poits to the OSMcha service
			else if (strpos($existing,'osmcha.org')) {
			
				$pos = strpos($existing,'?filters={');
				$filter_plus = substr($existing,$pos + 9);
				$tary = explode('&',$filter_plus);
				$enc_osmchaset = $tary[0];
				
				$osmchaset = json_decode($enc_osmchaset);

				$restring = rovas_repmerge_omcha_url($chset_id,$osmchaset);
			}
			else {
				$restring = $newdata ? $existing . '<br>' . $newdata : $existing;
			}
		}
		else {
			$restring = $newdata ? $existing . '<br>' . $newdata : $existing;
		}
		
		return $restring;

	}

	if ($field_name == 'field-name-body') {
	
		$title = isset($params['title']) ? $params['title'] : '';
    
		$restring = '<div>';
		$restring .= t('This work report is the result of multiple working sessions merged together.');
		$restring .= '<br>';
		$restring .= t('To learn how to verify the report, read the instructions shown on the project page');
		$restring .= '<div>';

    if (preg_match('/\s[iI][dD]$/', $title)) {
			$restring .= t('The individual work sessions this report consists off were created by the <a href="https://github.com/dp7x/rovas-id-timetracker">Rovas connector Chrome extension for ID</a>');
    } else {
			$restring .= t('The individual work sessions this report consists off were created by the <a href="https://wiki.openstreetmap.org/wiki/JOSM/Plugins/RovasConnector">Rovas connector plugin for JOSM</a>');
    }
		$restring .= '</div>';

		return $restring;

	}
}

/**
 * Report merger for code / GitHub (and GitLab) commit proof-of-work URLs.
 *
 * Expands same-repo session URLs into a compare range:
 *   /commit/A + /commit/B → /compare/A~1...B
 */
function _rovas_repmerger_code($field_name, $existing, $newdata, $params = NULL) {
  if ($field_name == 'field-web-address') {
    if (empty($existing)) {
      return $newdata;
    }
    if (empty($newdata)) {
      return $existing;
    }

    $old = rovas_repmerger_parse_git_pow_url($existing);
    $new = rovas_repmerger_parse_git_pow_url($newdata);
    if (!$old || !$new) {
      return $existing . '<br>' . $newdata;
    }
    if ($old['host'] !== $new['host'] || $old['path'] !== $new['path'] || $old['provider'] !== $new['provider']) {
      return $existing . '<br>' . $newdata;
    }

    $base = $old['base'];
    $head = $new['head'];
    if ($head === $old['head'] || $head === $base) {
      return $existing;
    }

    return rovas_repmerger_build_git_compare_url($old['provider'], $old['host'], $old['path'], $base, $head);
  }

  if ($field_name == 'field-name-body') {
    $restring = '<div>';
    $restring .= t('This work report is the result of multiple working sessions merged together.');
    $restring .= '<br>';
    $restring .= t('To learn how to verify the report, read the instructions shown on the project page');
    $restring .= '<div>';
    $restring .= t('The individual work sessions this report consists of were created by the Rovas Connector for Code (Cursor/VS Code extension).');
    $restring .= '</div>';
    return $restring;
  }

  return $existing;
}

/**
 * Parse a GitHub or GitLab commit/compare proof-of-work URL.
 *
 * @return array|false
 *   Keys: provider (github|gitlab), host, path (owner/repo), base, head.
 */
function rovas_repmerger_parse_git_pow_url($url) {
  $url = trim($url);
  if ($url === '') {
    return FALSE;
  }

  // GitHub commit.
  if (preg_match('#^https?://(github\.com)/([^/]+)/([^/]+)/commit/([a-f0-9]{7,40})/?$#i', $url, $m)) {
    return array(
      'provider' => 'github',
      'host' => strtolower($m[1]),
      'path' => $m[2] . '/' . $m[3],
      'base' => $m[4],
      'head' => $m[4],
    );
  }

  // GitHub compare (A~1...B or A^...B or A...B).
  if (preg_match('#^https?://(github\.com)/([^/]+)/([^/]+)/compare/([a-f0-9]{7,40})(?:~1|\^)?\.\.\.([a-f0-9]{7,40})/?$#i', $url, $m)) {
    return array(
      'provider' => 'github',
      'host' => strtolower($m[1]),
      'path' => $m[2] . '/' . $m[3],
      'base' => $m[4],
      'head' => $m[5],
    );
  }

  // GitLab commit (path may include groups).
  if (preg_match('#^https?://([^/]+)/(.+)/-/commit/([a-f0-9]{7,40})/?$#i', $url, $m)) {
    return array(
      'provider' => 'gitlab',
      'host' => strtolower($m[1]),
      'path' => $m[2],
      'base' => $m[3],
      'head' => $m[3],
    );
  }

  // GitLab compare.
  if (preg_match('#^https?://([^/]+)/(.+)/-/compare/([a-f0-9]{7,40})(?:~1|\^)?\.\.\.([a-f0-9]{7,40})/?$#i', $url, $m)) {
    return array(
      'provider' => 'gitlab',
      'host' => strtolower($m[1]),
      'path' => $m[2],
      'base' => $m[3],
      'head' => $m[4],
    );
  }

  return FALSE;
}

/**
 * Build a compare URL that includes the first commit through the latest.
 */
function rovas_repmerger_build_git_compare_url($provider, $host, $path, $base, $head) {
  if ($provider === 'gitlab') {
    return 'https://' . $host . '/' . $path . '/-/compare/' . $base . '~1...' . $head;
  }
  return 'https://' . $host . '/' . $path . '/compare/' . $base . '~1...' . $head;
}

// function that builds the OSMcha URL
function rovas_repmerge_omcha_url ($chset_id,$filter_object) {
	$id = new stdClass();
	$id->label = $chset_id;
	$id->value = $chset_id;
	$filter_object->ids[] = $id;
	if (!isset($filter_object->date__gte)) {
		$date__gte = new stdClass();
		$date__gte->label = "";
		$date__gte->value = "";
		$filter_object->date__gte[] = $date__gte;
	}
	$enc_osmchaset = json_encode($filter_object);
	$restring = 'https://osmcha.org/changesets/';
	$restring .= $chset_id;
	$restring .= '?filters=';
	$restring .= $enc_osmchaset;
	
	return $restring;
}

/**
 * Implements hook_rules_action_info().
 */
function rovas_repmerger_rules_action_info() {
  return array(
    '_rovas_repmerger_manipulateUrlWorkReport' => array(
      'label' => t('Merge a new proof-of-work URL into the existing list'),
      'group' => t('Rovas'),
      'parameter' => array(
        'node' => array(
          'type' => 'node', 
          'label' => t('Node'),
          'save' => FALSE,
        ),
        'newUrl' => array(
          'type' => 'text', 
          'label' => t('New URL to add')
        ),
        'mergeFunc' => array(
          'type' => 'text', 
          'label' => t('Name of the merger function')
        ),
      ),
      'provides' => array(
        'url_list' => array(
          'type' => 'list<text>',
          'label' => t('Updated URL list'),
        ),
      ),
    ),
  );
}

/**
 * Whether a work report may receive a same-day merge.
 *
 * Only "not verified" (0) reports are mergeable. Valid (1) and invalid (2)
 * are locked; callers should create a new WR instead.
 */
function rovas_repmerger_wr_is_mergeable($node) {
  if (empty($node) || empty($node->nid)) {
    return FALSE;
  }
  $wrapper = entity_metadata_wrapper('node', $node);
  try {
    $status = $wrapper->field_verification_status->value();
  }
  catch (EntityMetadataWrapperException $e) {
    return FALSE;
  }
  // Treat empty/NULL as not verified (mergeable).
  return ($status === NULL || $status === '' || (int) $status === 0);
}

/**
 * $node      – fully-loaded work-report node object (Drupal 7)
 * $newUrl    – freshly submitted URL string
 * $mergeFunc – callable(string $fieldName, string $old, string $new):string
 *
 * Returns: flat array of unique URLs that should be written back into
 * the node’s field_web_address field.
 *
 * Verified/invalid reports are not modified; existing URLs are returned as-is.
 * (rules_proxy_create_work_report also skips the merge branch for those.)
 */
function _rovas_repmerger_manipulateUrlWorkReport(stdClass $node, $newUrl, $mergeFunc) {
    if (empty($newUrl) && empty($node->field_web_address)) {
        return array();
    }

    $wrapper = entity_metadata_wrapper('node', $node);

    $list = $wrapper->field_web_address->value() ?: [];

    if (!rovas_repmerger_wr_is_mergeable($node)) {
      return array('url_list' => array_values(array_unique($list)));
    }

    $recent = end($list) ?: '';

    $merged = $mergeFunc('field-web-address', $recent, $newUrl);

    if (strlen($merged) >= 1000) {
        if ($newUrl && !in_array($newUrl, $list, true)) {
            $list[] = $newUrl;
        }
				return array('url_list' => array_values(array_unique($list)));
    }

    $list[count($list) - 1] = $merged;

  return array('url_list' => array_values(array_unique($list)));
}
