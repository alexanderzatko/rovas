<?php

//the purpose of this module is to prune unused categories from the complete NACE taxonomy

function rovas_reports_exposed_filters_form_alter(&$form, &$form_state, $form_id) {
	if ($form['#id'] == 'views-exposed-form-wr-time-line-page-1') {

		$result = db_query("SELECT DISTINCT td.tid AS tid, td.name AS name, td.vid AS vid, v.machine_name AS vname
		FROM {node} node
		LEFT JOIN {field_data_field_classification} c ON node.nid = c.entity_id
		AND c.entity_type = 'node'
		AND c.deleted = '0'
		LEFT JOIN {taxonomy_term_data} td ON c.field_classification_tid = td.tid
		LEFT JOIN {taxonomy_vocabulary} v ON td.vid = v.vid
		WHERE node.status = '1'
		AND td.tid != '1733'
		AND node.type IN  ('work_report')");

		$options = array();
		$counter = 0;
		$topeleindex = 0;

		foreach ($result as $row) {

			$level = '';
			$lev = count(taxonomy_get_parents_all($row->tid));
			for ($i = 0; $i <= $lev-2; $i++) {
				$level = $level . '-';
			}
				global $language;
				$langcode = $language->language;
				$term = taxonomy_term_load($row->tid);
				$translated_term = i18n_taxonomy_term_name($term,$langcode);
			
				$filler = new stdClass();

				$filler->option = array($row->tid => $level . $translated_term);
				$filler->lev = $lev;

				//getting the index of the top element
				if ($row->tid == 1856)
					$topeleindex = $counter;

				$options[$counter] = $filler;
				$counter = $counter + 1;
		}

		//move the root category to ther top of the list
/*
		if ($topeleindex > 0)
			$options = array($topeleindex => $options[$topeleindex]) + $options;
*/

		// Comparison function
		function cmp($a, $b) {
			
