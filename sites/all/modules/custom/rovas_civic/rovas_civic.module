/**
 * Implements hook_cron().
 *
 * Site cron runs often (~5 min); Merit Index snapshot rebuilds only every
 * ROVAS_CIVIC_MERIT_INDEX_SNAPSHOT_INTERVAL (default 12h).
 */
function rovas_civic_cron() {
  module_load_include('inc', 'rovas_civic', 'rovas_civic.merit_index');
  if (function_exists('rovas_civic_merit_index_snapshot_cron')) {
    rovas_civic_merit_index_snapshot_cron();
  }
  module_load_include('inc', 'rovas_civic', 'rovas_civic.receipt_history');
  if (function_exists('rovas_civic_receipt_history_cron')) {
    rovas_civic_receipt_history_cron();
  }
}

/**
 * Implements hook_cron_queue_info().
 */
function rovas_civic_cron_queue_info() {
  $queues = array();
  $queues['rovas_civic_charity_ai_check'] = array(
    'worker callback' => 'rovas_civic_charity_ai_check_worker',
    'time' => 60,
  );
  return $queues;
}

/**
 * Queue worker stub — loads charity.inc (Services file may not be loaded).
 *
 * @param mixed $item
 */
function rovas_civic_charity_ai_check_worker($item) {
  module_load_include('inc', 'rovas_civic', 'rovas_civic.charity');
  if (function_exists('rovas_civic_charity_ai_check_process')) {
    rovas_civic_charity_ai_check_process($item);
  }
}

/**
 * Implements hook_node_insert().
 *
 * Runs after Rules (module weight 21) so verification Chron grants exist before
 * Civic CHR→ME conversion. Also notifies site mail on new charity orgs.
 */
function rovas_civic_node_insert($node) {
  if ($node->type === 'charity_organization') {
    module_load_include('inc', 'rovas_civic', 'rovas_civic.charity');
    // Auto-approved SK creates skip the staff pending inbox; claim email covers contact.
    if (function_exists('rovas_civic_charity_org_status')
      && rovas_civic_charity_org_status($node) === ROVAS_CIVIC_CHARITY_STATUS_PENDING
      && function_exists('rovas_civic_notify_charity_org_pending')) {
      rovas_civic_notify_charity_org_pending($node);
    }
    return;
  }

  if ($node->type !== 'verification') {
    return;
  }
  module_load_include('inc', 'rovas_civic', 'rovas_civic.reward');
  if (!function_exists('field_get_items')) {
    return;
  }
  $wr_ref = field_get_items('node', $node, 'field_work_report');
  if (empty($wr_ref[0]['target_id'])) {
    return;
  }
  $work_report = node_load((int) $wr_ref[0]['target_id']);
  if ($work_report && $work_report->type === 'work_report') {
    rovas_civic_maybe_charge_wr_usage_fee($work_report);
    rovas_civic_maybe_convert_wr_chron_to_merits($work_report);
  }
}

/**
 * Implements hook_services_resources().
 *
 * - POST /rovas/rules/rules_proxy_claim_vat_receipt (VAT claim)
 * - GET  /rovas/civic_claims?view=… (+ /summary retrieve)
 * - GET  /rovas/civic_national_hourly_rate?country=SK (public)
 * - GET  /rovas/users_search?query= (split-claim typeahead)
 * - GET  /rovas/users_lookup?username= (community public profile)
 * - GET  /rovas/civic_project/{nid} (project modal detail)
 * - GET  /rovas/civic_project_work_reports?project_nid= (WR pages)
 * - GET  /rovas/civic_project_shareholders?project_nid= (user shareholders)
 * - GET  /rovas/civic_merit_history (signed-in Merit ledger)
 * - GET  /rovas/civic_my_projects, civic_projects_search, civic_nace_tree
 * - POST /rovas/civic_create_project, civic_create_work_report
 * - GET  /rovas/civic_work_report_map_config (map proof widget)
 * - GET  /rovas/civic_pending_verifications, civic_work_report/{nid}
 * - POST /rovas/civic_submit_verification
 * - GET  /rovas/civic_pending_comment_notices (watched-comment pull notices)
 * - GET  /rovas/civic_merit_index (Prínos / Merit Index leaderboard)
 * - GET  /rovas/civic_merit_index_countries (Prínos country filter dropdown)
 * - GET  /rovas/civic_merit_spotlight (period leads by Civic area)
 * - GET  /rovas/civic_merit_period_index (ME•ter period leaderboard)
 * - GET  /rovas/civic_charity_projects (public approved-charity catalog)
 * - POST /rovas/civic_create_charity_org (donor add public-benefit org)
 * - POST /rovas/civic_receipt_history_preference (keep vs 90-day scrub)
 *
 * Note: Services aliases must be slash-free. Do not use aliases like
 * civic/claims — Services treats the first segment as the resource name.
 */
function rovas_civic_services_resources() {
  module_load_include('inc', 'rovas_civic', 'rovas_civic.charity');
  $bearer_auth = array(
    'access callback' => 'rovas_civic_claim_access',
    'access arguments' => array(),
    'access arguments append' => FALSE,
  );
  $volunteer_file = array(
    'type' => 'inc',
    'module' => 'rovas_civic',
    'name' => 'rovas_civic.volunteer',
  );
  $geofield_file = array(
    'type' => 'inc',
    'module' => 'rovas_civic',
    'name' => 'rovas_civic.geofield',
  );
  $verify_file = array(
    'type' => 'inc',
    'module' => 'rovas_civic',
    'name' => 'rovas_civic.verify',
  );
  $comment_watch_file = array(
    'type' => 'inc',
    'module' => 'rovas_civic',
    'name' => 'rovas_civic.comment_watch',
  );
  $merit_index_file = array(
    'type' => 'inc',
    'module' => 'rovas_civic',
    'name' => 'rovas_civic.merit_index',
  );
  $merit_spotlight_file = array(
    'type' => 'inc',
    'module' => 'rovas_civic',
    'name' => 'rovas_civic.merit_spotlight',
  );
  $merit_period_index_file = array(
    'type' => 'inc',
    'module' => 'rovas_civic',
    'name' => 'rovas_civic.merit_period_index',
  );
  $charity_file = array(
    'type' => 'inc',
    'module' => 'rovas_civic',
    'name' => 'rovas_civic.charity',
  );
  $receipt_history_file = array(
    'type' => 'inc',
    'module' => 'rovas_civic',
    'name' => 'rovas_civic.receipt_history',
  );

  return array(
    'rules' => array(
      'actions' => array(
        'rules_proxy_claim_vat_receipt' => array(
          'help' => 'Claim eKasa VAT as donor Merits on the State Treasury project. Each shares[] entry is an individual donor. Bearer required.',
          'callback' => 'rovas_civic_services_claim_vat_receipt',
          'access callback' => 'rovas_civic_claim_access',
          'access arguments' => array(),
          'access arguments append' => FALSE,
          'args' => array(
            array(
              'name' => 'receipt_uid',
              'type' => 'string',
              'description' => 'eKasa online UID (O- + 32 hex).',
              'source' => array('data' => 'receipt_uid'),
              'optional' => FALSE,
            ),
            array(
              'name' => 'vat_eur',
              'type' => 'string',
              'description' => 'Verified VAT amount in EUR.',
              'source' => array('data' => 'vat_eur'),
              'optional' => FALSE,
            ),
            array(
              'name' => 'shares',
              'type' => 'array',
              'description' => 'Array of {rovas_uid, share_pct}; sum ≈ 100; scanner must be included.',
              'source' => array('data' => 'shares'),
              'optional' => FALSE,
            ),
            array(
              'name' => 'merchant_name',
              'type' => 'string',
              'description' => 'Merchant name (audit).',
              'source' => array('data' => 'merchant_name'),
              'optional' => TRUE,
            ),
            array(
              'name' => 'purchase_at',
              'type' => 'string',
              'description' => 'ISO purchase timestamp (audit).',
              'source' => array('data' => 'purchase_at'),
              'optional' => TRUE,
            ),
            array(
              'name' => 'hourly_wage_eur',
              'type' => 'string',
              'description' => 'Civic preview wage (ignored for grant; Rovas uses admin national rate).',
              'source' => array('data' => 'hourly_wage_eur'),
              'optional' => TRUE,
            ),
            array(
              'name' => 'formula_version',
              'type' => 'int',
              'description' => 'Client formula version (audit).',
              'source' => array('data' => 'formula_version'),
              'optional' => TRUE,
            ),
            array(
              'name' => 'total_merits',
              'type' => 'string',
              'description' => 'Civic preview total (ignored; Rovas recomputes).',
              'source' => array('data' => 'total_merits'),
              'optional' => TRUE,
            ),
          ),
        ),
      ),
    ),
    'civic_claims' => array(
      'operations' => array(
        'index' => array(
          'help' => 'List Civic VAT claims (?view=submitted|received) or claim-status lookup (?receipt_uid=). Bearer required.',
          'callback' => 'rovas_civic_services_claims_index',
          'access callback' => $bearer_auth['access callback'],
          'access arguments' => $bearer_auth['access arguments'],
          'access arguments append' => $bearer_auth['access arguments append'],
          'args' => array(
            array(
              'name' => 'view',
              'type' => 'string',
              'description' => 'submitted (scanner) or received (beneficiary shares). Ignored when receipt_uid is set.',
              'source' => array('param' => 'view'),
              'optional' => TRUE,
              'default value' => 'submitted',
            ),
            array(
              'name' => 'limit',
              'type' => 'int',
              'description' => 'Page size (default 50, max 100).',
              'source' => array('param' => 'limit'),
              'optional' => TRUE,
              'default value' => ROVAS_CIVIC_CLAIMS_DEFAULT_LIMIT,
            ),
            array(
              'name' => 'offset',
              'type' => 'int',
              'description' => 'Row offset for pagination.',
              'source' => array('param' => 'offset'),
              'optional' => TRUE,
              'default value' => 0,
            ),
            array(
              'name' => 'receipt_uid',
              'type' => 'string',
              'description' => 'When set, return {claimed, receipt_uid} for global UID dedup preview (Civic verify). Do not use param name "q".',
              'source' => array('param' => 'receipt_uid'),
              'optional' => TRUE,
              'default value' => '',
            ),
          ),
        ),
        'retrieve' => array(
          'help' => 'Civic claims summary for the Bearer user. Path id must be "summary". Received-based totals.',
          'callback' => 'rovas_civic_services_claims_retrieve',
          'access callback' => $bearer_auth['access callback'],
          'access arguments' => $bearer_auth['access arguments'],
          'access arguments append' => $bearer_auth['access arguments append'],
          'args' => array(
            array(
              'name' => 'id',
              'type' => 'string',
              'description' => 'Use "summary".',
              'source' => array('path' => 0),
              'optional' => FALSE,
            ),
          ),
        ),
      ),
    ),
    'civic_national_hourly_rate' => array(
      'operations' => array(
        'index' => array(
          'help' => 'Public national hourly wage (EUR/h) used for Civic Merit sizing. ?country=SK (default).',
          'callback' => 'rovas_civic_services_national_hourly_rate_index',
          'access callback' => 'services_access_menu',
          'args' => array(
            array(
              'name' => 'country',
              'type' => 'string',
              'description' => 'ISO 3166-1 alpha-2 country code (default SK).',
              'source' => array('param' => 'country'),
              'optional' => TRUE,
              'default value' => ROVAS_CIVIC_DEFAULT_COUNTRY,
            ),
          ),
        ),
      ),
    ),
    'users_search' => array(
      'operations' => array(
        'index' => array(
          // IMPORTANT: do NOT use query param name "q" — Drupal reserves
          // $_GET['q'] for the internal path (clean URLs off / path rewrite).
          // ?q=ann would replace the path with "ann" and 404 before Services.
          'help' => 'Typeahead search for Civic split-claim co-recipients. ?query= (≥3 chars). Bearer required. Max 10 public profile rows.',
          'callback' => 'rovas_civic_services_users_search_index',
          'access callback' => $bearer_auth['access callback'],
          'access arguments' => $bearer_auth['access arguments'],
          'access arguments append' => $bearer_auth['access arguments append'],
          'args' => array(
            array(
              'name' => 'query',
              'type' => 'string',
              'description' => 'Search string (username / display name); min 3 characters. Param name must not be "q" (Drupal path).',
              'source' => array('param' => 'query'),
              'optional' => FALSE,
            ),
          ),
        ),
      ),
    ),
    'users_lookup' => array(
      'operations' => array(
        'index' => array(
          'help' => 'Civic community public profile by exact Rovas username. ?username=. Bearer required.',
          'callback' => 'rovas_civic_services_users_lookup_index',
          'access callback' => $bearer_auth['access callback'],
          'access arguments' => $bearer_auth['access arguments'],
          'access arguments append' => $bearer_auth['access arguments append'],
          'args' => array(
            array(
              'name' => 'username',
              'type' => 'string',
              'description' => 'Exact Rovas username (case-insensitive).',
              'source' => array('param' => 'username'),
              'optional' => FALSE,
            ),
            array(
              'name' => 'lang',
              'type' => 'string',
              'description' => 'Optional content language (sk|en). Maps cs/cz→sk. Affects top_* project names.',
              'source' => array('param' => 'lang'),
              'optional' => TRUE,
              'default value' => '',
            ),
          ),
        ),
      ),
    ),
    'civic_project' => array(
      'operations' => array(
        'retrieve' => array(
          'help' => 'Civic project detail + first page of work reports and shareholders. Bearer for any published project; anonymous allowed for approved charity projects. Optional ?lang=. is_public is informational only.',
          'callback' => 'rovas_civic_services_project_retrieve',
          // services_access_menu: always allow; assert_project_readable gates
          // anonymous vs approved-charity inside the callback. Do not use
          // rovas_civic_project_read_access here — it lives in charity.inc and
