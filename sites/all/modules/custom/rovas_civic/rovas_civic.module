<?php

/**
 * @file
 * Civic / NeoFund Path-1: donor Merit, national rates, State Treasury, VAT claims.
 *
 * See NeoFund_NP charity-opt-in-project-ledger.md and docs/integration/civic.md.
 */

define('ROVAS_CIVIC_STATE_TREASURY_VAR', 'rovas_civic_state_treasury_nid');
define('ROVAS_CIVIC_DEFAULT_COUNTRY', 'SK');
define('ROVAS_CIVIC_ME_PER_HOUR', 10.0);
define('ROVAS_CIVIC_SHARE_PCT_TOLERANCE', 0.01);

/**
 * Implements hook_permission().
 */
function rovas_civic_permission() {
  return array(
    'administer rovas civic' => array(
      'title' => t('Administer Rovas Civic (rates, State Treasury, VAT API)'),
      'restrict access' => TRUE,
    ),
  );
}

/**
 * Implements hook_menu().
 */
function rovas_civic_menu() {
  $items = array();
  $items['admin/config/rovas/civic'] = array(
    'title' => 'Rovas Civic',
    'description' => 'National hourly rates, State Treasury project, VAT claim API.',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('rovas_civic_admin_form'),
    'access arguments' => array('administer rovas civic'),
    'file' => 'rovas_civic.admin.inc',
  );
  $items['admin/config/rovas/civic/rate/add'] = array(
    'title' => 'Add national hourly rate',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('rovas_civic_rate_form'),
    'access arguments' => array('administer rovas civic'),
    'file' => 'rovas_civic.admin.inc',
    'type' => MENU_LOCAL_ACTION,
  );
  $items['admin/config/rovas/civic/rate/%/edit'] = array(
    'title' => 'Edit national hourly rate',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('rovas_civic_rate_form', 5),
    'access arguments' => array('administer rovas civic'),
    'file' => 'rovas_civic.admin.inc',
    'type' => MENU_CALLBACK,
  );
  return $items;
}

