/**
 * Implements hook_permission().
 */
function rovas_civic_permission() {
  return array(
    'administer rovas civic' => array(
      'title' => t('Administer Rovas Civic (rates, State Treasury, VAT API)'),
      'restrict access' => TRUE,
    ),
  );
}

/**
 * Implements hook_menu().
 */
function rovas_civic_menu() {
  $items = array();
  $items['admin/config/rovas/civic'] = array(
    'title' => 'Rovas Civic',
    'description' => 'National hourly rates, State Treasury project, VAT claim API.',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('rovas_civic_admin_form'),
    'access arguments' => array('administer rovas civic'),
    'file' => 'rovas_civic.admin.inc',
  );
  $items['admin/config/rovas/civic/rate/add'] = array(
    'title' => 'Add national hourly rate',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('rovas_civic_rate_form'),
    'access arguments' => array('administer rovas civic'),
    'file' => 'rovas_civic.admin.inc',
    'type' => MENU_LOCAL_ACTION,
  );
  $items['admin/config/rovas/civic/rate/%/edit'] = array(
    'title' => 'Edit national hourly rate',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('rovas_civic_rate_form', 5),
    'access arguments' => array('administer rovas civic'),
    'file' => 'rovas_civic.admin.inc',
    'type' => MENU_CALLBACK,
  );
  $items['admin/config/rovas/civic/charities'] = array(
    'title' => 'Public-benefit / nonprofit organizations',
    'description' => 'Review and approve public-benefit / nonprofit organizations for the Civic catalog.',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('rovas_civic_admin_charities_form'),
    'access arguments' => array('administer rovas civic'),
    'file' => 'rovas_civic.admin.inc',
    'type' => MENU_LOCAL_TASK,
    'weight' => 5,
  );
  $items['charity-projects'] = array(
    'title' => 'Nonprofit projects',
    'description' => 'Enroll a public-benefit / nonprofit organization on Rovas for the Civic catalog.',
    'page callback' => 'rovas_civic_charity_projects_page',
    'access callback' => TRUE,
    'file' => 'rovas_civic.charity.inc',
    'type' => MENU_NORMAL_ITEM,
  );
  return $items;
}

/**
 * Implements hook_mail().
 */
function rovas_civic_mail($key, &$message, $params) {
  if ($key !== 'charity_org_pending' && $key !== 'charity_org_claim') {
    return;
  }
  if ($key === 'charity_org_claim') {
    // Claim body includes a trusted <a> to the charity catalog.
    $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
    $message['subject'] = isset($params['subject'])
      ? $params['subject']
      : t('Rovas: A public-benefit organization was added for you');
    $body = isset($params['body']) ? $params['body'] : '';
    $message['body'][] = nl2br($body);
  }
  else {
    $message['headers']['Content-Type'] = 'text/plain; charset=UTF-8; format=flowed';
    $message['subject'] = isset($params['subject'])
      ? $params['subject']
      : t('Rovas: New public-benefit / nonprofit organization pending review');
    $message['body'][] = isset($params['body']) ? $params['body'] : '';
  }
}

/**
 * Implements hook_form_alter().
 */
function rovas_civic_form_alter(&$form, &$form_state, $form_id) {
  module_load_include('inc', 'rovas_civic', 'rovas_civic.charity');
  if ($form_id === 'project_node_form') {
    rovas_civic_form_project_node_form_alter($form, $form_state);
  }
  elseif ($form_id === 'charity_organization_node_form') {
    rovas_civic_form_charity_organization_node_form_alter($form, $form_state);
  }
  elseif ($form_id === 'rovas_project_reward_form') {
    rovas_civic_form_rovas_project_reward_form_alter($form, $form_state);
  }
}

/**
 * Project node form validate (must live in .module — submit does not load .inc).
 *
 * Also kept under the older callback name so cached form builds from before
 * the rename still validate after deploy.
 */
function rovas_civic_project_node_form_validate($form, &$form_state) {
  module_load_include('inc', 'rovas_civic', 'rovas_civic.charity');
  if (function_exists('rovas_civic_project_charity_form_validate_impl')) {
    rovas_civic_project_charity_form_validate_impl($form, $form_state);
  }
}

