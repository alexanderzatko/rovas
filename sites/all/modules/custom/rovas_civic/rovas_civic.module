/**
 * Access: authenticated after OAuth2 Bearer (or session).
 */
function rovas_civic_claim_access() {
  global $user;
  if (!empty($user->uid)) {
    return TRUE;
  }
  if (function_exists('rovas_oauth_uid_from_bearer')) {
    return (bool) rovas_oauth_uid_from_bearer('user_profile');
  }
  return FALSE;
}

/**
 * Resolve Drupal uid for Civic Services callbacks.
 *
 * @return int
 *   uid or 0.
 */
function rovas_civic_request_uid() {
  global $user;
  if (!empty($user->uid)) {
    return (int) $user->uid;
  }
  if (function_exists('rovas_oauth_uid_from_bearer')) {
    return (int) rovas_oauth_uid_from_bearer('user_profile');
  }
  return 0;
}

/**
 * Normalize limit/offset query params.
 *
 * @param int $limit
 * @param int $offset
 * @param int|null $default
 *   Default page size (claims default when NULL).
 * @param int|null $max
 *   Max page size (claims max when NULL).
 *
 * @return array
 *   keys: limit, offset.
 */
function rovas_civic_normalize_pager($limit, $offset, $default = NULL, $max = NULL) {
  $default = $default === NULL ? ROVAS_CIVIC_CLAIMS_DEFAULT_LIMIT : (int) $default;
  $max = $max === NULL ? ROVAS_CIVIC_CLAIMS_MAX_LIMIT : (int) $max;
  $limit = (int) $limit;
  $offset = (int) $offset;
  if ($limit < 1) {
    $limit = $default;
  }
  if ($limit > $max) {
    $limit = $max;
  }
  if ($offset < 0) {
    $offset = 0;
  }
  return array('limit' => $limit, 'offset' => $offset);
}

/**
 * Format claim created unix timestamp as ISO-8601.
 */
function rovas_civic_format_created($timestamp) {
  $timestamp = (int) $timestamp;
  if ($timestamp < 1) {
    return NULL;
  }
  return format_date($timestamp, 'custom', 'c');
}

/**
 * Resolve optional Civic content language from request / argument.
 *
 * Civic sends sk|en. cs/cz map to sk. Empty → NULL (source/default text).
 * Does not use Accept-Language so omitting ?lang= keeps prior behavior.
 *
 * @param string|null $lang
 *   Explicit lang from Services, or empty to read $_GET['lang'].
 *
 * @return string|null
 *   Enabled Drupal langcode, or NULL when not requested.
 */
function rovas_civic_request_lang($lang = NULL) {
  if ($lang === NULL || $lang === '') {
    if (!isset($_GET['lang'])) {
      return NULL;
    }
    $lang = $_GET['lang'];
  }
  $lang = drupal_strtolower(trim((string) $lang));
  if ($lang === '') {
    return NULL;
  }
  if (strpos($lang, '-') !== FALSE || strpos($lang, '_') !== FALSE) {
    $parts = preg_split('/[-_]/', $lang, 2);
    $lang = $parts[0];
  }
  if ($lang === 'cs' || $lang === 'cz') {
    $lang = 'sk';
  }
  if (function_exists('rovas_base_normalize_to_enabled_language')) {
    return rovas_base_normalize_to_enabled_language($lang);
  }
  return $lang;
}

/**
 * Localized node title for Civic (?lang=).
 *
 * @param object $node
 * @param string|null $lang
 *   Enabled langcode, or NULL for default $node->title.
 *
 * @return string
 */
function rovas_civic_node_localized_title($node, $lang = NULL) {
  $fallback = (!empty($node->title)) ? (string) $node->title : '';
  if ($lang === NULL || $lang === '') {
    return $fallback;
  }
  $lang = drupal_strtolower(trim((string) $lang));

  if (!empty($node->title_field[$lang][0]['value'])) {
    return (string) $node->title_field[$lang][0]['value'];
  }
  $items = field_get_items('node', $node, 'title_field', $lang);
  if (!empty($items[0]['value'])) {
    return (string) $items[0]['value'];
  }
  if (function_exists('rovas_base_translation_pick_source_text')) {
    $src = rovas_base_translation_pick_source_text($node, 'title_field');
    if ($src !== '') {
      return $src;
    }
  }
  return $fallback !== '' ? $fallback : '';
}

/**
 * Resolve localized titles for a list of project nids.
 *
 * @param array $nids
 * @param string|null $lang
 *
 * @return array
 *   nid => title string.
 */
function rovas_civic_project_titles_for_nids(array $nids, $lang = NULL) {
  $out = array();
  $nids = array_values(array_unique(array_filter(array_map('intval', $nids))));
  if (empty($nids)) {
    return $out;
  }
  $nodes = node_load_multiple($nids);
  foreach ($nids as $nid) {
    if (empty($nodes[$nid])) {
      continue;
    }
    $title = trim(rovas_civic_node_localized_title($nodes[$nid], $lang));
    if ($title !== '') {
      $out[$nid] = $title;
    }
  }
  return $out;
}

/* ===========================================================================
 * National hourly rate
 * ========================================================================= */

/**
 * Load national hourly rate for a country (EUR / hour).
 *
 * @param string $country_code
 *   ISO alpha-2.
 *
 * @return float|false
 */
function rovas_civic_national_hourly_rate($country_code = ROVAS_CIVIC_DEFAULT_COUNTRY) {
  $row = rovas_civic_national_hourly_rate_row($country_code);
  return $row ? (float) $row->rate_eur : FALSE;
}

/**
 * Load full national hourly rate row.
 *
 * @param string $country_code
 *   ISO alpha-2.
 *
 * @return object|false
 *   Row with country_code, rate_eur, source, updated — or FALSE.
 */
function rovas_civic_national_hourly_rate_row($country_code = ROVAS_CIVIC_DEFAULT_COUNTRY) {
  $code = drupal_strtoupper(trim((string) $country_code));
  if ($code === '' || !preg_match('/^[A-Z]{2}$/', $code)) {
    return FALSE;
  }
  $row = db_query("SELECT country_code, rate_eur, source, updated FROM {rovas_national_hourly_rate} WHERE country_code = :c", array(
    ':c' => $code,
  ))->fetchObject();
  if (!$row || (float) $row->rate_eur <= 0) {
    return FALSE;
  }
  return $row;
}

/**
 * Services callback: GET /rovas/civic_national_hourly_rate?country=
 *
 * Public — no Bearer required.
 */
function rovas_civic_services_national_hourly_rate_index($country = ROVAS_CIVIC_DEFAULT_COUNTRY) {
  if ($country === NULL || $country === '') {
    $country = ROVAS_CIVIC_DEFAULT_COUNTRY;
  }
  $row = rovas_civic_national_hourly_rate_row($country);
  if (!$row) {
    return services_error(t('National hourly rate not found for country @c.', array(
      '@c' => drupal_strtoupper(trim((string) $country)),
    )), 404);
  }

  return array(
    'country_code' => $row->country_code,
    'hourly_wage_eur' => (float) $row->rate_eur,
    'merits_per_hour' => ROVAS_CIVIC_ME_PER_HOUR,
    'source' => isset($row->source) ? (string) $row->source : '',
    'updated' => !empty($row->updated) ? rovas_civic_format_created($row->updated) : NULL,
  );
}

/* ===========================================================================
 * Users search (split-claim typeahead)
 * ========================================================================= */

/**
 * Services callback: GET /rovas/users_search?query=
 *
 * Bearer required. Returns ≤10 public profile rows (no email / balance).
 * Param is "query", not "q" — Drupal uses $_GET['q'] as the request path.
 */
function rovas_civic_services_users_search_index($query = '') {
  $uid = rovas_civic_request_uid();
  if ($uid < 1) {
    return services_error(t('Authentication required'), 401);
  }

  $query = trim((string) $query);
  if (drupal_strlen($query) < ROVAS_CIVIC_USERS_SEARCH_MIN_Q) {
    return services_error(t('Query must be at least @n characters.', array(
      '@n' => ROVAS_CIVIC_USERS_SEARCH_MIN_Q,
    )), 400);
  }

  return rovas_civic_users_search($query, $uid);
}

/**
 * Search active users by username / display name for split-claim typeahead.
 *
 * @param string $q
 *   Trimmed search string (≥3 chars; caller validates).
 * @param int $caller_uid
 *   Bearer user — excluded from results.
 *
 * @return array
 *   List of {rovas_uid, username, display_name}.
 */
function rovas_civic_users_search($q, $caller_uid) {
  $caller_uid = (int) $caller_uid;
  $like = '%' . db_like($q) . '%';

  $query = db_select('users', 'u');
  $query->fields('u', array('uid', 'name'));
  $query->condition('u.status', 1);
  $query->condition('u.uid', 0, '>');
  if ($caller_uid > 0) {
    $query->condition('u.uid', $caller_uid, '<>');
  }

  $has_full_name = (bool) field_info_field('field_full_name');
  if ($has_full_name) {
    $query->leftJoin('field_data_field_full_name', 'fn',
      "fn.entity_id = u.uid AND fn.entity_type = 'user' AND fn.deleted = 0 AND fn.delta = 0");
    $query->addField('fn', 'field_full_name_value', 'full_name');
    $or = db_or()
      ->condition('u.name', $like, 'LIKE')
      ->condition('fn.field_full_name_value', $like, 'LIKE');
    $query->condition($or);
  }
  else {
    $query->condition('u.name', $like, 'LIKE');
  }

  // Oversample so searchable / negative-ME filtering can drop rows without
  // undershooting the 10-result cap.
  $query->orderBy('u.name', 'ASC');
  $query->range(0, ROVAS_CIVIC_USERS_SEARCH_MAX * 5);

  $rows = $query->execute();
  $out = array();
  foreach ($rows as $row) {
    if (!rovas_civic_user_is_searchable($row)) {
      continue;
    }
    // Hide negative Merit balances from Civic typeahead (do not expose total_me).
    if (rovas_civic_user_total_me((int) $row->uid) < 0) {
      continue;
    }
    $username = (string) $row->name;
    $display = $username;
    if ($has_full_name && !empty($row->full_name)) {
      $display = (string) $row->full_name;
    }
    $out[] = array(
      'rovas_uid' => (string) ((int) $row->uid),
      'username' => $username,
      'display_name' => $display,
    );
    if (count($out) >= ROVAS_CIVIC_USERS_SEARCH_MAX) {
      break;
    }
  }

  return $out;
}

/**
 * Whether a user may appear in Civic split-claim typeahead.
 *
 * Phase 3+: honour a per-user “not searchable / don’t include me in split
 * claims” preference. v1 is a no-op (always searchable).
 *
 * @param object $account
 *   User row with at least ->uid.
 *
 * @return bool
 */
function rovas_civic_user_is_searchable($account) {
  // Stub — always searchable in v1.
  return TRUE;
}

/**
 * Total Merits for a user (same source as /rovas/me and users_lookup).
 *
 * @param int $uid
 *
 * @return float
 *   Merit total; 0 when unknown (do not treat as negative).
 */
function rovas_civic_user_total_me($uid) {
  $uid = (int) $uid;
  if ($uid < 1) {
    return 0.0;
  }
  if (function_exists('_rovas_merit_distribution_user_merits')) {
    $merits = _rovas_merit_distribution_user_merits($uid);
    return $merits !== NULL ? (float) $merits : 0.0;
  }
  if (function_exists('rovas_oauth_user_merits_fallback')) {
    return (float) rovas_oauth_user_merits_fallback($uid);
  }
  return 0.0;
}

/* ===========================================================================
 * Users lookup (community public profile)
 * ========================================================================= */

/**
 * Services callback: GET /rovas/users_lookup?username=
 *
 * Bearer required. Public contribution profile for Civic Screen 6.
 */
function rovas_civic_services_users_lookup_index($username = '', $lang = '') {
  $caller_uid = rovas_civic_request_uid();
  if ($caller_uid < 1) {
    return services_error(t('Authentication required'), 401);
  }

  $username = trim((string) $username);
  if ($username === '') {
    return services_error(t('Username is required.'), 400);
  }

  $profile = rovas_civic_users_lookup($username, rovas_civic_request_lang($lang));
  if ($profile === FALSE) {
    return services_error(t('User not found'), 404);
  }
  return $profile;
}

/**
 * Load a public Civic contribution profile by exact username.
 *
 * @param string $username
 *   Trimmed Rovas username (case-insensitive).
 * @param string|null $lang
 *   Optional content language for top_* project names.
 *
 * @return array|false
 *   UserLookup-shaped array, or FALSE if not found / not searchable.
 */
function rovas_civic_users_lookup($username, $lang = NULL) {
  $username = trim((string) $username);
  if ($username === '') {
    return FALSE;
  }

  // Exact match, case-insensitive (MySQL utf8_general_ci is typical).
  $uid = db_query("SELECT uid FROM {users} WHERE status = 1 AND uid > 0 AND LOWER(name) = LOWER(:n)", array(
    ':n' => $username,
  ))->fetchField();
  if (!$uid) {
    return FALSE;
  }
  $uid = (int) $uid;

  $account = user_load($uid);
  if (!$account || empty($account->uid) || empty($account->status)) {
    return FALSE;
  }
  if (!rovas_civic_user_is_searchable($account)) {
    return FALSE;
  }

  $labels = rovas_civic_user_public_labels($uid, $account);

  $total_me = rovas_civic_user_total_me($uid);
  // Negative Merit users are hidden from Civic community profile lookup.
  if ($total_me < 0) {
    return FALSE;
  }

  $expertise = rovas_civic_users_lookup_expertise_categories($uid);
  $by_source = array();
  if (function_exists('rovas_merit_user_by_source')) {
    module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');
    $raw_source = rovas_merit_user_by_source($uid);
    foreach ($raw_source as $key => $me) {
      if ($me != 0) {
        $by_source[$key] = round($me, 2);
      }
    }
  }
  $nace_expertise = array();
  if (function_exists('rovas_meritscope_user_expertise_json')) {
    $nace_expertise = rovas_meritscope_user_expertise_json($uid, $lang);
  }

  $created_year = !empty($account->created) ? (int) date('Y', (int) $account->created) : 0;

  return array(
    'rovas_uid' => (string) $uid,
    'username' => $labels['username'],
    'display_name' => $labels['display_name'],
    'member_since_year' => $created_year,
    'total_me' => round($total_me, 2),
    'by_category' => array(
      'taxes' => round($expertise['taxes'], 2),
      'charity' => round($expertise['charity'], 2),
      'volunteer' => round($expertise['volunteer'], 2),
    ),
    'by_source' => $by_source,
    'nace_expertise' => $nace_expertise,
    'taxes_last_3_months' => rovas_civic_users_lookup_taxes_last_3_months($uid),
    'top_charities' => rovas_civic_users_lookup_top_charities($uid, $lang),
    'top_volunteer_projects' => rovas_civic_users_lookup_top_volunteer_projects($uid, $lang),
  );
}

/**
 * Split user Merits into taxes / charity / volunteer by ledger source.
 *
 * Falls back to legacy NACE inference when field_merit_source is unavailable.
 *
 * @param int $uid
 *
 * @return array
 *   keys: taxes, charity, volunteer (floats).
 */
function rovas_civic_users_lookup_expertise_categories($uid) {
  $uid = (int) $uid;
  $out = array('taxes' => 0.0, 'charity' => 0.0, 'volunteer' => 0.0);
  if ($uid < 1) {
    return $out;
  }

  if (module_exists('rovas_merit') && field_info_field('field_merit_source')) {
    module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');
    return rovas_merit_user_by_category($uid);
  }

  $fallback = (int) ROVAS_CIVIC_FALLBACK_NACE_TID;
  $charity_nace = (int) ROVAS_CIVIC_CHARITY_NACE_TID;
  $rows = db_query("SELECT c.field_category_tid AS tid,
      COALESCE(SUM(m.field_merits_value), 0) AS me
    FROM {node} n
    INNER JOIN {field_data_field_expert} e
      ON e.entity_id = n.nid AND e.entity_type = 'node' AND e.deleted = 0
    INNER JOIN {field_data_field_category} c
      ON c.entity_id = n.nid AND c.entity_type = 'node' AND c.deleted = 0
    INNER JOIN {field_data_field_merits} m
      ON m.entity_id = n.nid AND m.entity_type = 'node' AND m.deleted = 0
    WHERE n.type = 'user_expertise'
      AND n.status = 1
      AND e.field_expert_target_id = :uid
      AND m.field_merits_value > 0
    GROUP BY c.field_category_tid", array(
    ':uid' => $uid,
  ));

  foreach ($rows as $row) {
    $tid = (int) $row->tid;
    $me = (float) $row->me;
    if ($tid < 1 || $me <= 0) {
      continue;
    }
    if ($tid === $fallback) {
      $out['taxes'] += $me;
    }
    elseif ($charity_nace > 0 && $tid === $charity_nace) {
      $out['charity'] += $me;
    }
    else {
      $out['volunteer'] += $me;
    }
  }

  return $out;
}

/**
 * Top charity/donation projects for a user.
 *
 * Sums project-attributable Gifts ME:
 * - A3 issuance `project_reward_order` (Path-1 donor Merits)
 * - A3 issuance `eur_buy_merits` (EUR Commerce buy-Merits → configured project)
 * - timeshare_merit_allocation field_merits_earned (purchased share rewards)
 *
 * Do NOT use raw `purchase_receipt` rows: those also cover ordinary Merit
 * spending (rewarding others' work, platform fees, etc.) and would falsely
 * surface as charity (e.g. freemap.sk / Rováš tips).
 *
 * Excludes State Treasury, CHR→ME (`volunteer`), and co_worker labor ME
 * (`volunteer_work` — those belong in top_volunteer_projects).
 *
 * @param int $uid
 * @param string|null $lang
 *   Optional content language for project names.
 *
 * @return array
 *   Up to 3 { project_nid, name, me }.
 */
function rovas_civic_users_lookup_top_charities($uid, $lang = NULL) {
  $uid = (int) $uid;
  if ($uid < 1) {
    return array();
  }

  $treasury_nid = (int) variable_get(ROVAS_CIVIC_STATE_TREASURY_VAR, 0);
  $by_nid = array();

  // Path-1 + EUR buy-Merits issuance (disjoint source_types; sum per project).
  if (db_table_exists('rovas_merit_issuance')) {
    $query = db_select('rovas_merit_issuance', 'i');
    $query->join('node', 'pn', 'pn.nid = i.project_nid');
    $query->fields('pn', array('nid', 'title'));
    $query->addExpression('SUM(i.amount)', 'me');
    $query->condition('i.uid', $uid);
    $query->condition('i.source_type', array(
      'project_reward_order',
      ROVAS_CIVIC_SOURCE_EUR_BUY_MERITS,
    ), 'IN');
    $query->condition('i.amount', 0, '>');
    if ($treasury_nid > 0) {
      $query->condition('i.project_nid', $treasury_nid, '<>');
    }
    $query->groupBy('pn.nid');
    $query->groupBy('pn.title');
    foreach ($query->execute() as $row) {
      $nid = (int) $row->nid;
      $me = (float) $row->me;
      if ($nid < 1 || $me <= 0) {
        continue;
      }
      if (!isset($by_nid[$nid])) {
        $by_nid[$nid] = array('name' => trim((string) $row->title), 'me' => 0.0);
      }
      $by_nid[$nid]['me'] += $me;
    }
  }

  // Timeshare shareholder ME (Gifts) — same linkage as volunteer allocations.
  $ts_sql = "
    SELECT pn.nid AS nid, pn.title AS title, SUM(me.field_merits_earned_value) AS me
    FROM {node} n
    INNER JOIN {field_data_field_coworker} cw
      ON cw.entity_id = n.nid AND cw.entity_type = 'node' AND cw.deleted = 0
    INNER JOIN {field_data_field_project} p
      ON p.entity_id = n.nid AND p.entity_type = 'node' AND p.deleted = 0
    INNER JOIN {node} pn ON pn.nid = p.field_project_target_id
    INNER JOIN {field_data_field_merits_earned} me
      ON me.entity_id = n.nid AND me.entity_type = 'node' AND me.deleted = 0
    WHERE n.type = 'timeshare_merit_allocation'
      AND n.status = 1
      AND cw.field_coworker_target_id = :uid
      AND me.field_merits_earned_value > 0
  ";
  $ts_args = array(':uid' => $uid);
  if ($treasury_nid > 0) {
    $ts_sql .= ' AND pn.nid <> :treasury';
    $ts_args[':treasury'] = $treasury_nid;
  }
  $ts_sql .= ' GROUP BY pn.nid, pn.title';
  foreach (db_query($ts_sql, $ts_args) as $row) {
    $nid = (int) $row->nid;
    $me = (float) $row->me;
    $name = trim((string) $row->title);
    if ($nid < 1 || $me <= 0) {
      continue;
    }
    if (!isset($by_nid[$nid])) {
      $by_nid[$nid] = array('name' => $name, 'me' => 0.0);
    }
    $by_nid[$nid]['me'] += $me;
    if ($by_nid[$nid]['name'] === '' && $name !== '') {
      $by_nid[$nid]['name'] = $name;
    }
  }

  if (empty($by_nid)) {
    return array();
  }

  uasort($by_nid, function ($a, $b) {
    if ($a['me'] == $b['me']) {
      return 0;
    }
    return ($a['me'] > $b['me']) ? -1 : 1;
  });

  $top_nids = array();
  $i = 0;
  foreach ($by_nid as $nid => $row) {
    $top_nids[] = $nid;
    $i++;
    if ($i >= 3) {
      break;
    }
  }
  $titles = rovas_civic_project_titles_for_nids($top_nids, $lang);

  $out = array();
  foreach ($top_nids as $nid) {
    $name = isset($titles[$nid]) ? $titles[$nid] : $by_nid[$nid]['name'];
    if ($name === '') {
      continue;
    }
    $out[] = array(
      'project_nid' => (string) $nid,
      'name' => $name,
      'me' => round($by_nid[$nid]['me'], 2),
    );
  }
  return $out;
}

/**
 * Top volunteer projects for a user.
 *
 * Attributes ledger Merits already in the volunteer bucket
 * (`field_merit_source` = volunteer_work or empty) to projects via:
 * (1) shareholder project rewards — parent receipt `field_receipt_project`
 *     (excludes WR receipts so paths stay disjoint);
 * (2) individually rewarded work reports — parent receipt
 *     `field_rewarded_report` → WR → `field_project`.
 *
 * Does **not** use allocation `field_merits_earned` (can drift above what the
 * ledger credited). CHR→ME / forex (`volunteer`) is excluded. Sum of returned
 * `me` is therefore ≤ `by_source.volunteer_work` (modulo rounding).
 *
 * @param int $uid
 * @param string|null $lang
 *   Optional content language for project names.
 *
 * @return array
 *   Up to 3 { project_nid, name, me }.
 */
function rovas_civic_users_lookup_top_volunteer_projects($uid, $lang = NULL) {
  $uid = (int) $uid;
  if ($uid < 1) {
    return array();
  }

  // Shareholder ledger + WR-linked ledger (disjoint; UNION ALL then merge).
  $sql = "
    SELECT pn.nid AS nid, pn.title AS title, SUM(amt.field_reward_amount_value) AS me
    FROM {node} n
    INNER JOIN {field_data_field_reward_recipient} rec
      ON rec.entity_id = n.nid AND rec.entity_type = 'node' AND rec.deleted = 0
    INNER JOIN {field_data_field_reward_amount} amt
      ON amt.entity_id = n.nid AND amt.entity_type = 'node' AND amt.deleted = 0
    INNER JOIN {field_data_field_parent_purchase_receipt} parent
      ON parent.entity_id = n.nid AND parent.entity_type = 'node' AND parent.deleted = 0
    INNER JOIN {field_data_field_receipt_project} rp
      ON rp.entity_id = parent.field_parent_purchase_receipt_target_id
      AND rp.entity_type = 'node' AND rp.deleted = 0
    INNER JOIN {node} pn ON pn.nid = rp.field_receipt_project_target_id
    LEFT JOIN {field_data_field_merit_source} src
      ON src.entity_id = n.nid AND src.entity_type = 'node' AND src.deleted = 0
    LEFT JOIN {field_data_field_rewarded_report} wr
      ON wr.entity_id = parent.field_parent_purchase_receipt_target_id
      AND wr.entity_type = 'node' AND wr.deleted = 0
    WHERE n.type = 'merits_disbursement'
      AND n.status = 1
      AND rec.field_reward_recipient_target_id = :uid
      AND amt.field_reward_amount_value > 0
      AND wr.entity_id IS NULL
      AND (
        src.field_merit_source_value IS NULL
        OR src.field_merit_source_value = ''
        OR src.field_merit_source_value = 'volunteer_work'
      )
    GROUP BY pn.nid, pn.title

    UNION ALL

    SELECT pn.nid AS nid, pn.title AS title, SUM(amt.field_reward_amount_value) AS me
    FROM {node} n
    INNER JOIN {field_data_field_reward_recipient} rec
      ON rec.entity_id = n.nid AND rec.entity_type = 'node' AND rec.deleted = 0
    INNER JOIN {field_data_field_reward_amount} amt
      ON amt.entity_id = n.nid AND amt.entity_type = 'node' AND amt.deleted = 0
    INNER JOIN {field_data_field_parent_purchase_receipt} parent
      ON parent.entity_id = n.nid AND parent.entity_type = 'node' AND parent.deleted = 0
    INNER JOIN {field_data_field_rewarded_report} wr
      ON wr.entity_id = parent.field_parent_purchase_receipt_target_id
      AND wr.entity_type = 'node' AND wr.deleted = 0
    INNER JOIN {field_data_field_project} p
      ON p.entity_id = wr.field_rewarded_report_target_id
      AND p.entity_type = 'node' AND p.deleted = 0
    INNER JOIN {node} pn ON pn.nid = p.field_project_target_id
    LEFT JOIN {field_data_field_merit_source} src
      ON src.entity_id = n.nid AND src.entity_type = 'node' AND src.deleted = 0
    WHERE n.type = 'merits_disbursement'
      AND n.status = 1
      AND rec.field_reward_recipient_target_id = :uid
      AND amt.field_reward_amount_value > 0
      AND (
        src.field_merit_source_value IS NULL
        OR src.field_merit_source_value = ''
        OR src.field_merit_source_value = 'volunteer_work'
      )
    GROUP BY pn.nid, pn.title
  ";

  $rows = db_query($sql, array(':uid' => $uid));
  $by_nid = array();
  foreach ($rows as $row) {
    $nid = (int) $row->nid;
    $name = trim((string) $row->title);
    $me = (float) $row->me;
    if ($nid < 1 || $me <= 0) {
      continue;
    }
    if (!isset($by_nid[$nid])) {
      $by_nid[$nid] = array('name' => $name, 'me' => 0.0);
    }
    $by_nid[$nid]['me'] += $me;
    if ($by_nid[$nid]['name'] === '' && $name !== '') {
      $by_nid[$nid]['name'] = $name;
    }
  }

  if (empty($by_nid)) {
    return array();
  }

  uasort($by_nid, function ($a, $b) {
    if ($a['me'] == $b['me']) {
      return 0;
    }
    return ($a['me'] > $b['me']) ? -1 : 1;
  });

  $top_nids = array();
  $i = 0;
  foreach ($by_nid as $nid => $row) {
    $top_nids[] = $nid;
    $i++;
    if ($i >= 3) {
      break;
    }
  }
  $titles = rovas_civic_project_titles_for_nids($top_nids, $lang);

  $out = array();
  foreach ($top_nids as $nid) {
    $name = isset($titles[$nid]) ? $titles[$nid] : $by_nid[$nid]['name'];
    if ($name === '') {
      continue;
    }
    $out[] = array(
      'project_nid' => (string) $nid,
      'name' => $name,
      'me' => round($by_nid[$nid]['me'], 2),
    );
  }
  return $out;
}

/**
 * Last three calendar months of VAT-claim Merits for a beneficiary.
 *
 * @param int $uid
 *
 * @return array
 *   List of { month: YYYY-MM, me: float } for months with activity (≤3).
 */
function rovas_civic_users_lookup_taxes_last_3_months($uid) {
  $uid = (int) $uid;
  if ($uid < 1) {
    return array();
  }

  $months = array();
  for ($i = 2; $i >= 0; $i--) {
    $ts = strtotime('-' . $i . ' months');
    $key = format_date($ts, 'custom', 'Y-m');
    $months[$key] = 0.0;
  }
  $keys = array_keys($months);
  $start_key = $keys[0];
  $start_ts = strtotime($start_key . '-01 00:00:00');
  if ($start_ts === FALSE) {
    return array();
  }

  $rows = db_query("SELECT s.merits_awarded AS me, c.created AS created
    FROM {civic_claim_shares} s
    INNER JOIN {civic_claims} c ON c.id = s.claim_id
    WHERE s.beneficiary_uid = :u AND c.created >= :start", array(
    ':u' => $uid,
    ':start' => (int) $start_ts,
  ));

  foreach ($rows as $row) {
    $created = (int) $row->created;
    if ($created < 1) {
      continue;
    }
    $key = format_date($created, 'custom', 'Y-m');
    if (!isset($months[$key])) {
      continue;
    }
    $months[$key] += (float) $row->me;
  }

  $out = array();
  foreach ($months as $month => $me) {
    if ($me <= 0) {
      continue;
    }
    $out[] = array(
      'month' => $month,
      'me' => round($me, 2),
    );
  }
  return $out;
}

/* ===========================================================================
 * Project detail + work reports (Civic modal)
 * ========================================================================= */

/**
 * Services callback: GET /rovas/civic_project/{nid}
 */
function rovas_civic_services_project_retrieve($nid, $lang = '') {
  module_load_include('inc', 'rovas_civic', 'rovas_civic.charity');

  $project = rovas_civic_load_published_project((int) $nid);
  if (!$project) {
    return services_error(t('Project not found'), 404);
  }

  $gate = rovas_civic_assert_project_readable($project);
  if ($gate !== TRUE) {
    return $gate;
  }

  return rovas_civic_project_detail($project, ROVAS_CIVIC_WR_DEFAULT_LIMIT, 0, rovas_civic_request_lang($lang));
}

/**
 * Services callback: GET /rovas/civic_project_work_reports
 */
function rovas_civic_services_project_work_reports_index($project_nid, $limit = ROVAS_CIVIC_WR_DEFAULT_LIMIT, $offset = 0, $lang = '') {
  module_load_include('inc', 'rovas_civic', 'rovas_civic.charity');

  $project_nid = (int) $project_nid;
  if ($project_nid < 1) {
    return services_error(t('project_nid is required'), 400);
  }

  $project = rovas_civic_load_published_project($project_nid);
  if (!$project) {
    return services_error(t('Project not found'), 404);
  }

  $gate = rovas_civic_assert_project_readable($project);
  if ($gate !== TRUE) {
    return $gate;
  }

  $pager = rovas_civic_normalize_pager($limit, $offset, ROVAS_CIVIC_WR_DEFAULT_LIMIT, ROVAS_CIVIC_WR_MAX_LIMIT);
  return rovas_civic_project_work_reports_page($project, $pager['limit'], $pager['offset'], rovas_civic_request_lang($lang));
}

/**
 * Services callback: GET /rovas/civic_project_shareholders
 */
function rovas_civic_services_project_shareholders_index($project_nid, $limit = ROVAS_CIVIC_WR_DEFAULT_LIMIT, $offset = 0) {
  module_load_include('inc', 'rovas_civic', 'rovas_civic.charity');

  $project_nid = (int) $project_nid;
  if ($project_nid < 1) {
    return services_error(t('project_nid is required'), 400);
  }

  $project = rovas_civic_load_published_project($project_nid);
  if (!$project) {
    return services_error(t('Project not found'), 404);
  }

  $gate = rovas_civic_assert_project_readable($project);
  if ($gate !== TRUE) {
    return $gate;
  }

  $pager = rovas_civic_normalize_pager($limit, $offset, ROVAS_CIVIC_WR_DEFAULT_LIMIT, ROVAS_CIVIC_WR_MAX_LIMIT);
  return rovas_civic_project_shareholders_page($project, $pager['limit'], $pager['offset']);
}

/**
 * Services callback: GET /rovas/civic_merit_history
 *
 * Ledger is always the Bearer user (field_reward_recipient). Query params
 * uid / username are ignored — do not expose another user's history.
 */
function rovas_civic_services_merit_history_index($limit = ROVAS_CIVIC_WR_DEFAULT_LIMIT, $offset = 0, $lang = '') {
  $uid = rovas_civic_request_uid();
  if ($uid < 1) {
    return services_error(t('Authentication required'), 401);
  }

  $pager = rovas_civic_normalize_pager($limit, $offset, ROVAS_CIVIC_WR_DEFAULT_LIMIT, ROVAS_CIVIC_WR_MAX_LIMIT);
  return rovas_civic_merit_history_page($uid, $pager['limit'], $pager['offset'], rovas_civic_request_lang($lang));
}

/**
 * Load a published project node or NULL.
 *
 * @param int $nid
 *
 * @return object|null
 */
function rovas_civic_load_published_project($nid) {
  $nid = (int) $nid;
  if ($nid < 1) {
    return NULL;
  }
  $node = node_load($nid);
  if (!$node || empty($node->nid) || $node->type !== 'project' || (int) $node->status !== 1) {
    return NULL;
  }
  return $node;
}

/**
 * Whether a project is Public / Public-dependent (informational for Civic).
 *
 * field_participation: 0 = Private, 1 = Public, 2 = Public-dependent.
 * On Rovas, Private only restricts who may join as a shareholder — it does
 * not hide project content. Civic still receives full payload; is_public is
 * a flag only.
 *
 * @param object $project
 *
 * @return bool
 */
function rovas_civic_project_is_public($project) {
  $items = field_get_items('node', $project, 'field_participation');
  if ($items === FALSE || !isset($items[0]['value'])) {
    return FALSE;
  }
  $value = (int) $items[0]['value'];
  return ($value === 1 || $value === 2);
}

/**
 * Whether a user is a co-worker shareholder on a published project.
 *
 * @param int $uid
 * @param int $project_nid
 *
 * @return bool
 */
function rovas_civic_user_is_project_shareholder($uid, $project_nid) {
  $uid = (int) $uid;
  $project_nid = (int) $project_nid;
  if ($uid < 1 || $project_nid < 1) {
    return FALSE;
  }
  return (bool) db_query("
    SELECT 1
    FROM {node} n
    INNER JOIN {field_data_field_project} p
      ON p.entity_id = n.nid AND p.entity_type = 'node' AND p.deleted = 0
    INNER JOIN {field_data_field_coworker} cw
      ON cw.entity_id = n.nid AND cw.entity_type = 'node' AND cw.deleted = 0
    WHERE n.type = 'co_worker_merit_allocation'
      AND n.status = 1
      AND p.field_project_target_id = :nid
      AND cw.field_coworker_target_id = :uid
    LIMIT 1
  ", array(':nid' => $project_nid, ':uid' => $uid))->fetchField();
}

/**
 * Whether the user may file a work report on this project (Civic picker hint).
 *
 * Public projects: yes (Rovas self-join on submit). Private: project author or
 * existing co-worker shareholder only.
 *
 * @param int $uid
 * @param object $project
 *   Published project node.
 *
 * @return bool
 */
function rovas_civic_user_can_report_on_project($uid, $project) {
  $uid = (int) $uid;
  if ($uid < 1 || empty($project) || $project->type !== 'project') {
    return FALSE;
  }
  if (rovas_civic_project_is_public($project)) {
    return TRUE;
  }
  if ((int) $project->uid === $uid) {
    return TRUE;
  }
  return rovas_civic_user_is_project_shareholder($uid, (int) $project->nid);
}

/**
 * Plain-text teaser from HTML body (strip tags, decode entities, max chars).
 *
 * @param string|null $html
 * @param int $max
 *
 * @return string|null
 */
function rovas_civic_plain_teaser($html, $max = ROVAS_CIVIC_TEASER_MAX_CHARS) {
  if ($html === NULL || $html === '') {
    return NULL;
  }
  $text = decode_entities(strip_tags((string) $html));
  $text = trim(preg_replace('/\s+/u', ' ', $text));
  if ($text === '') {
    return NULL;
  }
  $max = (int) $max;
  if ($max > 0 && drupal_strlen($text) > $max) {
    $text = drupal_substr($text, 0, $max);
  }
  return $text;
}

/**
 * Node body value as raw HTML string (or empty).
 *
 * @param object $node
 * @param string|null $lang
 *   Optional content language; NULL keeps field_get_items default.
 *
 * @return string
 */
function rovas_civic_node_body_value($node, $lang = NULL) {
  if ($lang !== NULL && $lang !== '') {
    $lang = drupal_strtolower(trim((string) $lang));
    if (!empty($node->body[$lang][0]['value'])) {
      return (string) $node->body[$lang][0]['value'];
    }
    $items = field_get_items('node', $node, 'body', $lang);
    if (!empty($items[0]['value'])) {
      return (string) $items[0]['value'];
    }
    if (function_exists('rovas_base_translation_pick_source_text')) {
      $src = rovas_base_translation_pick_source_text($node, 'body');
      if ($src !== '') {
        return $src;
      }
    }
    if (!empty($node->body[LANGUAGE_NONE][0]['value'])) {
      return (string) $node->body[LANGUAGE_NONE][0]['value'];
    }
  }

  $items = field_get_items('node', $node, 'body');
  if (empty($items[0]['value'])) {
    return '';
  }
  return (string) $items[0]['value'];
}

/**
 * Float field value or NULL when missing.
 *
 * @param object $node
 * @param string $field_name
 *
 * @return float|null
 */
function rovas_civic_node_float_field($node, $field_name) {
  $items = field_get_items('node', $node, $field_name);
  if ($items === FALSE || !isset($items[0]['value']) || $items[0]['value'] === '' || $items[0]['value'] === NULL) {
    return NULL;
  }
  return (float) $items[0]['value'];
}

/**
 * Work-report created_at: prefer field_date unix; else node created.
 *
 * @param object $node
 *
 * @return string|null
 *   ISO-8601 or NULL.
 */
function rovas_civic_work_report_created_at($node) {
  $items = field_get_items('node', $node, 'field_date');
  if (!empty($items[0]['value'])) {
    $raw = $items[0]['value'];
    if (is_numeric($raw)) {
      $ts = (int) $raw;
    }
    else {
      $ts = (int) strtotime((string) $raw);
    }
    if ($ts > 0) {
      return rovas_civic_format_created($ts);
    }
  }
  return rovas_civic_format_created(isset($node->created) ? $node->created : 0);
}

/**
 * Count published work_report nodes linked to a project.
 *
 * @param int $project_nid
 *
 * @return int
 */
function rovas_civic_project_work_report_count($project_nid) {
  $project_nid = (int) $project_nid;
  if ($project_nid < 1) {
    return 0;
  }
  return (int) db_query("
    SELECT COUNT(n.nid)
    FROM {node} n
    INNER JOIN {field_data_field_project} p
      ON p.entity_id = n.nid AND p.entity_type = 'node' AND p.deleted = 0
    WHERE n.type = 'work_report'
      AND n.status = 1
      AND p.field_project_target_id = :nid
  ", array(':nid' => $project_nid))->fetchField();
}

/**
 * Build project detail payload (includes first WR page).
 *
 * @param object $project
 * @param int $limit
 * @param int $offset
 * @param string|null $lang
 *   Optional content language for title/summary/WR text.
 *
 * @return array
 */
function rovas_civic_project_detail($project, $limit = ROVAS_CIVIC_WR_DEFAULT_LIMIT, $offset = 0, $lang = NULL) {
  module_load_include('inc', 'rovas_civic', 'rovas_civic.charity');

  $nid = (int) $project->nid;
  $is_public = rovas_civic_project_is_public($project);
  $owner = user_load((int) $project->uid);
  $labels = rovas_civic_user_public_labels((int) $project->uid, $owner);
  $wr_count = rovas_civic_project_work_report_count($nid);
  $shareholder_count = rovas_civic_project_shareholder_count($nid);
  $pager = rovas_civic_normalize_pager($limit, $offset, ROVAS_CIVIC_WR_DEFAULT_LIMIT, ROVAS_CIVIC_WR_MAX_LIMIT);

  // Private participation does not hide content — only who may join as shareholder.
  $summary = rovas_civic_plain_teaser(rovas_civic_node_body_value($project, $lang));
  $page = rovas_civic_project_work_reports_fetch($nid, $pager['limit'], $pager['offset'], TRUE, $lang);
  $sh_page = rovas_civic_project_shareholders_fetch($nid, $pager['limit'], $pager['offset']);
  $charity = rovas_civic_project_charity_json($project, $lang);

  return array(
    'project_nid' => (string) $nid,
    'title' => rovas_civic_node_localized_title($project, $lang),
    'summary' => $summary,
    'is_public' => $is_public,
    'is_charity' => $charity['is_charity'],
    'charity_status' => $charity['charity_status'],
    'organization' => $charity['organization'],
    'org_id' => $charity['org_id'],
    'country' => $charity['country'],
    'website_url' => $charity['website_url'],
    'iban_verified' => $charity['iban_verified'],
    'donate_instructions' => $charity['donate_instructions'],
    'donate_url' => $charity['donate_url'],
    'donate_iban' => $charity['donate_iban'],
    'owner_username' => $labels['username'],
    'owner_display_name' => $labels['display_name'],
    'total_hours' => rovas_civic_node_float_field($project, 'field_project_total_hours'),
    'total_me' => rovas_civic_node_float_field($project, 'field_merit_reward'),
    'work_report_count' => $wr_count,
    'shareholder_count' => $shareholder_count,
    'rovas_url' => url('node/' . $nid, array('absolute' => TRUE)),
    'work_reports' => array(
      'project_nid' => (string) $nid,
      'total' => $wr_count,
      'limit' => $pager['limit'],
      'offset' => $pager['offset'],
      'items' => $page['items'],
    ),
    'shareholders' => array(
      'project_nid' => (string) $nid,
      'total' => $shareholder_count,
      'limit' => $pager['limit'],
      'offset' => $pager['offset'],
      'items' => $sh_page['items'],
    ),
  );
}

/**
 * Paginated work-reports response for a published project.
 *
 * @param object $project
 * @param int $limit
 * @param int $offset
 * @param string|null $lang
 *
 * @return array
 */
function rovas_civic_project_work_reports_page($project, $limit, $offset, $lang = NULL) {
  $nid = (int) $project->nid;
  $total = rovas_civic_project_work_report_count($nid);
  $page = rovas_civic_project_work_reports_fetch($nid, $limit, $offset, TRUE, $lang);
  return array(
    'project_nid' => (string) $nid,
    'total' => $total,
    'limit' => (int) $limit,
    'offset' => (int) $offset,
    'items' => $page['items'],
  );
}

/**
 * Fetch a page of work_report rows for a project.
 *
 * @param int $project_nid
 * @param int $limit
 * @param int $offset
 * @param bool $include_bodies
 *   When FALSE, summary is always null.
 * @param string|null $lang
 *   Optional content language for title/summary.
 *
 * @return array
 *   keys: items
 */
function rovas_civic_project_work_reports_fetch($project_nid, $limit, $offset, $include_bodies = TRUE, $lang = NULL) {
  $project_nid = (int) $project_nid;
  $limit = (int) $limit;
  $offset = (int) $offset;

  $nids = db_query("
    SELECT n.nid
    FROM {node} n
    INNER JOIN {field_data_field_project} p
      ON p.entity_id = n.nid AND p.entity_type = 'node' AND p.deleted = 0
    WHERE n.type = 'work_report'
      AND n.status = 1
      AND p.field_project_target_id = :nid
    ORDER BY n.created DESC, n.nid DESC
    LIMIT " . $limit . " OFFSET " . $offset . "
  ", array(':nid' => $project_nid))->fetchCol();

  $items = array();
  if (empty($nids)) {
    return array('items' => $items);
  }

  $nodes = node_load_multiple($nids);
  $author_uids = array();
  foreach ($nids as $wr_nid) {
    if (!empty($nodes[$wr_nid]->uid)) {
      $author_uids[(int) $nodes[$wr_nid]->uid] = (int) $nodes[$wr_nid]->uid;
    }
  }
  $authors = $author_uids ? user_load_multiple(array_values($author_uids)) : array();

  foreach ($nids as $wr_nid) {
    if (empty($nodes[$wr_nid])) {
      continue;
    }
    $node = $nodes[$wr_nid];
    $author_uid = (int) $node->uid;
    $author = isset($authors[$author_uid]) ? $authors[$author_uid] : NULL;
    $items[] = rovas_civic_work_report_item($node, $lang, $include_bodies, NULL, $author);
  }

  return array('items' => $items);
}

/**
 * Build one Civic work-report JSON row (list or verifier detail).
 *
 * @param object $node
 *   work_report node.
 * @param string|null $lang
 * @param bool $include_proof
 *   When TRUE, include summary and photo_urls (list) or full proof bundle (detail).
 * @param int|null $verifier_uid
 *   When set, include verifier detail fields (project, web URLs, map, NACE, reward).
 * @param object|null $author
 *   Preloaded author account (optional).
 *
 * @return array
 */
function rovas_civic_work_report_item($node, $lang = NULL, $include_proof = TRUE, $verifier_uid = NULL, $author = NULL) {
  $author_uid = (int) $node->uid;
  if ($author === NULL) {
    $author = user_load($author_uid);
  }
  $labels = rovas_civic_user_public_labels($author_uid, $author);
  $hours = rovas_civic_node_float_field($node, 'field_hours_worked');

  $item = array(
    'work_report_nid' => (string) ((int) $node->nid),
    'title' => rovas_civic_node_localized_title($node, $lang),
    'summary' => NULL,
    'hours' => $hours,
    'author_username' => $labels['username'],
    'author_display_name' => $labels['display_name'],
    'created_at' => rovas_civic_work_report_created_at($node),
    'photo_urls' => array(),
  );

  if ($include_proof) {
    $item['summary'] = rovas_civic_plain_teaser(rovas_civic_node_body_value($node, $lang));
    $item['photo_urls'] = rovas_civic_work_report_photo_urls($node);
    $photo_edits = rovas_civic_work_report_photo_edits($node);
    if (!empty($photo_edits)) {
      $item['photos_edited'] = TRUE;
      $item['photo_edits'] = $photo_edits;
    }
  }

  if ($verifier_uid !== NULL && (int) $verifier_uid > 0) {
    module_load_include('inc', 'rovas_civic', 'rovas_civic.verify');
    $project_nid = rovas_civic_wr_project_nid($node);
    $project_name = NULL;
    if ($project_nid > 0) {
      $project = node_load($project_nid);
      if ($project && $project->type === 'project') {
        $project_name = rovas_civic_node_localized_title($project, $lang);
      }
    }

    $nace = rovas_civic_wr_nace_fields($node, $lang);
    $item['project_nid'] = $project_nid > 0 ? (string) $project_nid : NULL;
    $item['project_name'] = $project_name;
    $item['web_urls'] = rovas_civic_wr_web_urls($node);
    $item['field_location'] = rovas_civic_wr_field_location_geojson($node);
    $item['nace_tid'] = $nace['nace_tid'];
    $item['nace_label'] = $nace['nace_label'];
    $item['reward_kind'] = rovas_civic_wr_reward_kind((int) $node->nid);
    $item['date_started'] = rovas_civic_wr_date_started($node);
  }

  return $item;
}

/**
 * Absolute public URLs for work_report field_photos.
 *
 * @param object $node
 *
 * @return array
 *   List of absolute URL strings.
 */
function rovas_civic_work_report_photo_urls($node) {
  $items = field_get_items('node', $node, 'field_photos');
  if ($items === FALSE || empty($items)) {
    return array();
  }

  $urls = array();
  foreach ($items as $item) {
    if (empty($item['fid'])) {
      continue;
    }
    $file = file_load($item['fid']);
    if (!$file || empty($file->uri)) {
      continue;
    }
    // Skip private:// and similar non-public schemes.
    $scheme = file_uri_scheme($file->uri);
    if ($scheme && $scheme !== 'public') {
      continue;
    }
    $url = file_create_url($file->uri);
    if (!empty($url)) {
      $urls[] = $url;
    }
  }
  return $urls;
}

/**
 * Photo redaction notices for a work report (Civic API).
 *
 * @param object $node
 *
 * @return array
 *   List of {filename, url, mode, regions_redacted, message}.
 */
function rovas_civic_work_report_photo_edits($node) {
  if (empty($node->nid) || !module_exists('rovas_ai')) {
    return array();
  }
  module_load_include('inc', 'rovas_ai', 'rovas_ai.redact');
  if (!function_exists('rovas_ai_photo_edits_for_nid')) {
    return array();
  }
  $edits = rovas_ai_photo_edits_for_nid((int) $node->nid);
  $out = array();
  foreach ($edits as $edit) {
    unset($edit['fid']);
    $out[] = $edit;
  }
  return $out;
}

/**
 * Count user shareholders (co_worker_merit_allocation) for a project.
 *
 * Mirrors project_coworkers view user rows; excludes project-as-shareholder.
 *
 * @param int $project_nid
 *
 * @return int
 */
function rovas_civic_project_shareholder_count($project_nid) {
  $project_nid = (int) $project_nid;
  if ($project_nid < 1) {
    return 0;
  }
  return (int) db_query("
    SELECT COUNT(n.nid)
    FROM {node} n
    INNER JOIN {field_data_field_project} p
      ON p.entity_id = n.nid AND p.entity_type = 'node' AND p.deleted = 0
    INNER JOIN {field_data_field_coworker} cw
      ON cw.entity_id = n.nid AND cw.entity_type = 'node' AND cw.deleted = 0
    INNER JOIN {users} u ON u.uid = cw.field_coworker_target_id
    WHERE n.type = 'co_worker_merit_allocation'
      AND n.status = 1
      AND p.field_project_target_id = :nid
      AND u.uid > 0
      AND u.status = 1
  ", array(':nid' => $project_nid))->fetchField();
}

/**
 * Paginated shareholders response for a published project.
 *
 * @param object $project
 * @param int $limit
 * @param int $offset
 *
 * @return array
 */
function rovas_civic_project_shareholders_page($project, $limit, $offset) {
  $nid = (int) $project->nid;
  $total = rovas_civic_project_shareholder_count($nid);
  $page = rovas_civic_project_shareholders_fetch($nid, $limit, $offset);
  return array(
    'project_nid' => (string) $nid,
    'total' => $total,
    'limit' => (int) $limit,
    'offset' => (int) $offset,
    'items' => $page['items'],
  );
}

/**
 * Fetch a page of user shareholder rows for a project.
 *
 * Logic mirrors Views `project_coworkers` user rows:
 * - type co_worker_merit_allocation + field_coworker username
 * - share_kind percent when field_merit_allocation > 0, else time_based
 *
 * @param int $project_nid
 * @param int $limit
 * @param int $offset
 *
 * @return array
 *   keys: items
 */
function rovas_civic_project_shareholders_fetch($project_nid, $limit, $offset) {
  $project_nid = (int) $project_nid;
  $limit = (int) $limit;
  $offset = (int) $offset;

  $rows = db_query("
    SELECT u.name AS username,
      ma.field_merit_allocation_value AS share_pct,
      hw.field_total_hours_worked_value AS hours
    FROM {node} n
    INNER JOIN {field_data_field_project} p
      ON p.entity_id = n.nid AND p.entity_type = 'node' AND p.deleted = 0
    INNER JOIN {field_data_field_coworker} cw
      ON cw.entity_id = n.nid AND cw.entity_type = 'node' AND cw.deleted = 0
    INNER JOIN {users} u ON u.uid = cw.field_coworker_target_id
    LEFT JOIN {field_data_field_merit_allocation} ma
      ON ma.entity_id = n.nid AND ma.entity_type = 'node' AND ma.deleted = 0
    LEFT JOIN {field_data_field_total_hours_worked} hw
      ON hw.entity_id = n.nid AND hw.entity_type = 'node' AND hw.deleted = 0
    WHERE n.type = 'co_worker_merit_allocation'
      AND n.status = 1
      AND p.field_project_target_id = :nid
      AND u.uid > 0
      AND u.status = 1
    ORDER BY hw.field_total_hours_worked_value DESC, u.name ASC, n.nid DESC
    LIMIT " . $limit . " OFFSET " . $offset . "
  ", array(':nid' => $project_nid));

  $items = array();
  foreach ($rows as $row) {
    $username = trim((string) $row->username);
    if ($username === '') {
      continue;
    }
    $share_pct = isset($row->share_pct) && $row->share_pct !== NULL && $row->share_pct !== ''
      ? (float) $row->share_pct
      : 0.0;
    $hours = isset($row->hours) && $row->hours !== NULL && $row->hours !== ''
      ? (float) $row->hours
      : NULL;

    if ($share_pct > 0) {
      $items[] = array(
        'username' => $username,
        'share_kind' => 'percent',
        'share_percent' => $share_pct,
        'hours' => $hours,
      );
    }
    else {
      $items[] = array(
        'username' => $username,
        'share_kind' => 'time_based',
        'share_percent' => NULL,
        'hours' => $hours,
      );
    }
  }

  return array('items' => $items);
}

/**
 * Paginated Merit ledger for the Bearer user.
 *
 * Mirrors Views merit_history / page_1 (/user/%/merits) with SQL — not
 * views_get_view(). Source kinds match that display's PHP field without HTML.
 *
 * @param int $uid
 * @param int $limit
 * @param int $offset
 * @param string|null $lang
 *
 * @return array
 *   keys: total, limit, offset, items
 */
function rovas_civic_merit_history_page($uid, $limit, $offset, $lang = NULL) {
  $uid = (int) $uid;
  $limit = (int) $limit;
  $offset = (int) $offset;

  $total = (int) db_query("
    SELECT COUNT(DISTINCT n.nid)
    FROM {node} n
    INNER JOIN {field_data_field_reward_recipient} rec
      ON rec.entity_id = n.nid AND rec.entity_type = 'node' AND rec.deleted = 0
    WHERE n.status = 1
      AND n.type IN ('merits_disbursement', 'merit_penalty')
      AND rec.field_reward_recipient_target_id = :uid
  ", array(':uid' => $uid))->fetchField();

  $items = array();
  if ($total > 0) {
    $items = rovas_civic_merit_history_fetch($uid, $limit, $offset, $lang);
  }

  return array(
    'total' => $total,
    'limit' => $limit,
    'offset' => $offset,
    'items' => $items,
  );
}

/**
 * Fetch a page of Merit ledger rows for a reward recipient.
 *
 * Source PHP on Views page_1 (no HTML; Civic i18n's purchase):
 * - no project and no work report → purchase (includes merit_penalty rows)
 * - project, no work report → project
 * - work report present → report (project_nid still set when known)
 *
 * @param int $uid
 * @param int $limit
 * @param int $offset
 * @param string|null $lang
 *
 * @return array
 */
function rovas_civic_merit_history_fetch($uid, $limit, $offset, $lang = NULL) {
  $uid = (int) $uid;
  $limit = (int) $limit;
  $offset = (int) $offset;

  $rows = db_query("
    SELECT n.nid AS disbursement_nid,
      n.type AS node_type,
      n.created AS created,
      MAX(amt.field_reward_amount_value) AS merits,
      MAX(src.field_merit_source_value) AS merit_source,
      MAX(proj.field_receipt_project_target_id) AS project_nid,
      MAX(wr.field_rewarded_report_target_id) AS work_report_nid
    FROM {node} n
    INNER JOIN {field_data_field_reward_recipient} rec
      ON rec.entity_id = n.nid AND rec.entity_type = 'node' AND rec.deleted = 0
    LEFT JOIN {field_data_field_reward_amount} amt
      ON amt.entity_id = n.nid AND amt.entity_type = 'node' AND amt.deleted = 0
    LEFT JOIN {field_data_field_merit_source} src
      ON src.entity_id = n.nid AND src.entity_type = 'node' AND src.deleted = 0
    LEFT JOIN {field_data_field_parent_purchase_receipt} parent
      ON parent.entity_id = n.nid AND parent.entity_type = 'node' AND parent.deleted = 0
    LEFT JOIN {field_data_field_receipt_project} proj
      ON proj.entity_id = parent.field_parent_purchase_receipt_target_id
      AND proj.entity_type = 'node' AND proj.deleted = 0
    LEFT JOIN {field_data_field_rewarded_report} wr
      ON wr.entity_id = parent.field_parent_purchase_receipt_target_id
      AND wr.entity_type = 'node' AND wr.deleted = 0
    WHERE n.status = 1
      AND n.type IN ('merits_disbursement', 'merit_penalty')
      AND rec.field_reward_recipient_target_id = :uid
    GROUP BY n.nid, n.type, n.created
    ORDER BY n.created DESC, n.nid DESC
    LIMIT " . $limit . " OFFSET " . $offset . "
  ", array(':uid' => $uid))->fetchAll();

  $title_nids = array();
  foreach ($rows as $row) {
    $project_nid = (int) $row->project_nid;
    $wr_nid = (int) $row->work_report_nid;
    if ($project_nid > 0) {
      $title_nids[] = $project_nid;
    }
    if ($wr_nid > 0) {
      $title_nids[] = $wr_nid;
    }
  }
  $titles = rovas_civic_project_titles_for_nids($title_nids, $lang);

  $items = array();
  foreach ($rows as $row) {
    $project_nid = (int) $row->project_nid;
    $wr_nid = (int) $row->work_report_nid;
    $node_type = ($row->node_type === 'merit_penalty') ? 'merit_penalty' : 'merits_disbursement';

    if ($wr_nid > 0) {
      $source_kind = 'report';
      $source_title = isset($titles[$wr_nid]) ? $titles[$wr_nid] : NULL;
    }
    elseif ($project_nid > 0) {
      $source_kind = 'project';
      $source_title = isset($titles[$project_nid]) ? $titles[$project_nid] : NULL;
    }
    else {
      $source_kind = 'purchase';
      $source_title = NULL;
    }

    $merit_source = !empty($row->merit_source) ? (string) $row->merit_source : NULL;
    if ($merit_source === NULL && module_exists('rovas_merit')) {
      module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');
      if ($node_type === 'merit_penalty') {
        $merit_source = ROVAS_MERIT_SOURCE_PENALTY;
      }
    }

    $items[] = array(
      'disbursement_nid' => (string) ((int) $row->disbursement_nid),
      'node_type' => $node_type,
      'created_at' => rovas_civic_format_created($row->created),
      'merits' => isset($row->merits) && $row->merits !== NULL && $row->merits !== ''
        ? (float) $row->merits
        : 0.0,
      'merit_source' => $merit_source,
      'source_kind' => $source_kind,
      'source_title' => $source_title,
      'project_nid' => $project_nid > 0 ? (string) $project_nid : NULL,
      'work_report_nid' => $wr_nid > 0 ? (string) $wr_nid : NULL,
    );
  }

  return $items;
}

/**
 * Compute donor Merits from an EUR slice and hourly rate.
 *
 * ME = (eur_slice / hourly_rate_eur) * 10
 *
 * @param float $eur_slice
 * @param float $hourly_rate_eur
 *
 * @return float
 */
function rovas_civic_merits_from_eur_slice($eur_slice, $hourly_rate_eur) {
  $eur_slice = (float) $eur_slice;
  $hourly_rate_eur = (float) $hourly_rate_eur;
  if ($eur_slice <= 0 || $hourly_rate_eur <= 0) {
    return 0.0;
  }
  return ($eur_slice / $hourly_rate_eur) * ROVAS_CIVIC_ME_PER_HOUR;
}

/**
 * Floor to 2 decimal places (for per-share Merits before residue).
 */
function rovas_civic_floor2($value) {
  return floor(((float) $value) * 100) / 100;
}

/**
 * Indicative base-fund hourly rate (EUR/hour) from forex quote.
 *
 * @param float $eur
 *   Sample EUR amount (does not settle).
 *
 * @return float|false
 */
function rovas_civic_base_fund_hourly_rate($eur = 10.0) {
  if (!function_exists('calculate_forex_transaction_params')) {
    return FALSE;
  }
  $params = calculate_forex_transaction_params('eur_to_chr', max(0.01, (float) $eur), 0, FALSE);
  if (!empty($params['effective_rate']) && (float) $params['effective_rate'] > 0) {
    return (float) $params['effective_rate'];
  }
  if (function_exists('forex_min_r_get')) {
    $min_r = forex_min_r_get();
    if ($min_r > 0) {
      return (float) $min_r;
    }
  }
  return FALSE;
}

/* ===========================================================================
 * Merit issuance (A3) + donor reward
 * ========================================================================= */

/**
 * Project nid used to attribute EUR buy-Merits in Civic top_charities.
 *
 * @return int
 *   Valid project nid, or 0 if unset / missing.
 */
function rovas_civic_eur_buy_merits_project_nid() {
  $nid = (int) variable_get(ROVAS_CIVIC_EUR_BUY_MERITS_PROJECT_VAR, ROVAS_CIVIC_EUR_BUY_MERITS_PROJECT_DEFAULT);
  if ($nid < 1) {
    $nid = (int) ROVAS_CIVIC_EUR_BUY_MERITS_PROJECT_DEFAULT;
  }
  if ($nid < 1) {
    return 0;
  }
  $node = node_load($nid);
  if (!$node || $node->type !== 'project') {
    return 0;
  }
  return $nid;
}

/**
 * Ensure the EUR buy-Merits attribution project variable is seeded.
 *
 * @param int|null $nid
 *   Optional override; default platform Rovas project.
 *
 * @return int
 *   Stored project nid, or 0 on failure.
 */
function rovas_civic_ensure_eur_buy_merits_project($nid = NULL) {
  $existing = (int) variable_get(ROVAS_CIVIC_EUR_BUY_MERITS_PROJECT_VAR, 0);
  if ($existing > 0) {
    $node = node_load($existing);
    if ($node && $node->type === 'project') {
      return $existing;
    }
  }
  $nid = $nid === NULL ? (int) ROVAS_CIVIC_EUR_BUY_MERITS_PROJECT_DEFAULT : (int) $nid;
  if ($nid < 1) {
    return 0;
  }
  $node = node_load($nid);
  if (!$node || $node->type !== 'project') {
    watchdog('rovas_civic', 'EUR buy-Merits project nid @nid missing or not a project.', array(
      '@nid' => $nid,
    ), WATCHDOG_ERROR);
    return 0;
  }
  variable_set(ROVAS_CIVIC_EUR_BUY_MERITS_PROJECT_VAR, $nid);
  return $nid;
}

/**
 * Record A3 attribution for EUR buy-Merits (no second ledger credit).
 *
 * Called after `_rovas_forex_grant_merits(..., charitable_donation)` has
 * already applied the wallet / disbursement. Idempotent on
 * (uid, source_type, source_id).
 *
 * @param object $account
 *   Buyer user object.
 * @param float $merits
 *   Merits granted.
 * @param int $receipt_nid
 *   purchase_merits node nid (preferred source_id).
 * @param int $order_id
 *   Optional Commerce order_id; used only when receipt_nid is missing.
 *
 * @return bool
 *   TRUE when attribution exists or was written; FALSE on skip/failure.
 */
function rovas_civic_attribute_eur_buy_merits($account, $merits, $receipt_nid = 0, $order_id = 0) {
  $merits = (float) $merits;
  $receipt_nid = (int) $receipt_nid;
  $order_id = (int) $order_id;
  if (empty($account->uid) || $merits <= 0) {
    return FALSE;
  }
  if (!db_table_exists('rovas_merit_issuance')) {
    return FALSE;
  }

  $project_nid = rovas_civic_eur_buy_merits_project_nid();
  if ($project_nid < 1) {
    watchdog('rovas_civic', 'EUR buy-Merits attribution skipped: no project configured (uid @u).', array(
      '@u' => (int) $account->uid,
    ), WATCHDOG_WARNING);
    return FALSE;
  }

  if ($receipt_nid > 0) {
    $source_id = 'purchase_merits:' . $receipt_nid;
  }
  elseif ($order_id > 0) {
    $source_id = 'order:' . $order_id;
  }
  else {
    // Last resort: still attribute once per grant without a stable key.
    $source_id = 'eur_buy_merits:uid:' . (int) $account->uid . ':t:' . REQUEST_TIME . ':me:' . $merits;
  }

  $exists = db_query("SELECT 1 FROM {rovas_merit_issuance} WHERE uid = :u AND source_type = :t AND source_id = :s", array(
    ':u' => (int) $account->uid,
    ':t' => ROVAS_CIVIC_SOURCE_EUR_BUY_MERITS,
    ':s' => $source_id,
  ))->fetchField();
  if ($exists) {
    return TRUE;
  }

  $desc = t('EUR buy-Merits attributed to project @nid', array('@nid' => $project_nid));
  db_insert('rovas_merit_issuance')
    ->fields(array(
      'uid' => (int) $account->uid,
      'amount' => $merits,
      'project_nid' => $project_nid,
      'source_type' => ROVAS_CIVIC_SOURCE_EUR_BUY_MERITS,
      'source_id' => $source_id,
      'description' => $desc,
      'created' => REQUEST_TIME,
    ))
    ->execute();

  return TRUE;
}

/**
 * Backfill eur_buy_merits issuance for historical EUR purchase_merits grants.
 *
 * Does not grant Merits; only writes missing A3 attribution rows to the
 * currently configured buy-ME project.
 *
 * @param int|null $only_uid
 *   Optional limit to one user.
 *
 * @return int
 *   Number of issuance rows inserted.
 */
function rovas_civic_backfill_eur_buy_merits_attribution($only_uid = NULL) {
  if (!db_table_exists('rovas_merit_issuance')) {
    return 0;
  }
  $project_nid = rovas_civic_ensure_eur_buy_merits_project();
  if ($project_nid < 1) {
    return 0;
  }

  module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');

  $sql = "
    SELECT n.nid AS disbursement_nid,
      n.created AS created,
      rec.field_reward_recipient_target_id AS uid,
      amt.field_reward_amount_value AS amount,
      parent.field_parent_purchase_receipt_target_id AS receipt_nid
    FROM {node} n
    INNER JOIN {field_data_field_reward_recipient} rec
      ON rec.entity_id = n.nid AND rec.entity_type = 'node' AND rec.deleted = 0
    INNER JOIN {field_data_field_reward_amount} amt
      ON amt.entity_id = n.nid AND amt.entity_type = 'node' AND amt.deleted = 0
    INNER JOIN {field_data_field_parent_purchase_receipt} parent
      ON parent.entity_id = n.nid AND parent.entity_type = 'node' AND parent.deleted = 0
    INNER JOIN {node} pr
      ON pr.nid = parent.field_parent_purchase_receipt_target_id
      AND pr.type = 'purchase_merits'
    LEFT JOIN {field_data_field_merit_source} src
      ON src.entity_id = n.nid AND src.entity_type = 'node' AND src.deleted = 0
    WHERE n.type = 'merits_disbursement'
      AND n.status = 1
      AND amt.field_reward_amount_value > 0
      AND (
        src.field_merit_source_value = :charity
        OR src.field_merit_source_value IS NULL
        OR src.field_merit_source_value = ''
      )
  ";
  $args = array(':charity' => ROVAS_MERIT_SOURCE_CHARITABLE_DONATION);
  if ($only_uid !== NULL && (int) $only_uid > 0) {
    $sql .= ' AND rec.field_reward_recipient_target_id = :uid';
    $args[':uid'] = (int) $only_uid;
  }
  $sql .= ' ORDER BY n.nid ASC';

  $inserted = 0;
  foreach (db_query($sql, $args) as $row) {
    $uid = (int) $row->uid;
    $amount = (float) $row->amount;
    $receipt_nid = (int) $row->receipt_nid;
    $created = (int) $row->created;
    if ($uid < 1 || $amount <= 0 || $receipt_nid < 1) {
      continue;
    }

    // Skip CHR→ME purchase_merits (volunteer) when source was unset/legacy.
    $src = db_query("SELECT field_merit_source_value FROM {field_data_field_merit_source}
      WHERE entity_id = :nid AND entity_type = 'node' AND deleted = 0 LIMIT 1", array(
      ':nid' => (int) $row->disbursement_nid,
    ))->fetchField();
    if ($src === ROVAS_MERIT_SOURCE_VOLUNTEER) {
      continue;
    }
    if ($src !== ROVAS_MERIT_SOURCE_CHARITABLE_DONATION) {
      // Unset/legacy: only EUR-funded Commerce merits orders.
      if (!function_exists('_rovas_merit_purchase_merits_was_eur_funded')
        || !_rovas_merit_purchase_merits_was_eur_funded($uid, $created, $amount)) {
        continue;
      }
    }

    $source_id = 'purchase_merits:' . $receipt_nid;
    $exists = db_query("SELECT 1 FROM {rovas_merit_issuance} WHERE uid = :u AND source_type = :t AND source_id = :s", array(
      ':u' => $uid,
      ':t' => ROVAS_CIVIC_SOURCE_EUR_BUY_MERITS,
      ':s' => $source_id,
    ))->fetchField();
    if ($exists) {
      continue;
    }

    db_insert('rovas_merit_issuance')
      ->fields(array(
        'uid' => $uid,
        'amount' => $amount,
        'project_nid' => $project_nid,
        'source_type' => ROVAS_CIVIC_SOURCE_EUR_BUY_MERITS,
        'source_id' => $source_id,
        'description' => t('Backfill: EUR buy-Merits attributed to project @nid', array(
          '@nid' => $project_nid,
        )),
        'created' => $created > 0 ? $created : REQUEST_TIME,
      ))
      ->execute();
    $inserted++;
  }

  return $inserted;
}

/**
 * Issue Merits to a donor with full paper trail + A3 audit row.
 *
 * Matches the work-report / project-reward housekeeping used by
 * /user/<uid>/merits (Views merit_history on merits_disbursement nodes):
 * purchase_receipt → merits_disbursement → ledger credit → project ME bump
 * → user_expertise (NACE 64.99 fallback tid — same as shares_merit_rewarder).
 *
 * @param object $account
 *   Drupal user (donor).
 * @param float $merits
 *   Merits to issue.
 * @param int $project_nid
 *   Rewarded project (State Treasury or ordinary project).
 * @param string $source_type
 *   A3 audit source_type (e.g. civic_vat_claim, project_reward_order).
 * @param string $source_id
 *   A3 audit source_id (idempotency key with uid).
 * @param string $description
 *   Human-readable note (receipt field_note + userpoints description).
 * @param float|null $amount_paid
 *   Optional EUR basis for the note only (VAT slice / net donation). Not stored
 *   on purchase_receipt.field_amount_paid — that field holds Merit units site-wide.
 *
 * @return bool
 *   TRUE on success.
 */
function rovas_civic_issue_donor_merits($account, $merits, $project_nid, $source_type, $source_id, $description, $amount_paid = NULL) {
  $merits = (float) $merits;
  $project_nid = (int) $project_nid;
  if (empty($account->uid) || $merits <= 0 || $project_nid < 1) {
    return FALSE;
  }

  // Idempotency for the same source event + uid.
  $exists = db_query("SELECT 1 FROM {rovas_merit_issuance} WHERE uid = :u AND source_type = :t AND source_id = :s", array(
    ':u' => (int) $account->uid,
    ':t' => $source_type,
    ':s' => (string) $source_id,
  ))->fetchField();
  if ($exists) {
    return TRUE;
  }

  if (!function_exists('rules_invoke_component')) {
    return FALSE;
  }

  $project = node_load($project_nid);
  if (!$project || $project->type !== 'project') {
    watchdog('rovas_civic', 'Donor Merit: project @nid missing or not a project.', array(
      '@nid' => $project_nid,
    ), WATCHDOG_ERROR);
    return FALSE;
  }

  $reward_entity = $project;
  if (function_exists('entity_metadata_wrapper')) {
    $reward_entity = entity_metadata_wrapper('node', $project);
  }

  // field_amount_paid is Merit units everywhere else (work reports, mrewarder).
  // EUR belongs in the note only — do not put vat_slice / net_eur here.
  $receipt_me = $merits;

  // 1) Parent purchase_receipt (Source = Project on /user/*/merits).
  $receipt = rules_invoke_component(
    'rules_create_purchase_receipt',
    (int) $account->uid,
    $project_nid,
    $receipt_me,
    $description,
    0
  );
  $receipt_id = is_array($receipt) ? (int) reset($receipt) : (int) $receipt;
  if ($receipt_id < 1) {
    watchdog('rovas_civic', 'Donor Merit: failed to create purchase_receipt for uid @u source @s.', array(
      '@u' => $account->uid,
      '@s' => $source_id,
    ), WATCHDOG_ERROR);
    return FALSE;
  }

  // 2–5) Ledger credit: wallet + user_expertise + disbursement (+ project ME bump).
  module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');
  $merit_source = rovas_merit_source_from_civic_audit($source_type);
  if (!rovas_merit_apply((int) $account->uid, $merits, $merit_source, ROVAS_CIVIC_FALLBACK_NACE_TID, array(
    'description' => $description,
    'reward_entity' => $reward_entity,
    'receipt_id' => $receipt_id,
    'project_nid' => $project_nid,
  ))) {
    watchdog('rovas_civic', 'Donor Merit: rovas_merit_apply failed for uid @u source @s.', array(
      '@u' => $account->uid,
      '@s' => $source_id,
    ), WATCHDOG_ERROR);
    return FALSE;
  }

  // 6) A3 audit (NeoFund invariant).
  db_insert('rovas_merit_issuance')
    ->fields(array(
      'uid' => (int) $account->uid,
      'amount' => $merits,
      'project_nid' => $project_nid,
      'source_type' => $source_type,
      'source_id' => (string) $source_id,
      'description' => $description,
      'created' => REQUEST_TIME,
    ))
    ->execute();

  // 7) Chron-tab ledger-only offset: Merit purchase_receipt looks like a Chron
  // debit on /user/*/chrons; cancel it without touching field_chrons_balance.
  if (module_exists('rovas_chron')) {
    module_load_include('inc', 'rovas_chron', 'rovas_chron.ledger');
    $offset_nid = rovas_chron_offset_merit_receipt(
      (int) $account->uid,
      $receipt_me,
      $receipt_id,
      t('Chron-tab offset for Civic Merit receipt (source @s).', array(
        '@s' => $source_type,
      ))
    );
    if ($offset_nid < 1) {
      watchdog('rovas_civic', 'Donor Merit: chron offset failed for uid @u receipt @r source @s.', array(
        '@u' => $account->uid,
        '@r' => $receipt_id,
        '@s' => $source_id,
      ), WATCHDOG_WARNING);
    }
  }

  return TRUE;
}

/**
 * Path-1: issue donor Merits after a successful EUR project reward.
 *
 * Called from rovas_project_reward fee-processing success paths.
 *
 * @param object $order
 *   Commerce order.
 * @param object|null $project
 *   Rewarded project node.
 * @param float $net_eur
 *   Net EUR after gateway fees (donation basis).
 * @param string $rail
 *   'stripe' or 'bank'.
 *
 * @return bool
 */
function rovas_civic_issue_donor_merit_for_order($order, $project, $net_eur, $rail = 'stripe') {
  if (empty($order->uid) || empty($project->nid) || (float) $net_eur <= 0) {
    return FALSE;
  }
  // Only project donations (not work-report / buy-merits / user).
  $payer_type = NULL;
  if (isset($order->field_payer_type[LANGUAGE_NONE][0]['value'])) {
    $payer_type = $order->field_payer_type[LANGUAGE_NONE][0]['value'];
  }
  elseif (function_exists('entity_metadata_wrapper')) {
    $payer_type = entity_metadata_wrapper('commerce_order', $order)->field_payer_type->value();
  }
  if ($payer_type !== 'project') {
    return FALSE;
  }

  $account = user_load($order->uid);
  if (!$account) {
    return FALSE;
  }

  // Ordinary projects: base-fund indicative rate. (Charity national rate later.)
  $rate = rovas_civic_base_fund_hourly_rate($net_eur);
  if ($rate === FALSE) {
    $rate = rovas_civic_national_hourly_rate(ROVAS_CIVIC_DEFAULT_COUNTRY);
  }
  if ($rate === FALSE || $rate <= 0) {
    watchdog('rovas_civic', 'No hourly rate available for donor Merit on order @oid.', array(
      '@oid' => $order->order_id,
    ), WATCHDOG_ERROR);
    return FALSE;
  }

  $merits = rovas_civic_merits_from_eur_slice($net_eur, $rate);
  if ($merits <= 0) {
    return FALSE;
  }

  $source_id = 'order:' . (int) $order->order_id;
  $desc = t('Donor Merit for project reward (@rail, @eur EUR @ @rate EUR/h)', array(
    '@rail' => $rail,
    '@eur' => number_format((float) $net_eur, 2, '.', ''),
    '@rate' => number_format($rate, 4, '.', ''),
  ));

  return rovas_civic_issue_donor_merits(
    $account,
    $merits,
    (int) $project->nid,
    'project_reward_order',
    $source_id,
    $desc,
    $net_eur
  );
}

/* ===========================================================================
 * State Treasury project
 * ========================================================================= */

/**
 * Ensure State Treasury of Slovakia project exists; return nid.
 *
 * @return int
 *   Project nid, or 0 on failure.
 */
function rovas_civic_ensure_state_treasury() {
  $nid = (int) variable_get(ROVAS_CIVIC_STATE_TREASURY_VAR, 0);
  if ($nid) {
    $node = node_load($nid);
    if ($node && $node->type === 'project') {
      return $nid;
    }
  }

  // Look for an existing system project by title.
  $existing = db_query("SELECT n.nid FROM {node} n WHERE n.type = 'project' AND n.title = :t ORDER BY n.nid ASC LIMIT 1", array(
    ':t' => 'State Treasury of Slovakia',
  ))->fetchField();
  if ($existing) {
    variable_set(ROVAS_CIVIC_STATE_TREASURY_VAR, (int) $existing);
    return (int) $existing;
  }

  global $user;
  $author_uid = !empty($user->uid) ? (int) $user->uid : 1;
  $author = user_load($author_uid);
  if (!$author) {
    $author = user_load(1);
  }

  $nid = 0;
  if (function_exists('rules_invoke_component') && rules_config_load('rules_create_project')) {
    $result = rules_invoke_component(
      'rules_create_project',
      'State Treasury of Slovakia',
      $author,
      'https://www.financnasprava.sk/',
      0,
      1,
      1,
      'Formal attribution target for eKasa VAT Merit claims (Civic). No EUR moves through NeoFund for these claims.',
      TRUE
    );
    if (is_array($result)) {
      $created = reset($result);
      if (is_object($created) && !empty($created->nid)) {
        $nid = (int) $created->nid;
      }
    }
    elseif (is_object($result) && !empty($result->nid)) {
      $nid = (int) $result->nid;
    }
  }

  if (empty($nid)) {
    $node = new stdClass();
    $node->type = 'project';
    $node->title = 'State Treasury of Slovakia';
    $node->language = LANGUAGE_NONE;
    $node->uid = $author_uid;
    $node->status = 1;
    $node->body[LANGUAGE_NONE][0] = array(
      'value' => 'Formal attribution target for eKasa VAT Merit claims (Civic). No EUR moves through NeoFund for these claims.',
      'format' => 'filtered_html',
    );
    if (field_info_field('field_system_project')) {
      $node->field_system_project[LANGUAGE_NONE][0]['value'] = 1;
    }
    if (field_info_field('field_participation')) {
      $node->field_participation[LANGUAGE_NONE][0]['value'] = 1;
    }
    node_object_prepare($node);
    node_save($node);
    $nid = (int) $node->nid;
  }

  if ($nid) {
    variable_set(ROVAS_CIVIC_STATE_TREASURY_VAR, $nid);
  }
  return $nid ? $nid : 0;
}

/**
 * Enable VAT claim + claim-read + rate + users_search + users_lookup + project + merit-history APIs on rovas_endpoint.
 *
 * @return bool
 */
function rovas_civic_ensure_services_resources() {
  if (!function_exists('services_endpoint_load') || !function_exists('services_endpoint_save')) {
    return FALSE;
  }
  // Ensure OAuth home resources too if available.
  if (function_exists('rovas_oauth_ensure_civic_resources')) {
    rovas_oauth_ensure_civic_resources();
  }

  $endpoint = services_endpoint_load('rovas_endpoint');
  if (!$endpoint) {
    return FALSE;
  }

  $changed = FALSE;
  if (!is_array($endpoint->authentication['oauth2_server'])
    || empty($endpoint->authentication['oauth2_server']['server'])) {
    $endpoint->authentication['oauth2_server'] = array('server' => 'civic');
    $changed = TRUE;
  }

  $bearer_op = array(
    'enabled' => 1,
    'settings' => array(
      'services_auth_apikeys' => array(
        'disable_authentication' => 1,
      ),
      'oauth2_server' => array(
        'require_authentication' => 1,
        'scope' => 'user_profile',
      ),
    ),
  );

  $public_op = array(
    'enabled' => 1,
    'settings' => array(
      'services_auth_apikeys' => array(
        'disable_authentication' => 1,
      ),
      'oauth2_server' => array(
        'require_authentication' => 0,
        'scope' => '',
      ),
    ),
  );

  // POST /rovas/rules/rules_proxy_claim_vat_receipt
  if (empty($endpoint->resources['rules']['actions']['rules_proxy_claim_vat_receipt'])
    || $endpoint->resources['rules']['actions']['rules_proxy_claim_vat_receipt'] != $bearer_op) {
    if (!isset($endpoint->resources['rules'])) {
      $endpoint->resources['rules'] = array();
    }
    if (!isset($endpoint->resources['rules']['actions'])) {
      $endpoint->resources['rules']['actions'] = array();
    }
    $endpoint->resources['rules']['actions']['rules_proxy_claim_vat_receipt'] = $bearer_op;
    $changed = TRUE;
  }

  // GET /rovas/civic_claims[+ /summary] — machine name path (no slash alias).
  $claims_resource = array(
    'operations' => array(
      'index' => $bearer_op,
      'retrieve' => $bearer_op,
    ),
  );
  if (empty($endpoint->resources['civic_claims'])
    || $endpoint->resources['civic_claims'] != $claims_resource) {
    $endpoint->resources['civic_claims'] = $claims_resource;
    $changed = TRUE;
  }

  // GET /rovas/civic_national_hourly_rate (public) — machine name path.
  $rate_resource = array(
    'operations' => array(
      'index' => $public_op,
    ),
  );
  if (empty($endpoint->resources['civic_national_hourly_rate'])
    || $endpoint->resources['civic_national_hourly_rate'] != $rate_resource) {
    $endpoint->resources['civic_national_hourly_rate'] = $rate_resource;
    $changed = TRUE;
  }

  // GET /rovas/users_search?query= — split-claim typeahead (Bearer).
  // Never use param name "q" (Drupal path conflict).
  $users_search_resource = array(
    'operations' => array(
      'index' => $bearer_op,
    ),
  );
  if (empty($endpoint->resources['users_search'])
    || $endpoint->resources['users_search'] != $users_search_resource) {
    $endpoint->resources['users_search'] = $users_search_resource;
    $changed = TRUE;
  }

  // GET /rovas/users_lookup?username= — community public profile (Bearer).
  $users_lookup_resource = array(
    'operations' => array(
      'index' => $bearer_op,
    ),
  );
  if (empty($endpoint->resources['users_lookup'])
    || $endpoint->resources['users_lookup'] != $users_lookup_resource) {
    $endpoint->resources['users_lookup'] = $users_lookup_resource;
    $changed = TRUE;
  }

  // GET /rovas/civic_project/{nid} — Bearer or anonymous (approved charity).
  $civic_project_resource = array(
    'operations' => array(
      'retrieve' => $public_op,
    ),
  );
  if (empty($endpoint->resources['civic_project'])
    || $endpoint->resources['civic_project'] != $civic_project_resource) {
    $endpoint->resources['civic_project'] = $civic_project_resource;
    $changed = TRUE;
  }

  // GET /rovas/civic_project_work_reports?project_nid= — same optional auth.
  $civic_wr_resource = array(
    'operations' => array(
      'index' => $public_op,
    ),
  );
  if (empty($endpoint->resources['civic_project_work_reports'])
    || $endpoint->resources['civic_project_work_reports'] != $civic_wr_resource) {
    $endpoint->resources['civic_project_work_reports'] = $civic_wr_resource;
    $changed = TRUE;
  }

  // GET /rovas/civic_project_shareholders?project_nid= — same optional auth.
  $civic_sh_resource = array(
    'operations' => array(
      'index' => $public_op,
    ),
  );
  if (empty($endpoint->resources['civic_project_shareholders'])
    || $endpoint->resources['civic_project_shareholders'] != $civic_sh_resource) {
    $endpoint->resources['civic_project_shareholders'] = $civic_sh_resource;
    $changed = TRUE;
  }

  // GET /rovas/civic_merit_history — signed-in Merit ledger (Bearer).
  $civic_mh_resource = array(
    'operations' => array(
      'index' => $bearer_op,
    ),
  );
  if (empty($endpoint->resources['civic_merit_history'])
    || $endpoint->resources['civic_merit_history'] != $civic_mh_resource) {
    $endpoint->resources['civic_merit_history'] = $civic_mh_resource;
    $changed = TRUE;
  }

  $civic_index_resource = array(
    'operations' => array(
      'index' => $bearer_op,
    ),
  );
  foreach (array('civic_my_projects', 'civic_projects_search') as $res_name) {
    if (empty($endpoint->resources[$res_name])
      || $endpoint->resources[$res_name] != $civic_index_resource) {
      $endpoint->resources[$res_name] = $civic_index_resource;
      $changed = TRUE;
    }
  }

  $civic_public_read_resource = array(
    'operations' => array(
      'index' => $public_op,
    ),
  );
  foreach (array(
    'civic_nace_tree',
    'civic_merit_index',
    'civic_merit_index_countries',
    'civic_merit_spotlight',
    'civic_merit_period_index',
    'civic_charity_projects',
  ) as $res_name) {
    if (empty($endpoint->resources[$res_name])
      || $endpoint->resources[$res_name] != $civic_public_read_resource) {
      $endpoint->resources[$res_name] = $civic_public_read_resource;
      $changed = TRUE;
    }
  }

  $civic_create_resource = array(
    'operations' => array(
      'create' => $bearer_op,
    ),
  );
  foreach (array(
    'civic_create_project',
    'civic_create_work_report',
    'civic_create_charity_org',
    'civic_receipt_history_preference',
  ) as $res_name) {
    if (empty($endpoint->resources[$res_name])
      || $endpoint->resources[$res_name] != $civic_create_resource) {
      $endpoint->resources[$res_name] = $civic_create_resource;
      $changed = TRUE;
    }
  }

  if (empty($endpoint->resources['civic_work_report_map_config'])
    || $endpoint->resources['civic_work_report_map_config'] != $civic_index_resource) {
    $endpoint->resources['civic_work_report_map_config'] = $civic_index_resource;
    $changed = TRUE;
  }

  foreach (array('civic_pending_verifications', 'civic_pending_comment_notices') as $res_name) {
    if (empty($endpoint->resources[$res_name])
      || $endpoint->resources[$res_name] != $civic_index_resource) {
      $endpoint->resources[$res_name] = $civic_index_resource;
      $changed = TRUE;
    }
  }

  $civic_wr_retrieve_resource = array(
    'operations' => array(
      'retrieve' => $bearer_op,
    ),
  );
  if (empty($endpoint->resources['civic_work_report'])
    || $endpoint->resources['civic_work_report'] != $civic_wr_retrieve_resource) {
    $endpoint->resources['civic_work_report'] = $civic_wr_retrieve_resource;
    $changed = TRUE;
  }

  if (empty($endpoint->resources['civic_submit_verification'])
    || $endpoint->resources['civic_submit_verification'] != $civic_create_resource) {
    $endpoint->resources['civic_submit_verification'] = $civic_create_resource;
    $changed = TRUE;
  }

  if ($changed) {
    services_endpoint_save($endpoint);
  }
  return TRUE;
}

/* ===========================================================================
 * Claim reads (SoT list + summary)
 * ========================================================================= */

/**
 * Services callback: GET /rovas/civic_claims?view=&limit=&offset=&receipt_uid=
 *
 * When receipt_uid is non-empty, returns global claim-status for Civic verify
 * preview: { claimed: bool, receipt_uid } — no scanner identity.
 */
function rovas_civic_services_claims_index($view = 'submitted', $limit = ROVAS_CIVIC_CLAIMS_DEFAULT_LIMIT, $offset = 0, $receipt_uid = '') {
  $uid = rovas_civic_request_uid();
  if ($uid < 1) {
    return services_error(t('Authentication required'), 401);
  }

  $receipt_uid = trim((string) $receipt_uid);
  if ($receipt_uid !== '') {
    return rovas_civic_claim_status_by_receipt_uid($receipt_uid);
  }

  $view = drupal_strtolower(trim((string) $view));
  if ($view === '') {
    $view = 'submitted';
  }
  if ($view !== 'submitted' && $view !== 'received') {
    return services_error(t('Invalid view; use submitted or received'), 400);
  }

  $pager = rovas_civic_normalize_pager($limit, $offset);
  if ($view === 'submitted') {
    return rovas_civic_claims_list_submitted($uid, $pager['limit'], $pager['offset']);
  }
  return rovas_civic_claims_list_received($uid, $pager['limit'], $pager['offset']);
}

/**
 * Global receipt UID claim check (SoT: {civic_claims}).
 *
 * @param string $receipt_uid
 *   eKasa online UID.
 *
 * @return array
 *   keys: claimed (bool), receipt_uid (string).
 */
function rovas_civic_claim_status_by_receipt_uid($receipt_uid) {
  $exists = (bool) db_query('SELECT 1 FROM {civic_claims} WHERE receipt_uid = :r', array(
    ':r' => $receipt_uid,
  ))->fetchField();
  return array(
    'claimed' => $exists,
    'receipt_uid' => $receipt_uid,
  );
}

/**
 * Services callback: GET /rovas/civic_claims/{id}
 *
 * Only id=summary is supported.
 */
function rovas_civic_services_claims_retrieve($id) {
  $uid = rovas_civic_request_uid();
  if ($uid < 1) {
    return services_error(t('Authentication required'), 401);
  }
  if ($id !== 'summary') {
    return services_error(t('Unknown claims resource'), 404);
  }
  return rovas_civic_claims_summary_received($uid);
}

/**
 * Claims the caller scanned (submitted), with nested shares.
 *
 * @return array
 *   keys: items, total, limit, offset, view
 */
function rovas_civic_claims_list_submitted($uid, $limit, $offset) {
  $uid = (int) $uid;
  $total = (int) db_query("SELECT COUNT(*) FROM {civic_claims} WHERE scanner_uid = :u", array(
    ':u' => $uid,
  ))->fetchField();

  $claim_rows = db_select('civic_claims', 'c')
    ->fields('c')
    ->condition('scanner_uid', $uid)
    ->orderBy('created', 'DESC')
    ->orderBy('id', 'DESC')
    ->range($offset, $limit)
    ->execute()
    ->fetchAll();

  $claim_ids = array();
  foreach ($claim_rows as $row) {
    $claim_ids[] = (int) $row->id;
  }

  $shares_by_claim = array();
  if ($claim_ids) {
    $share_rows = db_select('civic_claim_shares', 's')
      ->fields('s')
      ->condition('claim_id', $claim_ids, 'IN')
      ->orderBy('id', 'ASC')
      ->execute();
    foreach ($share_rows as $s) {
      $cid = (int) $s->claim_id;
      if (!isset($shares_by_claim[$cid])) {
        $shares_by_claim[$cid] = array();
      }
      $shares_by_claim[$cid][] = array(
        'beneficiary_rovas_uid' => (string) (int) $s->beneficiary_uid,
        'share_pct' => (float) $s->share_pct,
        'merits_awarded' => (float) $s->merits_awarded,
      );
    }
  }

  $items = array();
  foreach ($claim_rows as $row) {
    $cid = (int) $row->id;
    $items[] = array(
      'receipt_uid' => $row->receipt_uid,
      'vat_eur' => (float) $row->vat_eur,
      'total_merits_awarded' => (float) $row->total_merits,
      'merchant_name' => $row->merchant_name,
      'purchase_at' => $row->purchase_at,
      'created_at' => rovas_civic_format_created($row->created),
      'shares' => isset($shares_by_claim[$cid]) ? $shares_by_claim[$cid] : array(),
    );
  }

  return array(
    'items' => $items,
    'total' => $total,
    'limit' => (int) $limit,
    'offset' => (int) $offset,
    'view' => 'submitted',
  );
}

/**
 * Share rows credited to the caller (received), incl. others' scans.
 *
 * @return array
 *   keys: items, total, limit, offset, view
 */
function rovas_civic_claims_list_received($uid, $limit, $offset) {
  $uid = (int) $uid;
  $total = (int) db_query("SELECT COUNT(*) FROM {civic_claim_shares} WHERE beneficiary_uid = :u", array(
    ':u' => $uid,
  ))->fetchField();

  $query = db_select('civic_claim_shares', 's');
  $query->join('civic_claims', 'c', 'c.id = s.claim_id');
  $query->fields('s', array('share_pct', 'merits_awarded', 'created', 'id'));
  $query->fields('c', array('receipt_uid', 'merchant_name', 'purchase_at', 'scanner_uid'));
  $query->condition('s.beneficiary_uid', $uid);
  $query->orderBy('s.created', 'DESC');
  $query->orderBy('s.id', 'DESC');
  $query->range($offset, $limit);
  $rows = $query->execute()->fetchAll();

  $scanner_uids = array();
  foreach ($rows as $row) {
    $scanner_uid = (int) $row->scanner_uid;
    if ($scanner_uid > 0) {
      $scanner_uids[$scanner_uid] = $scanner_uid;
    }
  }
  $accounts = $scanner_uids ? user_load_multiple(array_values($scanner_uids)) : array();

  $items = array();
  foreach ($rows as $row) {
    $scanner_uid = (int) $row->scanner_uid;
    $labels = rovas_civic_user_public_labels(
      $scanner_uid,
      isset($accounts[$scanner_uid]) ? $accounts[$scanner_uid] : NULL
    );
    $items[] = array(
      'receipt_uid' => $row->receipt_uid,
      'merchant_name' => $row->merchant_name,
      'purchase_at' => $row->purchase_at,
      'scanner_rovas_uid' => (string) $scanner_uid,
      'scanner_username' => $labels['username'],
      'scanner_display_name' => $labels['display_name'],
      'share_pct' => (float) $row->share_pct,
      'merits_awarded' => (float) $row->merits_awarded,
      'created_at' => rovas_civic_format_created($row->created),
    );
  }

  return array(
    'items' => $items,
    'total' => $total,
    'limit' => (int) $limit,
    'offset' => (int) $offset,
    'view' => 'received',
  );
}

/**
 * Public username / display_name for Civic list rows (no email / balance).
 *
 * Missing or blocked accounts still return a usable username fallback (uid
 * string) so one bad scanner never fails the whole list.
 *
 * @param int $uid
 * @param object|null $account
 *   Preloaded user object, or NULL.
 *
 * @return array
 *   keys: username, display_name.
 */
function rovas_civic_user_public_labels($uid, $account = NULL) {
  $uid = (int) $uid;
  $fallback = (string) $uid;

  if (!$account || empty($account->uid) || empty($account->status)) {
    return array(
      'username' => $fallback,
      'display_name' => $fallback,
    );
  }

  $username = (string) $account->name;
  $display_name = $username;
  $items = field_get_items('user', $account, 'field_full_name');
  if (!empty($items[0]['value'])) {
    $display_name = (string) $items[0]['value'];
  }

  return array(
    'username' => $username,
    'display_name' => $display_name,
  );
}

/**
 * Received-based summary for Civic home taxes stats.
 *
 * - receipt_count: distinct claims where caller is a beneficiary
 * - total_vat_eur: sum of caller's vat_slice
 * - taxes_me: sum of caller's merits_awarded
 *
 * @return array
 */
function rovas_civic_claims_summary_received($uid) {
  $uid = (int) $uid;
  $row = db_query("SELECT COUNT(DISTINCT claim_id) AS receipt_count,
      COALESCE(SUM(vat_slice), 0) AS total_vat_eur,
      COALESCE(SUM(merits_awarded), 0) AS taxes_me
    FROM {civic_claim_shares}
    WHERE beneficiary_uid = :u", array(
    ':u' => $uid,
  ))->fetchObject();

  return array(
    'receipt_count' => (int) $row->receipt_count,
    'total_vat_eur' => round((float) $row->total_vat_eur, 4),
    'taxes_me' => round((float) $row->taxes_me, 6),
  );
}

/* ===========================================================================
 * VAT claim
 * ========================================================================= */

/**
 * Services callback: POST /rovas/rules/rules_proxy_claim_vat_receipt
 */
function rovas_civic_services_claim_vat_receipt($receipt_uid, $vat_eur, $shares, $merchant_name = NULL, $purchase_at = NULL, $hourly_wage_eur = NULL, $formula_version = NULL, $total_merits = NULL) {
  global $user;

  $scanner_uid = !empty($user->uid) ? (int) $user->uid : 0;
  if (!$scanner_uid && function_exists('rovas_oauth_uid_from_bearer')) {
    $scanner_uid = (int) rovas_oauth_uid_from_bearer('user_profile');
  }
  if ($scanner_uid < 1) {
    return array(
      'result' => 401,
      'result_explain' => 'authentication_required',
      'total_merits_awarded' => 0,
      'shares' => array(),
    );
  }

  $result = rovas_civic_claim_vat_receipt(array(
    'scanner_uid' => $scanner_uid,
    'receipt_uid' => $receipt_uid,
    'vat_eur' => $vat_eur,
    'shares' => $shares,
    'merchant_name' => $merchant_name,
    'purchase_at' => $purchase_at,
    'hourly_wage_eur' => $hourly_wage_eur,
    'formula_version' => $formula_version,
  ));

  return $result;
}

/**
 * Core VAT claim logic.
 *
 * @param array $params
 *
 * @return array
 *   JSON-serializable response with result / result_explain.
 */
function rovas_civic_claim_vat_receipt(array $params) {
  $scanner_uid = (int) $params['scanner_uid'];
  $receipt_uid = isset($params['receipt_uid']) ? trim($params['receipt_uid']) : '';
  $vat_eur = isset($params['vat_eur']) ? (float) $params['vat_eur'] : 0.0;
  $shares_in = isset($params['shares']) ? $params['shares'] : array();
  $merchant_name = isset($params['merchant_name']) ? $params['merchant_name'] : NULL;
  $purchase_at = isset($params['purchase_at']) ? $params['purchase_at'] : NULL;
  $formula_version = isset($params['formula_version']) ? (int) $params['formula_version'] : 1;

  if ($receipt_uid === '' || $vat_eur <= 0) {
    return rovas_civic_claim_error(1, 'invalid_input');
  }

  // Dedup.
  $existing = db_query("SELECT id FROM {civic_claims} WHERE receipt_uid = :r", array(
    ':r' => $receipt_uid,
  ))->fetchField();
  if ($existing) {
    return rovas_civic_claim_error(409, 'duplicate_receipt');
  }

  $rate = rovas_civic_national_hourly_rate(ROVAS_CIVIC_DEFAULT_COUNTRY);
  if ($rate === FALSE) {
    return rovas_civic_claim_error(500, 'national_rate_missing');
  }

  $treasury_nid = rovas_civic_ensure_state_treasury();
  if (!$treasury_nid) {
    return rovas_civic_claim_error(500, 'state_treasury_missing');
  }

  $validated = rovas_civic_validate_shares($shares_in, $scanner_uid);
  if (!empty($validated['error'])) {
    return rovas_civic_claim_error(2, $validated['error']);
  }
  $shares = $validated['shares'];

  // Per-share VAT slices + Merits; residue Merits to scanner.
  $computed = rovas_civic_compute_share_merits($shares, $vat_eur, $rate, $scanner_uid);
  $total_me = 0.0;
  foreach ($computed as $row) {
    $total_me += $row['merits_awarded'];
  }

  $txn = db_transaction();
  try {
    $claim_id = db_insert('civic_claims')
      ->fields(array(
        'receipt_uid' => $receipt_uid,
        'scanner_uid' => $scanner_uid,
        'vat_eur' => $vat_eur,
        'total_merits' => $total_me,
        'merchant_name' => $merchant_name,
        'purchase_at' => $purchase_at,
        'hourly_wage_eur' => $rate,
        'formula_version' => $formula_version,
        'treasury_nid' => $treasury_nid,
        'created' => REQUEST_TIME,
      ))
      ->execute();

    $out_shares = array();
    foreach ($computed as $row) {
      $account = user_load($row['uid']);
      if (!$account) {
        throw new Exception('beneficiary_missing:' . $row['uid']);
      }
      $source_id = 'claim:' . $claim_id . ':uid:' . $row['uid'];
      $desc = t('Civic VAT claim @receipt (@slice EUR VAT → State Treasury)', array(
        '@receipt' => $receipt_uid,
        '@slice' => number_format($row['vat_slice'], 4, '.', ''),
      ));
      $ok = rovas_civic_issue_donor_merits(
        $account,
        $row['merits_awarded'],
        $treasury_nid,
        'civic_vat_claim',
        $source_id,
        $desc,
        $row['vat_slice']
      );
      if (!$ok) {
        throw new Exception('merit_grant_failed:' . $row['uid']);
      }

      db_insert('civic_claim_shares')
        ->fields(array(
          'claim_id' => $claim_id,
          'beneficiary_uid' => $row['uid'],
          'share_pct' => $row['share_pct'],
          'vat_slice' => $row['vat_slice'],
          'merits_awarded' => $row['merits_awarded'],
          'rounding_residue' => $row['rounding_residue'],
          'created' => REQUEST_TIME,
        ))
        ->execute();

      $out_shares[] = array(
        'beneficiary_rovas_uid' => (string) $row['uid'],
        'merits_awarded' => $row['merits_awarded'],
      );
    }
  }
  catch (Exception $e) {
    $txn->rollback();
    watchdog('rovas_civic', 'VAT claim failed: @m', array('@m' => $e->getMessage()), WATCHDOG_ERROR);
    // Unique key race → treat as duplicate.
    if (strpos($e->getMessage(), 'Duplicate') !== FALSE || strpos($e->getMessage(), '1062') !== FALSE) {
      return rovas_civic_claim_error(409, 'duplicate_receipt');
    }
    return rovas_civic_claim_error(500, 'grant_failed');
  }

  return array(
    'result' => 0,
    'result_explain' => 'ok',
    'total_merits_awarded' => round($total_me, 6),
    'shares' => $out_shares,
    'hourly_wage_eur' => $rate,
    'treasury_nid' => $treasury_nid,
  );
}

/**
 * @param string $code
 * @param string $explain
 *
 * @return array
 */
function rovas_civic_claim_error($code, $explain) {
  return array(
    'result' => (int) $code,
    'result_explain' => $explain,
    'total_merits_awarded' => 0,
    'shares' => array(),
  );
}

/**
 * Validate shares array.
 *
 * @return array
 *   keys: error (string) or shares (list of uid+share_pct).
 */
function rovas_civic_validate_shares($shares_in, $scanner_uid) {
  if (!is_array($shares_in) || empty($shares_in)) {
    return array('error' => 'shares_empty');
  }

  $shares = array();
  $seen = array();
  $sum = 0.0;
  $scanner_included = FALSE;

  foreach ($shares_in as $item) {
    if (!is_array($item)) {
      return array('error' => 'shares_invalid');
    }
    $uid = isset($item['rovas_uid']) ? (int) $item['rovas_uid'] : 0;
    $pct = isset($item['share_pct']) ? (float) $item['share_pct'] : -1;
    if ($uid < 2 || $pct < 0) {
      return array('error' => 'shares_invalid');
    }
    if (isset($seen[$uid])) {
      return array('error' => 'shares_duplicate_uid');
    }
    $account = user_load($uid);
    if (!$account || empty($account->status)) {
      return array('error' => 'beneficiary_not_found');
    }
    $seen[$uid] = TRUE;
    if ($uid === (int) $scanner_uid) {
      $scanner_included = TRUE;
    }
    $sum += $pct;
    $shares[] = array('uid' => $uid, 'share_pct' => $pct);
  }

  if (!$scanner_included) {
    return array('error' => 'scanner_not_in_shares');
  }
  if (abs($sum - 100.0) > ROVAS_CIVIC_SHARE_PCT_TOLERANCE) {
    return array('error' => 'shares_pct_sum');
  }

  return array('shares' => $shares);
}

/**
 * Compute per-share VAT slices and Merits; residue ME to scanner.
 *
 * @return array
 *   List of uid, share_pct, vat_slice, merits_awarded, rounding_residue.
 */
function rovas_civic_compute_share_merits(array $shares, $vat_eur, $rate, $scanner_uid) {
  $total_me_exact = rovas_civic_merits_from_eur_slice($vat_eur, $rate);
  $rows = array();
  $floored_sum = 0.0;
  $vat_sum = 0.0;

  foreach ($shares as $s) {
    $vat_slice = round($vat_eur * $s['share_pct'] / 100.0, 4);
    $me_exact = rovas_civic_merits_from_eur_slice($vat_slice, $rate);
    $me_floor = rovas_civic_floor2($me_exact);
    $rows[] = array(
      'uid' => $s['uid'],
      'share_pct' => $s['share_pct'],
      'vat_slice' => $vat_slice,
      'merits_awarded' => $me_floor,
      'rounding_residue' => 0.0,
    );
    $floored_sum += $me_floor;
    $vat_sum += $vat_slice;
  }

  // Fix VAT slice residue on scanner (cents).
  $vat_residue = round($vat_eur - $vat_sum, 4);
  $me_residue = round($total_me_exact - $floored_sum, 6);

  foreach ($rows as &$row) {
    if ((int) $row['uid'] === (int) $scanner_uid) {
      $row['vat_slice'] = round($row['vat_slice'] + $vat_residue, 4);
      $row['merits_awarded'] = round($row['merits_awarded'] + $me_residue, 6);
      $row['rounding_residue'] = $me_residue;
      break;
    }
  }
  unset($row);

  return $rows;
}
