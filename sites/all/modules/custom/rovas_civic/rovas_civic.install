/**
 * Drop broken slash aliases (civic/claims, civic/national_hourly_rate).
 *
 * Services treats the first path segment as the resource name, so slash
 * aliases 404. Paths are machine names: /rovas/civic_claims,
 * /rovas/civic_national_hourly_rate.
 */
function rovas_civic_update_7004() {
  if (function_exists('rovas_civic_ensure_services_resources')) {
    rovas_civic_ensure_services_resources();
  }
  return t('Civic Services resources re-saved without slash aliases.');
}

