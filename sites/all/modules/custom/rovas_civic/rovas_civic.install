        'not null' => TRUE,
      ),
      'uid' => array(
        'description' => 'Recipient (donor) uid.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'amount' => array(
        'type' => 'numeric',
        'precision' => 18,
        'scale' => 6,
        'not null' => TRUE,
        'default' => 0,
      ),
      'project_nid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'source_type' => array(
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ),
      'source_id' => array(
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ),
      'description' => array(
        'type' => 'text',
        'not null' => FALSE,
        'size' => 'big',
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
