/**
 * Implements hook_install().
 */
function rovas_civic_install() {
  // Run hook_node_insert after Rules verification reactions complete.
  module_set_weight('rovas_civic', 20);

  // Seed SK rate placeholder (admin should set real series).
  db_merge('rovas_national_hourly_rate')
    ->key(array('country_code' => 'SK'))
    ->fields(array(
      'rate_eur' => 7.5,
      'source' => 'seed (replace with official series)',
      'updated' => REQUEST_TIME,
    ))
    ->execute();
}

/**
 * Implements hook_enable().
 */
function rovas_civic_enable() {
  if (function_exists('rovas_civic_ensure_state_treasury')) {
    try {
      rovas_civic_ensure_state_treasury();
    }
    catch (Exception $e) {
      watchdog_exception('rovas_civic', $e);
    }
  }
  if (function_exists('rovas_civic_ensure_services_resources')) {
    try {
      rovas_civic_ensure_services_resources();
    }
    catch (Exception $e) {
      watchdog_exception('rovas_civic', $e);
    }
  }
}

/**
 * Enable VAT claim Services action + State Treasury bootstrap.
 */
function rovas_civic_update_7001() {
  if (function_exists('rovas_civic_ensure_state_treasury')) {
    rovas_civic_ensure_state_treasury();
  }
  if (function_exists('rovas_civic_ensure_services_resources')) {
    rovas_civic_ensure_services_resources();
  }
  // Ensure SK seed exists.
  $exists = db_query("SELECT 1 FROM {rovas_national_hourly_rate} WHERE country_code = :c", array(':c' => 'SK'))->fetchField();
  if (!$exists) {
    db_insert('rovas_national_hourly_rate')
      ->fields(array(
        'country_code' => 'SK',
        'rate_eur' => 7.5,
        'source' => 'seed (replace with official series)',
        'updated' => REQUEST_TIME,
      ))
      ->execute();
  }
  return t('Civic VAT claim resources and State Treasury bootstrap applied.');
}

/**
 * Enable Civic claim-read Services resources (list + summary).
 */
function rovas_civic_update_7002() {
  if (function_exists('rovas_civic_ensure_services_resources')) {
    rovas_civic_ensure_services_resources();
  }
  return t('Civic claim-read APIs (GET /rovas/civic_claims, /summary) enabled on rovas_endpoint.');
}

/**
 * Enable public national hourly rate Services resource.
 */
function rovas_civic_update_7003() {
  if (function_exists('rovas_civic_ensure_services_resources')) {
    rovas_civic_ensure_services_resources();
  }
  return t('Civic national hourly rate API (GET /rovas/civic_national_hourly_rate) enabled on rovas_endpoint.');
}

/**
 * Drop broken slash aliases (civic/claims, civic/national_hourly_rate).
 *
 * Services treats the first path segment as the resource name, so slash
 * aliases 404. Paths are machine names: /rovas/civic_claims,
 * /rovas/civic_national_hourly_rate.
 */
function rovas_civic_update_7004() {
  if (function_exists('rovas_civic_ensure_services_resources')) {
    rovas_civic_ensure_services_resources();
  }
  return t('Civic Services resources re-saved without slash aliases.');
}

