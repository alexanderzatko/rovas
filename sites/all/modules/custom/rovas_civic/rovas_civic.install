      'claim_id' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'beneficiary_uid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'share_pct' => array(
        'type' => 'numeric',
        'precision' => 8,
        'scale' => 4,
        'not null' => TRUE,
        'default' => 0,
      ),
      'vat_slice' => array(
        'type' => 'numeric',
        'precision' => 12,
        'scale' => 4,
        'not null' => TRUE,
        'default' => 0,
      ),
      'merits_awarded' => array(
        'type' => 'numeric',
        'precision' => 18,
        'scale' => 6,
        'not null' => TRUE,
        'default' => 0,
      ),
      'rounding_residue' => array(
        'type' => 'numeric',
        'precision' => 18,
        'scale' => 6,
        'not null' => TRUE,
        'default' => 0,
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('id'),
    'unique keys' => array(
      'claim_beneficiary' => array('claim_id', 'beneficiary_uid'),
    ),
    'indexes' => array(
      'beneficiary_uid' => array('beneficiary_uid'),
    ),
  );

  $schema['civic_work_report_reward'] = array(
    'description' => 'Civic volunteer WR reward preference (chrons vs merits after verification).',
    'fields' => array(
      'wr_nid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'reward_kind' => array(
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'chrons',
      ),
      'uid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'converted' => array(
        'description' => 'Unix time when CHR→ME conversion ran (0 = not yet).',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('wr_nid'),
    'indexes' => array(
      'uid' => array('uid'),
    ),
  );

  return $schema;
