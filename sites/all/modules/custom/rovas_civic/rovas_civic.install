/**
 * Volunteer report APIs + reward-preference table.
 */
function rovas_civic_update_7010() {
  if (!db_table_exists('civic_work_report_reward')) {
    $schema = rovas_civic_schema();
    db_create_table('civic_work_report_reward', $schema['civic_work_report_reward']);
  }
  if (function_exists('rovas_civic_ensure_services_resources')) {
    rovas_civic_ensure_services_resources();
  }
  return t('Civic volunteer APIs (my projects, search, NACE, create project/WR) enabled on rovas_endpoint.');
}

/**
 * CHR→ME on WR verification (A6 conversion after rules_verify_work_report).
 */
function rovas_civic_update_7011() {
  module_set_weight('rovas_civic', 20);
  if (db_table_exists('civic_work_report_reward') && !db_field_exists('civic_work_report_reward', 'converted')) {
    db_add_field('civic_work_report_reward', 'converted', array(
      'description' => 'Unix time when CHR→ME conversion ran (0 = not yet).',
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
    ));
  }
  return t('Civic CHR→ME on work-report verification (A6 conversion hook).');
}
