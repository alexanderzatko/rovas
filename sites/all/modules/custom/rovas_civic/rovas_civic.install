      'id' => array(
        'type' => 'serial',
        'not null' => TRUE,
      ),
      'receipt_uid' => array(
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ),
      'scanner_uid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'vat_eur' => array(
        'type' => 'numeric',
        'precision' => 12,
        'scale' => 4,
        'not null' => TRUE,
        'default' => 0,
      ),
      'total_merits' => array(
        'type' => 'numeric',
        'precision' => 18,
        'scale' => 6,
        'not null' => TRUE,
        'default' => 0,
      ),
      'merchant_name' => array(
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ),
      'purchase_at' => array(
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ),
      'hourly_wage_eur' => array(
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 4,
        'not null' => TRUE,
        'default' => 0,
      ),
      'formula_version' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 1,
      ),
      'treasury_nid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'created' => array(
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
