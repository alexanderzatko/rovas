<?php

function rovas_priv_message_form_alter(&$form, &$form_state, $form_id) {
	if ($form['#id'] == 'privatemsg-form-reply') {
	
		$participants = $form_state['build_info']['args'][0]['participants'];
	
		$show = 1;
	
		foreach ($participants as $cipok => $cipov) {
			if($cipok == 'user_1') {
				$show = 0;
				break;
			}
		}
	
		if ($show == 0) {
			$form['reply'] = '';
			$form['body'] = '';
			$form['actions'] = '';
		}
	}
}