function _rrf_validate_adr_zip($element, &$form_state, $form) {
	$lang = $form['field_work_evidence']['#language'];
	if  ($form_state['input']['field_work_evidence'][$lang][2] == 2 && empty($form_state['input']['field_address'][LANGUAGE_NONE][0]['field_postal_code'][LANGUAGE_NONE][0]['value'])) {
