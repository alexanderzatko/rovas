<?php

/**
 * Implements hook_menu().
 */
function rovas_report_form_menu() {
  $items['rovas/report-photo-paint'] = array(
    'title' => 'Save painted proof photo',
    'page callback' => 'rovas_report_form_photo_paint_save',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_CALLBACK,
  );
  $items['rovas/report-photo-source'] = array(
    'title' => 'Proof photo original URL',
    'page callback' => 'rovas_report_form_photo_paint_source',
    'access callback' => 'user_is_logged_in',
    'type' => MENU_CALLBACK,
  );
  return $items;
}

/**
 * AJAX: return the original (full-size) public URL for a managed proof photo.
 */
function rovas_report_form_photo_paint_source() {
  drupal_add_http_header('Content-Type', 'application/json; charset=utf-8');

  $token = isset($_GET['token']) ? (string) $_GET['token'] : '';
  if (!drupal_valid_token($token, 'rovas_report_photo_paint')) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'invalid_token'));
    drupal_exit();
  }

  $fid = isset($_GET['fid']) ? (int) $_GET['fid'] : 0;
  $file = $fid > 0 ? file_load($fid) : FALSE;
  if (!$file || empty($file->uri)) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'not_found'));
    drupal_exit();
  }

  global $user;
  $allowed = ((int) $file->uid === (int) $user->uid)
    || user_access('administer files')
    || user_access('edit any work_report content');
  if (!$allowed) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'access_denied'));
    drupal_exit();
  }

  $url = file_create_url($file->uri);
  if (!$url) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'no_url'));
    drupal_exit();
  }

  drupal_json_output(array(
    'ok' => TRUE,
    'fid' => (int) $file->fid,
    'url' => $url,
  ));
  drupal_exit();
}

/**
 * AJAX: overwrite a managed proof photo with a client-painted JPEG.
 */
function rovas_report_form_photo_paint_save() {
  drupal_add_http_header('Content-Type', 'application/json; charset=utf-8');

  $token = isset($_POST['token']) ? (string) $_POST['token'] : '';
  if (!drupal_valid_token($token, 'rovas_report_photo_paint')) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'invalid_token'));
    drupal_exit();
  }

  $fid = isset($_POST['fid']) ? (int) $_POST['fid'] : 0;
  if ($fid < 1 || empty($_FILES['image']['tmp_name'])) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'invalid_input'));
    drupal_exit();
  }

  global $user;
  $file = file_load($fid);
  if (!$file || empty($file->uri)) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'not_found'));
    drupal_exit();
  }
  // Owner, or users who can administer files / edit any work report.
  $allowed = ((int) $file->uid === (int) $user->uid)
    || user_access('administer files')
    || user_access('edit any work_report content');
  if (!$allowed) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'access_denied'));
    drupal_exit();
  }

  $tmp = $_FILES['image']['tmp_name'];
  $size = isset($_FILES['image']['size']) ? (int) $_FILES['image']['size'] : 0;
  if ($size < 32 || $size > 8 * 1024 * 1024 || !is_uploaded_file($tmp)) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'invalid_image'));
    drupal_exit();
  }

  $bytes = file_get_contents($tmp);
  if ($bytes === FALSE || strlen($bytes) < 32) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'read_failed'));
    drupal_exit();
  }
  // Accept JPEG (paint export) and common originals if browser sends PNG.
  $mime = 'image/jpeg';
  if (substr($bytes, 0, 8) === "\x89PNG\r\n\x1a\n") {
    $mime = 'image/png';
  }
  elseif (substr($bytes, 0, 3) !== "\xFF\xD8\xFF") {
    drupal_json_output(array('ok' => FALSE, 'error' => 'unsupported_type'));
    drupal_exit();
  }

  if (file_unmanaged_save_data($bytes, $file->uri, FILE_EXISTS_REPLACE) === FALSE) {
    drupal_json_output(array('ok' => FALSE, 'error' => 'save_failed'));
    drupal_exit();
  }

  $file->filemime = $mime;
  $file->filesize = strlen($bytes);
  file_save($file);

  if (function_exists('image_path_flush')) {
    image_path_flush($file->uri);
  }

  $url = file_create_url($file->uri);
  drupal_json_output(array(
    'ok' => TRUE,
    'fid' => (int) $file->fid,
    'url' => $url ? $url : NULL,
  ));
  drupal_exit();
}

/**
 * Implements hook_form_FORM_ID_alter() for work_report_node_form.
 */
function rovas_report_form_form_work_report_node_form_alter(&$form, &$form_state, $form_id) {

//dsm($form_state);

	// Work report ID mirrors Project ID: show nid, not editable.
	if (isset($form['field_work_report_id'])) {
		$nid = !empty($form['nid']['#value']) ? (int) $form['nid']['#value'] : 0;
		if ($nid > 0) {
			$form['field_work_report_id'][LANGUAGE_NONE][0]['value']['#default_value'] = $nid;
		}
		$form['field_work_report_id'][LANGUAGE_NONE][0]['value']['#disabled'] = TRUE;
		$form['field_work_report_id'][LANGUAGE_NONE][0]['value']['#description'] = t('Assigned automatically when the work report is saved. Use this ID when filing a dispute.');
		if ($nid < 1) {
			// Not yet saved — hide until an ID exists.
			$form['field_work_report_id']['#access'] = FALSE;
		}
	}

	if (!in_array('_recalc_time',$form['#validate'])) {

		array_unshift($form['#validate'], '_recalc_time');

		$form['field_web_address'][LANGUAGE_NONE][0]['#element_validate'][] = '_rrf_validate_www';
		$form['field_photos'][LANGUAGE_NONE][0]['#element_validate'][] = '_rrf_validate_pic';
		$form['field_location'][LANGUAGE_NONE]['#element_validate'][] = '_rrf_validate_loc';
		$form['field_rovas_report'][LANGUAGE_NONE]['#element_validate'][] = '_rrf_validate_rovrep';

		$form['field_address'][LANGUAGE_NONE][0]['field_country'][LANGUAGE_NONE]['#element_validate'][] = '_rrf_validate_adr_cntry';
		$form['field_address'][LANGUAGE_NONE][0]['field_address_1'][LANGUAGE_NONE]['#element_validate'][] = '_rrf_validate_adr_adr1';
		$form['field_address'][LANGUAGE_NONE][0]['field_city'][LANGUAGE_NONE]['#element_validate'][] = '_rrf_validate_adr_city';
		$form['field_address'][LANGUAGE_NONE][0]['field_postal_code'][LANGUAGE_NONE]['#element_validate'][] = '_rrf_validate_adr_zip';

	}

	$form['field_date']['und'][0]['#element_validate'][] = '_wr_date_check';

	$lang = $form['field_work_evidence']['#language'];
	$fhsname1 = 'field_work_evidence['.$lang.'][1]';
	$fhsname2 = 'field_work_evidence['.$lang.'][2]';
	$fhsname3 = 'field_work_evidence['.$lang.'][3]';
	$fhsname4 = 'field_work_evidence['.$lang.'][4]';
	$fhsname5 = 'field_work_evidence['.$lang.'][5]';

	//shows and makes required the particular proof type section depending on the choices made in the field_work_evidence
	$form['field_web_address']['#states'] = array(
		'visible' => array(
				':input[name="'. $fhsname1 .'"]' => array('checked' => TRUE),
			),
		'required' => array(
				':input[name="'. $fhsname1 .'"]' => array('checked' => TRUE),
			),
		);

	$form['field_address']['#states'] = array(
		'visible' => array(
				':input[name="'. $fhsname2 .'"]' => array('checked' => TRUE),
			),
		);

	$form['field_address'][LANGUAGE_NONE][0]['field_country']['#states'] = array(
		'required' => array(
				':input[name="'. $fhsname2 .'"]' => array('checked' => TRUE),
			),
		);

	$form['field_address'][LANGUAGE_NONE][0]['field_address_1']['#states'] = array(
		'required' => array(
				':input[name="'. $fhsname2 .'"]' => array('checked' => TRUE),
			),
		);

	$form['field_address'][LANGUAGE_NONE][0]['field_city']['#states'] = array(
		'required' => array(
				':input[name="'. $fhsname2 .'"]' => array('checked' => TRUE),
			),
		);

	$form['field_address'][LANGUAGE_NONE][0]['field_postal_code']['#states'] = array(
		'required' => array(
				':input[name="'. $fhsname2 .'"]' => array('checked' => TRUE),
			),
		);

	$form['locgroup'] = array(
		'#type' => 'fieldset',
		'#title' => t('Show the map'),
		'#weight' => 11,
		'#collapsible' => TRUE, 
		'#collapsed' => TRUE,
		'#states' => array(
			'visible' => array(
				':input[name="'. $fhsname3 .'"]' => array('checked' => TRUE),
			),
		),
	);
	
	$form['locgroup']['field_location'] = $form['field_location'];
	
	unset($form['field_location']);
	$form['field_location']['#language'] = LANGUAGE_NONE;

	$form['locgroup']['field_location']['#states'] = array(
		'required' => array(
				':input[name="'. $fhsname3 .'"]' => array('checked' => TRUE),
			),
		);

	$form['field_photos']['#states'] = array(
		'visible' => array(
				':input[name="'. $fhsname4 .'"]' => array('checked' => TRUE),
			),
		'required' => array(
				':input[name="'. $fhsname4 .'"]' => array('checked' => TRUE),
			),
		);

	$form['field_photos']['#weight'] = 13;
	// Client-side blackout paint (shown after the first proof photo is attached).
	$path = drupal_get_path('module', 'rovas_report_form');
	$form['field_photos']['#attached']['css'][] = $path . '/css/rovas-photo-paint.css';
	$form['field_photos']['#attached']['js'][] = $path . '/js/rovas-photo-paint.js';
	$form['field_photos']['#attached']['js'][] = array(
		'type' => 'setting',
		'data' => array(
			'rovasPhotoPaint' => array(
				'saveUrl' => url('rovas/report-photo-paint'),
				'sourceUrl' => url('rovas/report-photo-source'),
				'token' => drupal_get_token('rovas_report_photo_paint'),
				'noteTitle' => t('Public proof photos'),
				'note' => t('Proofs of work are visible to the public, so we encourage you to review and redact sensitive information from the images using the paint tools provided here.'),
				'noteHint' => t('Use "Black out areas" under each photo to cover names, emails, or phones with a black marker.'),
				'noteOk' => t('Got it'),
				'btnLabel' => t('Black out areas'),
				'btnHint' => t('Opens a marker tool to black out sensitive parts of this image.'),
				'brushLabel' => t('Marker size'),
				'undoLabel' => t('Undo'),
				'clearLabel' => t('Clear marks'),
				'applyLabel' => t('Apply'),
				'cancelLabel' => t('Cancel'),
				'savingLabel' => t('Saving…'),
				'loadingLabel' => t('Loading full image…'),
				'errorLabel' => t('Could not save. Try again.'),
				'loadErrorLabel' => t('Could not load the full image.'),
				'defaultBrush' => 24,
			),
		),
	);

	$form['field_rovas_report']['#weight'] = 14;
	$form['field_classification']['#weight'] = 15;
	$form['body']['#weight'] = 16;
	
	$form['field_rovas_report']['#states'] = array(
		'visible' => array(
				':input[name="'. $fhsname5 .'"]' => array('checked' => TRUE),
			),
		'required' => array(
				':input[name="'. $fhsname5 .'"]' => array('checked' => TRUE),
			),
		);

	$lang = $form['field_hours_worked']['#language'];
	$default_old = $form['field_hours_worked'][$lang][0]['value']['#default_value'];
	$time_old = (is_numeric($default_old)) ? (float) $default_old : 0.0;

	$hrs_old_num = (int) floor($time_old);
	$hrs_old = ($hrs_old_num > 0) ? $hrs_old_num : '';
	$mds = ($time_old - $hrs_old_num) * 60;
	$mins_old_num = (int) round($mds, 0);
	$mins_old = ($mins_old_num > 0) ? $mins_old_num : '';

	$form['labor_time'] = array(
		'#type' => 'fieldset',
		'#description' => t('Enter the time spent performing the reported activity'),
		'#title' => t('Time worked') . ' *',
		'#weight' => 3,
		'#element_validate' => array('_validate_labor_time'),
		'#attributes' => array('class' => array('labrtime')),
