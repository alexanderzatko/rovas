/**
 * Options callback for transaction types.
 */
function rovas_forex_transaction_types_options() {
  return array(
    'eur_to_chr' => t('EUR to CHR'),
    'chr_to_eur' => t('CHR to EUR'),
  );
}

/**
 * Action callback for forex calculation.
 */
function rovas_forex_calculate($input, $input_balance, $output_balance, $fee, $fixed_fee = 0) {
  $result = forex($input, $input_balance, $output_balance, $fee, $fixed_fee);
  
  return array(
    'calc_output' => $result['output'],
    'total_fee' => $result['fee'],
  );
}

/**
 * Action callback for forex transaction parameters calculation.
 */
function rovas_forex_transaction_params($transact_type, $input, $processor_fee = NULL, $charge_fees = TRUE) {
  $result = calculate_forex_transaction_params($transact_type, $input, $processor_fee, $charge_fees);
  
  return array(
    'eur_basket' => $result['eur_basket'],
    'chr_basket' => $result['chr_basket'],
    'variable_fee' => $result['xfee'],
    'output_amount' => $result['output'],
    'fixed_fee_amount' => $result['fixed_fee'],
    'use_temp_baskets' => $result['use_temp_baskets'],
    'regime' => isset($result['regime']) ? $result['regime'] : NULL,
    'rejected' => !empty($result['rejected']),
    'min_r' => isset($result['min_r']) ? $result['min_r'] : forex_min_r_get(),
    'effective_rate' => isset($result['effective_rate']) ? $result['effective_rate'] : NULL,
  );
}

/**
 * Rules action: apply trade and commit universal basket balances.
 */
function rovas_forex_apply_trade($transact_type, $input, $ch_basket, $eur_basket, $variable_fee = 0, $fixed_fee = 0, $ratchet_min_r = FALSE, $charge_fees = TRUE, $use_temp_baskets = FALSE) {
  $trade = rovas_forex_settle_trade($transact_type, $input, $ch_basket, $eur_basket, $variable_fee, $fixed_fee, $ratchet_min_r, $charge_fees, $use_temp_baskets);
  return array(
    'output_amount' => isset($trade['output']) ? $trade['output'] : 0,
    'new_ch_basket' => isset($trade['new_ch_basket']) ? $trade['new_ch_basket'] : $ch_basket,
    'new_eur_basket' => isset($trade['new_eur_basket']) ? $trade['new_eur_basket'] : $eur_basket,
    'trade_rejected' => !empty($trade['rejected']),
    'trade_regime' => isset($trade['regime']) ? $trade['regime'] : NULL,
  );
}


/**
 * Calculate merits purchased and unit price.
 *
 * @param float $buy_amount
 *   Amount in EUR.
 */
function rovas_forex_rules_action_calculate_merits_execute($buy_amount,$processor_fee = null, $charge_fees = TRUE) {
  $buy_amount = is_numeric($buy_amount) ? (float) $buy_amount : 0.0;
  if ($buy_amount <= 0) {
    return array(
      'merits_purchased' => 0,
      'unit_price' => 0,
    );
  }

  $forex_params = calculate_forex_transaction_params('eur_to_chr', $buy_amount,$processor_fee, $charge_fees);
  $chr_out = isset($forex_params['output']) ? (float) $forex_params['output'] : 0.0;
  if ($chr_out <= 0) {
    return array(
      'merits_purchased' => 0,
      'unit_price' => 0,
    );
  }

  $convary = rovas_purchase_shares_stripe_convertor($buy_amount, $chr_out);

  return array(
    'merits_purchased' => $convary['units'],
    'unit_price' => $convary['unit_price'],
  );
}

/**
 * Smallest EUR amount (major units) that yields at least one Merit at default fees.
 *
 * @return float
 */
function rovas_forex_minimum_eur_for_one_merit() {
  $lo = 0.01;
  $hi = 500.0;
  $probe = rovas_forex_rules_action_calculate_merits_execute($hi);
  if ($probe['merits_purchased'] < 1) {
    return 1.0;
  }
  for ($i = 0; $i < 45; $i++) {
    $mid = ($lo + $hi) / 2.0;
    $m = rovas_forex_rules_action_calculate_merits_execute($mid);
    if ($m['merits_purchased'] >= 1) {
      $hi = $mid;
    }
    else {
      $lo = $mid;
    }
  }
  return round($hi, 2);
}

/**
 * Create a Commerce order for buying Merits with euros (same line item rules as legacy forex flow).
 *
 * @param int $uid
 * @param float $euros
 *   Amount in major EUR units.
 * @param string|null $rpr_paytype
 *   One of pay-choice-card, pay-choice-bank, or NULL.
 *
 * @return object|null
 *   Saved commerce order, or NULL on failure.
 */
function rovas_forex_create_merits_eur_order($uid, $euros, $rpr_paytype = NULL) {
  if (!function_exists('commerce_order_new') || !function_exists('commerce_product_load_by_sku')) {
    return NULL;
  }
  $euros = is_numeric($euros) ? (float) $euros : 0.0;
  if ($euros <= 0) {
    return NULL;
  }
  $fp_submit = calculate_forex_transaction_params('eur_to_chr', $euros, NULL, TRUE);
  if (!isset($fp_submit['output']) || (float) $fp_submit['output'] <= 0) {
    return NULL;
  }

  $convary = rovas_forex_rules_action_calculate_merits_execute($euros);
  $merits = isset($convary['merits_purchased']) ? (int) $convary['merits_purchased'] : 0;
  $unit_price = isset($convary['unit_price']) ? (float) $convary['unit_price'] : 0.0;
  if ($merits < 1 || $unit_price <= 0) {
    return NULL;
  }

  $quantity = $merits;
  $fee_variable = variable_get('buy_ch_fee');
  $fee_fixed = variable_get('buy_ch_fixed_fee');
  $fee = $fee_fixed + $fee_variable * $quantity * $unit_price;
  $unit_price_cents = (int) round(100 * $unit_price);

  if ($unit_price_cents > 2147483647 || $quantity * $unit_price_cents > 2147483647) {
    return NULL;
  }

  $product_obj = commerce_product_load_by_sku('merits');
  if (!$product_obj) {
    return NULL;
  }
  $product_nid = $product_obj->product_id;

  $order = commerce_order_new($uid, 'checkout_checkout');
  commerce_order_save($order);

  $product = commerce_product_load($product_nid);
  $line_item = commerce_product_line_item_new($product, $quantity, $order->order_id);
  $line_item_wrapper = entity_metadata_wrapper('commerce_line_item', $line_item);
  $line_item_wrapper->commerce_unit_price->amount->set($unit_price_cents);
  $line_item_wrapper->commerce_unit_price->currency_code->set('EUR');

  if (!isset($line_item->data) || !is_array($line_item->data)) {
    $line_item->data = array();
  }
  $line_item->data['rpr_custom_unit_price'] = (int) $unit_price_cents;
  $line_item->data['rpr_custom_currency'] = 'EUR';

  commerce_line_item_rebase_unit_price($line_item);
  commerce_line_item_save($line_item);

  $order_wrapper = entity_metadata_wrapper('commerce_order', $order);
  $order_wrapper->commerce_line_items[] = $line_item;
  $order_wrapper->field_conversion_fee = $fee;
  $order_wrapper->field_payer_type = 'user';
  $order_wrapper->field_payment_recipient = $uid;

  if ($rpr_paytype !== NULL && $rpr_paytype !== '' && function_exists('_rovas_project_reward_commerce_method_for_rpr_paytype')) {
    $order->data['rpr_paytype'] = $rpr_paytype;
    $commerce_method = _rovas_project_reward_commerce_method_for_rpr_paytype($rpr_paytype);
    if ($commerce_method !== NULL) {
      $order->data['payment_method'] = $commerce_method;
      $order->data['rovas_payment_method'] = $commerce_method;
    }
  }

  commerce_order_save($order);
  commerce_cart_order_session_save($order->order_id);

  return commerce_order_load($order->order_id);
}

