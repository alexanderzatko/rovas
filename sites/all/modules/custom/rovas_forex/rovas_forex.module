/* 
* convert the fee to euro and assign it to the forex admin
* update the forex currency baskets
* the @conversion_fee -> transaction fee in Chrons
*/
function _process_fee_update_baskets ($conversion_fee) {

	//convert the conversion fee to Euros
	$forex_basket = variable_get('forex_baskets_temp');
	if ($forex_basket) {
		variable_set('forex_baskets',$forex_basket);
		variable_del('forex_baskets_temp');
	}
	$buy_eur_fee = variable_get('buy_eur_fee') ? variable_get('buy_eur_fee') : 0;

	$fee_trade = forex_apply_trade('chr_to_eur', $conversion_fee, $forex_basket['ch_basket'], $forex_basket['eur_basket'], $buy_eur_fee, 0.0, TRUE, TRUE, FALSE);
	$amnt_to_get = $fee_trade['output'];
	$fee_to_pay = $fee_trade['fee'];

	$new_basket = array(
	'ch_basket' => $fee_trade['new_ch_basket'],
	'eur_basket' => $fee_trade['new_eur_basket'],
	);
	$forex_basket_temp = variable_set('forex_baskets_temp',$new_basket);

	$rovas_admin_uid = variable_get('rovas_admin_uid');

	$adm_user = user_load($rovas_admin_uid);

	//put the conversion fee temporarily into the Rovas account
	$update_user_ch = rules_invoke_component(
		'rules_update_user_chron_account',
		1,
		$conversion_fee
	);

	//send the conversion fee money from the Rovas account to the Rovas Forex admin account.
	//This will create a money transfer record for the Rovas Forex admin
	$update_user_ch = rules_invoke_component(
		'rules_make_money_transfer',
		user_load(1),
		$adm_user,
		$conversion_fee,
		t('A fee received from forex conversion when a user bought Chrons.')
	);

	//convert the fee into euros
	$result_fee_proc = rules_invoke_component(
		'rules_process_forex_order',
		$rovas_admin_uid,
		'chrons_to_euros',
		$conversion_fee, //CH paid
		$amnt_to_get, //EUR received
		$fee_to_pay,
		$forex_basket['ch_basket'],
		$forex_basket['eur_basket'],
		0,
		0
	);
	
	return $result_fee_proc;
	
}

/*
* needed to get PayPal credentials from a protected object in the rules config
*/
function accessProtected($obj, $prop) {
  $reflection = new ReflectionClass($obj);
  $property = $reflection->getProperty($prop);
  $property->setAccessible(true);
  return $property->getValue($obj);
}

/**
 * @param string      $transactType  'chr_to_eur' | 'eur_to_chr' (default 'eur_to_chr').
 * @param float       $input         Input amount.
 * @param float				$processor_fee Payment processor fee
*/
function calculate_forex_transaction_params ($transactType, $input, $processor_fee = null, $charge_fees = TRUE) {

    $base_buy_ch_fee = variable_get('base_buy_ch_fee');
    $baskets = forex_load_basket_balances(TRUE);
    $chBasket = $baskets['ch_basket'];
    $eurBasket = $baskets['eur_basket'];
    $useTempBaskets = $baskets['use_temp_baskets'];

    $type = strtolower($transactType);
    $type = ($type === 'chr_to_eur') ? 'chr_to_eur' : 'eur_to_chr';

    $variableFee = 0.0;
    $fixedFee    = 0.0;
    $output      = 0.0;
    $regime = 'blocked';
    $rejected = FALSE;
    $reject_reason = NULL;
    $effective_rate = NULL;
    $fee_amount = 0.0;

    if ($type === 'chr_to_eur') {
    	if ($charge_fees) {
				$variableFee = (float) variable_get('buy_eur_fee');
				$fixedFee    = 0.0;	
			}
			$quote = forex_price_chr_to_eur($input, $chBasket, $eurBasket, $variableFee, $fixedFee);
			$output = isset($quote['output']) ? (float) $quote['output'] : 0.0;
			$fee_amount = isset($quote['fee']) ? (float) $quote['fee'] : 0.0;
			$regime = isset($quote['regime']) ? $quote['regime'] : 'blocked';
			$rejected = !empty($quote['rejected']);
			$reject_reason = isset($quote['reject_reason']) ? $quote['reject_reason'] : NULL;
			$effective_rate = isset($quote['effective_rate']) ? $quote['effective_rate'] : NULL;
    }
    else {
    	if ($charge_fees) {
				if ($processor_fee) {
					$variableFee = $base_buy_ch_fee;
					$fixedFee    = $processor_fee < 0 ? 0 : $processor_fee;
				}
				else {
					$variableFee = (float) variable_get('buy_ch_fee');
					$fixedFee    = (float) variable_get('buy_ch_fixed_fee');
				}
			}
			$quote = forex_price_eur_to_chr($input, $chBasket, $eurBasket, $variableFee, $fixedFee);
			$output = isset($quote['output']) ? (float) $quote['output'] : 0.0;
			$fee_amount = isset($quote['fee']) ? (float) $quote['fee'] : 0.0;
			$regime = isset($quote['regime']) ? $quote['regime'] : 'blocked';
			$rejected = !empty($quote['rejected']);
			$reject_reason = isset($quote['reject_reason']) ? $quote['reject_reason'] : NULL;
			$effective_rate = isset($quote['effective_rate']) ? $quote['effective_rate'] : NULL;
    }

    return array(
			'eur_basket'       => (float) $eurBasket,
			'chr_basket'       => (float) $chBasket,
			'xfee'             => (float) $variableFee,
			'output'           => (float) $output,
			'fixed_fee'        => (float) $fixedFee,
			'fee'              => (float) $fee_amount,
			'use_temp_baskets' => $useTempBaskets,
			'regime'           => $regime,
			'rejected'         => $rejected,
			'reject_reason'    => $reject_reason,
			'min_r'            => forex_min_r_get(),
			'effective_rate'   => $effective_rate,
    );
}


