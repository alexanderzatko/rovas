	$form['ch-eu']['convert-ch-eu'] = array(
		'#type' => 'button',
		'#name' => 'con_ch_eu',
		'#button_type' => 'button',
//		'#value' => t('recalculate'),
		'#value' => '<span class="glyphicon glyphicon-refresh"> </span>',
		"#submit" => array(),
		'#ajax' => array(
			'callback' => '_convert_ch_eu',
			'effect' => 'fade',
			),
		);

		$buy_ch_fee = variable_get('buy_ch_fee');
		$buy_ch_fixed_fee = variable_get('buy_ch_fixed_fee');
		if(empty($form_state['input']['ch-eu_value'])) {
			$eur_paid = 1;
