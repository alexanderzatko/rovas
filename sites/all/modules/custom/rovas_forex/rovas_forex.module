		'#description' => 'The fee charged when converting CH to Eur',
		'#default_value' => $buy_eur_fee,
		'#size' => 60, 
		'#maxlength' => 128, 
		'#required' => TRUE,
	);

	$base_buy_ch_fee = variable_get('base_buy_ch_fee') ? variable_get('base_buy_ch_fee') : 0;

	$form['base_buy_ch_fee'] = array(
		'#type' => 'textfield',
		'#title' => 'Rovas base fee [multiplier]',
		'#description' => 'The Rovas base fee used when converting Eur to CH',
		'#default_value' => $base_buy_ch_fee,
		'#size' => 60, 
		'#maxlength' => 128, 
		'#required' => TRUE,
	);

	$buy_ch_fee = variable_get('buy_ch_fee') ? variable_get('buy_ch_fee') : 0;

	$form['buy_ch_fee'] = array(
		'#type' => 'textfield',
		'#title' => 'Buy Chrons fee [multiplier]',
		'#description' => 'The default payment processor <strong>variable fee</strong> + Rovas base fee, charged when converting Eur to CH. <br>Used for estimated forex calculations, given the variability of fees for various payment methods.',
		'#default_value' => $buy_ch_fee,
		'#size' => 60, 
		'#maxlength' => 128, 
		'#required' => TRUE,
	);

	$buy_ch_fixed_fee = variable_get('buy_ch_fixed_fee') ? variable_get('buy_ch_fixed_fee') : 0;

	$form['buy_ch_fixed_fee'] = array(
		'#type' => 'textfield',
		'#title' => 'Buy Chrons fixed fee [€]',
		'#description' => 'The default payment processor <strong>fixed portion of the fee</strong>, charged when converting Eur to CH. <br>Used for estimated forex calculations, given the variability of fees for various payment methods.',
		'#default_value' => $buy_ch_fixed_fee,
		'#size' => 60, 
		'#maxlength' => 128, 
		'#required' => TRUE,
	);

	$form['adjust_chrons'] = array(
		'#type' => 'textfield',
		'#title' => 'Adjust the Chrons basket amount',
		'#description' => 'Add or subtract Chron in the basket',
