/* 
* convert the fee to euro and assign it to the forex admin
* update the forex currency baskets
* the @conversion_fee -> transaction fee in Chrons
*/
function _process_fee_update_baskets ($conversion_fee) {

	//convert the conversion fee to Euros
	$forex_basket = variable_get('forex_baskets_temp');
	if ($forex_basket) {
		variable_set('forex_baskets',$forex_basket);
		variable_del('forex_baskets_temp');
	}
	$buy_ch_fee = variable_get('buy_ch_fee') ? variable_get('buy_ch_fee') : 0;
	$buy_ch_fixed_fee = variable_get('buy_ch_fixed_fee') ? variable_get('buy_ch_fixed_fee') : 0;

	$to_receive_ary = forex($conversion_fee,$forex_basket['ch_basket'],$forex_basket['eur_basket'],$buy_ch_fee,$buy_ch_fixed_fee);
	$amnt_to_get = $to_receive_ary['output'];
	$fee_to_pay = $to_receive_ary['fee']; //in EUR

	$new_basket = array(
	'ch_basket' => $forex_basket['ch_basket'] + $conversion_fee,
	'eur_basket' => $forex_basket['eur_basket'] - $amnt_to_get - $fee_to_pay
	);
	$forex_basket_temp = variable_set('forex_baskets_temp',$new_basket);

	$rovas_admin_uid = variable_get('rovas_admin_uid');

	$adm_user = user_load($rovas_admin_uid);

	//put the conversion fee temporarily into the Rovas account
	$update_user_ch = rules_invoke_component(
		'rules_update_user_chron_account',
		1,
		$conversion_fee
	);

	//send the conversion fee money from the Rovas account to the Rovas Forex admin account.
	//This will create a money transfer record for the Rovas Forex admin
	$update_user_ch = rules_invoke_component(
		'rules_make_money_transfer',
		user_load(1),
		$adm_user,
		$conversion_fee,
		t('A fee received from forex conversion when a user bought Chrons.')
	);

	//convert the fee into euros
	$result_fee_proc = rules_invoke_component(
		'rules_process_forex_order',
		$rovas_admin_uid,
		'chrons_to_euros',
		$conversion_fee, //CH paid
		$amnt_to_get, //EUR received
		$fee_to_pay,
		$forex_basket['ch_basket'],
		$forex_basket['eur_basket'],
		0,
		0
	);
	
	return $result_fee_proc;
	
}

/*
* needed to get PayPal credentials from a protected object in the rules config
*/
function accessProtected($obj, $prop) {
  $reflection = new ReflectionClass($obj);
  $property = $reflection->getProperty($prop);
  $property->setAccessible(true);
  return $property->getValue($obj);
}

/**
 * @param string      $transactType  'chr_to_eur' | 'eur_to_chr' (default 'eur_to_chr').
 * @param float       $input         Input amount.
 * @param float				$processor_fee Payment processor fee
*/
function calculate_forex_transaction_params ($transactType, $input, $processor_fee = null, $charge_fees = TRUE) {

    $forexBaskets    = variable_get('forex_baskets');
    $base_buy_ch_fee = variable_get('base_buy_ch_fee');

		//very unlikely - we do not have forex baskets
    if (empty($forexBaskets) || !is_array($forexBaskets)) {
			$chInit  = (float) variable_get('ch_basket_init');
			$eurInit = (float) variable_get('eu_basket_init');
			$forexBaskets = array(
					'ch_basket'  => $chInit,
					'eur_basket' => $eurInit,
			);
			variable_set('forex_baskets', $forexBaskets);
    }

    // use temp baskets if lock is set
    $forexBasketsTemp  = (array) variable_get('forex_baskets_temp');
    $lockTs            = (array) variable_get('forex_lock');
    $lockTimeRemaining = isset($lockTs['time']) ? ((int)$lockTs['time']) - (time() - 5 * 60) : -1;
    $lockUserId        = isset($lockTs['uid']) ? $lockTs['uid'] : null;

    global $user;

    $useTempBaskets = ($lockTimeRemaining > 0) && ($lockUserId != $user->uid) ? 1 : 0;

    if ($useTempBaskets) {
			$chBasket  = isset($forexBasketsTemp['ch_basket'])  ? (float)$forexBasketsTemp['ch_basket']
								 : (isset($forexBaskets['ch_basket'])     ? (float)$forexBaskets['ch_basket'] : 0.0);
			$eurBasket = isset($forexBasketsTemp['eur_basket']) ? (float)$forexBasketsTemp['eur_basket']
								 : (isset($forexBaskets['eur_basket'])    ? (float)$forexBaskets['eur_basket'] : 0.0);
    }
    else {
			$chBasket  = isset($forexBaskets['ch_basket'])  ? (float)$forexBaskets['ch_basket']  : 0.0;
			$eurBasket = isset($forexBaskets['eur_basket']) ? (float)$forexBaskets['eur_basket'] : 0.0;
    }

    $type = strtolower($transactType);
    $type = ($type === 'chr_to_eur') ? 'chr_to_eur' : 'eur_to_chr';

    $variableFee = 0.0;
    $fixedFee    = 0.0;
    $output      = 0.0;

    if ($type === 'chr_to_eur') {
    	if ($charge_fees) {
				$variableFee = (float) variable_get('buy_eur_fee');
				$fixedFee    = 0.0;	
			}
			else {
				$variableFee = 0.0;
				$fixedFee    = 0.0;
			}
			$res    = forex($input, $chBasket, $eurBasket, $variableFee, $fixedFee);
			$output = isset($res['output']) ? (float) $res['output'] : 0.0;
    }
    else {
    	if ($charge_fees) {
				if ($processor_fee) {
					$variableFee = $base_buy_ch_fee;
					$fixedFee    = $processor_fee < 0 ? 0 : $processor_fee; //negative values (like -1) indicate payment methods that do not charge fees (like bank transfer)
				}
				else {
					$variableFee = (float) variable_get('buy_ch_fee');
					$fixedFee    = (float) variable_get('buy_ch_fixed_fee');
				}
			}
			else {
				$variableFee = 0.0;
				$fixedFee    = 0.0;
			}

			$res    = forex($input, $eurBasket, $chBasket, $variableFee, $fixedFee);
			$output = isset($res['output']) ? (float) $res['output'] : 0.0;
    }

    return array(
			'eur_basket'       => (float) $eurBasket,
			'chr_basket'       => (float) $chBasket,
			'xfee'             => (float) $variableFee,
			'output'           => (float) $output,
			'fixed_fee'        => (float) $fixedFee,
			'use_temp_baskets' => $useTempBaskets,
    );
}


/**
 * Implements hook_rules_action_info().
 */
function rovas_forex_rules_action_info() {
  return array(
    'rovas_forex_calculate' => array(
      'label' => t('Forex calculation'),
