	$form['ch-eu']['ch-eu-converted'] = array(
		'#type' => 'markup',
		'#prefix' => '<div id="ch-eu-converted">',
		'#suffix' => '</div>',
		'#markup' => number_format($ch_result,2,'.',' ') . '<span class="to-unit"> CH</span>',
	);

	//change the Preview order button to Refresh if another person is just submitting an order
	if ($time_remaining > 0 && $lock_user != $user->uid) {
		$btn_name = 'forex_refresh';
	}
	else {
		$btn_name = 'preview_ch_eu';
		$sub_explain = '';
	}	

	$form['ch-eu']['submit-explain'] = array(
		'#type' => 'markup',
		'#prefix' => '<div id="submit-explain">',
