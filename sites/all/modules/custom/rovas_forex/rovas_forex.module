 */

include_once 'rovas_forex.inc';

define('ROVAS_FOREX_CHR_TO_EUR_SUSPENDED', TRUE);

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 */
function rovas_forex_form_views_exposed_form_alter(&$form, &$form_state) {
  if (empty($form_state['view']) || $form_state['view']->name != 'forex_purchases') {
    return;
  }
  if (!module_exists('date_popup') || empty($form['created']['min']) || empty($form['created']['max'])) {
    return;
  }

  // Views exposes created[min]/[max] as strings; date_popup expects arrays.
  if (!empty($form_state['input'])) {
    _rovas_forex_normalize_created_exposed_input($form_state['input']);
  }

  array_unshift($form['#validate'], 'rovas_forex_forex_purchases_exposed_validate');
  _rovas_forex_date_popup_bound_element($form['created']['min'], t('From'));
  _rovas_forex_date_popup_bound_element($form['created']['max'], t('To'));
}

/**
 * Converts Views date filter strings to the structure date_popup expects.
 */
function _rovas_forex_normalize_created_exposed_input(array &$input) {
  if (empty($input['created']) || !is_array($input['created'])) {
    return;
  }

  foreach (array('min', 'max') as $bound) {
    if (!isset($input['created'][$bound]) || is_array($input['created'][$bound])) {
      continue;
    }
    $raw = $input['created'][$bound];
    if ($raw === '' || $raw === NULL) {
      $input['created'][$bound] = array('date' => '');
      continue;
    }
    $timestamp = is_numeric($raw) ? $raw : strtotime($raw);
    $input['created'][$bound] = array(
      'date' => $timestamp ? date('Y-m-d', $timestamp) : $raw,
    );
  }
}

/**
 * Replaces a Views exposed date textfield with a Date module pop-up calendar.
 */
function _rovas_forex_date_popup_bound_element(&$element, $title) {
  if (empty($element['#type']) || $element['#type'] != 'textfield') {
    return;
  }

  $default = '';
  if (!empty($element['#default_value'])) {
    $timestamp = is_numeric($element['#default_value'])
      ? $element['#default_value']
      : strtotime($element['#default_value']);
    if ($timestamp) {
      $default = date('Y-m-d H:i:s', $timestamp);
    }
  }

  $element = array(
    '#type' => 'date_popup',
    '#title' => $title,
    '#date_label_position' => 'invisible',
    '#default_value' => $default,
    '#date_format' => 'Y-m-d',
    '#date_year_range' => '-10:+0',
    '#weight' => isset($element['#weight']) ? $element['#weight'] : 0,
  );
}

/**
 * Ensures Views receives flat date strings for the created between filter.
 */
function rovas_forex_forex_purchases_exposed_validate($form, &$form_state) {
  foreach (array('min', 'max') as $bound) {
    if (!isset($form_state['values']['created'][$bound])) {
      continue;
    }
    $value = $form_state['values']['created'][$bound];
    if (is_array($value)) {
      $form_state['values']['created'][$bound] = !empty($value['date']) ? $value['date'] : '';
    }
  }
}

/**
 * Implementations of hook_menu().
 */
function rovas_forex_menu() {
  $items = array();

  $items['forex'] = array(
    'title' => t('Forex'),
    'description' => t('Exchange Chrons for national currency and vice versa'),
    'page callback' => 'drupal_get_form',
    'page arguments' => array('rovas_forex_form'),
    'access arguments' => array(array('full access')),
    'access callback' => 'forex_has_roles',
    'menu_name' => 'main-menu'
  );

  $items['admin/config/development/forex'] = array(
    'title' => t('Forex administration'),
    'description' => t('Administer Forex'),
    'page callback' => 'drupal_get_form',
    'page arguments' => array('forex_admin_form'),
    'access arguments' => array('access administration pages'),
    'menu_name' => 'management'
  );

	//do not allow users to see the cart page
  $items['cart']['page callback'] = 'checkout_redirect';
  $items['cart']['access callback'] = TRUE;

  return $items;
}

function checkout_redirect() {
	global $user;
	$has_order = commerce_cart_order_load($user->uid);

	if ($has_order)
		drupal_goto('/checkout');
	else
		drupal_goto('/');
}

//forex page access callback
function forex_has_roles() {
  global $user;

  if ($user->uid == 0) {
    return FALSE;
  }

  // Check if user has 'banned' role
  if (in_array('banned', $user->roles)) {
    return FALSE;
  }

  return TRUE;
}


