	);

	$form['ch-eu']['submit'] = array(
		'#type' => 'submit',
		'#name' => $btn_name,
		'#value' => $btn_label,
		'#prefix' => '<div id="eu-ch-subbutton">',
		'#suffix' => '</div>',
	);
*/
	return $form;

}

function rovas_preview_form($form, &$form_state) {

	if (isset($form_state['storage']['page_one_values'])) {
		$page_one_vals = $form_state['storage']['page_one_values'];
		$form_state['saved'] = $page_one_vals;
	}
	else {
		$page_one_vals = $form_state['saved'];
	 }

//dsm($form_state,'start');

	if ($form_state['values']['forex-rate'] === '0') {
		$forex_baskets = variable_get('forex_baskets');
		$ch_basket = $forex_baskets['ch_basket'];
		$eur_basket = $forex_baskets['eur_basket'];
	}
	else {
		$ch_basket = $form_state['values']['fx-baskets']['ch_basket'];
		$eur_basket = $form_state['values']['fx-baskets']['eur_basket'];

		$wma_string = $form_state['values']['wma-string'];
		$wmarray = explode('-',$wma_string);
		$projid = (int)$wmarray[2];

		$form['fx-baskets'] = array(
				'#type' => 'hidden',
				'#value' => $form_state['values']['fx-baskets']
			);
		
		$form['forex-rate'] = array(
				'#type' => 'hidden',
				'#value' => $form_state['values']['forex-rate']
			);
		
		$form['wma-string'] = array(
				'#type' => 'hidden',
				'#value' => $wma_string
			);
		
		$form['project_nid'] = array(
				'#type' => 'hidden',
				'#value' => $projid
			);	
	}

	switch ($form_state['clicked_button']['#name']) {
		//converting CH to EUR
		case 'preview_eu_ch':
			$buy_eur_fee = variable_get('buy_eur_fee');
			$curr2convert = $page_one_vals['eu-ch_value'];

			if($form_state['values']['forex-rate'] === '0') {
				$chr_quote = forex_price_chr_to_eur($curr2convert, $ch_basket, $eur_basket, $buy_eur_fee, 0.0);
				$to_receive_ary = array(
					'output' => isset($chr_quote['output']) ? $chr_quote['output'] : 0.0,
					'fee' => isset($chr_quote['fee']) ? $chr_quote['fee'] : 0.0,
				);
			}
			else {
				$to_receive_ary = project_forex($curr2convert,$ch_basket,$eur_basket,$buy_eur_fee);
			}

			$amnt_to_get = $to_receive_ary['output'];
			$fee_to_pay = $to_receive_ary['fee'];
			$effective_rate = round(($amnt_to_get + $fee_to_pay) / ($curr2convert/10),2);
			$input_unit = t('CH');
			$output_unit = t('EUR');
			$preview_note = '<span class="">' . t('The effective hourly wage for this conversion is') . ' <strong>' . number_format($effective_rate,2,'.',' ') . ' ' . t('Eur/hour') . '</strong>.</span>';
			$preview_submit_label = t('Submit order', array(), array('context' => 'Forex'));
			break;
		//converting EUR to CH
		case 'preview_ch_eu':
			$buy_ch_fee = variable_get('buy_ch_fee');
			$buy_ch_fixed_fee = variable_get('buy_ch_fixed_fee');
			
			$curr2convert = $page_one_vals['ch-eu_value'];
			$eur_quote = forex_price_eur_to_chr($curr2convert, $ch_basket, $eur_basket, $buy_ch_fee, $buy_ch_fixed_fee);
			$to_receive_ary = array(
				'output' => isset($eur_quote['output']) ? $eur_quote['output'] : 0.0,
				'fee' => isset($eur_quote['fee']) ? $eur_quote['fee'] : 0.0,
			);
			//rounding the chron amount down to whole numbers
			$amnt_to_get = round($to_receive_ary['output']); //whole Chrons
			$fee_to_pay = $to_receive_ary['fee']; //the euro value of the fee
			$ch_eu_rate = $curr2convert/$amnt_to_get; //ch/eur rounded rate
			$to_pay_eur = $amnt_to_get*$ch_eu_rate;


			global $user;

			$forex_product_nid = variable_get('forex_product_id');
			$quantity = $amnt_to_get; //chrons we are buying
			$unit_price = 100*($to_pay_eur / $quantity);

			//delete abandoned orders for this user
			$statuses = array_keys(commerce_order_statuses());
			$statuses2delete = array_diff($statuses,array('completed','checkout_complete','pending','processing'));
			foreach ($statuses2delete as $status) {
				$order = commerce_order_load_multiple(array(), array('uid' => $user->uid,'status' => $status));
				commerce_order_delete_multiple(array_keys($order));
			}

			// Create a new order in checkout
			$order = commerce_order_new($user->uid, 'checkout_checkout');
			commerce_order_save($order);

			//modify unit price of the product
			$product = entity_metadata_wrapper('commerce_product', $forex_product_nid);
			$product->commerce_price->amount->set($unit_price);
			$product->commerce_price->currency_code->set('EUR');
			$product->save();

			// Load whatever product represents the item the customer will be
			// paying for and create a line item for it.
			$product = commerce_product_load($forex_product_nid);
			$line_item = commerce_product_line_item_new($product, $quantity, $order->order_id);

			// Save the line item to get its ID.
			commerce_line_item_save($line_item);

			// Add the line item to the order
			$order_wrapper = entity_metadata_wrapper('commerce_order', $order);
			$order_wrapper->commerce_line_items[] = $line_item;
			//modify the order
			$order_wrapper->field_conversion_fee = $fee_to_pay;

			// Save the order again to update its line item reference field.
			commerce_order_save($order);

			drupal_goto('checkout/' . $order->order_id);

	}

	$summary = '<div class="preview summary">';
	$summary .= '<div class="preview title">';
	$summary .= '<span class="label">' . t('Order summary') . '</span>';
	$summary .= '</div>';
	$summary .= '<div class="preview paid">';
	$summary .= '<span class="label">' . t('To pay:') . '</span><span class="value">' . number_format($curr2convert,2,'.',' ') . '</span><span class="unit">' . $input_unit . '</span>';
	$summary .= '</div>';
	$summary .= '<div class="preview to_receive">';
	$summary .= '<span class="label">' . t('To receive:') . '</span><span class="value">' . number_format($amnt_to_get,2,'.',' ') . '</span><span class="unit">' . $output_unit . '</span>';
	$summary .= '</div>';
	$summary .= '</div>';
	$summary .= '<div class="preview note">';
	$summary .= $preview_note;
	$summary .= '</div>';

	$form['preview-wrapper'] = array(
		'#type' => 'markup',
		'#prefix' => '<div class="preview-wrapper">',
		'#suffix' => '</div>',
	);

	$form['preview-wrapper']['preview'] = array(
		'#type' => 'markup',
		'#markup' => $summary,
	);

	$lock_ts = variable_get('forex_lock');
	$locktime = format_date($lock_ts['time'] + 5*60,'custom','G:i','Europe/Bratislava');
	
	$order_explain = t('You have five guaranteed minutes (until @time) to complete this order.',array('@time'=> $locktime));

	$form['preview-wrapper']['order-explain'] = array(
		'#type' => 'markup',
		'#prefix' => '<div class="order-explain">',
		'#suffix' => '</div>',
		'#markup' => $order_explain,
	);

	$form['preview-wrapper']['cancel'] = array(
		'#name' => 'ord_cancel',
		'#type' => 'submit',
		'#value' => t('Cancel', array(), array('context' => 'Forex')),
	);

	$form['preview-wrapper']['input'] = array(
			'#type' => 'hidden',
			'#value' => $curr2convert
		);
	$form['preview-wrapper']['output'] = array(
			'#type' => 'hidden',
			'#value' => $amnt_to_get
		);
	$form['preview-wrapper']['fee'] = array(
			'#type' => 'hidden',
			'#value' => $fee_to_pay
		);

	$form['preview-wrapper']['conv-type'] = array(
			'#type' => 'hidden',
			'#value' => $form_state['clicked_button']['#name']
		);

	$form['preview-wrapper']['submit'] = array(
		'#name' => 'order_submit',
		'#type' => 'submit',
		'#attributes' => array('class' => array('btn-primary')),
		'#value' => $preview_submit_label,
	);

return $form;

}

function rovas_forex_form_submit($form, &$form_state) {
	global $user;
	$uid = $user->uid;

	switch (TRUE) {
		// preview_eu_ch -> converting CH to EUR
		// preview_ch_eu -> converting EUR to CH 
		case ($form_state['clicked_button']['#name'] == 'preview_eu_ch' || $form_state['clicked_button']['#name'] == 'preview_ch_eu'):
			if (ROVAS_FOREX_CHR_TO_EUR_SUSPENDED && $form_state['clicked_button']['#name'] == 'preview_eu_ch') {
				drupal_set_message(t('Chrons to Euros exchanges are temporarily suspended'), 'warning');
				$form_state['rebuild'] = TRUE;
				break;
			}
			//if another user has a lock already, we need to refresh the form instead of proceeding
			$lock_ts = variable_get('forex_lock') ? variable_get('forex_lock') : array('uid' => -1,'time' => 0);
			$time_remaining = $lock_ts['time'] - (time() - 5*60);
			$lock_user = $lock_ts['uid'];

			if ($time_remaining > 0 && $lock_user != $uid) {
				$form_state["rebuild"] = TRUE;
				break;
			}

			$form_state['storage']['page_two'] = TRUE;
			$form_state['storage']['page_one_values'] = $form_state['values'];
			$form_state["rebuild"] = TRUE;

			//updating the baskets to reflect this particular conversion
			if ($form_state['values']['forex-rate'] === '0') {
					$old_basket = variable_get('forex_baskets');
			}
				else {
					$old_basket = $form_state['values']['fx-baskets'];
			}

			if ($form_state['clicked_button']['#name'] == 'preview_eu_ch') {
				if ($form_state['values']['forex-rate'] === '0') {
					$buy_eur_fee = variable_get('buy_eur_fee');
					$chr_in = $form_state['values']['eu-ch_value'];
					$trade = forex_apply_trade('chr_to_eur', $chr_in, $old_basket['ch_basket'], $old_basket['eur_basket'], $buy_eur_fee, 0.0, TRUE, TRUE, FALSE);
					$new_basket = array(
						'ch_basket' => $trade['new_ch_basket'],
						'eur_basket' => $trade['new_eur_basket'],
					);
				}
				else {
					$new_basket = array(
					'ch_basket' => $old_basket['ch_basket'] - ($form_state['values']['eu-ch_value'] - $form_state['values']['eu-ch-fee']),
					'eur_basket' => $old_basket['eur_basket'] - $form_state['values']['eu-ch-converted-value']
					);
				}
			}
			else {
				$buy_ch_fee = variable_get('buy_ch_fee');
				$buy_ch_fixed_fee = variable_get('buy_ch_fixed_fee');
				$eur_in = $form_state['values']['ch-eu_value'];
				$trade = forex_apply_trade('eur_to_chr', $eur_in, $old_basket['ch_basket'], $old_basket['eur_basket'], $buy_ch_fee, $buy_ch_fixed_fee, FALSE, TRUE, FALSE);
				$new_basket = array(
					'ch_basket' => $trade['new_ch_basket'],
					'eur_basket' => $trade['new_eur_basket'],
				);
			}
			variable_set('forex_lock',array('uid' => $uid, 'time' => time()));
			variable_set('forex_baskets_temp',$new_basket); //to be liquidated when forex_lock expires

			break;
		case ($form_state['clicked_button']['#name'] == 'order_submit'):

			//the choice of the forex rate determines the "order" parameter of the rules_process_forex_order call
			if (isset($form_state['values']['forex-rate']) && $form_state['values']['forex-rate'] != '0') {

				$wma_string = $form_state['values']['wma-string'];
				$wmarray = explode('-',$wma_string);
				$projid = -1 * (int)$wmarray[2];
 
				$forex_basket_old = $form_state['values']['fx-baskets'];
 			}
			else {
				$forex_basket_old = variable_get('forex_baskets');

				$projid = 0;
			}

			$forex_lock = variable_get('forex_lock');

			//first let's make sure the lock is still ours
			//we pass the project nid via the "order" parameter of the rules_process_forex_order as a negative number
			if ($forex_lock['uid'] == $uid) {
				$result = rules_invoke_component(
					'rules_process_forex_order',
					$uid,
					'chrons_to_euros',
					$form_state['values']['input'],
					$form_state['values']['output'],
					$form_state['values']['fee'],
					$forex_basket_old['ch_basket'],
					$forex_basket_old['eur_basket'],
					$projid,
					0
				);
				$the_message = NULL;

				if (isset($form_state['values']['forex-rate']) && $form_state['values']['forex-rate'] != '0') {
	
					$project_nid = $form_state['values']['project_nid'];
	
					forex_complete_order_fxs ($the_message,'/forex',$project_nid);
				}
				else {
					forex_complete_order($the_message,'/forex');
				}

			}
			else {
				$the_message = t('Your order was not completed within the allowed time.') . '<br>' . t('Please try again with a new order');
			}
			lost_lock($the_message);
			break;
		case ($form_state['clicked_button']['#name'] == 'ord_cancel'):
			lost_lock();
			break;
		case ($form_state['clicked_button']['#name'] == 'buy_merits_start'):
			drupal_goto('rewpro', array('query' => array(
				'paytype' => 'buymerits',
				'recipient' => $uid,
			)));
			break;
		default : //user clicked the refresh button
			$form_state["rebuild"] = TRUE;
	}
}

