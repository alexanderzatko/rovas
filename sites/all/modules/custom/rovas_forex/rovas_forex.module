/*
grant merits to self-rewarding user
it is expected the @chrons parameter is a negative number, in order to subtract from the user's Chron account
*/
function _rovas_forex_grant_merits($user,$merits,$chrons) {

	$uid = $user->uid;

	//spend and destroy the Chrons
	$reschr = rules_invoke_component('rules_update_user_chron_account',$user,$chrons);

	//grant Merits to the buyer
	$description = t('Purchase of Merits for Chrons');
	$rewent = $user; //the user is the REWarded ENTity as they are rewarding themselves
	$rewent = entity_metadata_wrapper('user', $user);
	$resmerusr = rules_invoke_component('rules_give_merits_to_user',$user,$merits,$rewent,$description,'Insert');
	
	//create Merit purchase record
	$note = '';
	$merprec = rules_invoke_component('rules_create_merit_purchase_record',$user,$merits,$note);

	//create Merit disbursement record
	$merdibrec = rules_invoke_component('rules_create_merit_disbursement',$merprec[0],$uid,$merits);

	//update the user expertise
	$nace_areas = _rb_user_time_in_nace_codes($uid);
	
	foreach ($nace_areas as $labl => $nace_tid) {
		$cat = $labl;
		$time_share = $nace_tid['percent'];
		$rndsum = round($merits*$time_share);
		if ($rndsum > 0){
			$result = rules_invoke_component('rules_update_user_expertise',$time_share,$merits,$cat,$uid);
		}
	}

}

//for the current user, deletes the lock and temp basket
function lost_lock($message = NULL) {
	global $user;
	$forex_lock = variable_get('forex_lock');
	if ($forex_lock['uid'] == $user->uid) {
		variable_del('forex_lock');
		variable_del('forex_baskets_temp');
	}
	if (is_null($message)) {$message = t('Order canceled');}
	drupal_set_message($message);

	//deleting the canceled order
	$order = commerce_cart_order_load($user->uid);
	if (isset($order->order_number)) {
		$ordr_id = $order->order_number;
		$order = commerce_order_load_multiple(array($ordr_id));

		//if time shares are purchased, return to the "Project investing" page
		$paymentRecipient = $order[$ordr_id]->field_payment_recipient[LANGUAGE_NONE][0]['value'];
		$lineItemID = $order[$ordr_id]->commerce_line_items[LANGUAGE_NONE][0]['line_item_id'];
		$lineItem = commerce_line_item_load($lineItemID);
		
		$productID = $lineItem->commerce_product['und'][0]['product_id'];

		if ($productID == 2) {
			$destination = '/rewpro?paytype=buyshares&recipient=' . $paymentRecipient;
		}
		else {
			$destination = '/forex';
		}

		commerce_order_delete_multiple(array_keys($order));
	}
	else {
		$destination = '/forex';
	}
	drupal_goto($destination);
}

//for the current user, deletes the lock and temp basket
function forex_complete_order($message = NULL, $path = NULL) {
	$forex_basket = variable_get('forex_baskets_temp');
	
	if ($message) {
		drupal_set_message($message, 'status', FALSE);
	}

	// Exit early if forex_baskets_temp is empty or doesn't exist
	if (empty($forex_basket)) {
		if ($path) {
			drupal_goto($path);
		}
		return;
	}
	
	variable_set('forex_baskets', $forex_basket);
	variable_del('forex_baskets_temp');
	variable_del('forex_lock');
	
	if ($path) {
		drupal_goto($path);
	}
}

/*
for the current user
	- deletes the lock and temp basket
	- updates the sandbox project baskets
*/
function forex_complete_order_fxs ($message = NULL, $path=NULL,$project_nid) {
	$forex_basket = variable_get('forex_baskets_temp');

	//update the project baskets
	$projob = entity_metadata_wrapper('node', $project_nid);
	$projob->field_euro_basket->set($forex_basket['eur_basket']);
	$projob->field_chron_basket->set($forex_basket['ch_basket']);
	$projob->save();

	variable_del('forex_baskets_temp');
	variable_del('forex_lock');
	if ($message) {drupal_set_message($message,'status',FALSE);}
	if ($path) {drupal_goto($path);}
}

/**
 * Read the minR floor (EUR per reported hour; 10 CHR = 1 hour).
 */
function forex_min_r_get() {
  $min_r = variable_get('forex_min_r');
  return is_numeric($min_r) ? (float) $min_r : 0.0;
}

/**
 * Persist minR (admin initial value or ratcheted floor).
 */
function forex_min_r_set($min_r) {
  variable_set('forex_min_r', max(0.0, (float) $min_r));
}

/**
 * Ratchet minR up on worker CHR→EUR trades only.
 */
function forex_min_r_ratchet($eur_out, $chr_in) {
  if ($chr_in <= 0) {
    return forex_min_r_get();
  }
  $computed = 10.0 * (float) $eur_out / (float) $chr_in;
  $new_min_r = max(forex_min_r_get(), $computed);
  forex_min_r_set($new_min_r);
  return $new_min_r;
}

/**
 * Synthetic CHR pool depth for liability-side Bancor (donor EUR→CHR).
 */
function forex_synthetic_chr_depth($ch_basket) {
  return abs((float) $ch_basket) + 1.0;
}

/**
 * Synthetic CHR depth when a worker CHR→EUR trade stays in liability.
 */
function forex_synthetic_worker_chr_depth($ch_basket, $chr_in) {
  return abs((float) $ch_basket + (float) $chr_in) + 1.0;
}

/**
 * Whether universal baskets are at the 0/0 bootstrap point.
 */
function forex_is_bootstrap_state($ch_basket, $eur_basket) {
  return ((float) $ch_basket == 0.0) && ((float) $eur_basket == 0.0);
}

/**
 * Effective hourly rate: EUR per reported hour (10 CHR = 1 hour).
 */
function forex_effective_hourly_rate($eur_amount, $chr_amount) {
  if ($chr_amount <= 0) {
    return NULL;
  }
  return (float) $eur_amount / ((float) $chr_amount / 10.0);
}

/**
 * EUR remaining after variable and fixed fees (donor leg).
 */
function forex_eur_net_after_fees($eur_in, $variable_fee, $fixed_fee) {
  $eur_in = (float) $eur_in;
  if ($eur_in <= 0) {
    return 0.0;
  }
  $fx = forex($eur_in, max($eur_in, 1e-9), 1.0, $variable_fee, $fixed_fee);
  $fee = isset($fx['fee']) ? (float) $fx['fee'] : 0.0;
  return $eur_in - $fee;
}

/**
 * Load current universal basket balances, respecting forex lock temp baskets.
 *
 * @return array
 *   Keys: ch_basket, eur_basket, use_temp_baskets.
 */
function forex_load_basket_balances($respect_lock = TRUE) {
  $forex_baskets = variable_get('forex_baskets');
  if (empty($forex_baskets) || !is_array($forex_baskets)) {
    $forex_baskets = array(
      'ch_basket' => (float) variable_get('ch_basket_init'),
      'eur_basket' => (float) variable_get('eu_basket_init'),
    );
    variable_set('forex_baskets', $forex_baskets);
  }

  $use_temp = 0;
  if ($respect_lock) {
    $forex_baskets_temp = (array) variable_get('forex_baskets_temp');
    $lock_ts = (array) variable_get('forex_lock');
    $lock_time_remaining = isset($lock_ts['time']) ? ((int) $lock_ts['time']) - (time() - 5 * 60) : -1;
    $lock_user_id = isset($lock_ts['uid']) ? $lock_ts['uid'] : NULL;
    global $user;
    $use_temp = ($lock_time_remaining > 0) && ($lock_user_id != $user->uid) ? 1 : 0;

    if ($use_temp) {
      $ch_basket = isset($forex_baskets_temp['ch_basket'])
        ? (float) $forex_baskets_temp['ch_basket']
        : (isset($forex_baskets['ch_basket']) ? (float) $forex_baskets['ch_basket'] : 0.0);
      $eur_basket = isset($forex_baskets_temp['eur_basket'])
        ? (float) $forex_baskets_temp['eur_basket']
        : (isset($forex_baskets['eur_basket']) ? (float) $forex_baskets['eur_basket'] : 0.0);
      return array(
        'ch_basket' => $ch_basket,
        'eur_basket' => $eur_basket,
        'use_temp_baskets' => $use_temp,
      );
    }
  }

  return array(
    'ch_basket' => isset($forex_baskets['ch_basket']) ? (float) $forex_baskets['ch_basket'] : 0.0,
    'eur_basket' => isset($forex_baskets['eur_basket']) ? (float) $forex_baskets['eur_basket'] : 0.0,
    'use_temp_baskets' => $use_temp,
  );
}

/**
 * Commit basket balances to forex_baskets or forex_baskets_temp.
 */
function forex_commit_baskets(array $new_baskets, $use_temp = FALSE) {
  $payload = array(
    'ch_basket' => (float) $new_baskets['ch_basket'],
    'eur_basket' => (float) $new_baskets['eur_basket'],
  );
  if ($use_temp) {
    variable_set('forex_baskets_temp', $payload);
  }
  else {
    if (variable_get('forex_baskets_temp')) {
      variable_del('forex_baskets_temp');
    }
    variable_set('forex_baskets', $payload);
  }
}

/**
 * Regime-aware EUR→CHR quote (does not mutate baskets or minR).
 */
function forex_price_eur_to_chr($eur_in, $ch_basket, $eur_basket, $variable_fee = 0.0, $fixed_fee = 0.0) {
  $eur_in = (float) $eur_in;
  $ch_basket = (float) $ch_basket;
  $eur_basket = (float) $eur_basket;
  $variable_fee = (float) $variable_fee;
  $fixed_fee = (float) $fixed_fee;
  $min_r = forex_min_r_get();
  $eur_net = forex_eur_net_after_fees($eur_in, $variable_fee, $fixed_fee);
  $fee = $eur_in - $eur_net;

  $result = array(
    'output' => 0.0,
    'fee' => $fee,
    'eur_net' => $eur_net,
    'regime' => 'positive',
    'rejected' => FALSE,
    'reject_reason' => NULL,
    'chr_depth' => NULL,
    'effective_rate' => NULL,
    'min_r' => $min_r,
  );

  if ($eur_in <= 0 || $eur_net <= 0) {
    $result['rejected'] = TRUE;
    $result['reject_reason'] = 'invalid_input';
    return $result;
  }

  if (forex_is_bootstrap_state($ch_basket, $eur_basket)) {
    if ($min_r <= 0) {
      $result['rejected'] = TRUE;
      $result['reject_reason'] = 'min_r_not_set';
      return $result;
    }
    $chr_out = 10.0 * $eur_net / $min_r;
    $result['output'] = $chr_out;
    $result['regime'] = 'bootstrap';
    $result['effective_rate'] = forex_effective_hourly_rate($eur_net, $chr_out);
    return $result;
  }

  if ($ch_basket <= 0) {
    $chr_depth = forex_synthetic_chr_depth($ch_basket);
    $fx = forex($eur_in, $eur_basket + $eur_in, $chr_depth, $variable_fee, $fixed_fee);
    $chr_out = isset($fx['output']) ? (float) $fx['output'] : 0.0;
    $result['output'] = $chr_out;
    $result['regime'] = 'liability_symmetric';
    $result['chr_depth'] = $chr_depth;
    $result['effective_rate'] = $chr_out > 0 ? forex_effective_hourly_rate($eur_net, $chr_out) : NULL;
    return $result;
  }

  $fx = forex($eur_in, $eur_basket + $eur_in, $ch_basket, $variable_fee, $fixed_fee);
  $chr_out = isset($fx['output']) ? (float) $fx['output'] : 0.0;
  $result['output'] = $chr_out;
  $result['regime'] = 'positive';
  $result['effective_rate'] = $chr_out > 0 ? forex_effective_hourly_rate($eur_net, $chr_out) : NULL;
  return $result;
}

/**
 * Regime-aware CHR→EUR quote (does not mutate baskets or minR).
 */
function forex_price_chr_to_eur($chr_in, $ch_basket, $eur_basket, $variable_fee = 0.0, $fixed_fee = 0.0) {
  $chr_in = (float) $chr_in;
  $ch_basket = (float) $ch_basket;
  $eur_basket = (float) $eur_basket;
  $variable_fee = (float) $variable_fee;
  $fixed_fee = (float) $fixed_fee;
  $min_r = forex_min_r_get();

  $result = array(
    'output' => 0.0,
    'fee' => 0.0,
    'regime' => 'blocked',
    'rejected' => FALSE,
    'reject_reason' => NULL,
    'chr_depth' => NULL,
    'effective_rate' => NULL,
    'min_r' => $min_r,
  );

  if ($chr_in <= 0) {
    $result['rejected'] = TRUE;
    $result['reject_reason'] = 'invalid_input';
    return $result;
  }

  if ($eur_basket <= 0) {
    $result['rejected'] = TRUE;
    $result['reject_reason'] = 'eur_basket_empty';
    return $result;
  }

  if ($ch_basket + $chr_in > 0) {
    $fx = forex($chr_in, $ch_basket + $chr_in, $eur_basket, $variable_fee, $fixed_fee);
    $eur_out = isset($fx['output']) ? (float) $fx['output'] : 0.0;
    $result['output'] = $eur_out;
    $result['fee'] = isset($fx['fee']) ? (float) $fx['fee'] : 0.0;
    $result['regime'] = 'positive';
    $result['effective_rate'] = forex_effective_hourly_rate($eur_out, $chr_in);
    if ($eur_out <= 0) {
      $result['rejected'] = TRUE;
      $result['reject_reason'] = 'zero_payout';
    }
    elseif ($eur_out > $eur_basket) {
      $result['rejected'] = TRUE;
      $result['reject_reason'] = 'insufficient_eur_liquidity';
    }
    return $result;
  }

  $chr_depth = forex_synthetic_worker_chr_depth($ch_basket, $chr_in);
  $fx = forex($chr_in, $chr_depth, $eur_basket, $variable_fee, $fixed_fee);
  $eur_raw = isset($fx['output']) ? (float) $fx['output'] : 0.0;
  $floor = ($chr_in / 10.0) * $min_r;
  $eur_out = max($eur_raw, $floor);
  $result['output'] = $eur_out;
  $result['fee'] = isset($fx['fee']) ? (float) $fx['fee'] : 0.0;
  $result['regime'] = 'liability_symmetric';
  $result['chr_depth'] = $chr_depth;
  $result['effective_rate'] = forex_effective_hourly_rate($eur_out, $chr_in);

  if ($eur_out <= 0) {
    $result['rejected'] = TRUE;
    $result['reject_reason'] = 'zero_payout';
  }
  elseif ($eur_out > $eur_basket) {
    $result['rejected'] = TRUE;
    $result['reject_reason'] = 'insufficient_eur_liquidity';
  }
  return $result;
}

/**
 * Binary-search inverse: EUR input needed for a target CHR output.
 */
function forex_price_eur_to_chr_reverse($target_chr, $ch_basket, $eur_basket, $variable_fee = 0.0, $fixed_fee = 0.0) {
  $target_chr = (float) $target_chr;
  if ($target_chr <= 0) {
    return array('output' => 0.0, 'fee' => 0.0, 'rejected' => TRUE, 'reject_reason' => 'invalid_input');
  }

  $quote = forex_price_eur_to_chr(0.01, $ch_basket, $eur_basket, $variable_fee, $fixed_fee);
  if (!empty($quote['rejected']) && $quote['reject_reason'] === 'min_r_not_set' && forex_is_bootstrap_state($ch_basket, $eur_basket)) {
    return array('output' => 0.0, 'fee' => 0.0, 'rejected' => TRUE, 'reject_reason' => 'min_r_not_set');
  }

  $lo = 0.01;
  $hi = max(1.0, (float) $eur_basket + $target_chr);
  for ($i = 0; $i < 60; $i++) {
    $mid = ($lo + $hi) / 2.0;
    $fwd = forex_price_eur_to_chr($mid, $ch_basket, $eur_basket, $variable_fee, $fixed_fee);
    $out = isset($fwd['output']) ? (float) $fwd['output'] : 0.0;
    if ($out >= $target_chr) {
      $hi = $mid;
    }
    else {
      $lo = $mid;
    }
  }

  $fwd = forex_price_eur_to_chr($hi, $ch_basket, $eur_basket, $variable_fee, $fixed_fee);
  return array(
    'output' => $hi,
    'fee' => isset($fwd['fee']) ? (float) $fwd['fee'] : 0.0,
    'eur_net' => isset($fwd['eur_net']) ? (float) $fwd['eur_net'] : 0.0,
    'rejected' => !empty($fwd['rejected']),
    'reject_reason' => isset($fwd['reject_reason']) ? $fwd['reject_reason'] : NULL,
    'regime' => isset($fwd['regime']) ? $fwd['regime'] : NULL,
  );
}

/**
 * Binary-search inverse: CHR input needed for a target EUR output.
 */
function forex_price_chr_to_eur_reverse($target_eur, $ch_basket, $eur_basket, $variable_fee = 0.0, $fixed_fee = 0.0) {
  $target_eur = (float) $target_eur;
  if ($target_eur <= 0) {
    return array('output' => 0.0, 'fee' => 0.0, 'rejected' => TRUE, 'reject_reason' => 'invalid_input');
  }

  if ($eur_basket <= 0) {
    return array('output' => 0.0, 'fee' => 0.0, 'rejected' => TRUE, 'reject_reason' => 'eur_basket_empty');
  }

  $lo = 0.01;
  $hi = max(10.0, abs($ch_basket) + $target_eur * 100.0);
  for ($i = 0; $i < 60; $i++) {
    $mid = ($lo + $hi) / 2.0;
    $fwd = forex_price_chr_to_eur($mid, $ch_basket, $eur_basket, $variable_fee, $fixed_fee);
    $out = isset($fwd['output']) ? (float) $fwd['output'] : 0.0;
    if ($out >= $target_eur) {
      $hi = $mid;
    }
    else {
      $lo = $mid;
    }
  }

  $fwd = forex_price_chr_to_eur($hi, $ch_basket, $eur_basket, $variable_fee, $fixed_fee);
  return array(
    'output' => $hi,
    'fee' => isset($fwd['fee']) ? (float) $fwd['fee'] : 0.0,
    'rejected' => !empty($fwd['rejected']),
    'reject_reason' => isset($fwd['reject_reason']) ? $fwd['reject_reason'] : NULL,
    'regime' => isset($fwd['regime']) ? $fwd['regime'] : NULL,
  );
}

/**
 * Apply a trade and return pricing plus post-trade basket state.
 *
 * @param bool $ratchet_min_r
 *   TRUE for worker CHR→EUR trades (ratchets minR); FALSE for donor EUR→CHR.
 * @param bool $persist_min_r
 *   When TRUE and $ratchet_min_r, write ratcheted minR to variable storage.
 */
function forex_apply_trade($transact_type, $input, $ch_basket, $eur_basket, $variable_fee = 0.0, $fixed_fee = 0.0, $ratchet_min_r = FALSE, $charge_fees = TRUE, $persist_min_r = TRUE) {
  $type = (strtolower($transact_type) === 'chr_to_eur') ? 'chr_to_eur' : 'eur_to_chr';
  $ch_basket = (float) $ch_basket;
  $eur_basket = (float) $eur_basket;
  $input = (float) $input;

  if (!$charge_fees) {
    $variable_fee = 0.0;
    $fixed_fee = 0.0;
  }

  $min_r_before = forex_min_r_get();
  $result = array(
    'output' => 0.0,
    'fee' => 0.0,
    'eur_net' => 0.0,
    'new_ch_basket' => $ch_basket,
    'new_eur_basket' => $eur_basket,
    'min_r_before' => $min_r_before,
    'min_r_after' => $min_r_before,
    'regime' => 'blocked',
    'rejected' => TRUE,
    'reject_reason' => 'invalid_type',
    'effective_rate' => NULL,
    'chr_fee' => 0.0,
  );

  if ($type === 'eur_to_chr') {
    $quote = forex_price_eur_to_chr($input, $ch_basket, $eur_basket, $variable_fee, $fixed_fee);
    $result['output'] = isset($quote['output']) ? (float) $quote['output'] : 0.0;
    $result['fee'] = isset($quote['fee']) ? (float) $quote['fee'] : 0.0;
    $result['eur_net'] = isset($quote['eur_net']) ? (float) $quote['eur_net'] : 0.0;
    $result['regime'] = $quote['regime'];
    $result['rejected'] = !empty($quote['rejected']);
    $result['reject_reason'] = isset($quote['reject_reason']) ? $quote['reject_reason'] : NULL;
    $result['effective_rate'] = isset($quote['effective_rate']) ? $quote['effective_rate'] : NULL;

    if (!$result['rejected'] && $result['output'] > 0 && $result['eur_net'] > 0) {
      $chr_out = $result['output'];
      $eur_net = $result['eur_net'];
      if ($quote['regime'] === 'bootstrap') {
        $result['new_ch_basket'] = -$chr_out;
      }
      else {
        $result['new_ch_basket'] = $ch_basket - $chr_out;
      }
      $result['new_eur_basket'] = $eur_basket + $eur_net;
    }
    return $result;
  }

  $quote = forex_price_chr_to_eur($input, $ch_basket, $eur_basket, $variable_fee, $fixed_fee);
  $result['output'] = isset($quote['output']) ? (float) $quote['output'] : 0.0;
  $result['fee'] = isset($quote['fee']) ? (float) $quote['fee'] : 0.0;
  $result['chr_fee'] = $result['fee'];
  $result['regime'] = $quote['regime'];
  $result['rejected'] = !empty($quote['rejected']);
  $result['reject_reason'] = isset($quote['reject_reason']) ? $quote['reject_reason'] : NULL;
  $result['effective_rate'] = isset($quote['effective_rate']) ? $quote['effective_rate'] : NULL;

  if ($result['rejected'] || $result['output'] <= 0) {
    return $result;
  }

  $eur_out = $result['output'];
  if ($quote['regime'] === 'liability_symmetric') {
    $result['new_ch_basket'] = $ch_basket + $input;
  }
  else {
    $result['new_ch_basket'] = $ch_basket + $input - $result['chr_fee'];
  }
  $result['new_eur_basket'] = $eur_basket - $eur_out;

  if ($ratchet_min_r) {
    if ($persist_min_r) {
      $result['min_r_after'] = forex_min_r_ratchet($eur_out, $input);
    }
    else {
      $result['min_r_after'] = max($min_r_before, 10.0 * $eur_out / $input);
    }
  }

  return $result;
}

/**
 * Apply a trade and commit basket balances (used by Rules and checkout flows).
 */
function rovas_forex_settle_trade($transact_type, $input, $ch_basket, $eur_basket, $variable_fee = 0.0, $fixed_fee = 0.0, $ratchet_min_r = FALSE, $charge_fees = TRUE, $use_temp_baskets = FALSE) {
  $trade = forex_apply_trade($transact_type, $input, $ch_basket, $eur_basket, $variable_fee, $fixed_fee, $ratchet_min_r, $charge_fees, TRUE);
  if (empty($trade['rejected'])) {
    forex_commit_baskets(array(
      'ch_basket' => $trade['new_ch_basket'],
      'eur_basket' => $trade['new_eur_basket'],
    ), $use_temp_baskets);
  }
  return $trade;
}

/*
* the forex core function for converting one currency to another
* derived from the bancor formula
* @input = the amount of currency we have and want to exchange
* @input_balance = the amount of input currency in the Rovas reserve basket for that currency
* @output_balance = the amount of currency in the Rovas reserve basket for the target currency
* @fee = the fee between 0 and 1 we want to charge for the conversion
* @fixedfee = fixed base amount to be added to the fee
*/
function forex ($input,$input_balance,$output_balance,$fee,$fixedfee = 0) {

	if (!$input_balance) {
		return ['output' => null, 'fee' => null];
	}

	// PHP 7.4+ emits "non-numeric value" warnings for NULL/string in arithmetic.
	// Coerce to float; non-numeric values become 0.
	$input = is_numeric($input) ? (float) $input : 0.0;
	$input_balance = (float) $input_balance;
	$output_balance = is_numeric($output_balance) ? (float) $output_balance : 0.0;
	$fee = is_numeric($fee) ? (float) $fee : 0.0;
	$fixedfee = is_numeric($fixedfee) ? (float) $fixedfee : 0.0;

	$tt_balance=1;
	$input_weight=0.5;
	$output_weight=1-$input_weight;
	
	$allfees = $input * $fee + $fixedfee;

	$input_adjusted = $input - $allfees;
	
	if ($fee < 0 || $input <= $allfees || $fee > 1) {
		$calc_output = 0;
	}
	else {
		$smartt = $tt_balance*(pow((1+$input_adjusted/$input_balance),$input_weight)-1);
		$calc_output = $output_balance*(pow((1-$smartt/($tt_balance+$smartt)),(1/$output_weight))-1)*(-1);
	}

	return ['output' => $calc_output, 'fee' => abs($allfees)];
	
}

/*
forex for fx-sandbox project currency conversions
*/
function project_forex ($input,$input_balance,$output_balance,$fee,$fixedfee = 0) {
	// PHP 7.4+ compatibility: coerce non-numeric values.
	$input = is_numeric($input) ? (float) $input : 0.0;
	$input_balance = is_numeric($input_balance) ? (float) $input_balance : 0.0;
	$output_balance = is_numeric($output_balance) ? (float) $output_balance : 0.0;
	$fee = is_numeric($fee) ? (float) $fee : 0.0;
	$fixedfee = is_numeric($fixedfee) ? (float) $fixedfee : 0.0;
	$rate = $input_balance > 0 ? ($output_balance/$input_balance) : 0;
	$feeoutput = $input*$fee + $fixedfee; //[€]
	$calc_output = $rate * $input - $feeoutput; //[€]

	return array('output' => $calc_output, 'fee' => $feeoutput);
}

/*
* derived from the bancor formula
* for a given amount we want to get on the output, this function returns the amount we need to pay.
* the @input must be lower than the input balance
* @input = the amount of currency we have and want to exchange
* @input_balance = the amount of input currency in the Rovas reserve basket for that currency
* @output_balance = the amount of currency in the Rovas reserve basket for the target currency
* @fee = the fee we want to charge for the conversion
*/
function forex_reverse ($input,$input_balance,$output_balance,$fee) {

	// PHP 7.4+ compatibility: coerce non-numeric values.
	$input = is_numeric($input) ? (float) $input : 0.0;
	$input_balance = is_numeric($input_balance) ? (float) $input_balance : 0.0;
	$output_balance = is_numeric($output_balance) ? (float) $output_balance : 0.0;
	$fee = is_numeric($fee) ? (float) $fee : 0.0;

	$tt_balance=1;
	$input_weight=0.5;
	$output_weight=1-$input_weight;

if ($input_balance > $fee*$input_balance + $input) {

	$K = pow($input/($input_balance*($fee-1)) + 1,$input_weight);
	$inc = ($tt_balance * (1 - $K))/$K;
	$output = $output_balance*(pow($inc/($tt_balance*(1-$fee)) + 1,1/$output_weight) -1);
}
else {
	$output = -1;
}	
	$calc_fee = $fee*($output/(1-$fee));
	
	return array('output' => $output, 'fee' => $calc_fee);
	
}

/**
 * Custom validation handler to check session expiration.
 */
function rovas_forex_session_expiration_validate($form, &$form_state) {

//	watchdog('rovas_forex_module','validating (form state content) <pre>' . print_r($form_state,1) . '</pre>');

  if (isset($form_state['rovas_session_data']) && !isset($form_state['triggering_element']['#ajax'])) {
    $expiration = $form_state['rovas_session_data']['expiration'];
    $callback_url = $form_state['rovas_session_data']['callback_url'];
    $curtime = time();
    
    if ($expiration < $curtime) {
      drupal_goto($callback_url . '?error=timeout');
    }
  }
}

