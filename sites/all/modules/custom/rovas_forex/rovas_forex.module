function forex_admin_form_submit($form, &$form_state) {

	variable_set('forex_product_id',$form_state['values']['prod_id']);
	variable_set('rovas_admin_uid',$form_state['values']['rovas_admin_uid']);
	variable_set('minimum_eur',$form_state['values']['minimum_eur']);
	variable_set('ch_basket_init',$form_state['values']['ch_basket_init']);
	variable_set('eu_basket_init',$form_state['values']['eu_basket_init']);
	if (is_numeric($form_state['values']['forex_min_r'])) {
		forex_min_r_set($form_state['values']['forex_min_r']);
	}
	variable_set('buy_ch_fee',$form_state['values']['buy_ch_fee']);
	variable_set('base_buy_ch_fee',$form_state['values']['base_buy_ch_fee']);
	variable_set('buy_ch_fixed_fee',$form_state['values']['buy_ch_fixed_fee']);
	variable_set('buy_eur_fee',$form_state['values']['buy_eur_fee']);

	$lock_ts = variable_get('forex_lock');
	$time_remaining = $lock_ts ? $lock_ts['time'] - (time() - 5*60) : -1;

	// transaction-processing functionality
	if ($time_remaining <= 0 && $form_state['values']['adjust_chrons'] != 0) {
		variable_set('forex_lock',array('uid' => 1, 'time' => time()));

		$forex_baskets = variable_get('forex_baskets');
	
		$forex_baskets = empty($forex_baskets) ? array('ch_basket' => $form_state['values']['adjust_chrons'], 'eur_basket' => $form_state['values']['eu_basket_init']) : $forex_baskets;

		$new_ch_value = $form_state['values']['adjust_chrons'] + $forex_baskets['ch_basket'];
		variable_set('forex_baskets',array('ch_basket' => $new_ch_value, 'eur_basket' => $forex_baskets['eur_basket'] ? $forex_baskets['eur_basket'] : 0));

		if ($form_state['values']['adjust_chrons'] > 0) {
			$result = rules_invoke_component(
				'rules_process_forex_order',
				$form_state['values']['rovas_admin_uid'],
				'chrons_to_euros',
				$form_state['values']['adjust_chrons'], //chrons transfered
				0, //EUR received
				0, //fee
				$forex_baskets['ch_basket'],
				$forex_baskets['eur_basket'],
				0,
				0
			);
		}
		else {
			$result = rules_invoke_component(
				'rules_process_forex_order',
				$form_state['values']['rovas_admin_uid'],
				'euros_to_chrons',
				0, //EUR received
				-1 * $form_state['values']['adjust_chrons'], //chrons transfered
				0, //fee
				$forex_baskets['ch_basket'],
				$forex_baskets['eur_basket'],
				0,
				0
			);
		}
		if($result[0] > 0) {
			global $user;
			//update the user's chron account
			rules_invoke_component(
				'rules_update_user_chron_account',
				$user,
				-1 * $form_state['values']['adjust_chrons'], //chrons transfered
				null
			);
			$msg = 'The changes have been saved';
		}
		else {
			$msg = 'Error! There was a problem with creating a transaction record';
		}

		variable_del('forex_lock');

	}
	else if ($time_remaining <= 0) {
			$msg = 'The changes have been saved';	
		}
	else {

		$msg = 'Somebody has a lock right now. You can try again in '. date('i',$time_remaining) .' minutes, '. date('s',$time_remaining) .' seconds.';
		}
	drupal_set_message($msg);

	$path= current_path();
	drupal_goto($path);

}

function _validate_admin($form, &$form_state) {

	$user_id = $form_state['values']['rovas_admin_uid'];
	$user = user_load($user_id);
	$ch_available = rules_invoke_component('rules_chrons_actually_available',$user);
	
	$forex_baskets = variable_get('forex_baskets');

  if ($form_state['values']['adjust_chrons'] > 0 && $form_state['values']['adjust_chrons'] > $ch_available[0]) {
    form_set_error('adjust_chrons', 'Error: the amout must be lower than the Chrons available.');
  }
  if (!is_numeric($form_state['values']['forex_min_r']) || $form_state['values']['forex_min_r'] < 0) {
    form_set_error('forex_min_r', 'Error: minR must be a non-negative number.');
  }

}


function rovas_forex_form($form, &$form_state) {

	if (variable_get('minimum_eur') === 0) {
		drupal_set_message('Error: Setup variables are not defined. Please contact the portal administrator with this error.');
		return $form;
	}

	//the minimum EUR amount for an order. We do not want to process smaller orders
	$minimum_eur = variable_get('minimum_eur');

	if (isset($form_state['storage']['page_two'])) {
		return rovas_preview_form($form, $form_state);
	}

	global $user;

	//determining if there is a lock active and who owns it
	$lock_ts = variable_get('forex_lock') ? variable_get('forex_lock') : array('uid' => -1,'time' => 0);
	$time_remaining = $lock_ts['time'] - (time() - 5*60);
	$lock_user = $lock_ts['uid'];

/*	
	//lock is active - using the active value for the forex baskets
	if ($time_remaining > 0 && $lock_user != $user->uid) {
		$forex_baskets = variable_get('forex_baskets_temp');
	}
	else {
		if (empty(variable_get('forex_baskets'))) {

			//initial endowments for the baskets
			$ch_basket_init = variable_get('ch_basket_init');
			$eur_basket_init = variable_get('eu_basket_init');
		
			$forex_baskets = array('ch_basket' => $ch_basket_init, 'eur_basket' => $eur_basket_init);
			variable_set('forex_baskets',$forex_baskets);
		}
		else {
			$forex_baskets = variable_get('forex_baskets');
		}
	}

	$ch_basket = $forex_baskets['ch_basket'];
	$eur_basket = $forex_baskets['eur_basket'];
*/

/* Buy Euros */

	if (ROVAS_FOREX_CHR_TO_EUR_SUSPENDED) {
		$form['eu-ch'] = array(
			'#type' => 'markup',
			'#prefix' => '<div class="eu-ch-wrapper">',
			'#suffix' => '</div>',
			'#markup' => '<div class="forex subhead">' . t('Chrons to Euros exchanges are temporarily suspended') . '</div>',
		);
	}
	else {
	$forex_params = calculate_forex_transaction_params('chr_to_eur',1);
	$eur_basket = $forex_params['eur_basket'];
	$ch_basket = $forex_params['chr_basket'];
	$buy_eur_fee = $forex_params['xfee'];

	$fx_sandbox_projects = rules_invoke_component('rules_worker_merit_shares_for_fx_sandbox_projects',$user);

	$showRateSwitch = count($fx_sandbox_projects[0]) > 0 ? TRUE : FALSE;

	$options = [0 => t('default')];

	if ($fx_sandbox_projects[0]) {

		foreach ($fx_sandbox_projects[0] as $i => $wma_string) {
			$wma_array = explode('-',$wma_string);
			$wma_nid = $wma_array[2];
			$wma = node_load($wma_nid);
			$options['ind-'.$i] = $wma_array[3] . ' €/Chr (' . t('from the "@projname" project',['@projname' => $wma->title]) . ')';
		}
	}

	$result = rules_invoke_component('rules_chrons_actually_available',$user);
	if ($result[0]) {
		$user_chrons = $result[0];
	}
	else {
		$user_chrons = 0;
	}

	if (isset($form_state['values']['forex-rate']) && substr($form_state['values']['forex-rate'],0,3) == 'ind') {
		$indexv = $form_state['values']['forex-rate'];
		$indx = substr($indexv,4);
		$wma_string = $fx_sandbox_projects[0][$indx];
		$wma_array = explode('-',$wma_string);
		$proj_nid = $wma_array[2];

		$projob = entity_metadata_wrapper('node', $proj_nid);

		$proj_title = $projob->label();

		//setting the exchange rate, through project-specific currency baskets
		$ch_basket = $projob->field_chron_basket->value();
		$eur_basket = $projob->field_euro_basket->value();

		$show = 'project';
		$user_chrons = $wma_array[1];
		
		$defopt = $indexv;

		//pass the wma string to the next page
		$form['wma-string'] = [
			'#type' => 'hidden',
			'#value' => $wma_string
		];

		//pass the fx-baskets to the next page
		$form['fx-baskets'] = [
			'#type' => 'hidden',
			'#value' => ['ch_basket' => $ch_basket,'eur_basket' => $eur_basket]
		];

	}
	else {
		$show = 'default';
		$defopt = 0;
	}

	if ($show == 'project') {
		$title = t('Project @pname balance',['@pname' => $proj_title]);
	}
	else {
		$title = t('Account balance');
	}

	$chrbal = '<div class="ch-balance-wrapper">';
	$chrbal .= '<div class="title">';
	$chrbal .= $title;
	$chrbal .= '</div>';
	$chrbal .= '<div class="value">';
	$chrbal .= $user_chrons . ' ' . t('CH');
	$chrbal .= '</div>';
	$chrbal .= '</div>';

	$form['chron-balance'] = array(
			'#type' => 'markup',
			'#markup' => $chrbal,
		);

	$form['eu-ch'] = array(
			'#type' => 'markup',
			'#prefix' => '<div class="eu-ch-wrapper">',
			'#suffix' => '</div>',
		);

	$widget_text = '<div class="icon euro" style="width: 30px; display: inline-block; margin-right: 7px; top: -3px; position: relative;"><img src="/sites/all/themes/rovas/images/euroIcon.svg"></div>';
	$widget_text .= '<div class="forex subhead">' . t('Buy Euros') . '</div>';

//	$widget_text .= '<div class="explain-char">' . t('You too can help improve the exchange rate. Ask users of the Rovas projects you are working on, to reward them.') . '</div>';
	$widget_text .= '<div class="explain-char"></div>';

	$form['eu-ch']['eu-ch-markup'] = array(
		'#type' => 'markup',
		'#markup' => $widget_text,
	);

	if ($showRateSwitch) {
		$form['eu-ch']['forex-rate'] = array(
			'#type' => 'select',
			'#title' => t('Rate'),
			'#options' => $options,
			'#default_value' => $defopt,
			'#attributes' => ['style' => 'width: fit-content'],
			'#description' => t('Choose the exchange rate you wish to use for the purchase'),
			'#ajax' => [
				'callback' => '_rf_update_rate_dependents',
				'effect' => 'fade',
				],
		);
	}
	else {
		$form['forex-rate'] = array(
				'#type' => 'hidden',
				'#value' => '0'
			);

	}

	$form['eu-ch']['eu-ch_value'] = array(
		'#type' => 'textfield', 
		'#default_value' => 1,
		'#field_suffix' => 'CH',
		'#size' => 60, 
		'#maxlength' => 128, 
		'#required' => FALSE,
	);
	
	$amount = empty($form_state['input']['eu-ch_value']) ? 1 : $form_state['input']['eu-ch_value'];

	if (isset($form_state['values']['forex-rate']) && substr($form_state['values']['forex-rate'],0,3) == 'ind') {
		$eur_result_ary = project_forex ($amount,$ch_basket,$eur_basket,$buy_eur_fee);
	}
	else {
		$chr_quote = forex_price_chr_to_eur($amount, $ch_basket, $eur_basket, $buy_eur_fee, 0.0);
		$eur_result_ary = array(
			'output' => isset($chr_quote['output']) ? $chr_quote['output'] : 0.0,
			'fee' => isset($chr_quote['fee']) ? $chr_quote['fee'] : 0.0,
		);
	}

	$eur_result = $eur_result_ary['output'];
	$result_fee = $eur_result_ary['fee']; //CHR
	
	$form['eu-ch']['convert'] = [
		'#type' => 'button',
		'#name' => 'con_eu_ch',
		'#button_type' => 'button',
		'#value' => '<span class="glyphicon glyphicon-refresh"> </span>', //recalculate icon
		"#submit" => [],
		'#ajax' => [
			'callback' => '_rf_update_rate_dependents',
			'effect' => 'fade',
			],
		];

	$form['eu-ch-converted-value'] = array(
			'#type' => 'hidden',
			'#value' => $eur_result
		);

	$form['eu-ch-fee'] = array(
			'#type' => 'hidden',
			'#value' => $result_fee
		);

	$form['eu-ch']['eu-ch-converted'] = array(
			'#type' => 'markup',
			'#prefix' => '<div id="eu-ch-converted">',
			'#suffix' => '</div>',
			'#markup' => number_format($eur_result,2,'.',' ') . '<span class="to-unit"> EUR</span>',
		);

	$usr_obj = entity_metadata_wrapper('user', $user);
	if($usr_obj->field_bank_account_iban->value() || $usr_obj->field_paypal_email->value() || $usr_obj->field_phone->value()) {
		$missing_accounts = FALSE;
	}
	else {
		$missing_accounts = TRUE;
	}
	
	//change the Preview order button to Refresh if another person is just submitting an order
	if ($time_remaining > 0 && $lock_user != $user->uid) {
		$btn_label = t('Refresh', array(), array('context' => 'Forex'));
		$btn_name = 'forex_refresh';
		$lock_note =  t('Another person is ahead of you in the queue to exchange money at this moment.');
		$lock_note .= '<br>' . t('You can proceed in @minutes minutes, @seconds seconds or sooner, by clicking the Refresh button.',array('@minutes' => 1* date('i',$time_remaining),'@seconds' => 1* date('s',$time_remaining)));
	}

	else {
		$btn_label = t('Preview order', array(), array('context' => 'Forex'));
		$btn_name = 'preview_eu_ch';
		$lock_note = '';
	}	

	$balanc_tester = isset($form_state['input']['eu-ch_value']) ? $form_state['input']['eu-ch_value'] : $form['eu-ch']['eu-ch_value']['#default_value'];
	switch (TRUE) {
		case $balanc_tester > $user_chrons :
			$submit_disabled = TRUE;
			$eu_ch_explain = t('Your account balance of @chrons CH is insufficient to proceed with this order.',array('@chrons' => $user_chrons));
			break;
		case $eur_result < $minimum_eur:
			$submit_disabled = TRUE;
			$eu_ch_explain = t('To proceed with the order, the Euro amount must be at least @euro €',array('@euro' => $minimum_eur));
			break;
		//user does not have paypal account or bank account set up
		case $missing_accounts:
			$submit_disabled = TRUE;
			$eu_ch_explain = t('To proceed with the order, you must have a bank, telephone number, or paypal account information entered in your <a href="@usrprofile">user profile</a>',array('@usrprofile' => '/user/' . $user->uid . '/edit'));
			break;
		default :
			$submit_disabled = FALSE;
			$eu_ch_explain = '';
	}

	$form['eu-ch']['submit-explain'] = array(
		'#type' => 'markup',
		'#prefix' => '<div id="submit-explain">',
		'#suffix' => '</div>',
		'#markup' => ($eu_ch_explain == '') ? $lock_note : $eu_ch_explain,
	);

	$form['eu-ch']['submit'] = array(
		'#type' => 'submit',
		'#name' => $btn_name,
		'#value' => $btn_label,
		'#disabled' => $submit_disabled,
		'#prefix' => '<div id="eu-ch-subbutton">',
		'#suffix' => '</div>',
	);

	}


/* Buy Merits */
	$form['buy-merits'] = array(
		'#type' => 'markup',
		'#prefix' => '<div class="buy-merits-wrapper">',
		'#suffix' => '</div>',
		'#weight' => 6,
	);

	$widget_text = '<div class="icon merit" style="width: 30px; display: inline-block; margin-right: 7px; top: -3px; position: relative;"><img src="/sites/all/themes/rovas/images/meritIcon.svg"></div>';
	$widget_text .= '<div class="forex subhead">' . t('Buying Merits') . '</div>';
	$widget_text .= '<div class="buy-merits-explain">' . t('Your Merit balance reflects the economic value you have contributed to society, and buying here is the most favourable way to obtain Merits with your money. When you exchange Chrons or euros for Merits, you strengthen the Chron exchange rate and, with it, the hourly compensation that workers in Rovas can receive for their reported hours. This mechanism directs your money effectively to people on the lowest incomes.') . '</div>';

	$form['buy-merits']['buy-merits-markup'] = array(
		'#type' => 'markup',
		'#markup' => $widget_text,
	);

	$form['buy-merits']['submit'] = array(
		'#type' => 'submit',
		'#name' => 'buy_merits_start',
		'#value' => t('Buy Merits'),
		'#attributes' => array(
			'id' => array('buy-merits-start'),
			'class' => array('btn', 'btn-default'),
			'style' => array('color: #222; border-color: #bdbdbd;'),
			'role' => array('button'),
		),
		'#html' => TRUE,
		'#prefix' => '<div id="buy-merits-subbutton">',
		'#suffix' => '</div>',
	);


/* Buy Chrons */
/*
	$form['ch-eu'] = array(
			'#type' => 'markup',
			'#prefix' => '<div class="ch-eu-wrapper">',
			'#suffix' => '</div>',
		);

	$widget_text = '<div class="forex subhead">' . t('Buy Chrons') . '</div>';
	$widget_text .= '<div class="explain">' . t('Due to the constrains imposed by our payment processor, the amounts calculated below might differ slightly from the amounts actually paid and received. Please advance to the next screen to see the actual rates.') . '</div>';

	$form['ch-eu']['ch-eu-markup'] = array(
		'#type' => 'markup',
		'#markup' => $widget_text,
	);

	$form['ch-eu']['ch-eu_value'] = array(
