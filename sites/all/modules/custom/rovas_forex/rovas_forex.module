		}
			$ch_result_ary = forex($eur_paid,$eur_basket,$ch_basket,$buy_ch_fee,$buy_ch_fixed_fee);
			$ch_result = $ch_result_ary['output'];
			$ch_result_fee = $ch_result_ary['fee'];

	$form['ch-eu']['ch-eu-converted-value'] = array(
