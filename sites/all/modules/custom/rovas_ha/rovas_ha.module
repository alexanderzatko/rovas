<?php

/**
 * Alter HybridAuth provider configuration.
 * @param $config
 * @param $provider_id
 */
 
/* default config
config Array (
	[enabled] => 1
	[keys] => Array (
		[id] => hydra
		[key] =>
		[secret] => riecna
	)
	[scope] =>
	[display] =>
	[hauth_return_to] => https://dev.merit.world/hybridauth/endpoint
	[oauth2_server] => https://dev.nabezky.sk
	[skip_ssl] =>
	[http_proxy] =>
)
*/

function rovas_ha_hybridauth_provider_config_alter(&$config, $provider_id) {
	if($provider_id == 'DrupalOAuth2' || $provider_id == 'Nabezky') {
		$config['scope'] = 'openid email profile address';
	}
}

/**
 * Implements hook_ctools_plugin_directory().
*/
function rovas_ha_ctools_plugin_directory($module, $type) {
  if ($module == 'hybridauth' && $type == 'icon_pack') {
    return 'plugins/icon_pack';
  }
}


