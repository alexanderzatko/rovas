<?php

/**
 * Set module weight higher than Field Permissions (with weight = 50) to ensure access hooks run after.
 */
function rovas_project_edit_update_7101() {
  db_update('system')
    ->fields(['weight' => 51])
    ->condition('name', 'rovas_project_edit')
    ->execute();

  drupal_set_message('Set rovas_project_edit module weight to 51.');
}

/**
 * Variable allocation is a percentage (0–100); fixed threshold stays in euros.
 *
 * Reward processing uses field_preferred_allocation_thres (€) and/or
 * field_variable_allocation (%); see process_preferred_allocation_payment().
 */
function rovas_project_edit_update_7102() {
  $instance = field_info_instance('node', 'field_variable_allocation', 'project');
  if (!$instance) {
    return;
  }
  $instance['settings']['suffix'] = ' %';
  $instance['settings']['prefix'] = '';
  $instance['settings']['min'] = '0';
  $instance['settings']['max'] = '100';
  field_update_instance($instance);
}
