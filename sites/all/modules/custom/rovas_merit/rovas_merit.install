<?php

/**
 * @file
 * Install / update for Rovas Merit ledger.
 */

/** Batch size for field_merit_source backfill (update hooks + drush). */
define('ROVAS_MERIT_BACKFILL_BATCH', 25);

/**
 * Field base definition for field_merit_source.
 *
 * @return array
 */
function _rovas_merit_field_merit_source_base() {
  $allowed = array();
  foreach (array_keys(rovas_merit_source_options()) as $key) {
    $allowed[$key] = $key;
  }
  return array(
    'field_name' => 'field_merit_source',
    'type' => 'list_text',
    'module' => 'list',
    'active' => 1,
    'locked' => 0,
    'cardinality' => 1,
    'translatable' => 0,
    'settings' => array(
      'allowed_values' => $allowed,
      'allowed_values_function' => '',
    ),
  );
}

/**
 * Field instances for merits_disbursement and merit_penalty.
 *
 * @return array
 */
function _rovas_merit_field_merit_source_instances() {
  $instances = array();
  foreach (array('merits_disbursement', 'merit_penalty') as $bundle) {
    $instances[] = array(
      'field_name' => 'field_merit_source',
      'entity_type' => 'node',
      'bundle' => $bundle,
      'label' => 'Merit source',
      'description' => '',
      'required' => 0,
      'deleted' => 0,
      'default_value' => NULL,
      'settings' => array(
        'user_register_form' => FALSE,
      ),
      'widget' => array(
        'type' => 'options_select',
        'module' => 'options',
        'active' => 1,
        'weight' => 5,
        'settings' => array(),
      ),
      'display' => array(
        'default' => array(
          'label' => 'above',
          'type' => 'list_default',
          'weight' => 5,
          'settings' => array(),
          'module' => 'list',
        ),
        'teaser' => array(
          'type' => 'hidden',
          'label' => 'above',
          'weight' => 0,
          'settings' => array(),
        ),
      ),
    );
  }
  return $instances;
}

/**
 * Implements hook_install().
 *
 * Drupal 7 sets the schema version to the highest hook_update_N number when a
 * module is enabled. Without hook_install(), update 7001 would never run on
 * first enable — the field must be created here.
 */
function rovas_merit_install() {
  module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');
  _rovas_merit_ensure_merit_source_field();
  field_cache_clear();
}

/**
 * Ensure field_merit_source exists on ledger node types.
 */
function _rovas_merit_ensure_merit_source_field() {
  module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');
  if (!field_info_field('field_merit_source')) {
    field_create_field(_rovas_merit_field_merit_source_base());
  }
  foreach (_rovas_merit_field_merit_source_instances() as $instance) {
    if (!field_info_instance('node', 'field_merit_source', $instance['bundle'])) {
      field_create_instance($instance);
    }
  }
  field_cache_clear();
}

/**
 * Ledger nodes missing field_merit_source (paginated).
 *
 * @param int $last_nid
 * @param int $limit
 * @param bool $reclassify
 *   When TRUE, include nodes that already have a source (for re-inference).
 *
 * @return DatabaseStatementInterface
 */
function _rovas_merit_backfill_missing_query($last_nid = 0, $limit = ROVAS_MERIT_BACKFILL_BATCH, $reclassify = FALSE) {
  $source_clause = $reclassify
    ? '1 = 1'
    : "(src.field_merit_source_value IS NULL OR src.field_merit_source_value = '')";
  return db_query_range("
    SELECT n.nid, n.vid, n.type, n.created,
      MAX(rec.field_reward_recipient_target_id) AS uid,
      MAX(amt.field_reward_amount_value) AS amount,
      MAX(pr.field_parent_purchase_receipt_target_id) AS receipt_nid
    FROM {node} n
    LEFT JOIN {field_data_field_merit_source} src
      ON src.entity_id = n.nid AND src.entity_type = 'node' AND src.deleted = 0
    LEFT JOIN {field_data_field_reward_recipient} rec
      ON rec.entity_id = n.nid AND rec.entity_type = 'node' AND rec.deleted = 0
    LEFT JOIN {field_data_field_reward_amount} amt
      ON amt.entity_id = n.nid AND amt.entity_type = 'node' AND amt.deleted = 0
    LEFT JOIN {field_data_field_parent_purchase_receipt} pr
      ON pr.entity_id = n.nid AND pr.entity_type = 'node' AND pr.deleted = 0
    WHERE n.status = 1
      AND n.type IN ('merits_disbursement', 'merit_penalty')
      AND n.nid > :last_nid
      AND $source_clause
    GROUP BY n.nid, n.vid, n.type, n.created
    ORDER BY n.nid ASC
  ", 0, (int) $limit, array(':last_nid' => (int) $last_nid));
}

/**
 * Count ledger nodes still missing field_merit_source.
 *
 * @param bool $reclassify
 *
 * @return int
 */
function _rovas_merit_backfill_missing_count($reclassify = FALSE) {
  if ($reclassify) {
    return (int) db_query("
      SELECT COUNT(DISTINCT n.nid)
      FROM {node} n
      WHERE n.status = 1
        AND n.type IN ('merits_disbursement', 'merit_penalty')
    ")->fetchField();
  }
  return (int) db_query("
    SELECT COUNT(DISTINCT n.nid)
    FROM {node} n
    LEFT JOIN {field_data_field_merit_source} src
      ON src.entity_id = n.nid AND src.entity_type = 'node' AND src.deleted = 0
    WHERE n.status = 1
      AND n.type IN ('merits_disbursement', 'merit_penalty')
      AND (src.field_merit_source_value IS NULL OR src.field_merit_source_value = '')
  ")->fetchField();
}

/**
 * Write field_merit_source without loading the full node.
 *
 * @param int $nid
 * @param int $vid
 * @param string $bundle
 * @param string $source
 */
function _rovas_merit_set_node_merit_source($nid, $vid, $bundle, $source) {
  $entity = (object) array(
    'nid' => (int) $nid,
    'vid' => (int) $vid,
    'type' => $bundle,
  );
  $entity->field_merit_source[LANGUAGE_NONE][0]['value'] = $source;
  field_attach_update('node', $entity);
  entity_get_controller('node')->resetCache(array((int) $nid));
}

/**
 * Batch backfill field_merit_source (sandbox update hook / drush).
 *
 * @param array $sandbox
 */
function _rovas_merit_backfill_sources_sandbox(array &$sandbox) {
  module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');
  if (!field_info_field('field_merit_source')) {
    $sandbox['#finished'] = 1;
    return;
  }

  $reclassify = !empty($sandbox['reclassify']);

  if (empty($sandbox['progress'])) {
    $sandbox['progress'] = 0;
    $sandbox['last_nid'] = 0;
    $sandbox['changed'] = 0;
    $sandbox['max'] = _rovas_merit_backfill_missing_count($reclassify);
    if ($sandbox['max'] === 0) {
      $sandbox['#finished'] = 1;
      return;
    }
  }

  $result = _rovas_merit_backfill_missing_query($sandbox['last_nid'], ROVAS_MERIT_BACKFILL_BATCH, $reclassify);
  $processed = 0;
  foreach ($result as $row) {
    $source = _rovas_merit_infer_source_from_row($row);
    $current = db_query("SELECT field_merit_source_value FROM {field_data_field_merit_source}
      WHERE entity_id = :nid AND entity_type = 'node' AND deleted = 0 LIMIT 1", array(
      ':nid' => $row->nid,
    ))->fetchField();
    if ($current !== $source) {
      _rovas_merit_set_node_merit_source($row->nid, $row->vid, $row->type, $source);
      $sandbox['changed']++;
    }
    $sandbox['last_nid'] = (int) $row->nid;
    $sandbox['progress']++;
    $processed++;
  }

  if ($processed === 0) {
    $sandbox['#finished'] = 1;
  }
  else {
    $sandbox['#finished'] = min(0.99, $sandbox['progress'] / max(1, $sandbox['max']));
  }
}

/**
 * Backfill field_merit_source on existing ledger nodes (single pass, drush).
 *
 * @param bool $reclassify
 *   When TRUE, re-infer sources even when already set.
 *
 * @return int
 *   Number of nodes whose source value changed.
 */
function _rovas_merit_backfill_sources($reclassify = FALSE) {
  $sandbox = array('reclassify' => !empty($reclassify));
  do {
    _rovas_merit_backfill_sources_sandbox($sandbox);
  } while (empty($sandbox['#finished']));
  field_cache_clear();
  return !empty($sandbox['changed']) ? (int) $sandbox['changed'] : 0;
}

/**
 * Add field_merit_source and backfill historical ledger rows.
 */
function rovas_merit_update_7001(&$sandbox) {
  module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');
  if (empty($sandbox['field_done'])) {
    _rovas_merit_ensure_merit_source_field();
    $sandbox['field_done'] = TRUE;
  }
  _rovas_merit_backfill_sources_sandbox($sandbox);
  if (isset($sandbox['#finished']) && $sandbox['#finished'] == 1) {
    field_cache_clear();
    return t('Merit source field installed; backfilled @count ledger nodes.', array(
      '@count' => !empty($sandbox['progress']) ? $sandbox['progress'] : 0,
    ));
  }
}

/**
 * Ensure field_merit_source exists when 7001 was skipped on first enable.
 *
 * On first enable Drupal 7 sets schema to max(update) without running updates
 * when hook_install() was missing. Sites that enabled rovas_merit before
 * hook_install() was added need this idempotent fix.
 */
function rovas_merit_update_7002(&$sandbox) {
  module_load_include('inc', 'rovas_merit', 'rovas_merit.ledger');
  if (empty($sandbox['field_done'])) {
    _rovas_merit_ensure_merit_source_field();
    $sandbox['field_done'] = TRUE;
  }
  _rovas_merit_backfill_sources_sandbox($sandbox);
  if (isset($sandbox['#finished']) && $sandbox['#finished'] == 1) {
    field_cache_clear();
    return t('Merit source field ensured (7001 recovery); backfilled @count ledger nodes.', array(
      '@count' => !empty($sandbox['progress']) ? $sandbox['progress'] : 0,
    ));
  }
}
