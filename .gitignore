# Drupal runtime
sites/*/files/
sites/*/private/
sites/*/tmp/

# Local scratch (e.g. Views export tarballs)
/tmp/

# Secrets / per-env settings
sites/*/settings.php
sites/*/settings.local.php
sites/*/secrets/
.env
.env.*
auth.json

# DB dumps / keys (never commit)
*.sql
*.sql.gz
*.dump
*.pem
*.p8
*.key
id_rsa
id_rsa.pub

# OS / editor
.DS_Store

# Vendor bins (optional)
sites/all/vendor/bin/

# Translation helper progress artifacts
translations/po/*.progress.json

# Apple Sign-In PHP deps (fetched by ops/fetch_apple_signin_libs.sh / deploy-rovas)
sites/all/libraries/php-jwt/
sites/all/libraries/phpseclib/
sites/all/libraries/constant_time_encoding/
